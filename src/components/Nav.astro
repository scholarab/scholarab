---
const { currentPath } = Astro.props;
const navCls = (p) => `hidden md:block transition-colors ${currentPath === p ? 'text-white' : 'text-white/50 hover:text-white/90'}`;
const navClsStart = (p) => `hidden md:block transition-colors ${currentPath.startsWith(p) ? 'text-white' : 'text-white/50 hover:text-white/90'}`;
---

<div id="top-nav-wrapper" class="sticky top-2 z-[500] mb-10" style="padding: 0 16px;">
  <div class="nav-wrapper mx-auto" style="max-width: 900px; position: relative;">
    <nav class="glass-nav flex justify-between items-center px-6 py-3" style="border-radius: 9999px;">
      <a href="/" onclick="if(window.location.pathname==='/'){event.preventDefault()}" class="hover:opacity-80 transition-opacity flex items-center gap-2" aria-label="ScholarAB home">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 310 56" fill="none" height="36" aria-hidden="true">
          <path d="M10 42 L22 20 L34 42Z" fill="#22d3a5" opacity="0.35"/><path d="M26 42 L42 14 L58 42Z" fill="#22d3a5" opacity="0.6"/>
          <path d="M18 42 L34 6 L50 42Z" fill="#22d3a5"/><path d="M34 6 L39 18 L29 18Z" fill="white" opacity="0.9"/>
          <line x1="6" y1="42" x2="62" y2="42" stroke="#22d3a5" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          <text font-family="Syne, sans-serif" font-weight="800" font-size="28" letter-spacing="-0.8">
            <tspan x="74" y="38" class="logo-scholar">Scholar</tspan><tspan fill="#22d3a5">AB</tspan>
          </text>
        </svg>
      </a>
      <div class="flex items-center gap-5 text-sm font-medium">
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined} class={navCls('/')}>Home</a>
        <a href="/scholarships" aria-current={currentPath.startsWith('/scholarships') ? 'page' : undefined} class={navClsStart('/scholarships')}>Scholarships</a>
        <a href="/programs" aria-current={currentPath.startsWith('/programs') ? 'page' : undefined} class={navClsStart('/programs')}>Programs</a>
        <a href="/saved" aria-current={currentPath === '/saved' ? 'page' : undefined} class={navCls('/saved')}>Saved</a>
        <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined} class={navCls('/about')}>About</a>
      </div>
    </nav>
  </div>
</div>

<script>
  let scrollAbort: AbortController | null = null;

  function initNav() {
    const nav = document.querySelector('.glass-nav');
    if (nav) {
      if (scrollAbort) scrollAbort.abort();
      scrollAbort = new AbortController();
      const onScroll = () => {
        nav.classList.toggle('scrolled', window.scrollY > 10);
        nav.classList.toggle('shrunk',   window.scrollY > 60);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true, signal: scrollAbort.signal });
    }
  }

  document.addEventListener('astro:page-load', initNav);
</script>

<style is:global>
  .logo-scholar { fill: #ffffff; }
  .glass-nav a {
    -webkit-tap-highlight-color: transparent;
  }
  .glass-nav {
    background: rgba(10, 10, 15, 0.8);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border: 0.5px solid rgba(255,255,255,0.1);
    position: relative;
    transition: padding 0.3s ease;
  }
  .glass-nav::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 8px 16px -4px rgba(0,0,0,0.35);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .glass-nav.scrolled::after {
    opacity: 1;
  }
  @media (min-width: 769px) {
    .glass-nav {
      background: rgba(255,255,255,0.05);
    }
  }
  .glass-nav.shrunk {
    padding-top: 6px !important;
    padding-bottom: 6px !important;
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .glass-nav { padding-top: 4px !important; padding-bottom: 4px !important; }
    .glass-nav img { height: 24px !important; }
  }
  @media (max-width: 768px) {
    .glass-nav {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: #1c1c28;
      border: 0.5px solid rgba(255, 255, 255, 0.07);
      box-shadow: none;
    }
    .glass-nav.scrolled {
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
      box-shadow: none !important;
    }
    .glass-nav.scrolled::after {
      opacity: 0 !important;
    }
  }
</style>
