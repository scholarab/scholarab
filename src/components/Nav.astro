---
const { currentPath } = Astro.props;
const navCls = (p) => `hidden md:inline-flex items-center relative transition-colors nav-link ${currentPath === p ? 'text-primary nav-link-active' : 'text-secondary hover:text-primary'}`;
const navClsStart = (p) => `hidden md:inline-flex items-center relative transition-colors nav-link ${currentPath.startsWith(p) ? 'text-primary nav-link-active' : 'text-secondary hover:text-primary'}`;
---

<div id="top-nav-wrapper" class="sticky top-2 z-[500] mb-10" style="padding: 0 16px;">
  <div class="nav-wrapper mx-auto" style="max-width: 900px; position: relative;">
    <nav class="glass-nav flex justify-between items-center px-6 py-3" style="border-radius: 9999px; overflow: visible;">
      <!-- gradient rainbow underline -->
      <div aria-hidden="true" style="position:absolute;bottom:-1px;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,rgba(34,211,165,0.6),rgba(59,130,246,0.5),rgba(167,139,250,0.4),transparent);border-radius:1px;pointer-events:none;"></div>
      <a href="/" onclick="if(window.location.pathname==='/'){event.preventDefault()}" class="hover:opacity-80 transition-opacity flex items-center gap-2" aria-label="ScholarAB home">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 310 56" fill="none" height="36" aria-hidden="true">
          <path d="M10 42 L22 20 L34 42Z" fill="#22d3a5" opacity="0.35"/><path d="M26 42 L42 14 L58 42Z" fill="#22d3a5" opacity="0.6"/>
          <path d="M18 42 L34 6 L50 42Z" fill="#22d3a5"/><path d="M34 6 L39 18 L29 18Z" fill="white" opacity="0.9"/>
          <line x1="6" y1="42" x2="62" y2="42" stroke="#22d3a5" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          <text font-family="Syne, sans-serif" font-weight="800" font-size="28" letter-spacing="-0.8">
            <tspan x="74" y="38" class="logo-scholar">Scholar</tspan><tspan fill="#22d3a5">AB</tspan>
          </text>
        </svg>

      </a>
      <div class="flex items-center gap-5 text-sm font-medium">
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined} class={navCls('/')}>Home</a>
        <a href="/scholarships" aria-current={currentPath.startsWith('/scholarships') ? 'page' : undefined} class={navClsStart('/scholarships')}>Scholarships</a>
        <a href="/programs" aria-current={currentPath.startsWith('/programs') ? 'page' : undefined} class={navClsStart('/programs')}>Programs</a>
        <a href="/saved" aria-current={currentPath === '/saved' ? 'page' : undefined} class={navCls('/saved')}>Saved</a>
        <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined} class={navCls('/about')}>About</a>
        <!-- Social icons — mobile only -->
        <a href="https://www.instagram.com/scholar.ab" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label="ScholarAB on Instagram" class="md:hidden flex items-center text-secondary hover:text-primary transition-colors">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.tiktok.com/@scholar.ab" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label="ScholarAB on TikTok" class="md:hidden flex items-center text-secondary hover:text-primary transition-colors">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
        </a>
        <button id="theme-toggle" aria-label="Toggle theme"
          class="flex items-center justify-center rounded-full transition-colors"
          style="width:34px;height:34px;border:0.5px solid var(--border-medium);background:var(--bg-subtle);color:var(--text-secondary);">
          <svg id="theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <svg id="theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</div>

<script>
  let scrollAbort: AbortController | null = null;

  function syncThemeIcon() {
    const isDark = document.documentElement.classList.contains('theme-dark');
    const moon = document.getElementById('theme-icon-moon');
    const sun  = document.getElementById('theme-icon-sun');
    if (moon) moon.style.display = isDark ? 'block' : 'none';
    if (sun)  sun.style.display  = isDark ? 'none'  : 'block';
  }

  function initNav() {
    const nav = document.querySelector('.glass-nav');
    if (nav) {
      if (scrollAbort) scrollAbort.abort();
      scrollAbort = new AbortController();
      const onScroll = () => {
        nav.classList.toggle('scrolled', window.scrollY > 10);
        nav.classList.toggle('shrunk',   window.scrollY > 60);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true, signal: scrollAbort.signal });
    }

    syncThemeIcon();

    const btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', async () => {
        const { applyTheme, getStoredTheme } = await import('../lib/themeClient.ts');
        const current = getStoredTheme();
        applyTheme(current === 'dark' ? 'light' : 'dark');
        syncThemeIcon();
      });
    }
  }

  document.addEventListener('astro:page-load', initNav);
  document.addEventListener('astro:after-swap', syncThemeIcon);
</script>

<style is:global>
  .logo-scholar { fill: var(--text-primary); }
  .glass-nav a {
    -webkit-tap-highlight-color: transparent;
  }
  /* Active tab teal underline */
  .nav-link { padding-bottom: 2px; }
  .nav-link-active::after {
    content: '';
    position: absolute;
    left: 4px; right: 4px;
    bottom: -14px;
    height: 2px;
    background: var(--brand);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--brand);
  }
  .glass-nav {
    background: var(--nav-glass-bg);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border: 0.5px solid var(--border-card);
    position: relative;
    transition: padding 0.3s ease;
  }
  .glass-nav::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 8px 16px -4px rgba(0,0,0,0.2);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .glass-nav.scrolled::after {
    opacity: 1;
  }
  @media (min-width: 769px) {
    .glass-nav {
      background: var(--nav-bg-desktop);
    }
  }
  .glass-nav.shrunk {
    padding-top: 6px !important;
    padding-bottom: 6px !important;
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .glass-nav { padding-top: 4px !important; padding-bottom: 4px !important; }
    .glass-nav img { height: 24px !important; }
  }
  @media (max-width: 768px) {
    .glass-nav {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: var(--nav-bg-mobile);
      border: 0.5px solid var(--nav-border-mobile);
      box-shadow: none;
    }
    .glass-nav.scrolled {
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
      box-shadow: none !important;
    }
    .glass-nav.scrolled::after {
      opacity: 0 !important;
    }
  }
</style>
