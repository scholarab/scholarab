---
const { currentPath } = Astro.props;
const navCls = (p) => `hidden md:block transition-colors ${currentPath === p ? 'text-gray-900 dark:text-white' : 'text-gray-500 hover:text-gray-700 dark:text-white/50 dark:hover:text-white/90'}`;
const navClsStart = (p) => `hidden md:block transition-colors ${currentPath.startsWith(p) ? 'text-gray-900 dark:text-white' : 'text-gray-500 hover:text-gray-700 dark:text-white/50 dark:hover:text-white/90'}`;
---

<div class="sticky top-2 z-50 mb-10" style="padding: 0 16px;">
  <div class="nav-wrapper mx-auto" style="max-width: 900px; position: relative;">
    <nav class="glass-nav flex justify-between items-center px-6 py-3" style="border-radius: 9999px;">
      <a href="/" onclick="if(window.location.pathname==='/'){event.preventDefault()}" class="hover:opacity-80 transition-opacity flex items-center gap-2" aria-label="ScholarAB home">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 310 56" fill="none" height="36" aria-hidden="true">
          <path d="M10 42 L22 20 L34 42Z" fill="#22d3a5" opacity="0.35"/><path d="M26 42 L42 14 L58 42Z" fill="#22d3a5" opacity="0.6"/>
          <path d="M18 42 L34 6 L50 42Z" fill="#22d3a5"/><path d="M34 6 L39 18 L29 18Z" fill="white" opacity="0.9"/>
          <line x1="6" y1="42" x2="62" y2="42" stroke="#22d3a5" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          <text font-family="Syne, sans-serif" font-weight="800" font-size="28" letter-spacing="-0.8">
            <tspan x="74" y="38" class="logo-scholar">Scholar</tspan><tspan fill="#22d3a5">AB</tspan>
          </text>
        </svg>
        <span class="beta-badge">BETA</span>
      </a>
      <div class="flex items-center gap-5 text-sm font-medium">
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined} class={navCls('/')}>Home</a>
        <a href="/scholarships" aria-current={currentPath.startsWith('/scholarships') ? 'page' : undefined} class={navClsStart('/scholarships')}>Scholarships</a>
        <a href="/programs" aria-current={currentPath.startsWith('/programs') ? 'page' : undefined} class={navClsStart('/programs')}>Programs</a>
        <a href="/saved" aria-current={currentPath === '/saved' ? 'page' : undefined} class={navCls('/saved')}>Saved</a>
        <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined} class={navCls('/about')}>About</a>
        <button id="theme-toggle" aria-label="Toggle color theme" class="w-8 h-8 flex items-center justify-center rounded-lg text-lg leading-none text-gray-500 hover:text-gray-800 hover:bg-black/5 dark:text-white/40 dark:hover:text-white/80 dark:hover:bg-white/5 transition-colors">🌙</button>
      </div>
    </nav>
  </div>
</div>

<script>
  function applyTheme() {
    const theme = localStorage.getItem('theme') ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', theme === 'dark');
    const btn = document.getElementById('theme-toggle');
    if (btn) btn.textContent = theme === 'dark' ? '🌙' : '☀️ ';
  }

  function handleToggle() {
    const isDark = document.documentElement.classList.contains('dark');
    const next = isDark ? 'light' : 'dark';
    const overlay = document.createElement('div');
    overlay.style.cssText = `
      position: fixed; inset: 0; z-index: 99998; pointer-events: none;
      background: ${isDark ? '#f5f5fa' : '#0a0a0f'}; opacity: 0;
    `;
    document.body.appendChild(overlay);
    overlay.animate(
      [{ opacity: 0 }, { opacity: 0.18 }, { opacity: 0 }],
      { duration: 320, easing: 'ease' }
    ).onfinish = () => overlay.remove();
    localStorage.setItem('theme', next);
    document.documentElement.classList.toggle('dark', !isDark);
    const btn = document.getElementById('theme-toggle');
    if (btn) btn.textContent = next === 'dark' ? '🌙' : '☀️ ';
  }

  let scrollAbort: AbortController | null = null;

  function initNav() {
    applyTheme();
    const btn = document.getElementById('theme-toggle');
    if (btn) {
      // Clone to remove any previous listener before re-attaching
      const fresh = btn.cloneNode(true);
      btn.replaceWith(fresh);
      (fresh as HTMLElement).addEventListener('click', handleToggle);
    }
    const nav = document.querySelector('.glass-nav');
    if (nav) {
      if (scrollAbort) scrollAbort.abort();
      scrollAbort = new AbortController();
      let ticking = false;
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            nav.classList.toggle('scrolled', window.scrollY > 10);
            nav.classList.toggle('shrunk',   window.scrollY > 60);
            ticking = false;
          });
          ticking = true;
        }
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true, signal: scrollAbort.signal });
    }
  }

  // Fires on first load AND every ClientRouter navigation
  document.addEventListener('astro:page-load', initNav);
</script>

<style is:global>
  .logo-scholar { fill: #0a0a0f; }
  .dark .logo-scholar { fill: #ffffff; }
  .beta-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #22d3a5;
    background: rgba(34, 211, 165, 0.12);
    border: 0.5px solid rgba(34, 211, 165, 0.35);
    border-radius: 4px;
    padding: 2px 5px;
    line-height: 1;
    align-self: flex-start;
    margin-top: 4px;
  }
  .glass-nav {
    background: rgba(245, 245, 250, 0.8);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(0,0,0,0.08);
    position: relative;
    transition: padding 0.3s ease;
  }
  .glass-nav::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .glass-nav.scrolled::after {
    opacity: 1;
  }
  .dark .glass-nav {
    background: rgba(10, 10, 15, 0.8);
    border: 0.5px solid rgba(255,255,255,0.1);
  }
  .dark .glass-nav::after {
    box-shadow: 0 8px 16px -4px rgba(0,0,0,0.35);
  }
  @media (min-width: 769px) {
    .glass-nav {
      background: rgba(255,255,255,0.8);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      backdrop-filter: blur(20px) saturate(180%);
    }
    .dark .glass-nav {
      background: rgba(255,255,255,0.05);
    }
  }
  .glass-nav.shrunk {
    padding-top: 6px !important;
    padding-bottom: 6px !important;
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .glass-nav { padding-top: 4px !important; padding-bottom: 4px !important; }
    .glass-nav img { height: 24px !important; }
  }
</style>
