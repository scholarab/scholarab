---
import BookmarkButton from './BookmarkButton.tsx';

interface Props {
  badge: { emoji: string; label: string; color: string; bg: string; border: string };
  title: string;
  titleMb?: string;
  subtitle?: string;
  amount?: string;
  amountStyle?: string;
  url: string;
  status: 'active' | 'closed' | 'future';
  openDate?: string;
  backHref: string;
  backLabel: string;
  ctaLabel?: string;
  itemId?: number;
  itemType?: 'scholarship' | 'program';
}

const {
  badge,
  title,
  titleMb = 'mb-2',
  subtitle,
  amount,
  amountStyle = 'clamp(28px, 5vw, 40px)',
  url,
  status,
  openDate,
  backHref,
  backLabel,
  ctaLabel = 'Apply Now →',
  itemId,
  itemType,
} = Astro.props;
---

<main class="py-6">
  <a
    href={backHref}
    class="inline-flex items-center gap-2 text-sm text-gray-500 dark:text-white/40 hover:text-[#22d3a5] dark:hover:text-[#22d3a5] transition-colors mb-6"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    {backLabel}
  </a>


  <div class="card p-6 md:p-8" style={`border-top: 2px solid ${badge.color};`}>
    <span
      class="inline-flex items-center gap-1.5 rounded-full text-xs font-semibold mb-4"
      style={`padding: 3px 10px; background: ${badge.bg}; color: ${badge.color}; border: 1px solid ${badge.border};`}
    >
      <span style="font-size: 15px;">{badge.emoji}</span>
      {badge.label}
    </span>

    <h1 class={`font-bold text-gray-900 dark:text-white ${titleMb} leading-tight`} style="font-size: clamp(20px, 4vw, 30px);">
      {title}
    </h1>

    {subtitle && (
      <p class="text-sm text-gray-400 dark:text-white/35 mb-6">{subtitle}</p>
    )}

    {amount && (
      <p class="font-extrabold mb-6 text-[#22d3a5]" style={`font-size: ${amountStyle}; line-height: 1.1;`}>
        {amount}
      </p>
    )}

    <slot />

    <div class="pt-2 flex gap-2">
      {status === 'closed' ? (
        <button disabled class="flex-1 py-3 rounded-xl text-sm font-semibold cursor-not-allowed bg-gray-100 text-gray-400 dark:bg-white/5 dark:text-white/20">
          Closed
        </button>
      ) : status === 'future' ? (
        <button disabled class="flex-1 py-3 rounded-xl text-sm font-semibold cursor-not-allowed bg-blue-50 text-blue-400 dark:bg-blue-500/[0.08] dark:text-blue-400">
          Opening Soon{openDate ? ` — ${openDate}` : ''}
        </button>
      ) : (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          referrerpolicy="no-referrer"
          onclick="window.va?.('event',{name:'apply_detail'})"
          class="btn-teal flex-1 text-center py-3 px-4 rounded-xl text-sm font-semibold transition-opacity hover:opacity-85"
          style="background: #22d3a5; color: #0a0a0f; display: flex; align-items: center; justify-content: center;"
        >
          {ctaLabel}
        </a>
      )}
      {itemId !== undefined && itemType && (
        <BookmarkButton id={itemId} type={itemType} client:load />
      )}
    </div>

    <div class="flex flex-wrap gap-2 pt-3">
      <button id="copy-link-btn" aria-label="Copy link"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border transition-colors text-gray-500 dark:text-white/40 border-gray-200 dark:border-white/10 hover:border-[#22d3a5] hover:text-[#22d3a5] dark:hover:border-[#22d3a5] dark:hover:text-[#22d3a5]">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span id="copy-link-text">Copy link</span>
      </button>
    </div>
    <script>
      const btn = document.getElementById('copy-link-btn');
      const txt = document.getElementById('copy-link-text');
      btn?.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          if (txt) { txt.textContent = 'Copied!'; (txt as HTMLElement).style.color = '#22d3a5'; }
          setTimeout(() => { if (txt) { txt.textContent = 'Copy link'; (txt as HTMLElement).style.color = ''; } }, 2500);
        });
      });
    </script>
  </div>
</main>
