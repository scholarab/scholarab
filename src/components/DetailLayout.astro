---
import BookmarkButton from './BookmarkButton.jsx';
import ShareButtons from './ShareButtons.jsx';

interface Props {
  badge: { emoji: string; label: string; color: string; bg: string; border: string };
  title: string;
  titleMb?: string;
  subtitle?: string;
  amount?: string;
  amountStyle?: string;
  url: string;
  status: 'active' | 'closed' | 'future';
  openDate?: string;
  backHref: string;
  backLabel: string;
  ctaLabel?: string;
  itemId?: number;
  itemType?: 'scholarship' | 'program';
  pageUrl?: string;
}

const {
  badge,
  title,
  titleMb = 'mb-2',
  subtitle,
  amount,
  amountStyle = 'clamp(28px, 5vw, 40px)',
  url,
  status,
  openDate,
  backHref,
  backLabel,
  ctaLabel = 'Apply Now →',
  itemId,
  itemType,
  pageUrl,
} = Astro.props;
---

<main class="py-6">
  <a
    id="detail-back-link"
    href={backHref}
    class="inline-flex items-center gap-2 text-sm text-gray-500 dark:text-white/40 hover:text-[#22d3a5] dark:hover:text-[#22d3a5] transition-colors mb-6"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span id="detail-back-label">{backLabel}</span>
  </a>

  <script>
    const link = document.getElementById('detail-back-link') as HTMLAnchorElement | null;
    const label = document.getElementById('detail-back-label');
    if (link && label && new URLSearchParams(location.search).get('from') === 'match') {
      label.textContent = 'Back to results';
      link.href = '/match';
      link.addEventListener('click', (e) => {
        e.preventDefault();
        history.back();
      });
    }
  </script>

  <div class="card p-6 md:p-8" style={`border-top: 2px solid ${badge.color};`}>
    <span
      class="inline-flex items-center gap-1.5 rounded-full text-xs font-semibold mb-4"
      style={`padding: 3px 10px; background: ${badge.bg}; color: ${badge.color}; border: 1px solid ${badge.border};`}
    >
      <span style="font-size: 15px;">{badge.emoji}</span>
      {badge.label}
    </span>

    <h1 class={`font-bold text-gray-900 dark:text-white ${titleMb} leading-tight`} style="font-size: clamp(20px, 4vw, 30px);">
      {title}
    </h1>

    {subtitle && (
      <p class="text-sm text-gray-400 dark:text-white/35 mb-6">{subtitle}</p>
    )}

    {amount && (
      <p class="font-extrabold mb-6 text-[#22d3a5]" style={`font-size: ${amountStyle}; line-height: 1.1;`}>
        {amount}
      </p>
    )}

    <slot />

    <div class="pt-2 flex gap-2">
      {status === 'closed' ? (
        <button disabled class="flex-1 py-3 rounded-xl text-sm font-semibold cursor-not-allowed bg-gray-100 text-gray-400 dark:bg-white/5 dark:text-white/20">
          Closed
        </button>
      ) : status === 'future' ? (
        <button disabled class="flex-1 py-3 rounded-xl text-sm font-semibold cursor-not-allowed bg-blue-50 text-blue-400 dark:bg-blue-500/[0.08] dark:text-blue-400">
          Opening Soon{openDate ? ` — ${openDate}` : ''}
        </button>
      ) : (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          referrerpolicy="no-referrer"
          onclick="window.va?.('event',{name:'apply_detail'})"
          class="btn-teal flex-1 text-center py-3 px-4 rounded-xl text-sm font-semibold transition-opacity hover:opacity-85"
          style="background: #22d3a5; color: #0a0a0f; display: flex; align-items: center; justify-content: center;"
        >
          {ctaLabel}
        </a>
      )}
      {itemId !== undefined && itemType && (
        <BookmarkButton id={itemId} type={itemType} client:load />
      )}
    </div>

    <ShareButtons title={title} pageUrl={pageUrl} client:load />
  </div>
</main>
