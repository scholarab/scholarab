---
---

<nav id="bottom-nav" class="bottom-nav-bar md:hidden fixed bottom-0 left-0 right-0" style="z-index: 9999;">
  <div class="flex h-16 relative">

    <!-- Home -->
    <a href="/" id="bn-home" class="bn-tab flex-1 flex flex-col items-center justify-center gap-[3px]" style="z-index:1;" aria-label="Home">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/>
        <path d="M9 21V12h6v9"/>
      </svg>
      <span class="text-[10px] font-medium leading-none">Home</span>
    </a>

    <!-- Scholarships -->
    <a href="/scholarships" id="bn-scholarships" class="bn-tab flex-1 flex flex-col items-center justify-center gap-[3px]" style="z-index:1;" aria-label="Scholarships">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
        <path d="M6 12v5c3.33 2 8.67 2 12 0v-5"/>
      </svg>
      <span class="text-[10px] font-medium leading-none">Scholarships</span>
    </a>

    <!-- Programs -->
    <a href="/programs" id="bn-programs" class="bn-tab flex-1 flex flex-col items-center justify-center gap-[3px]" style="z-index:1;" aria-label="Programs">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 3h6M9 3v7l-4 8a1 1 0 0 0 .9 1.5h12.2a1 1 0 0 0 .9-1.5l-4-8V3"/>
        <line x1="6.5" y1="14" x2="17.5" y2="14"/>
      </svg>
      <span class="text-[10px] font-medium leading-none">Programs</span>
    </a>

    <!-- Saved -->
    <a href="/saved" id="bn-saved" class="bn-tab flex-1 flex flex-col items-center justify-center gap-[3px]" style="z-index:1;" aria-label="Saved">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="text-[10px] font-medium leading-none">Saved</span>
    </a>

    <!-- About -->
    <a href="/about" id="bn-about" class="bn-tab flex-1 flex flex-col items-center justify-center gap-[3px]" style="z-index:1;" aria-label="About">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="16" x2="12" y2="12"/>
        <line x1="12" y1="8" x2="12.01" y2="8"/>
      </svg>
      <span class="text-[10px] font-medium leading-none">About</span>
    </a>

  </div>
</nav>

<script lang="ts">
  const TEAL = '#22d3a5';
  const IDS = ['bn-home', 'bn-scholarships', 'bn-programs', 'bn-saved', 'bn-about'];

  function setActive(tabId: string) {
    IDS.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        const isActive = id === `bn-${tabId}`;
        el.style.color = isActive ? TEAL : '';
        el.setAttribute('aria-current', isActive ? 'page' : 'false');
      }
    });
  }

  function resolveActive() {
    const path = window.location.pathname;
    if (path.startsWith('/about'))        return setActive('about');
    if (path.startsWith('/programs'))     return setActive('programs');
    if (path.startsWith('/saved'))        return setActive('saved');
    if (path.startsWith('/scholarships')) return setActive('scholarships');
    setActive('home');
  }

  document.addEventListener('astro:page-load', resolveActive);
</script>

<style is:global>
  .bottom-nav-bar {
    background: #f5f5fa;
    border-top: 0.5px solid rgba(0, 0, 0, 0.08);
    pointer-events: auto;
    will-change: transform;
  }
  .dark .bottom-nav-bar {
    background: #0a0a0f;
    border-top: 0.5px solid rgba(255, 255, 255, 0.08);
  }
  .bn-tab {
    color: rgba(100, 100, 100, 0.55);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto;
    touch-action: manipulation;
    text-decoration: none;
  }
  .dark .bn-tab {
    color: rgba(255, 255, 255, 0.3);
  }
  .bn-tab:active {
    transform: scale(0.85);
    transition: transform 0.1s ease, color 0.2s ease;
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .bottom-nav-bar { padding-top: 4px !important; padding-bottom: 4px !important; }
    .bottom-nav-bar span { display: none !important; }
    .bottom-nav-bar a { padding: 4px !important; }
    .bn-tab { pointer-events: auto !important; touch-action: manipulation !important; }
  }
</style>
