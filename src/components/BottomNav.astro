---
interface Props { currentPath?: string; }
const { currentPath = '' } = Astro.props;
const activeTab = currentPath.startsWith('/saved') ? 'saved'
  : currentPath.startsWith('/scholarships') ? 'scholarships'
  : currentPath.startsWith('/programs') ? 'programs'
  : currentPath.startsWith('/about') ? 'about'
  : 'home';
---

<nav id="bottom-nav" aria-label="Mobile navigation" class="bottom-nav-bar md:hidden fixed" style="z-index: 9999; bottom: 24px; left: 50%; transform: translateX(-50%); width: max-content;">
  <div class="flex relative" style="padding: 6px; gap: 2px;">

    <!-- Home -->
    <a href="/" id="bn-home" class="bn-tab flex flex-col items-center justify-center gap-[3px]" style="z-index:1;padding:8px 12px 10px;border-radius:22px;position:relative;" aria-label="Home" aria-current={activeTab === 'home' ? 'page' : 'false'}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/>
        <path d="M9 21V12h6v9"/>
      </svg>
      <span class="text-[10px] font-semibold leading-none">Home</span>
      <span class="bn-dot" aria-hidden="true"></span>
    </a>

    <!-- Browse (Scholarships) -->
    <a href="/scholarships" id="bn-scholarships" class="bn-tab flex flex-col items-center justify-center gap-[3px]" style="z-index:1;padding:8px 12px 10px;border-radius:22px;position:relative;" aria-label="Browse scholarships" aria-current={activeTab === 'scholarships' ? 'page' : 'false'}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"/>
        <path d="M3 9h18"/>
        <path d="M9 21V9"/>
      </svg>
      <span class="text-[10px] font-semibold leading-none">Browse</span>
      <span class="bn-dot" aria-hidden="true"></span>
    </a>

    <!-- Programs -->
    <a href="/programs" id="bn-programs" class="bn-tab flex flex-col items-center justify-center gap-[3px]" style="z-index:1;padding:8px 12px 10px;border-radius:22px;position:relative;" aria-label="Research programs" aria-current={activeTab === 'programs' ? 'page' : 'false'}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
      </svg>
      <span class="text-[10px] font-semibold leading-none">Programs</span>
      <span class="bn-dot" aria-hidden="true"></span>
    </a>

    <!-- Saved -->
    <a href="/saved" id="bn-saved" class="bn-tab flex flex-col items-center justify-center gap-[3px]" style="z-index:1;padding:8px 12px 10px;border-radius:22px;position:relative;" aria-label="Saved" aria-current={activeTab === 'saved' ? 'page' : 'false'}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="text-[10px] font-semibold leading-none">Saved</span>
      <span class="bn-dot" aria-hidden="true"></span>
    </a>

    <!-- About -->
    <a href="/about" id="bn-about" class="bn-tab flex flex-col items-center justify-center gap-[3px]" style="z-index:1;padding:8px 12px 10px;border-radius:22px;position:relative;" aria-label="About" aria-current={activeTab === 'about' ? 'page' : 'false'}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
      </svg>
      <span class="text-[10px] font-semibold leading-none">About</span>
      <span class="bn-dot" aria-hidden="true"></span>
    </a>

  </div>
</nav>

<script lang="ts">
  const IDS = ['bn-home', 'bn-scholarships', 'bn-programs', 'bn-saved', 'bn-about'];

  function getBrandColor(): string {
    return getComputedStyle(document.documentElement).getPropertyValue('--brand').trim() || '#22d3a5';
  }

  function setActive(tabId: string) {
    const brand = getBrandColor();
    IDS.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        const isActive = id === `bn-${tabId}`;
        el.style.color = isActive ? brand : '';
        el.setAttribute('aria-current', isActive ? 'page' : 'false');
        const dot = el.querySelector('.bn-dot') as HTMLElement | null;
        if (dot) {
          dot.style.opacity = isActive ? '1' : '0';
          dot.style.background = brand;
          dot.style.boxShadow = isActive ? `0 0 6px ${brand}` : 'none';
        }
      }
    });
  }

  function resolveActive() {
    const path = window.location.pathname;
    if (path.startsWith('/saved'))        return setActive('saved');
    if (path.startsWith('/scholarships')) return setActive('scholarships');
    if (path.startsWith('/programs'))     return setActive('programs');
    if (path.startsWith('/about'))        return setActive('about');
    setActive('home');
  }

  document.addEventListener('astro:page-load', resolveActive);
</script>

<style is:global>
  .bottom-nav-bar {
    background: var(--nav-glass-bg);
    border: 1px solid var(--bottom-nav-border);
    border-radius: 28px;
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    box-shadow: 0 12px 40px rgba(0,0,0,0.45), 0 1px 0 rgba(255,255,255,0.08) inset;
    pointer-events: auto;
    will-change: transform;
  }
  html.theme-light .bottom-nav-bar {
    box-shadow: 0 12px 32px rgba(10,10,15,0.15), 0 1px 0 rgba(255,255,255,0.9) inset;
  }
  .bn-tab {
    color: var(--bn-tab-color);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto;
    touch-action: manipulation;
    text-decoration: none;
  }
  .bn-tab:active {
    transform: scale(0.85);
    transition: transform 0.1s ease, color 0.2s ease;
  }
  .bn-dot {
    position: absolute;
    bottom: 3px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .bottom-nav-bar { padding-top: 4px !important; padding-bottom: 4px !important; }
    .bottom-nav-bar span { display: none !important; }
    .bottom-nav-bar a { padding: 4px !important; }
    .bn-tab { pointer-events: auto !important; touch-action: manipulation !important; }
  }
</style>
