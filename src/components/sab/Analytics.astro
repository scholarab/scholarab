---
/**
 * Google Analytics 4, behind an explicit consent gate.
 *
 * The measurement ID is committed (GA_MEASUREMENT_ID) because a Cloudflare
 * Pages secret is not exposed to the build, and Astro inlines import.meta.env
 * at build time; PUBLIC_GA_ID still overrides it when set. Which hostnames may
 * report is enforced by GA_HOSTS in lib/consent.ts.
 *
 * The tag is never on the page before a grant. Consent Mode is configured
 * `denied` first regardless, because gtag queues commands and the order the
 * queue is drained in is what decides whether the first hit is cookieless.
 */
import { GA_MEASUREMENT_ID } from '../../lib/constants';
const gaId = import.meta.env.PUBLIC_GA_ID ?? GA_MEASUREMENT_ID;
---

{gaId && (
  <>
    <script is:inline define:vars={{ gaId }}>
      // Queue + defaults only. No network request happens here: gtag.js is
      // injected by the module below, and only after a grant.
      window.dataLayer = window.dataLayer || [];
      // `arguments`, not rest parameters, and not by accident: gtag.js reads
      // the pushed value as an Arguments object, and an Array pushed in its
      // place is silently ignored. This is Google's own snippet verbatim.
      // eslint-disable-next-line prefer-rest-params
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      window.__sabGaId = gaId;
    </script>

    <div
      id="sab-consent"
      class="sab-consent"
      role="dialog"
      aria-modal="false"
      aria-labelledby="sab-consent-title"
      hidden
    >
      <div class="sab-consent-inner">
        <div class="sab-consent-copy">
          <p id="sab-consent-title" class="sab-consent-title">Can we count this visit with Google Analytics?</p>
          <p class="sab-consent-body">
            It sets a cookie and gives your browser an ID, which is how we tell a returning
            visitor from a new one. Saying no changes nothing about the site.
            <a href="/privacy/">What we collect</a>
          </p>
        </div>
        <div class="sab-consent-actions">
          <button type="button" data-consent="denied" class="sab-consent-btn sab-consent-no">No thanks</button>
          <button type="button" data-consent="granted" class="sab-consent-btn sab-consent-yes">Allow</button>
        </div>
      </div>
    </div>

    <script>
      import { readConsent, setConsent, analyticsAllowedHere, syncConsentReset } from '../../lib/consent.ts';

      const gaWindow = window as unknown as {
        __sabGaId?: string;
        gtag?: (...args: unknown[]) => void;
        [key: string]: unknown;
      };
      let loaded = false;

      // One consent transition and one page-view path for both the banner and
      // ClientRouter. Denial also disables a tag loaded on an earlier page.
      function applyChoice(choice: 'granted' | 'denied' | null) {
        if (!analyticsAllowedHere(location.hostname, navigator.webdriver, import.meta.env.MODE))
          choice = 'denied';
        const banner = document.getElementById('sab-consent');
        if (banner) banner.hidden = choice !== null;
        const id = gaWindow.__sabGaId;
        if (!id || !gaWindow.gtag) return;
        gaWindow[`ga-disable-${id}`] = choice !== 'granted';
        if (choice !== 'granted') {
          if (loaded) gaWindow.gtag('consent', 'update', { analytics_storage: 'denied' });
          return;
        }
        gaWindow.gtag('consent', 'update', { analytics_storage: 'granted' });
        if (!loaded) {
          loaded = true;
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
          document.head.appendChild(script);
          gaWindow.gtag('js', new Date());
          gaWindow.gtag('config', id, { send_page_view: false, anonymize_ip: true });
        }
        gaWindow.gtag('event', 'page_view', {
          page_location: location.href,
          page_path: location.pathname + location.search,
          page_title: document.title,
        });
      }

      document.addEventListener('click', e => {
        const btn = (e.target as HTMLElement | null)?.closest?.('[data-consent]');
        if (!btn) return;
        const choice = setConsent(btn.getAttribute('data-consent') === 'granted' ? 'granted' : 'denied');
        // The browser-wide opt-out outranks even a new grant. A grant with
        // blocked storage still applies to this page, as it did previously.
        applyChoice(readConsent() === 'denied' ? 'denied' : choice);
      });

      // Astro emits this on first load as well as navigation; calling it here
      // too used to count a returning visitor's first page three times.
      document.addEventListener('astro:page-load', () => {
        syncConsentReset(location.search);
        applyChoice(readConsent());
      });
    </script>
  </>
)}
