---
/** Circular ScholarAB mark ("rim break" design): peak + cap inside an open ring, gold sun on the gap. */
interface Props {
  size?: number;
  /** Unique per page instance; clipPath ids collide when the mark renders twice on one page. */
  id?: string;
}
const { size = 30, id = 'a' } = Astro.props;
const clipId = `sab-mark-clip-${id}`;
---
<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <defs><clipPath id={clipId}><circle cx="50" cy="50" r="38.5"></circle></clipPath></defs>
  <circle cx="50" cy="50" r="38.5" fill="#10231B"></circle>
  <g clip-path={`url(#${clipId})`}>
    <polygon points="6,92 28,60 41,72 37,92" fill="#0E8C64"></polygon>
    <polygon points="53,92 68,58 96,92" fill="#0E8C64"></polygon>
    <polygon points="14,92 46,37 78,92" fill="#2FD3A0"></polygon>
    <polygon points="30,44 46,34 62,44 46,54" fill="#141915" stroke="#F2F0E9" stroke-width="2.3" stroke-linejoin="round"></polygon>
    <path d="M 62 44 Q 66 50 64.8 58" fill="none" stroke="#FFC94A" stroke-width="2.1" stroke-linecap="round"></path>
    <circle cx="64.6" cy="61" r="2.9" fill="#FFC94A"></circle>
  </g>
  <path d="M 85.32 31.22 A 40 40 0 1 1 68.78 14.68" fill="none" stroke="#2FD3A0" stroke-width="2.5" stroke-linecap="round"></path>
  <circle cx="78.28" cy="21.72" r="8.5" fill="#FFC94A"></circle>
</svg>
