---
// Shared shell for /guides pages: title, prose, the hub's open listings,
// keep-reading links, JSON-LD. Guide pages put their prose in the default slot and
// optional extra JSON-LD (e.g. FAQPage) in the "ld" slot.
import Layout from '../../layouts/Layout.astro';
import SabHeader from './SabHeader.astro';
import SabFooter from './SabFooter.astro';
import SabFonts from './SabFonts.astro';
import { guides, type GuideMeta } from '../../lib/guides';
// The guide CTA hardcoded "TWO MINUTES" long after lib/quiz.ts settled on 30
// seconds as the honest number; the guides were the last surface still
// quoting the rejected one. Read it from the constant like everywhere else.
import { QUIZ_DURATION } from '../../lib/quiz';
import { brandedTitle } from '../../lib/meta';
import { SCHOLARSHIP_FACETS, PROGRAM_FACETS, facetItems } from '../../lib/facets';
import { loadScholarships, loadPrograms } from '../../lib/data-loader';
import { scholarshipStatusOf, programStatusOf } from '../../lib/status';
import { generateSlug, formatDeadline } from '../../lib/utils';
import { todayDate } from '../../lib/calendar';

interface Props {
  guide: GuideMeta;
}

const { guide } = Astro.props;
const canonical = `https://www.scholarab.ca/guides/${guide.slug}/`;

// The hub this guide explains, declared on the facet rather than here so the
// pairing is defined once and points both ways: the hub links to the guide,
// the guide links to the listings. Guides about a process rather than a pool
// (essays, reference letters, the Grade 12 timeline) have no single hub, and
// null is the right answer for them.
const hubFacet =
  SCHOLARSHIP_FACETS.find(f => f.guide === guide.slug) ??
  PROGRAM_FACETS.find(f => f.guide === guide.slug);
const hubHref = hubFacet
  ? `/${SCHOLARSHIP_FACETS.includes(hubFacet) ? 'scholarships' : 'programs'}/${hubFacet.slug}/`
  : null;
// The hub's open listings beside the prose, soonest first (critique
// 2026-09-23: a city guide cited 19 listings and showed none of them as data,
// with half the desktop page empty). Same status ladder as the directory.
const today = todayDate();
type LocalRow = { href: string; name: string; amount: string; due: string };
let localRows: LocalRow[] = [];
let localTotal = 0;
if (hubFacet && SCHOLARSHIP_FACETS.includes(hubFacet)) {
  const open = facetItems(hubFacet, await loadScholarships())
    .filter(x => x.deadline && scholarshipStatusOf(x, today) === 'active')
    .sort((a, b) => a.deadline!.localeCompare(b.deadline!));
  localTotal = open.length;
  localRows = open.slice(0, 8).map(x => ({
    href: `/scholarships/${generateSlug(x.title)}/`, name: x.title, amount: x.amount,
    due: formatDeadline(x.deadline) ?? '',
  }));
} else if (hubFacet) {
  const open = facetItems(hubFacet, await loadPrograms())
    .filter(x => programStatusOf(x, today) === 'active')
    .sort((a, b) => (a.deadline ?? '').localeCompare(b.deadline ?? ''));
  localTotal = open.length;
  localRows = open.slice(0, 8).map(x => ({
    href: `/programs/${generateSlug(x.name)}/`, name: x.name, amount: x.duration || '',
    due: formatDeadline(x.deadline) ?? '',
  }));
}

// Same rule as the listing pages: the brand goes on only when it does not
// push the guide's own title out of what Google renders.
const pageTitle = brandedTitle(guide.title);

const articleJson = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': guide.title,
  'description': guide.description,
  'url': canonical,
  'mainEntityOfPage': canonical,
  'datePublished': guide.datePublished,
  'dateModified': guide.dateModified,
  'author': { '@type': 'Person', 'name': 'Ilia Ivanov', 'url': 'https://www.scholarab.ca/about/' },
  'publisher': { '@type': 'Organization', 'name': 'ScholarAB', 'url': 'https://www.scholarab.ca' },
};

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Guides', 'item': 'https://www.scholarab.ca/guides/' },
    { '@type': 'ListItem', 'position': 3, 'name': guide.title, 'item': canonical },
  ],
};

// Rotate the keep-reading window by the current guide's position rather than
// taking the first three every time. `.slice(0, 3)` linked guides 1-3 from all
// eight pages and never linked guides 4-8 from anywhere, so the later half of
// the section had a single inbound link each (the /guides/ index) and sat in
// Search Console's "Discovered - currently not indexed". Rotating spreads the
// links evenly, giving every guide three inbound links from its siblings.
const others = guides.filter(g => g.slug !== guide.slug);
const start = guides.findIndex(g => g.slug === guide.slug) % (others.length || 1);
const keepReading = [...others.slice(start), ...others.slice(0, start)].slice(0, 3);
---

<Layout
  title={pageTitle}
  description={guide.description}
  ogTitle={pageTitle}
  ogDescription={guide.description}
  ogUrl={canonical}
  canonical={canonical}
  ogType="article"
>
  <SabFonts slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJson)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <slot name="ld" slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/guides" />
  </div>

  <div class="sabp" id="sab-guide" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabg-hero">
      <a href="/guides/" class="sabg-crumb">← All guides</a>
      <h1 class="sabg-h1">{guide.title}</h1>
    </div>

    <div class:list={['sabg-body', { 'has-aside': localRows.length > 0 }]} style="flex:1;">
      <article class="sabg-prose">
        <slot />
      </article>

      {localRows.length > 0 && hubFacet && hubHref && (
        <aside class="sabg-local" aria-labelledby="sabg-local-h">
          <h2 id="sabg-local-h" class="sabg-local-h">Open now: {hubFacet.label}</h2>
          <ul class="sabg-local-list">
            {localRows.map(r => (
              <li>
                <a href={r.href} class="sabg-local-row">
                  <span class="sabg-local-name">{r.name}</span>
                  <span class="sabg-local-meta tnum">{r.amount && <span class="sabg-local-amt">{r.amount}</span>}{r.due && <span>due {r.due}</span>}</span>
                </a>
              </li>
            ))}
          </ul>
          <a href={hubHref} class="sabg-local-all">{localTotal > localRows.length ? `See all ${localTotal} open →` : 'See the full list →'}</a>
        </aside>
      )}

      {/* The guide ends in its own voice, not on a dark CTA band (critique
          2026-09-23): where to look next, as plain lines on the note card. */}
      <div class="sabg-hublink">
        {hubFacet && hubHref && (
          <p>Ready to look? <a href={hubHref}>Browse every {hubFacet.label} listing →</a></p>
        )}
        <p>Not sure which ones fit you? <a href="/match/">Take the match quiz</a> ({QUIZ_DURATION}, no account) and get a shortlist worth checking.</p>
      </div>

      <nav class="sabg-more" aria-labelledby="sabg-more-h">
        <h2 id="sabg-more-h" class="sabg-more-title">Keep reading</h2>
        <ul class="sabg-more-list">
          {keepReading.map(g => (
            <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>
          ))}
        </ul>
      </nav>
    </div>

  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  body:has(#sab-guide) { background: var(--bg-page); }

  /* White title area like every other page, not a dark band with a kicker
     and a read time (critique 2026-09-23). */
  .sabg-hero { padding: 64px var(--sab-gutter) 0; width: 100%; box-sizing: border-box; }
  .sabg-crumb { display: inline-block; font-size: 15px; font-weight: 600; color: #0A6B4D; text-decoration: none; margin-bottom: 18px; }
  .sabg-crumb:hover { color: #141915; }
  .sabg-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(38px, 5.5vw, 62px); line-height: 1.05; letter-spacing: -0.015em;
    margin: 0; text-wrap: balance; max-width: 22ch;
  }

  /* ── Prose body ── */
  .sabg-body { padding: 40px var(--sab-gutter) 96px; width: 100%; box-sizing: border-box; }
  /* Prose on the left, the hub's open listings in the column the prose's
     measure leaves empty. Everything after the prose stays in column one. */
  @media (min-width: 1100px) {
    .sabg-body.has-aside {
      display: grid; grid-template-columns: minmax(0, var(--sab-read)) minmax(300px, 420px);
      column-gap: clamp(40px, 6vw, 96px); align-items: start;
    }
    .sabg-body.has-aside > :not(.sabg-local) { grid-column: 1; }
    .sabg-local { grid-column: 2; grid-row: 1 / span 3; position: sticky; top: calc(var(--sab-nav-h) + 24px); }
  }
  .sabg-local { margin-top: 32px; }
  @media (min-width: 1100px) { .sabg-local { margin-top: 0; } }
  .sabg-local-h { font-family: var(--font-display); font-weight: 400; font-size: 26px; line-height: 1.15; margin: 0 0 10px; }
  .sabg-local-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid #141915; }
  .sabg-local-row { display: flex; flex-direction: column; gap: 2px; padding: 11px 4px; border-bottom: 1px solid rgba(20,25,21,0.14); text-decoration: none; color: #141915; }
  .sabg-local-row:hover { background: rgba(20,25,21,0.04); }
  .sabg-local-row:hover .sabg-local-name { color: var(--green); }
  .sabg-local-name { font-weight: 700; font-size: 15px; line-height: 1.35; }
  .sabg-local-meta { display: flex; gap: 10px; font-size: 13.5px; color: rgba(20, 25, 21, 0.75); }
  .sabg-local-amt { color: #0A6B4D; font-weight: 700; }
  .sabg-local-all { display: inline-block; margin-top: 12px; font-size: 15px; font-weight: 600; color: #0A6B4D; text-decoration: none; }
  .sabg-local-all:hover { color: #141915; }
  /* The page runs full width; the prose alone keeps a readable line. */
  .sabg-prose { font-size: 17px; line-height: 1.7; color: rgba(20, 25, 21, 0.85); max-width: var(--sab-read); }
  .sabg-prose h2 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(28px, 3.4vw, 38px); line-height: 1.15; letter-spacing: -0.01em;
    margin: 44px 0 14px; color: #141915;
  }
  .sabg-prose h3 { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; margin: 30px 0 10px; color: #141915; }
  .sabg-prose p { margin: 0 0 18px; }
  .sabg-prose ul, .sabg-prose ol { margin: 0 0 18px; padding-left: 24px; }
  .sabg-prose li { margin-bottom: 8px; }
  .sabg-prose a { color: #0A6B4D; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .sabg-prose a:hover { color: #141915; }
  .sabg-prose strong { color: #141915; }
  .sabg-prose table { width: 100%; border-collapse: collapse; margin: 0 0 18px; font-size: 15.5px; }
  .sabg-prose th { font-family: var(--font-label); font-weight: 500; font-size: 12px; letter-spacing: 0.05em; text-align: left; color: rgba(20, 25, 21, 0.68); padding: 10px 14px; border-bottom: 2px solid #141915; }
  .sabg-prose td { padding: 12px 14px; border-bottom: 1px solid rgba(20,25,21,0.14); }
  .sabg-prose td:last-child, .sabg-prose th:last-child { text-align: right; }
  /* At 320px the three columns with 14px sides ran 8px past the screen. */
  @media (max-width: 420px) {
    .sabg-prose th, .sabg-prose td { padding-left: 6px; padding-right: 6px; }
    .sabg-prose th:first-child, .sabg-prose td:first-child { padding-left: 0; }
    .sabg-prose th:last-child, .sabg-prose td:last-child { padding-right: 0; }
  }
  .sabg-note {
    background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 14px;
    padding: 18px 22px; margin: 0 0 18px; font-size: 15.5px;
  }
  /* Quoted specimen prose -- a sample essay paragraph the surrounding text is
     analysing. Set apart from the guide's own voice, and deliberately not the
     .sabg-note treatment: a note is the author talking louder, this is
     somebody else's words being examined. */
  .sabg-prose blockquote {
    margin: 0 0 18px; padding: 4px 0 4px 22px;
    border-left: 3px solid rgba(20,25,21,0.25);
    font-size: 16.5px; color: rgba(20, 25, 21, 0.72);
  }
  .sabg-prose blockquote p:last-child { margin-bottom: 0; }

  /* Was a 3px mint left stripe over a mint wash. That treatment is the one
     genuinely template-looking thing left on a guide page, and the guides
     already own a better one: .sabg-note, a white card on a hard border. Same
     card here, so a hub link and a note read as the same site. */
  .sabg-hublink {
    margin: 32px 0 0; font-size: 16px;
    background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 14px;
    padding: 18px 22px;
  }
  .sabg-hublink p { margin: 0; line-height: 1.55; }
  .sabg-hublink p + p { margin-top: 8px; }
  .sabg-hublink a { color: #0A6B4D; font-weight: 600; }

  /* ── Keep reading ── */
  .sabg-more { margin-top: 48px; max-width: var(--sab-read); }
  .sabg-more-title { font-size: 17px; font-weight: 700; margin: 0 0 8px; }
  .sabg-more-list { margin: 0; padding-left: 1.2em; font-size: 16px; line-height: 1.6; }
  .sabg-more-list li + li { margin-top: 6px; }
  .sabg-more-list a { color: #0A6B4D; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(10,107,77,0.35); }
  .sabg-more-list a:hover { text-decoration-color: currentColor; }

  @media (max-width: 900px) {
    .sabg-hero { padding: 36px 20px 0; }
    .sabg-body { padding: 28px 20px 72px; }
  }
</style>
