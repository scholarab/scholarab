---
// Shared shell for /guides pages: dark hero, light prose body, keep-reading
// links, CTA, JSON-LD. Guide pages put their prose in the default slot and
// optional extra JSON-LD (e.g. FAQPage) in the "ld" slot.
import Layout from '../../layouts/Layout.astro';
import SabHeader from './SabHeader.astro';
import SabFooter from './SabFooter.astro';
import SabFonts from './SabFonts.astro';
import { guides, type GuideMeta } from '../../lib/guides';

interface Props {
  guide: GuideMeta;
}

const { guide } = Astro.props;
const canonical = `https://www.scholarab.ca/guides/${guide.slug}/`;
const pageTitle = `${guide.title} | ScholarAB`;

const articleJson = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': guide.title,
  'description': guide.description,
  'url': canonical,
  'mainEntityOfPage': canonical,
  'datePublished': guide.datePublished,
  'dateModified': guide.dateModified,
  'author': { '@type': 'Person', 'name': 'Ilia Ivanov', 'url': 'https://www.scholarab.ca/about/' },
  'publisher': { '@type': 'Organization', 'name': 'ScholarAB', 'url': 'https://www.scholarab.ca' },
};

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Guides', 'item': 'https://www.scholarab.ca/guides/' },
    { '@type': 'ListItem', 'position': 3, 'name': guide.title, 'item': canonical },
  ],
};

const keepReading = guides.filter(g => g.slug !== guide.slug).slice(0, 3);
---

<Layout
  title={pageTitle}
  description={guide.description}
  ogTitle={pageTitle}
  ogDescription={guide.description}
  ogUrl={canonical}
  canonical={canonical}
  currentPath="/guides"
  hideChrome
>
  <SabFonts italic slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJson)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <slot name="ld" slot="head" />

  <div class="sabp" id="sab-guide" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabp-header">
      <SabHeader currentPath="/guides" />
      <div class="sabg-hero">
        <div class="sabg-kicker sabg-mono">
          <a href="/guides" class="sabg-kicker-link">GUIDES</a>
          <span class="sabg-kicker-sep">/</span>
          <span>{guide.kicker}</span>
        </div>
        <h1 class="sabg-h1">{guide.title}</h1>
        <div class="sabg-meta sabg-mono">
          <span>{guide.minutes} MIN READ</span>
        </div>
      </div>
    </div>

    <div class="sabg-body" style="flex:1;">
      <article class="sabg-prose">
        <slot />
      </article>

      <div class="sabg-cta">
        <div class="sabg-mono sabg-cta-kicker">TWO MINUTES, NO ACCOUNT</div>
        <div class="sabg-cta-title">See every scholarship you qualify for.</div>
        <a href="/match" class="sabg-cta-btn">Find my match <span style="font-size:18px;">→</span></a>
      </div>

      <div class="sabg-more">
        <div class="sabg-mono sabg-more-title">KEEP READING</div>
        <div class="sabg-more-grid">
          {keepReading.map(g => (
            <a href={`/guides/${g.slug}/`} class="sabg-more-card">
              <span class="sabg-mono sabg-more-tag">{g.kicker}</span>
              <span class="sabg-more-name">{g.title}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <SabFooter />
  </div>
</Layout>

<style is:global>
  body:has(#sab-guide) { background: #FAF7F0; }

  .sabg-mono { font-family: 'IBM Plex Mono', monospace; }

  /* ── Dark hero ── */
  .sabg-hero { max-width: 780px; margin: 0 auto; padding: 64px 24px 72px; width: 100%; box-sizing: border-box; }
  .sabg-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; font-size: 13px; letter-spacing: 0.06em; color: #2FD3A0; }
  .sabg-kicker-link { color: rgba(242,240,233,0.55); text-decoration: none; }
  .sabg-kicker-link:hover { color: #F2F0E9; }
  .sabg-kicker-sep { color: rgba(242,240,233,0.3); }
  .sabg-h1 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(38px, 5.5vw, 62px); line-height: 1.05; letter-spacing: -0.015em;
    margin: 0; text-wrap: balance;
  }
  .sabg-meta { display: flex; align-items: center; gap: 12px; margin-top: 24px; font-size: 12px; letter-spacing: 0.05em; color: rgba(242,240,233,0.55); }
  .sabg-meta-dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(242,240,233,0.35); }

  /* ── Prose body ── */
  .sabg-body { max-width: 780px; margin: 0 auto; padding: 56px 24px 96px; width: 100%; box-sizing: border-box; }
  .sabg-prose { font-size: 17px; line-height: 1.7; color: rgba(20,25,21,0.85); }
  .sabg-prose h2 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(28px, 3.4vw, 38px); line-height: 1.15; letter-spacing: -0.01em;
    margin: 44px 0 14px; color: #141915;
  }
  .sabg-prose h3 { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; margin: 30px 0 10px; color: #141915; }
  .sabg-prose p { margin: 0 0 18px; }
  .sabg-prose ul, .sabg-prose ol { margin: 0 0 18px; padding-left: 24px; }
  .sabg-prose li { margin-bottom: 8px; }
  .sabg-prose a { color: #0E8C64; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .sabg-prose a:hover { color: #141915; }
  .sabg-prose strong { color: #141915; }
  .sabg-prose table { width: 100%; border-collapse: collapse; margin: 0 0 18px; font-size: 15.5px; }
  .sabg-prose th { font-family: 'IBM Plex Mono', monospace; font-weight: 500; font-size: 12px; letter-spacing: 0.05em; text-align: left; color: rgba(20,25,21,0.55); padding: 10px 14px; border-bottom: 2px solid #141915; }
  .sabg-prose td { padding: 12px 14px; border-bottom: 1px solid rgba(20,25,21,0.14); }
  .sabg-prose td:last-child, .sabg-prose th:last-child { text-align: right; }
  .sabg-note {
    background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 14px;
    padding: 18px 22px; margin: 0 0 18px; font-size: 15.5px;
  }

  /* ── CTA ── */
  .sabg-cta {
    background: #0B1512; color: #F2F0E9; border-radius: 18px; padding: 40px 32px;
    text-align: center; margin-top: 56px; box-shadow: 6px 6px 0 rgba(47,211,160,0.4);
  }
  .sabg-cta-kicker { font-size: 12px; letter-spacing: 0.06em; color: #2FD3A0; margin-bottom: 12px; }
  .sabg-cta-title { font-family: 'Instrument Serif', serif; font-size: clamp(26px, 3.4vw, 36px); line-height: 1.1; margin-bottom: 24px; }
  .sabg-cta-btn {
    display: inline-flex; align-items: center; gap: 10px; background: #2FD3A0; color: #0B1512;
    font-weight: 700; font-size: 16px; padding: 14px 26px; border-radius: 100px; text-decoration: none;
    transition: background 0.15s ease;
  }
  .sabg-cta-btn:hover { background: #F2F0E9; }

  /* ── Keep reading ── */
  .sabg-more { margin-top: 56px; }
  .sabg-more-title { font-size: 12px; letter-spacing: 0.06em; color: rgba(20,25,21,0.5); margin-bottom: 16px; }
  .sabg-more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .sabg-more-card {
    display: flex; flex-direction: column; gap: 10px; background: #FFFFFF;
    border: 1.5px solid rgba(20,25,21,0.85); border-radius: 14px; padding: 20px;
    text-decoration: none; color: #141915; transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .sabg-more-card:hover { transform: translate(-2px, -2px); box-shadow: 3px 3px 0 #2FD3A0; }
  .sabg-more-tag { font-size: 11px; letter-spacing: 0.05em; color: #0E8C64; }
  .sabg-more-name { font-weight: 700; font-size: 15px; line-height: 1.35; letter-spacing: -0.01em; }

  @media (max-width: 900px) {
    .sabg-hero { padding: 40px 20px 48px; }
    .sabg-body { padding: 40px 20px 72px; }
    .sabg-more-grid { grid-template-columns: 1fr; }
  }
</style>
