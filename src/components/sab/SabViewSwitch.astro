---
// Finder's four view buttons for the directories (Ilia, 2026-09-23: "like
// its done on my mac, so that a student can pick which way he likes"). One
// DOM, four stylesheets: the buttons set html[data-view] and global.css lays
// the same server-rendered rows out as a grid, a list, a list beside a
// preview, or a preview over a strip. directory-client owns the state and the
// preview; the Layout's inline script re-applies it before the first paint.
// Columns needs two panes side by side, so a phone does not get that button.
// The chosen view shows its name beside the icon (35 gate: views have text
// labels); the other three keep icon and tooltip so the toolbar stays one row.
const VIEWS = [
  {
    key: 'grid', label: 'Grid',
    icon: '<rect x="3" y="3" width="6" height="6" rx="1.5"/><rect x="11" y="3" width="6" height="6" rx="1.5"/><rect x="3" y="11" width="6" height="6" rx="1.5"/><rect x="11" y="11" width="6" height="6" rx="1.5"/>',
  },
  {
    key: 'list', label: 'List',
    icon: '<path d="M7.5 5h9.5M7.5 10h9.5M7.5 15h9.5"/><circle cx="3.8" cy="5" r="1" fill="currentColor" stroke="none"/><circle cx="3.8" cy="10" r="1" fill="currentColor" stroke="none"/><circle cx="3.8" cy="15" r="1" fill="currentColor" stroke="none"/>',
  },
  {
    key: 'columns', label: 'Columns',
    icon: '<rect x="2.5" y="4" width="15" height="12" rx="2"/><path d="M7.5 4v12M12.5 4v12"/>',
  },
  {
    key: 'gallery', label: 'Gallery',
    icon: '<rect x="2.5" y="3" width="15" height="10" rx="2"/><path d="M3 16.5h14" stroke-dasharray="2.2 1.6"/>',
  },
] as const;
---
<div class="sabl-views" role="group" aria-label="View">
  {VIEWS.map(v => (
    <button
      type="button"
      class="sabl-view"
      data-dir-view={v.key}
      aria-pressed={v.key === 'list' ? 'true' : 'false'}
      aria-label={`${v.label} view`}
      title={v.label}
    >
      <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={v.icon} />
      <span class="sabl-view-label">{v.label}</span>
    </button>
  ))}
</div>
