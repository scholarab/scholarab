---
// The combo pages' menu board: an ink panel with a mustard kicker, a huge
// heading, numbered jump pills and a price burst. Shared by a city's combo
// page and the /combos/ index, so the two open the same way.
import { BURST_PATH } from '../../lib/icons';

interface Props {
  kicker: string;
  h1: string;
  intro: string;
  menuLabel: string;
  items: { href: string; name: string; count: string }[];
  /** Two short lines for the sticker. */
  burst: [string, string];
}
const { kicker, h1, intro, menuLabel, items, burst } = Astro.props;
---

<header class="sabc-board">
  <p class="sabc-kicker">{kicker}</p>
  <h1 class="sabc-h1">{h1}</h1>
  <p class="sabc-intro">{intro}</p>
  <ol class="sabc-menu" aria-label={menuLabel}>
    {items.map((item, n) => (
      <li>
        <a href={item.href} class={`sabc-menu-link sabc-tone-${n % 3}`}>
          <span class="sabc-menu-no" aria-hidden="true">{n + 1}</span>
          <span class="sabc-menu-name">{item.name}</span>
          <span class="sabc-menu-count">{item.count}</span>
        </a>
      </li>
    ))}
  </ol>
  <div class="sabc-burst" aria-hidden="true">
    <svg viewBox="0 0 120 120"><path d={BURST_PATH} /></svg>
    <span>{burst[0]}<br />{burst[1]}</span>
  </div>
</header>

<style is:global>
  :root { --sabc-ink: var(--text-primary); --sabc-mustard: #FFC700; }
  .sabc-tone-0 { --sabc-tray: var(--brand); }
  .sabc-tone-1 { --sabc-tray: #FFD84D; }
  .sabc-tone-2 { --sabc-tray: #FDBEBA; }

  /* ── The menu board ── */
  .sabc-board {
    position: relative; background: var(--sabc-ink); color: #fff;
    border-radius: 30px; padding: 44px 48px 40px; overflow: hidden;
  }
  .sabc-kicker {
    margin: 0; font: 800 15px/1 var(--font-display); letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--sabc-mustard);
  }
  .sabc-h1 {
    margin: 14px 0 0; max-width: 11ch;
    font: 800 clamp(54px, 8.5vw, 112px)/0.86 var(--font-display);
    letter-spacing: -0.015em; text-transform: uppercase; text-wrap: balance;
  }
  .sabc-intro { margin: 20px 0 0; max-width: 56ch; font-size: 17px; line-height: 1.55; color: rgba(255,255,255,0.8); }
  .sabc-menu { list-style: none; margin: 30px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .sabc-menu-link {
    display: inline-flex; align-items: center; gap: 12px; min-height: 48px;
    padding: 6px 18px 6px 6px; border-radius: 999px;
    border: 2px solid rgba(255,255,255,0.28); color: #fff; text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .sabc-menu-link:hover { border-color: var(--sabc-tray); background: rgba(255,255,255,0.06); }
  .sabc-menu-no {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    background: var(--sabc-tray); color: var(--sabc-ink); font: 800 22px/1 var(--font-display);
  }
  .sabc-menu-name { font-weight: 700; font-size: 15.5px; }
  .sabc-menu-count { font-size: 13.5px; color: rgba(255,255,255,0.62); white-space: nowrap; }
  .sabc-burst {
    position: absolute; top: 28px; right: 34px; width: 150px; height: 150px;
    display: grid; place-items: center; transform: rotate(12deg);
  }
  .sabc-burst svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--sabc-mustard); }
  .sabc-burst span {
    position: relative; text-align: center; color: var(--sabc-ink);
    font: 800 21px/0.95 var(--font-display); text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .sabc-board { border-radius: 22px; padding: 30px 20px 26px; }
    .sabc-burst { top: 14px; right: 10px; width: 96px; height: 96px; }
    .sabc-burst span { font-size: 14px; }
    .sabc-h1 { margin-top: 12px; max-width: 8ch; font-size: clamp(46px, 13vw, 64px); }
    .sabc-intro { font-size: 16px; }
    /* Calgary has a dozen combos: stacked full-width they were a screen of
       pills before the first tray, so on a phone they wrap, name only. */
    .sabc-menu { gap: 8px; }
    .sabc-menu-link { min-height: 44px; gap: 8px; padding-right: 14px; }
    .sabc-menu-no { width: 30px; height: 30px; font-size: 18px; }
    .sabc-menu-name { font-size: 14px; }
    .sabc-menu-count { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sabc-menu-link { transition: none; }
  }
</style>
