---
// Server-rendered replacement for the old ProgramList React island.
// All cards are in the HTML (build-time closed ones hidden); directory-client
// shows/hides/reorders them, so the page ships no React.
import SabStatusHelp from './SabStatusHelp.astro';
import { STATUS_WORDS } from '../../lib/status.ts';
import { DEFAULT_PROGRAM_STATE, DIRECTORY_PAGE_SIZE, PROGRAM_GROUP_LABELS, directoryCountLine, filterSortPrograms, getProgramStatus, groupRuns, programGroupKey, programWhen } from '../../lib/list-core.ts';
import { programSearchBlob } from '../../lib/search-text.ts';
import type { ProgramFilterState, ProgramWithMeta } from '../../lib/list-core.ts';
import { generateSlug, formatVerifiedMonth } from '../../lib/utils.ts';
import { emailOff } from '../../lib/email-off';
import { PROGRAM_FACETS, PROGRAM_FORMATS, facetItems, MIN_FACET_ITEMS } from '../../lib/facets.ts';
import { ARROW_REF, BOOKMARK_REF, ICON_SPRITE } from '../../lib/icons.ts';
import SabViewSwitch from './SabViewSwitch.astro';
import { FORMAT_TERMS, GLOSSARY } from '../../lib/glossary.ts';

interface Props {
  items: ProgramWithMeta[];
  /** Facet hubs supply their own heading and standfirst; /programs keeps these defaults. */
  h1?: string;
  intro?: string;
  /** Set on a field hub: the FIELD row turns into navigation rather than a
      filter, since filtering a hub by any other field can only empty it. */
  currentField?: string | null;
  /** The same, on the FORMAT axis. Exactly one of the two is ever set. */
  currentFormat?: string | null;
  /** A hub is handed only its own field's programs, and the FIELD row is a map
      of the whole directory wherever it appears, so it counts against this. */
  allItems?: ProgramWithMeta[];
  /** The chip rows move into a sticky left column so the cards start at the
      top of the page; hubs and /programs alike. The scholarship twin; see the
      note there. */
  railFilters?: boolean;
}
const {
  items,
  h1 = 'All programs',
  intro = 'Labs, competitions, apprenticeships, and summer placements open to Alberta high school students. Some even pay you.',
  currentField = null,
  currentFormat = null,
  allItems = items,
  railFilters = false,
} = Astro.props;

// A hub named by a jargon word says what the word means under its heading.
const defined = currentFormat && FORMAT_TERMS[currentFormat] ? GLOSSARY[FORMAT_TERMS[currentFormat]!] : null;

const SORT_CHIPS = [
  { value: 'closest_due', label: 'Earliest deadline' },
  { value: 'paid_first',  label: 'Paid first' },
  { value: 'name',        label: 'A–Z' },
] as const;

// Mirrors the scholarship STATUS row, in the same words: 'ongoing' is open
// with no deadline, 'tba' is a date the provider has not posted yet.
const STATUS_CHIPS = [
  { value: 'all',     label: 'All' },
  { value: 'active',  label: 'Open' },
  { value: 'ongoing', label: STATUS_WORDS.none },
  { value: 'tba',     label: STATUS_WORDS.unconfirmed },
  { value: 'closed', label: 'Closed' },
] as const;

// FIELD is navigation, not a filter, and it is that on /programs as much as on
// a hub: the twin of the scholarship SCOPE row, which links to a city's page
// rather than hiding rows in place. A chip that filtered here and navigated one
// page deeper would be the same control doing two different things.
//
// The chip carries the facet's label, not the raw category value. They are the
// same word for eight of the nine; "Trades & Tech" is the exception, and the
// long form is 20px more than the row has to give, which is the scroller this
// row was rebuilt to be rid of. The data and the admin dropdown keep the full
// name.
//
// Counted against the whole corpus, not the page, so the order and the numbers
// are identical on /programs and on all eight hubs and a reader crossing the
// row twice finds the chip where they left it. Every field clears the
// MIN_FACET_ITEMS floor today; the filter is here so that the day one stops
// clearing it, the row stops offering a chip whose page no longer exists.
const fieldChips = PROGRAM_FACETS
  .map(f => ({ slug: f.slug, label: f.label, count: facetItems(f, allItems).length }))
  .filter(c => c.count >= MIN_FACET_ITEMS)
  .sort((a, b) => b.count - a.count);

// The scholarship twin of this; see the note on chipCount there.
// FORMAT is the second navigation row, added 2026-09-15 (Ilia): FIELD says what
// a program is about and FORMAT says what shape it is, and a reader looking for
// "an olympiad" or "something over the summer" was choosing on the axis the
// page did not have. Same rules as FIELD above: whole-corpus counts, and a
// format that drops under the floor loses its chip along with its page.
const formatChips = PROGRAM_FORMATS
  .map(f => ({ slug: f.slug, label: f.label, count: facetItems(f, allItems).length }))
  .filter(c => c.count >= MIN_FACET_ITEMS)
  .sort((a, b) => b.count - a.count);

// "All" is the current page only when neither axis is narrowed; on a format hub
// the FIELD row is showing a slice of the directory even though no field is set.
const onAll = !currentField && !currentFormat;

const chipCount = (o: Partial<ProgramFilterState>) =>
  filterSortPrograms(items, { ...DEFAULT_PROGRAM_STATE, ...o }).length;

// Initial view = the default STATUS filter ('all'), matching /scholarships:
// closed programs stay in the list wearing a CLOSED chip instead of vanishing.
const initial = filterSortPrograms(items, DEFAULT_PROGRAM_STATE);

// Only open-vs-closed: unlike scholarships, the program sorts do not keep
// dated and undated deadlines apart, so a finer split would put the same
// label on the grid twice. See groupRuns.
const runs = groupRuns(initial, programGroupKey, PROGRAM_GROUP_LABELS);
const showGroups = runs.length > 1;
const headerAt = new Map<number, { label: string; count: number; key: string }>();
if (showGroups) {
  let at = 0;
  for (const r of runs) { headerAt.set(at, r); at += r.count; }
}
const openNow = initial.filter(p => getProgramStatus(p) === 'active').length;
---

<Fragment set:html={ICON_SPRITE} />
<div class:list={['sabl-page', { 'sabl-railed': railFilters }]}>
  {/* The scholarship twin's wrapper, and load-bearing on a railed hub: it is
      what puts the heading and the toolbar in the right-hand column beside the
      filter rail. Without it both would auto-place into the rail's column. */}
  <div class="sabl-head">
  <div class="sabl-title-row">
    <div>
      <h1 class="sabl-h1">{h1}</h1>
      <p class="sabl-desc">{intro}</p>
      <p class="sabl-quiz-line">Not sure where to start? <a href="/match/">Answer a few questions</a> for a shortlist.</p>
    </div>
  </div>

  <div class="sabl-toolbar">
    <div class="sabl-search">
      <span class="sabl-search-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none"><circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.5"/><path d="M10.6 10.6L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
      <input
        type="search"
        data-dir-search
        placeholder="Search programs, universities, fields…"
        aria-label="Search programs by name, university, or field"
      />
    </div>
    <div class="sabl-sort" id="dir-sort">
      <span class="sabl-row-label">Sort</span>
      {/* One picker, not three chips (critique 2026-09-23: the toolbar held
          nine controls). directory-client reads [data-fselect] on change. */}
      <select class="sabl-sort-select" data-fselect="sort" aria-label="Sort">
        {SORT_CHIPS.map(s => <option value={s.value} selected={s.value === 'closest_due'}>{s.label}</option>)}
      </select>
    </div>
    {/* TRACK and STATUS put away from here, and on a hub the cards take the
        rail's column with them (Ilia, 2026-09-15). Only the filters: the
        heading, the standfirst, the money, the search box and these chips all
        stay whichever way it is set. */}
    {/* Phones only: sort and every chip row fold behind this, so the first
        card is on the first screen. Desktop keeps the lean toggle below. */}
    <button type="button" class="sabl-filters-btn" data-dir-filters aria-expanded="false" aria-controls="dir-sort dir-filters">
      Filters<span class="sabl-mono sabl-filters-n" data-dir-filter-n hidden></span>
    </button>
    <SabViewSwitch />
    <button type="button" class="sabl-lean" data-dir-lean aria-pressed="false">
      <span data-dir-lean-word>Hide filters</span>
      <svg class="sabl-lean-caret" viewBox="0 0 12 8" width="12" height="8" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  </div>

  {/* Rail or rows, one DOM; see the twin in ScholarshipDirectory. */}
  <div class="sabl-split">
  <aside class="sabl-rail" id="dir-filters" aria-label="Filters">
  {/* -dense: FIELD is nine chips wide and only holds one line on the tighter
      metrics: 995px of the 1020 the measure gives it, where the default chip
      padding would put it well over. The row was ten and scrolling before
      Environmental was folded into Research. See the modifier in global.css; it tightens all
      three rows here, not just FIELD, so the block still reads as one set of
      controls. */}
  <div class="sabl-filters sabl-filters-dense">
    <div class="sabl-filter-row">
      <span class="sabl-row-label">Format</span>
      <div class="sabl-chips">
        {onAll
          ? <span class="sabl-chip on" aria-current="page">All<span class="sabl-mono sabl-chip-count">{allItems.length}</span></span>
          : <a href="/programs/" class="sabl-chip sabl-chip-link">All<span class="sabl-mono sabl-chip-count">{allItems.length}</span></a>}
        {formatChips.map(c => (
          c.slug === currentFormat
            ? <span class="sabl-chip on" aria-current="page">
                {c.label}<span class="sabl-mono sabl-chip-count">{c.count}</span>
              </span>
            : <a href={`/programs/${c.slug}/`} class="sabl-chip sabl-chip-link">
                {c.label}<span class="sabl-mono sabl-chip-count">{c.count}</span>
              </a>
        ))}
      </div>
    </div>
    <div class="sabl-filter-row">
      <span class="sabl-row-label">Field</span>
      <div class="sabl-chips">
        {onAll
          ? <span class="sabl-chip on" aria-current="page">All<span class="sabl-mono sabl-chip-count">{allItems.length}</span></span>
          : <a href="/programs/" class="sabl-chip sabl-chip-link">All<span class="sabl-mono sabl-chip-count">{allItems.length}</span></a>}
        {fieldChips.map(c => (
          c.slug === currentField
            ? <span class="sabl-chip on" aria-current="page">
                {c.label}<span class="sabl-mono sabl-chip-count">{c.count}</span>
              </span>
            : <a href={`/programs/${c.slug}/`} class="sabl-chip sabl-chip-link">
                {c.label}<span class="sabl-mono sabl-chip-count">{c.count}</span>
              </a>
        ))}
      </div>
    </div>
    <div class="sabl-filter-row">
      <span class="sabl-row-label">Status</span>
      <div class="sabl-chips">
        {STATUS_CHIPS.filter(s => s.value !== 'closed' || chipCount({ statusFilter: s.value }) > 0).map(s => (
          <button type="button" class={`sabl-chip${s.value === 'all' ? ' on' : ''}`} data-fkey="status" data-fval={s.value} aria-pressed={s.value === 'all' ? 'true' : 'false'}>{s.label}<span class="sabl-mono sabl-chip-count" data-chip-count>{chipCount({ statusFilter: s.value })}</span></button>
        ))}
      </div>
    </div>
    <SabStatusHelp kind="program" />
  </div>

  <button type="button" class="sabl-filters-done" data-dir-filters-done>Show results</button>
  </aside>

  <div class="sabl-col">
  {/* Deleted from the page 2026-09-15 (Ilia), kept for screen readers. The
      status headings below now carry the counts a sighted reader needs, and
      each one is about its own run rather than the whole page. But typing in
      the search box changes nothing else a screen reader would announce -- the
      cards simply stop existing -- so the line stays as a polite live region.
      role="status" is implicitly atomic, which is right: it is replaced
      wholesale on every keystroke, not appended to. */}
  <div class="sr-only" data-dir-count role="status">
    {directoryCountLine(initial.length, items.length, 'PROGRAMS', openNow)}
  </div>

  {/* Over the results, not under the standfirst: every hub's toolbar sits at
      one height (smoke.spec.ts), and the word is read where the rows use it. */}
  {defined && <p class="sabl-define"><strong>{defined.term}:</strong> {defined.line}</p>}
  <div class="sabl-grid" data-dir-grid hidden={initial.length === 0}>
    {initial.map((p, i) => {
      const slug = p._slug ?? generateSlug(p.name);
      const meta = [p.duration, p.grades, p.location].filter(Boolean) as string[];
      const when = programWhen(p);
      const head = headerAt.get(i);
      return (
        <>
        {head && (
          <button
            type="button"
            class="sabl-group"
            data-dir-group={head.key}
            aria-expanded="true"
            data-dir-later={i >= DIRECTORY_PAGE_SIZE ? '' : undefined}
          >
            {/* The rule belongs to the words, not to the row: it stops
                after the count rather than running on to the toggle (Ilia,
                2026-09-15: "only for text and number of scholarships in that
                filter, stop there"). */}
            <span class="sabl-group-name">
              <span class="sabl-group-label">{head.label}</span>
              <span class="sabl-group-count">{head.count}</span>
            </span>
            {/* aria-hidden so the button's name stays "OPEN NOW 15"; the state
                itself is carried by aria-expanded, which is what a screen
                reader announces and what the word duplicates for everyone
                else. */}
            <span class="sabl-group-toggle" aria-hidden="true">
              <span data-dir-group-word>Hide</span>
              <svg class="sabl-group-caret" viewBox="0 0 12 8" width="12" height="8" fill="none"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </button>
        )}
        <div
          class="sabl-card"
          data-dir-card
          data-dir-later={i >= DIRECTORY_PAGE_SIZE ? '' : undefined}
          data-id={p.id}
          data-name={p.name}
          data-category={p.category ?? undefined}
          data-grades={p.grades ?? undefined}
          data-paid={p.paid ? '1' : undefined}
          data-deadline={p.deadline ?? undefined}
          data-search={programSearchBlob(p)}
        >
          {/* Same four cells as a scholarship row. The category label above the
              heading is gone; the PAID badge stays, because nothing else on
              the row says it. */}
          <div class="sabl-row-main">
            <h2 class="sabl-name-h"><a href={`/programs/${slug}/`} class="sabl-name">{p.name}</a></h2>
            {p.provider && <div class="sabl-org">{p.provider}</div>}
            {meta.length > 0 && (
              <ul class="sabl-meta-row">
                {meta.map(m => <li class="sabl-meta" title={m}>{m}</li>)}
              </ul>
            )}
            {p.description && <div class="sabl-blurb" set:html={emailOff(p.description)} />}
          </div>
          <span class="sabl-card-top-left">
            {p.paid && <span class="sabl-paid">Paid</span>}
          </span>
          <div class="sabl-row-when">
            <span class={when.cls} data-when><span data-when-main>{when.main}</span><span class="sabl-when-sub" data-when-sub hidden={!when.sub}>{when.sub}</span></span>
            {formatVerifiedMonth(p.lastVerified) && <span class="sabl-checked">Checked {formatVerifiedMonth(p.lastVerified)}</span>}
          </div>
          <div class="sabl-card-actions">
              <button
                type="button"
                class="sabl-save"
                data-dir-save
                data-id={p.id}
                data-name={p.name}
                aria-label={`Save ${p.name}`}
                aria-pressed="false"
              ><Fragment set:html={BOOKMARK_REF} /></button>
              <a href={`/programs/${slug}/`} class="sabl-apply">Details<Fragment set:html={ARROW_REF} /></a>
          </div>
        </div>
        </>
      );
    })}
  </div>

  {/* Every card is in the HTML; past the first step they carry data-dir-later,
      hidden only under html.js. Same as the scholarship list, including leaving
      the block out of a list that fits in one step. */}
  {initial.length > DIRECTORY_PAGE_SIZE && (
    <div class="sabl-more" data-dir-more>
      <p class="sabl-more-line" data-dir-more-line>Showing {DIRECTORY_PAGE_SIZE} of {initial.length.toLocaleString('en-CA')}</p>
      <div class="sabl-more-actions">
        <button type="button" class="sabl-more-btn" data-dir-more-btn>Show {Math.min(DIRECTORY_PAGE_SIZE, initial.length - DIRECTORY_PAGE_SIZE)} more</button>
        <button type="button" class="sabl-more-all" data-dir-all hidden={initial.length - DIRECTORY_PAGE_SIZE <= DIRECTORY_PAGE_SIZE}>Show all {initial.length}</button>
      </div>
    </div>
  )}

  <div class="sabl-empty" data-dir-empty hidden={initial.length > 0}>
    <div class="sabl-empty-title">Nothing matches that.</div>
    <div class="sabl-empty-sub" data-dir-empty-sub>Try a shorter word, or clear a filter.</div>
    {/* Filled in by directory-client when the term exists somewhere else on
        the site: a facet page holds a slice, so "clear a filter" is the wrong
        advice for a match sitting on another page. */}
    <div class="sabl-empty-elsewhere" data-dir-elsewhere hidden></div>
    <button type="button" class="sabl-empty-btn" data-dir-clear>Clear search</button>
  </div>
  </div>
  </div>
</div>

<script>
  import { initDirectory } from '../../lib/directory-client.ts';
  import { PROGRAM_GROUP_LABELS, buildProgramStatusCache, directoryCountLine, filterSortPrograms, getProgramStatus, programGroupKey, programWhen, selectPrograms } from '../../lib/list-core.ts';
  import type { ProgramWithMeta, ProgramSort, ProgramStatus, ProgramStatusFilter } from '../../lib/list-core.ts';
  import { getSavedPrograms, toggleSavedProgram } from '../../lib/tracker.ts';

  type Item = ProgramWithMeta & { el: HTMLElement; search: string };
  type State = { sort: string; category: string; status: string };

  type Cache = Map<number, ProgramStatus>;

  const asFilterState = (state: State) => ({
    selectedCategory: state.category,
    searchQuery: '',
    sortBy: state.sort as ProgramSort,
    statusFilter: state.status as ProgramStatusFilter,
  });

  initDirectory<Item, State, Cache>('#sab-programs', {
    itemType: 'program',
    defaultState: { sort: 'closest_due', category: 'all', status: 'all' },
    toggleKeys: ['category'],
    parseCard(el) {
      const d = el.dataset;
      return {
        el,
        search: d.search ?? '',
        id: Number(d.id),
        name: d.name ?? '',
        category: d.category ?? null,
        grades: d.grades ?? null,
        paid: d.paid === '1',
        deadline: d.deadline ?? null,
        // Visitor-timezone ms from the ISO string; a serialized build-time
        // value would be UTC-midnight and close listings a day early here.
        _deadline_ms: d.deadline && d.deadline !== 'TBA' && d.deadline !== 'Ongoing'
          ? new Date(d.deadline + 'T00:00:00').getTime()
          : undefined,
        // FORMAT is a hub axis, not a client filter: the chips above the grid
        // are links to /programs/<format>/, so no card carries a data-format
        // and nothing in list-core reads this at runtime.
        format: null,
        emoji: null, provider: null, duration: null, stipend: null, location: null,
        eligibility: null, url: '', description: null, lastVerified: null, active: true,
        cost: 'unconfirmed', costNote: null,
      };
    },
    // One pass over the corpus per render, shared by the visible list and all
    // eighteen chip counts. See the scholarship twin.
    renderContext: items => buildProgramStatusCache(items),
    select: (items, state, cache) => filterSortPrograms(items, asFilterState(state), cache) as Item[],
    countFor: (items, state, cache) => selectPrograms(items, asFilterState(state), cache).length,
    groups: { key: programGroupKey, label: key => PROGRAM_GROUP_LABELS[key] ?? key },
    summary: (visible, total) => ({
      count: directoryCountLine(visible.length, total, 'PROGRAMS', visible.filter(p => getProgramStatus(p) === 'active').length),
    }),
    getSavedIds: () => [...getSavedPrograms()],
    toggleSave: id => [...toggleSavedProgram(id)],
    saveLabel: (name, saved) => (saved ? `Remove ${name} from saved` : `Save ${name}`),
    // Day chips depend on the clock, not just the data: recompute them on every
    // load so CDN-cached HTML never shows a stale countdown.
    onCardsParsed(items) {
      for (const p of items) {
        const whenEl = p.el.querySelector<HTMLElement>('[data-when]');
        if (!whenEl) continue;
        const when = programWhen(p);
        whenEl.className = when.cls;
        whenEl.querySelector('[data-when-main]')!.textContent = when.main;
        const sub = whenEl.querySelector<HTMLElement>('[data-when-sub]')!;
        sub.textContent = when.sub;
        sub.hidden = !when.sub;
      }
    },
  });
</script>
