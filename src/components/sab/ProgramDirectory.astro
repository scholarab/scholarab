---
// Server-rendered replacement for the old ProgramList React island.
// All cards are in the HTML (build-time closed ones hidden); directory-client
// shows/hides/reorders them, so the page ships no React.
import { PROGRAM_GROUP_LABELS, directoryCountLine, filterSortPrograms, getProgramStatus, groupRuns, programDayChip, programGroupKey, shortDate } from '../../lib/list-core.ts';
import type { ProgramWithMeta } from '../../lib/list-core.ts';
import { generateSlug } from '../../lib/utils.ts';

interface Props {
  items: ProgramWithMeta[];
}
const { items } = Astro.props;

const SORT_CHIPS = [
  { value: 'closest_due', label: 'Earliest deadline' },
  { value: 'paid_first',  label: 'Paid first' },
  { value: 'name',        label: 'A–Z' },
] as const;
const GRADE_CHIPS = [10, 11, 12];

// Mirrors the scholarship STATUS row: 'tba' covers Ongoing and undated intakes.
const STATUS_CHIPS = [
  { value: 'all',    label: 'All' },
  { value: 'active', label: 'Open' },
  { value: 'tba',    label: 'Ongoing' },
  { value: 'closed', label: 'Closed' },
] as const;

const counts = new Map<string, number>();
for (const p of items) if (p.category) counts.set(p.category, (counts.get(p.category) ?? 0) + 1);
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([name]) => name);

// Initial view = the default STATUS filter ('all'), matching /scholarships:
// closed programs stay in the list wearing a CLOSED chip instead of vanishing.
const initial = filterSortPrograms(items, {
  selectedCategory: 'all', gradeFilter: null, searchQuery: '', sortBy: 'closest_due', statusFilter: 'all',
});
const paidCount = initial.filter(p => p.paid).length;

// Only open-vs-closed: unlike scholarships, the program sorts do not keep
// dated and undated deadlines apart, so a finer split would put the same
// label on the grid twice. See groupRuns.
const runs = groupRuns(initial, programGroupKey, PROGRAM_GROUP_LABELS);
const showGroups = runs.length > 1;
const headerAt = new Map<number, { label: string; count: number; key: string }>();
if (showGroups) {
  let at = 0;
  for (const r of runs) { headerAt.set(at, r); at += r.count; }
}
const openNow = initial.filter(p => getProgramStatus(p) !== 'closed').length;
---

<div class="sabl-page">
  <div class="sabl-title-row">
    <div>
      <div class="sab-kicker">PROGRAMS AND PLACEMENTS</div>
      <h1 class="sabl-h1">Research programs</h1>
      <p class="sabl-desc">
        Labs, competitions, apprenticeships, and summer placements open to Alberta high school students. Some even pay you.
      </p>
    </div>
    <div class="sabl-stat">
      <div class="sabl-stat-value tnum" data-dir-stat>{paidCount} / {initial.length}</div>
      <div class="sabl-mono sabl-stat-label">PAID ACROSS THESE LISTINGS</div>
    </div>
  </div>

  <div class="sabl-toolbar">
    <div class="sabl-search">
      <span class="sabl-search-icon" aria-hidden="true">⌕</span>
      <input
        type="search"
        data-dir-search
        placeholder="Search programs, universities, fields…"
        aria-label="Search programs by name, university, or field"
      />
    </div>
    <div class="sabl-sort">
      <span class="sabl-mono sabl-row-label">SORT</span>
      {SORT_CHIPS.map(s => (
        <button type="button" class={`sabl-chip${s.value === 'closest_due' ? ' on' : ''}`} data-fkey="sort" data-fval={s.value} aria-pressed={s.value === 'closest_due' ? 'true' : 'false'}>{s.label}</button>
      ))}
    </div>
  </div>

  <div class="sabl-filters">
    <div class="sabl-filter-row">
      <span class="sabl-mono sabl-row-label">FIELD</span>
      <button type="button" class="sabl-chip on" data-fkey="category" data-fval="all" aria-pressed="true">All</button>
      {categories.map(c => (
        <button type="button" class="sabl-chip" data-fkey="category" data-fval={c} aria-pressed="false">{c}</button>
      ))}
    </div>
    <div class="sabl-filter-row">
      <span class="sabl-mono sabl-row-label">GRADE</span>
      <button type="button" class="sabl-chip on" data-fkey="grade" data-fval="" aria-pressed="true">All</button>
      {GRADE_CHIPS.map(g => (
        <button type="button" class="sabl-chip" data-fkey="grade" data-fval={String(g)} aria-pressed="false">{`Gr ${g}`}</button>
      ))}
    </div>
    <div class="sabl-filter-row">
      <span class="sabl-mono sabl-row-label">STATUS</span>
      {STATUS_CHIPS.map(s => (
        <button type="button" class={`sabl-chip${s.value === 'all' ? ' on' : ''}`} data-fkey="status" data-fval={s.value} aria-pressed={s.value === 'all' ? 'true' : 'false'}>{s.label}</button>
      ))}
    </div>
  </div>

  <div class="sabl-mono sabl-result-line" data-dir-count>
    {directoryCountLine(initial.length, items.length, 'PROGRAMS', openNow)}
  </div>

  <div class="sabl-grid" data-dir-grid hidden={initial.length === 0}>
    {initial.map((p, i) => {
      const slug = p._slug ?? generateSlug(p.name);
      const meta = [p.duration, p.grades, p.location].filter(Boolean) as string[];
      const chip = programDayChip(p);
      const head = headerAt.get(i);
      return (
        <>
        {head && (
          <div class="sabl-group" data-dir-group={head.key}>
            <span class="sabl-group-label">{head.label}</span>
            <span class="sabl-group-count">{head.count}</span>
          </div>
        )}
        <div
          class="sabl-card"
          data-dir-card
          data-id={p.id}
          data-name={p.name}
          data-category={p.category ?? undefined}
          data-grades={p.grades ?? undefined}
          data-paid={p.paid ? '1' : undefined}
          data-deadline={p.deadline ?? undefined}
          data-search={[p.name, p.provider, p.description, p.category].filter(Boolean).join('\n').toLowerCase()}
        >
          <div class="sabl-card-top">
            <span class="sabl-card-top-left">
              <span class="sabl-mono sabl-tag">{(p.category ?? 'PROGRAM').toUpperCase()}</span>
              {p.paid && <span class="sabl-mono sabl-paid">$ PAID</span>}
            </span>
            <span class={chip ? chip.cls : 'sabl-days'} data-days-chip hidden={!chip}>{chip?.label}</span>
          </div>
          <a href={`/programs/${slug}/`} class="sabl-name">
            {p.emoji && <span class="sabl-name-emoji" aria-hidden="true">{`${p.emoji} `}</span>}
            {p.name}
          </a>
          {p.provider && <div class="sabl-org">{p.provider}</div>}
          {meta.length > 0 && (
            <div class="sabl-meta-row">
              {meta.map(m => <span class="sabl-meta">{m}</span>)}
            </div>
          )}
          {p.description && <div class="sabl-blurb">{p.description}</div>}
          <div class="sabl-card-foot">
            <span class="sabl-due">
              {p.deadline && p.deadline !== 'TBA' && p.deadline !== 'Ongoing'
                ? `DUE ${shortDate(p.deadline)}`
                : 'NO FIXED DEADLINE'}
            </span>
            <div class="sabl-card-actions">
              <button
                type="button"
                class="sabl-save"
                data-dir-save
                data-id={p.id}
                data-name={p.name}
                aria-label={`Save ${p.name}`}
                aria-pressed="false"
              >☆</button>
              <a href={`/programs/${slug}/`} class="sabl-apply">Details →</a>
            </div>
          </div>
        </div>
        </>
      );
    })}
  </div>

  <div class="sabl-empty" data-dir-empty hidden={initial.length > 0}>
    <div class="sabl-empty-title">Nothing matches that.</div>
    <div class="sabl-empty-sub">Try clearing a filter or searching something broader.</div>
    <button type="button" class="sabl-empty-btn" data-dir-clear>Clear all filters</button>
  </div>
</div>

<script>
  import { initDirectory } from '../../lib/directory-client.ts';
  import { PROGRAM_GROUP_LABELS, directoryCountLine, filterSortPrograms, getProgramStatus, programDayChip, programGroupKey } from '../../lib/list-core.ts';
  import type { ProgramWithMeta, ProgramSort, ProgramStatusFilter } from '../../lib/list-core.ts';
  import { getSavedPrograms, toggleSavedProgram } from '../../lib/tracker.ts';

  type Item = ProgramWithMeta & { el: HTMLElement; search: string };
  type State = { sort: string; category: string; grade: string; status: string };

  initDirectory<Item, State>('#sab-programs', {
    itemType: 'program',
    defaultState: { sort: 'closest_due', category: 'all', grade: '', status: 'all' },
    toggleKeys: ['category', 'grade'],
    parseCard(el) {
      const d = el.dataset;
      return {
        el,
        search: d.search ?? '',
        id: Number(d.id),
        name: d.name ?? '',
        category: d.category ?? null,
        grades: d.grades ?? null,
        paid: d.paid === '1',
        deadline: d.deadline ?? null,
        // Visitor-timezone ms from the ISO string; a serialized build-time
        // value would be UTC-midnight and close listings a day early here.
        _deadline_ms: d.deadline && d.deadline !== 'TBA' && d.deadline !== 'Ongoing'
          ? new Date(d.deadline + 'T00:00:00').getTime()
          : undefined,
        emoji: null, provider: null, duration: null, stipend: null, location: null,
        eligibility: null, url: '', description: null, lastVerified: null, active: true,
      };
    },
    select(items, state, q) {
      const sorted = filterSortPrograms(items, {
        selectedCategory: state.category,
        gradeFilter: state.grade ? Number(state.grade) : null,
        searchQuery: '',
        sortBy: state.sort as ProgramSort,
        statusFilter: state.status as ProgramStatusFilter,
      }) as Item[];
      return q ? sorted.filter(it => it.search.includes(q)) : sorted;
    },
    countLine: (shown, total, visible) =>
      directoryCountLine(shown, total, 'PROGRAMS', visible.filter(p => getProgramStatus(p) !== 'closed').length),
    groups: { key: programGroupKey, label: key => PROGRAM_GROUP_LABELS[key] ?? key },
    // The sibling page puts a dollar figure in this exact slot, so a bare
    // numeral in 44px serif reads as money. The denominator makes it a
    // proportion, which is what it always was.
    stat: visible => `${visible.filter(p => p.paid).length} / ${visible.length}`,
    getSavedIds: () => [...getSavedPrograms()],
    toggleSave: id => [...toggleSavedProgram(id)],
    saveLabel: (name, saved) => (saved ? `Remove ${name} from saved` : `Save ${name}`),
    // Day chips depend on the clock, not just the data: recompute them on every
    // load so CDN-cached HTML never shows a stale countdown.
    onCardsParsed(items) {
      for (const p of items) {
        const chipEl = p.el.querySelector<HTMLElement>('[data-days-chip]');
        if (!chipEl) continue;
        const chip = programDayChip(p);
        chipEl.hidden = !chip;
        if (chip) { chipEl.className = chip.cls; chipEl.textContent = chip.label; }
      }
    },
  });
</script>
