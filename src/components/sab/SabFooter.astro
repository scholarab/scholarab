---
const links = [
  ['All scholarships', '/scholarships/'], ['Research programs', '/programs/'], ['Match', '/match/'],
  ['About', '/about/'], ['For educators', '/educators/'], ['Updates', '/updates/'],
  ['Guides', '/guides/'], ['Reference template', '/templates/reference-letter/'],
  ['Privacy', '/privacy/'], ['Terms', '/terms/'],
  ['Instagram', 'https://www.instagram.com/scholarab.ca'], ['TikTok', 'https://www.tiktok.com/@scholarab'],
];
---
<footer class="sabf-footer">
  <div class="sabf-inner">
    <p>Free. No ads. No account. Confirm deadlines with the provider.</p>
    <nav aria-label="More about ScholarAB">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <Fragment set:html={'<!--email_off--><a href="mailto:contact.scholarab@gmail.com">Contact</a><!--/email_off-->'} />
    </nav>
    <p>© 2026 ScholarAB · Medicine Hat, Alberta</p>
  </div>
</footer>
<style is:global>
  .sabf-footer { background: #0A1310; color: #C6CEC9; font-family: 'Archivo', sans-serif; font-size: 14px; }
  .sabf-inner { padding: 32px 48px; max-width: var(--sab-measure); margin: 0 auto; box-sizing: border-box; }
  .sabf-footer nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .sabf-footer nav a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-underline-offset: 3px; }
  @media (max-width: 900px) { .sabf-inner { padding: 24px 20px; } }
</style>
