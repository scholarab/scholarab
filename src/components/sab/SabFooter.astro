---
import SabLogoMark from './SabLogoMark.astro';

// Full dark footer shared by every sab-design page (same design as the home page).
const footerCols = [
  { title: 'Explore', links: [
    { label: 'All scholarships', href: '/scholarships/' },
    { label: 'Research programs', href: '/programs/' },
    { label: 'Closing soon', href: '/#closing' },
    { label: 'Deadline calendar', href: '/deadlines/' },
    { label: 'Find my match', href: '/match/' },
    { label: 'Guides', href: '/guides/' },
    { label: 'Reference letter template', href: '/templates/reference-letter/' },
  ]},
  { title: 'About', links: [
    { label: 'The story', href: '/about/' },
    { label: 'For educators', href: '/educators/' },
    { label: 'What changed', href: '/updates/' },
    { label: 'Privacy', href: '/privacy/' },
    { label: 'Terms of use', href: '/terms/' },
    { label: 'Photo credits', href: '/credits/' },
    { label: 'Suggest a scholarship', href: 'mailto:contact.scholarab@gmail.com' },
  ]},
  { title: 'Contact', links: [
    { label: 'Email', href: 'mailto:contact.scholarab@gmail.com' },
    { label: 'Instagram', href: 'https://www.instagram.com/scholarab.ca' },
    { label: 'TikTok', href: 'https://www.tiktok.com/@scholarab' },
  ]},
];
---
<footer class="sabf-footer">
  <div class="sabf-inner">
    <div class="sabf-top">
      <div>
        <div class="sabf-logo">
          <SabLogoMark size={32} id="footer" />
          <span class="sabf-word">Scholar<span class="sabf-accent">AB</span></span>
        </div>
        <p class="sabf-blurb">ScholarAB is a free directory of scholarships and research programs for Alberta high school students, with deadlines tracked. No account needed.</p>
        <p class="sabf-blurb sabf-disclaimer">Listings are written and reviewed by a person, but this site can still contain errors and out-of-date information. Deadlines move and rules change. Always confirm the details on the provider's own page before you apply. <a href="/terms/">More in the terms of use</a>.</p>
      </div>
      <div class="sabf-cols">
        {footerCols.map(col => (
          <div>
            <div class="sabf-col-title">{col.title}</div>
            <div class="sabf-links">
              {col.links.map(l => (
                l.href.startsWith('mailto:')
                  ? <Fragment set:html={`<!--email_off--><a href="${l.href}">${l.label}</a><!--/email_off-->`} />
                  : <a
                      href={l.href}
                      rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      target={l.href.startsWith('http') ? '_blank' : undefined}
                    >{l.label}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="sabf-bottom sabf-mono">
      <span>© 2026 ScholarAB · Medicine Hat, Alberta</span>
    </div>
  </div>
</footer>

<style>
  .sabf-footer { background: #0A1310; color: rgba(238, 241, 236, 0.65); font-family: var(--font-body); }
  /* Full window width on the header's gutter, so the footer's edges line up
     with the logo and the social icons above (2026-09-18). */
  .sabf-inner { padding: 64px clamp(20px, 4vw, 56px) 40px; box-sizing: border-box; }
  .sabf-mono { font-family: var(--font-label); }
  .sabf-accent { color: #2FD3A0; }
  .sabf-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; }
  .sabf-logo { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
  .sabf-word { font-weight: 800; letter-spacing: -0.02em; color: #EEF1EC; font-size: 28px; line-height: 1; }
  .sabf-blurb { font-size: 14px; line-height: 1.6; max-width: 340px; margin: 0; }
  /* The accuracy disclaimer. Deliberately in the footer rather than only in
     the terms: a student about to miss a deadline is not reading /terms. */
  .sabf-disclaimer { margin-top: 14px; font-size: 13px; color: rgba(238, 241, 236, 0.62); }
  .sabf-disclaimer a { color: rgba(238, 241, 236, 0.7); text-decoration: underline; text-underline-offset: 2px; }
  .sabf-disclaimer a:hover { color: #EEF1EC; }
  .sabf-cols { display: flex; gap: 64px; flex-wrap: wrap; }
  .sabf-col-title { font-size: 14px; font-weight: 700; color: #EEF1EC; margin-bottom: 8px; }
  /* The links were 21px tall with a 10px gap between them: under the 24px
     WCAG 2.2 minimum. The gap now lives inside each link, so the rhythm is
     the same 31-32px and the whole row takes the tap; 44px on touch. */
  .sabf-links { display: flex; flex-direction: column; gap: 0; align-items: flex-start; }
  /* :global because the mailto links arrive through set:html (email_off) and
     carry no scope attribute; scoped, they rendered in the browser default. */
  .sabf-links :global(a) { font-size: 14px; color: rgba(238, 241, 236, 0.7); text-decoration: none; display: inline-flex; align-items: center; min-height: 32px; }
  @media (pointer: coarse) { .sabf-links :global(a) { min-height: 44px; } }
  .sabf-links :global(a:hover) { color: #EEF1EC; }
  .sabf-bottom {
    display: flex; justify-content: space-between; margin-top: 56px; padding-top: 24px;
    border-top: 1px solid rgba(238, 241, 236,0.12);
    font-size: 12px; color: rgba(238, 241, 236, 0.62); gap: 12px; flex-wrap: wrap;
  }
  @media (max-width: 900px) {
    .sabf-top { flex-direction: column; }
    .sabf-cols { gap: 36px; }
    /* This used to be `padding-bottom: 110px`; clearance for the fixed
       bottom tab bar. That bar is gone, so it was 70px of dead space at the
       end of every phone page. */
    .sabf-inner { padding: 48px 20px 40px; }
    .sabf-bottom { margin-top: 40px; }
  }
</style>
