---
/* The background of one home panel: the first frame of a hero clip as a
   still, and the clip itself, which index.astro starts only while the panel
   is on screen. Phones get the same 720x1080 centre crop as the hero. */
interface Props { clip: string }
const { clip } = Astro.props;
---
<div class="sab-panel-media" aria-hidden="true">
  <picture>
    <source media="(max-width: 900px)" srcset={`/video/hero/poster-${clip}.m.webp`} />
    <img src={`/video/hero/poster-${clip}.webp`} alt="" loading="lazy" decoding="async" />
  </picture>
  <video muted playsinline loop preload="none" data-panel-clip={clip}></video>
</div>

<style>
  .sab-panel-media { position: absolute; inset: 0; z-index: -1; }
  .sab-panel-media img, .sab-panel-media video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .sab-panel-media video { opacity: 0; transition: opacity 0.8s ease; }
  .sab-panel-media video.is-on { opacity: 1; }
  /* Solid ink at both edges, the shade the hero and the carousel fade to.
     At the veil's thinnest (0.66, mid-panel) the muted row text measured
     5.0:1 or better on 99% of the pixels of every second of clips 07, 20 and
     12, both cuts; the lowest single pixel, the sun in 20, is 4.1:1. */
  .sab-panel-media::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(#0A1310, rgba(10,19,16,0.74) 16%, rgba(10,19,16,0.66) 50%, rgba(10,19,16,0.74) 84%, #0A1310);
  }
  @media print { .sab-panel-media { display: none; } }
</style>
