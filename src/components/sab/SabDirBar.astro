---
// A directory's bar (Ilia, 2026-10-12, after polymarket.com): the tab line,
// every page of that directory, the same on every one of them and always
// starting at All, this page's tab lit; then three icons. The search icon
// opens a box in its own place, with a few words to try under it while it is
// empty; the filters open as a row under the bar.
import { BOOKMARK_REF } from '../../lib/icons.ts';
import { TAB_PHOTOS } from '../../lib/photo-credits.ts';
interface Props {
  label: string;
  /** photo: a backdrop name (facets.ts); the tab wears its photo crop. Without one, TAB_PHOTOS by href. */
  tabs: Array<{ href: string; label: string; current?: boolean; photo?: string }>;
  searchPlaceholder: string;
  searchLabel: string;
  /** Words to try under the empty box (searchSuggestions). */
  suggestions?: string[];
}
const { label, tabs: given, searchPlaceholder, searchLabel, suggestions = [] } = Astro.props;
const tabs = given.map(t => ({ ...t, photo: t.photo ?? TAB_PHOTOS[t.href]?.photo }));
const LENS = '<svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.5"/><path d="M10.6 10.6L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
---
<div class="sabl-bar">
  <nav class="sabl-tabs" aria-label={label}>
    <button type="button" class="sabl-tabs-more sabl-tabs-back" data-tabs-back aria-label="Back" hidden>
      <svg viewBox="0 0 8 12" width="8" height="12" fill="none" aria-hidden="true"><path d="M6.5 1 1.5 6 6.5 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="sabl-tabs-track" data-tabs-track>
      {tabs.map(t => (
        <a href={t.href} class:list={['sabl-tab', { 'sabl-tab-photo': t.photo }]} aria-current={t.current ? 'page' : undefined}>
          {t.photo && <img class="sabl-tab-img" src={`/photos/backdrops/${t.photo}-tab.webp`} alt="" width="144" height="52" loading="lazy" decoding="async" />}
          <span class="sabl-tab-label">{t.label}</span>
        </a>
      ))}
    </div>
    <button type="button" class="sabl-tabs-more" data-tabs-more aria-label="More" hidden>
      <svg viewBox="0 0 8 12" width="8" height="12" fill="none" aria-hidden="true"><path d="M1.5 1 6.5 6 1.5 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </nav>
  <div class="sabl-tools">
    <div class="sabl-find" data-dir-find>
      <button type="button" class="sabl-tool" data-dir-search-btn aria-label="Search" aria-expanded="false" aria-controls="dir-search">
        <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.8" stroke="currentColor" stroke-width="1.8"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <div class="sabl-search" id="dir-search" data-dir-search-row hidden>
        <span class="sabl-search-icon"><Fragment set:html={LENS} /></span>
        <input type="search" data-dir-search placeholder={searchPlaceholder} aria-label={searchLabel} autocomplete="off" />
        <button type="button" class="sabl-search-clear" data-dir-search-clear aria-label="Clear search" hidden>
          <svg viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true"><path d="M1.5 1.5l9 9M10.5 1.5l-9 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </button>
      </div>
      {suggestions.length > 0 && (
        <div class="sabl-suggest" data-dir-suggest hidden>
          <p class="sabl-suggest-head">Try</p>
          {suggestions.map(q => <button type="button" class="sabl-suggest-q" data-dir-suggest-q={q}><Fragment set:html={LENS} />{q}</button>)}
        </div>
      )}
    </div>
    <button type="button" class="sabl-tool" data-dir-filters aria-label="Sort and filters" aria-expanded="false" aria-controls="dir-filters">
      <svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true"><path d="M3 6h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="7.5" cy="6" r="2.3" fill="var(--bg-page)" stroke="currentColor" stroke-width="1.8"/><circle cx="12.5" cy="14" r="2.3" fill="var(--bg-page)" stroke="currentColor" stroke-width="1.8"/></svg>
      <span class="sabl-mono sabl-tool-n" data-dir-filter-n hidden></span>
    </button>
    <a class="sabl-tool" href="/saved/" aria-label="My combo">
      <Fragment set:html={BOOKMARK_REF} />
      <span class="sabl-mono sabl-tool-n" data-saved-n hidden></span>
    </a>
  </div>
</div>

<script>
  // Arrows at either edge while more tabs sit past them. The lit tab glides
  // to the middle of the line (Ilia, 2026-10-13): the line starts where the
  // last page left it, then scrolls, so a click on Medicine Hat visibly
  // brings Medicine Hat to the centre.
  let sync = () => {};
  addEventListener('resize', () => sync(), { passive: true });
  document.addEventListener('astro:page-load', () => {
    sync = () => {};
    const track = document.querySelector<HTMLElement>('[data-tabs-track]');
    const more = document.querySelector<HTMLButtonElement>('[data-tabs-more]:not([data-tabs-back])');
    const back = document.querySelector<HTMLButtonElement>('[data-tabs-back]');
    if (!track || !more || !back) return;
    sync = () => {
      back.hidden = track.scrollLeft <= 4;
      more.hidden = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    const step = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.7, behavior: 'smooth' });
    more.addEventListener('click', () => step(1));
    back.addEventListener('click', () => step(-1));
    track.addEventListener('scroll', () => sync(), { passive: true });
    track.addEventListener('click', () => {
      try { sessionStorage.setItem('sa_tabs_x', String(track.scrollLeft)); } catch { /* storage blocked */ }
    });
    const lit = track.querySelector<HTMLElement>('[aria-current="page"]');
    if (lit) {
      let from = 0;
      try { from = Number(sessionStorage.getItem('sa_tabs_x')) || 0; sessionStorage.removeItem('sa_tabs_x'); } catch { /* storage blocked */ }
      track.scrollLeft = from;
      const box = lit.getBoundingClientRect(), line = track.getBoundingClientRect();
      const to = track.scrollLeft + box.left - line.left - (track.clientWidth - box.width) / 2;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: to, behavior: still || Math.abs(to - from) < 2 ? 'instant' : 'smooth' });
    }
    sync();
  });
</script>
