---
// Editorial detail page from the claude.ai/design "ScholarAB Detail" page,
// shared by scholarship and program slug pages.
// Deviations from the design (established site conventions):
// - SabHeader replaces the design's plain header; the mono
//   annotation bar stays removed per Ilia (2026-07-11).
// - The canvas "PREVIEWING X OF N" switcher is implemented as real prev/next
//   links between listings ("LISTING X OF N").
// - A "Checked against the provider's page in <month>" line under the CTA
//   (removed site-wide 2026-07-12, back 2026-09-22 after the design critique:
//   trust is the product, and the month is per listing, not a promised cycle).
// - Reminder copy reflects the real send schedule (30/14/3 days out).
// - Closed and opening-soon states added (the design only shows open listings).

import { emailOff } from '../../lib/email-off';
import { BOOKMARK } from '../../lib/icons';
import { URGENT_DAYS, SOON_DAYS } from '../../lib/list-core';
import { STATUS_WORDS } from '../../lib/status';

interface Fact {
  label: string;
  value: string;
}

interface Props {
  itemType: 'scholarship' | 'program';
  itemId: number;
  typeLabel: string; // 'SCHOLARSHIP' | 'PROGRAM'
  name: string;
  subline: string;
  status: 'active' | 'closed' | 'future' | 'unconfirmed' | 'ongoing' | 'tba';
  daysLeft: number | null;
  // ISO dates for the client-side chip recompute: the page is prerendered, so
  // the SSR chip is only as fresh as the last build. null = not clock-driven.
  deadlineIso?: string | null;
  openDateIso?: string | null;
  inactive?: boolean; // curator-closed next-cycle listing (open date unknown)
  estimated?: boolean; // the deadline is last cycle's, rolled forward
  dueLong: string; // 'July 15, 2026' / 'No fixed deadline, join any time' / 'TBA'
  opensLabel?: string | null; // formatted open date, for status 'future'
  backHref: string;
  backLabel: string;
  /** The facet hub this listing sits under, when it has one. */
  facetHref?: string | null;
  facetLabel?: string | null;
  facts: Fact[];
  eligibility: string | null;
  about: string | null;
  notes?: string | null;
  steps: string[];
  valueLabel: string;
  valueBig: string;
  valueNote?: string | null;
  /** The value is a word, not a figure: set small rather than in money type. */
  valueQuiet?: boolean;
  /** 'Sep 2026' from lastVerified; null hides the line. */
  checkedLabel?: string | null;
  ctaLabel: string;
  url: string;
  canRemind: boolean;
  canonical: string;
  /** Link to the guide that explains this listing, when one covers it. */
  guideHref?: string;
  guideTitle?: string;
}

const {
  itemType, itemId, typeLabel, name, subline,
  status, daysLeft, deadlineIso, openDateIso, inactive, estimated = false, dueLong, opensLabel,
  backHref, backLabel, facetHref = null, facetLabel = null,
  facts, eligibility, about, notes, steps,
  valueLabel, valueBig, valueNote, checkedLabel = null, valueQuiet = false,
  ctaLabel, url, canRemind, canonical, guideHref, guideTitle,
} = Astro.props;

// The directory's three tiers (list-core), so a listing is the same colour on
// its own page as in the row that linked to it. This page used to go solid at 7.
const urgent = status === 'active' && typeof daysLeft === 'number' && daysLeft <= URGENT_DAYS;
const far = status === 'active' && typeof daysLeft === 'number' && daysLeft > SOON_DAYS;

// Listing prose can carry a provider's own address ("apply to x@y.ca"), so it
// is bracketed for Cloudflare's obfuscator. See src/lib/email-off.ts.
const aboutHtml = about ? emailOff(about) : '';
const notesHtml = notes ? emailOff(notes) : '';

const chip =
  status === 'closed' ? { text: STATUS_WORDS.closed, bg: 'rgba(20,25,21,0.08)', fg: 'rgba(20,25,21,0.68)' }
  : status === 'future' ? { text: opensLabel ? `Opens ${opensLabel}` : STATUS_WORDS.future, bg: 'rgba(14,140,100,0.12)', fg: '#0A6B4D' }
  : status === 'unconfirmed' ? { text: STATUS_WORDS.unconfirmed, bg: 'rgba(20,25,21,0.08)', fg: 'rgba(20,25,21,0.68)' }
  : status === 'ongoing' ? { text: STATUS_WORDS.none, bg: 'rgba(14,140,100,0.12)', fg: '#0A6B4D' }
  : status === 'tba' ? { text: STATUS_WORDS.unconfirmed, bg: 'rgba(20,25,21,0.08)', fg: 'rgba(20,25,21,0.68)' }
  : daysLeft === 0 ? { text: 'Due today', bg: '#A0491A', fg: '#FFFFFF' }
  : typeof daysLeft === 'number'
    ? { text: `${daysLeft} ${daysLeft === 1 ? 'day' : 'days'} left`, bg: urgent ? '#A0491A' : far ? 'rgba(20,25,21,0.05)' : 'rgba(160,73,26,0.12)', fg: urgent ? '#FFFFFF' : far ? 'rgba(20,25,21,0.65)' : '#A0491A' }
    : { text: 'Open', bg: 'rgba(14,140,100,0.12)', fg: '#0A6B4D' };
---

<div class="sabd-crumb-row">
  <a href={backHref} class="sabd-mono sabd-back">← {backLabel}</a>
  {facetHref && facetLabel && (
    <a href={facetHref} class="sabd-mono sabd-back sabd-facet">{facetLabel}</a>
  )}
  {/*
    Empty until the client can say which list these arrows walk. There is no
    server-side answer: the build order of the JSON is not a list any reader
    has seen, and a position in it is a claim about nothing. See
    lib/list-context.ts.
  */}
  <div class="sabd-mono sabd-switcher" data-sabd-switcher hidden>
    <span class="sabd-position" data-sabd-position></span>
    <a href="" class="sabd-arrow" data-sabd-prev aria-label="Previous listing">‹</a>
    <a href="" class="sabd-arrow" data-sabd-next aria-label="Next listing">›</a>
  </div>
</div>

<div class="sabd-title-block" data-detail-view data-item-type={itemType} data-item-id={itemId}>
  <div class="sabd-chips">
    {/* Status only. The type and topic pills restated the breadcrumb and
        read as template tags over the title (critique 2026-09-23). */}
    <span
      class="sabd-mono sabd-chip"
      style={`background:${chip.bg};color:${chip.fg};`}
      data-status-chip
      data-deadline={deadlineIso ?? undefined}
      data-open-date={openDateIso ?? undefined}
      data-inactive={inactive ? '' : undefined}
      data-estimated={estimated ? '' : undefined}
    >{chip.text}</span>
  </div>
  <h1 class="sabd-h1">
    {name}
  </h1>
  <div class="sabd-subline">{subline}</div>
</div>

<div class="sabd-grid">

  {/* First in the source, as it is first on a phone screen: the page used
      CSS order to lift it, so a screen reader and the Tab key reached the
      amount, deadline and Apply after all the prose (critique 2026-09-23). */}
  <section class="sabd-card" aria-labelledby="sabd-card-h">
    <h2 id="sabd-card-h" class="sr-only">Amount and deadline</h2>
    <div class="sabd-mono sabd-fact-label">{valueLabel}</div>
    {/* Green is money you receive. A cost in the same green read as a prize. */}
    <div class:list={['sabd-value', { 'is-cost': valueLabel === 'PROGRAM COST', 'is-quiet': valueQuiet }]}>{valueBig}</div>
    {valueNote && <div class="sabd-value-note">{valueNote}</div>}
    <div class="sabd-deadline-row">
      <span class="sabd-mono sabd-deadline-label">DEADLINE</span>
      <span class="sabd-deadline-value">{estimated ? `Around ${dueLong}` : dueLong}</span>
    </div>
    {/* Beside the deadline, at reading size: the check is what the site is
        for, and at the foot of the card in 12.5px grey nobody saw it. */}
    {checkedLabel && (
      <p class="sabd-checked">Checked against the provider's page in {checkedLabel}.</p>
    )}
    {status === 'closed' && (
      <p class="sabd-estimate-note">{opensLabel
        ? `This cycle is over. The next one opens ${opensLabel}.`
        : "This cycle is over and the provider hasn't posted the next one. Save it to find it again."}</p>
    )}
    {estimated && (
      <p class="sabd-estimate-note">Last year's date. The provider hasn't posted this year's yet, so check their page before you plan around it.</p>
    )}
    <div class="sabd-cta-row">
      {status === 'closed' ? (
        <span class="sab-btn sabd-cta sabd-cta-disabled">Closed</span>
      ) : status === 'future' ? (
        <span class="sab-btn sabd-cta sabd-cta-disabled">{opensLabel ? `Opens ${opensLabel}` : STATUS_WORDS.future}</span>
      ) : (
        <a href={url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
          data-track="apply" data-item-type={itemType} data-item-id={itemId}
          class="sab-btn sabd-cta">{status === 'unconfirmed' ? 'Check the provider' : ctaLabel}<span class="sabl-ext" aria-hidden="true">↗</span></a>
      )}
      <button data-sabd-save data-bookmark-type={itemType} data-bookmark-id={itemId}
        class="sabd-save" title="Save" aria-label={`Save: ${name}`} data-save-name={name} aria-pressed="false"><Fragment set:html={BOOKMARK} /></button>
    </div>
    {/* Only when the button above is a dead label. For TBA and ongoing
        listings the button already goes to this same URL, and a second
        link to it under a different name read as a second destination. */}
    {(status === 'closed' || status === 'future') && url && (
      <a href={url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
        data-track="apply" data-item-type={itemType} data-item-id={itemId}
        class="sabd-visit">Visit the official site<span class="sabl-ext" aria-hidden="true">↗</span></a>
    )}
    <button data-sabd-copy data-copy-url={canonical} class="sabd-copy">Copy link</button>
  </section>

  <!-- left column -->
  <div class="sabd-left">

    {facts.length > 0 && (
      <div class="sabd-facts">
        {facts.map(f => (
          <div class="sabd-fact">
            <div class="sabd-mono sabd-fact-label">{f.label}</div>
            <div class="sabd-fact-value">{f.value}</div>
          </div>
        ))}
      </div>
    )}

    {eligibility && (
      <div class="sabd-elig">
        <h2 class="sabd-h2 sabd-h2-elig">Who can apply</h2>
        <div class="sabd-elig-text" set:html={emailOff(eligibility)} />
      </div>
    )}

    {about && (
      <div>
        <h2 class="sabd-h2">About this {typeLabel.toLowerCase()}</h2>
        <div class="sabd-about">
          <p set:html={aboutHtml} />
        </div>
      </div>
    )}

    {/* The notes are the part no other list has: the catch, the trick, the
        thing the sponsor's page buries. They get the ruled paper from the
        founder's letter on /about, so the one voice that is ours reads as
        ours wherever it appears; the words are in the body face so the
        condition that decides eligibility is easy to read. No signature: a note is
        the site's, not a personal promise from one person. */}
    {notes && (
      <div class="sabd-note">
        <h2 class="sabd-h2">Worth knowing</h2>
        <div class="sabd-paper"><p set:html={notesHtml} /></div>
      </div>
    )}

    {steps.length > 0 && (
      <div>
        <h2 class="sabd-h2">How to apply</h2>
        <div class="sabd-steps">
          {steps.map((text, i) => (
            <div class="sabd-step">
              <span class="sabd-step-n">{i + 1}</span>
              <span class="sabd-step-text">{text}</span>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- right rail -->
  <div class="sabd-rail">
    {guideHref && guideTitle && (
      <a href={guideHref} class="sabd-guide">
        <span class="sabd-guide-label">Read the guide</span>
        <span class="sabd-guide-title">{guideTitle} →</span>
      </a>
    )}

    {canRemind && (
      <div class="sabd-remind">
        <h2 class="sabd-remind-label">Email me before it closes</h2>
        <div class="sabd-remind-sub">We send one link to confirm, then a reminder 30, 14 and 3 days before the deadline.</div>
        <form data-sabd-alert-form data-item-type={itemType} data-item-id={itemId} class="sabd-remind-form" novalidate>
          <label for={`sabd-remind-${itemType}-${itemId}`} class="sr-only">Your email for a deadline reminder</label>
          <input id={`sabd-remind-${itemType}-${itemId}`} type="email" name="email" required autocomplete="email" placeholder="your@email.com" class="sabd-remind-input" />
          <button type="submit" class="sab-btn sabd-remind-btn">Remind me</button>
        </form>
        <div data-sabd-alert-msg class="sabd-remind-msg" role="status" aria-live="polite" style="display:none;"></div>
        <div class="sabd-remind-fine">
          We store your address only to send these reminders, and delete it the
          moment you unsubscribe. <a href="/privacy/">How this works</a>.
        </div>
      </div>
    )}
  </div>

</div>

<style>
  .sabd-mono { font-family: var(--font-label); }

  .sabd-guide {
    display: block; margin-top: 16px; padding: 18px 20px;
    border: 1px solid rgba(20,25,21,0.14); border-radius: 4px;
    background: var(--bg-page); text-decoration: none; box-sizing: border-box;
  }
  .sabd-guide:hover { border-color: #0E8C64; }

  /* Collection notice, sits under the sign-up form. Deliberately quiet but
     always present: the address is the only personal data the site takes, and
     the moment to say what happens to it is the moment it is asked for. */
  /* On the #141915 block, #6B716C measured 3.56:1. Paper at 0.55 is 5.48:1
     and still sits below the sub above it, which is paper at 0.65. */
  .sabd-remind-fine { margin-top: 10px; font-size: 12.5px; line-height: 1.55; color: rgba(20, 25, 21, 0.72); }
  /* This was the same colour as the sentence around it with no underline, so
     the one route from the reminder form to the privacy page was invisible. */
  .sabd-remind-fine a { color: #0A6B4D; text-decoration: underline; text-underline-offset: 2px; }
  .sabd-guide-label { display: block; font-size: 13.5px; font-weight: 600; color: rgba(20, 25, 21, 0.72); }
  .sabd-guide-title {
    display: block; margin-top: 6px; font-family: var(--font-display);
    font-size: 19px; line-height: 1.25; color: #141915;
  }

  .sabd-crumb-row {
    padding: 40px var(--sab-gutter) 0;
    display: flex; justify-content: space-between; align-items: center; box-sizing: border-box;
  }
  /* 12px of padding cancelled by margin: the text sits where it did, the tap
     target grows from 20px to 44px. */
  .sabd-back { font-size: 13px; letter-spacing: 0.04em; color: rgba(20, 25, 21, 0.65); text-decoration: none; display: inline-block; padding: 12px 0; margin: -12px 0; }
  .sabd-back:hover { color: #0A6B4D; }
  /* The facet crumb sits beside the back link with a separator drawn in CSS, so
     the two read as one trail rather than two competing back-buttons. */
  .sabd-facet::before { content: '/'; margin-right: 8px; opacity: 0.45; }
  /* The auto margin keeps the crumb beside the back link. Without it
     space-between threw it to the far edge, a stray "/ Calgary" on its own. */
  .sabd-facet { margin-left: 8px; margin-right: auto; }
  .sabd-switcher { display: flex; align-items: center; gap: 14px; font-size: 12px; letter-spacing: 0.05em; color: rgba(20, 25, 21, 0.68); }
  .sabd-arrow {
    font-size: 13px; border: 1.5px solid rgba(20,25,21,0.3); color: #141915;
    border-radius: 100px; width: 30px; height: 30px; text-decoration: none;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .sabd-arrow:hover { border-color: #141915; color: #141915; }

  .sabd-title-block { padding: 36px var(--sab-gutter) 0; box-sizing: border-box; }
  .sabd-chips { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sabd-chip { font-family: var(--font-body); font-size: 13px; font-weight: 700; padding: 5px 12px; border-radius: 100px; }
  .sabd-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(38px, 6vw, 64px); line-height: 1.05; letter-spacing: -0.015em;
    margin: 22px 0 0; max-width: 820px;
  }
  .sabd-subline { font-size: 15px; color: rgba(20, 25, 21, 0.75); margin-top: 12px; }

  .sabd-grid {
    padding: 44px var(--sab-gutter) 96px; box-sizing: border-box;
    display: grid; grid-template-columns: 1fr 360px; grid-template-rows: auto 1fr; gap: 16px 40px; align-items: start;
  }
  /* Source order is card, prose, rail; the desktop puts the card and rail in
     the right column and lets the prose span both rows. */
  .sabd-card { grid-column: 2; grid-row: 1; }
  .sabd-left { grid-column: 1; grid-row: 1 / span 2; }
  .sabd-left { display: flex; flex-direction: column; gap: 36px; min-width: 0; }

  /* auto-fit rather than a hard 2 columns: with three facts, repeat(2, 1fr)
     left one alone on its own row with a border running past nothing. */
  .sabd-facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    border-top: 2px solid #141915;
  }
  .sabd-fact { padding: 20px 24px 20px 0; border-bottom: 1px solid rgba(20,25,21,0.14); }
  .sabd-fact-label { font-size: 11.5px; letter-spacing: 0.06em; color: rgba(20, 25, 21, 0.68); margin-bottom: 8px; }
  .sabd-fact-value { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }

  .sabd-elig { background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 16px; padding: 28px 30px; }
  /* Section heads in the directory's own group-heading voice (OPEN NOW,
     CLOSING SOON): real h2s, so a screen reader can walk the page by
     section, where these used to be 12px grey mono labels in divs. */
  /* Sentence-case display headings, not an uppercase label voice
     (critique 2026-09-23: the overline habit was the loudest tell left). */
  .sabd-h2 {
    font-family: var(--font-display); font-size: 30px; font-weight: 400;
    letter-spacing: -0.01em; line-height: 1.1;
    color: #141915; margin: 0 0 14px;
  }
  .sabd-h2-elig { color: #0A6B4D; }
  .sabd-elig-text { font-size: 16.5px; line-height: 1.6; }

  /* Ruled paper drawn in CSS rather than the /about scan, which is sized for
     an 880px sheet: blue rules one line apart, the red margin, and text set
     on the rules. Line height IS the rule pitch, and the top padding is one
     pitch, so every line box ends on a rule at any width.
     The words are in the body face, not the handwriting: these notes carry
     the condition that decides eligibility (residency, nomination, must be
     enrolled), and the least legible face on the page was holding the most
     important sentence (critique 2026-09-23). The paper stays; it is what
     marks the note as ours. The 6px shift sets each baseline just above its
     rule rather than floating mid-line. */
  .sabd-paper {
    --pitch: 32px;
    max-width: 640px; box-sizing: border-box;
    padding: calc(var(--pitch) + 6px) 24px calc(var(--pitch) - 6px) 56px;
    background:
      linear-gradient(to right, transparent 40px, rgba(206,72,72,0.5) 40px, rgba(206,72,72,0.5) 41.5px, transparent 41.5px),
      repeating-linear-gradient(to bottom, transparent 0, transparent calc(var(--pitch) - 1px), rgba(64,120,196,0.3) calc(var(--pitch) - 1px), rgba(64,120,196,0.3) var(--pitch));
    background-color: #F7F9FA;
    box-shadow: 0 1px 2px rgba(20,25,21,0.08), 0 10px 30px rgba(20,25,21,0.10);
    font-family: var(--font-body);
    font-size: 17px; line-height: var(--pitch); color: #1F2A44;
  }
  .sabd-paper p { margin: 0; }
  .sabd-paper a { color: inherit; text-decoration-color: rgba(31,42,68,0.45); text-underline-offset: 3px; }
  @media (max-width: 640px) {
    .sabd-paper { --pitch: 30px; font-size: 16px; padding-left: 46px; padding-right: 16px; }
    .sabd-paper { background:
      linear-gradient(to right, transparent 32px, rgba(206,72,72,0.5) 32px, rgba(206,72,72,0.5) 33.5px, transparent 33.5px),
      repeating-linear-gradient(to bottom, transparent 0, transparent calc(var(--pitch) - 1px), rgba(64,120,196,0.3) calc(var(--pitch) - 1px), rgba(64,120,196,0.3) var(--pitch));
      background-color: #F7F9FA; }
  }
  .sabd-about { font-size: 16.5px; line-height: 1.65; color: rgba(20, 25, 21, 0.78); max-width: 640px; }
  .sabd-about p { margin: 0; }
  .sabd-about p + p { margin-top: 12px; }

  .sabd-steps { display: flex; flex-direction: column; border-top: 1px solid rgba(20,25,21,0.14); max-width: 640px; }
  .sabd-step { display: flex; gap: 18px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid rgba(20,25,21,0.14); }
  .sabd-step-n { font-family: var(--font-display); font-size: 24px; color: #0A6B4D; flex: none; width: 28px; }
  .sabd-step-text { font-size: 15.5px; line-height: 1.55; color: rgba(20, 25, 21, 0.8); }

  .sabd-rail { grid-column: 2; grid-row: 2; display: flex; flex-direction: column; gap: 16px; }
  .sabd-card {
    background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 16px;
    padding: 28px 26px;
  }
  .sabd-value { font-family: var(--font-display); font-size: 52px; line-height: 1.05; color: #0A6B4D; margin: 8px 0 4px; }
  .sabd-value.is-cost { color: #141915; }
  .sabd-value.is-quiet { font-family: var(--font-body); font-size: 20px; font-weight: 700; line-height: 1.3; margin: 6px 0 2px; }
  .sabd-value-note { font-size: 14px; color: rgba(20, 25, 21, 0.65); }
  /* space-between with no gap only looked safe because the rail was 360px
     wide. In the phone's single column the label and the date met in the
     middle and read as one word. */
  .sabd-deadline-row {
    display: flex; justify-content: space-between; align-items: center; gap: 14px;
    margin: 22px 0 0; padding-top: 18px; border-top: 1px solid rgba(20,25,21,0.12);
  }
  .sabd-deadline-label { font-size: 12px; color: rgba(20, 25, 21, 0.68); }
  .sabd-deadline-value { font-size: 15px; font-weight: 700; }
  .sabd-checked { margin: 10px 0 0; font-size: 14.5px; line-height: 1.45; color: rgba(20, 25, 21, 0.8); }
  .sabd-estimate-note { margin: 10px 0 0; font-size: 13.5px; line-height: 1.45; color: rgba(20, 25, 21, 0.72); }
  .sabd-cta-row { display: flex; gap: 10px; margin-top: 22px; }
  .sabd-cta {
    flex: 1; text-align: center; font-size: 15.5px; font-weight: 700;
    background: #0A6B4D; color: #F5FBF8; padding: 15px 0; border-radius: 100px; text-decoration: none;
  }
  .sabd-cta:hover { background: #08573E; color: #F5FBF8; }
  .sabd-cta-disabled { background: rgba(20,25,21,0.08); color: rgba(20, 25, 21, 0.68); cursor: not-allowed; }
  .sabd-cta-disabled:hover { background: rgba(20,25,21,0.08); color: rgba(20, 25, 21, 0.68); }
  .sabd-save {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-body); font-size: 17px; border: 1.5px solid rgba(20,25,21,0.3);
    border-radius: 100px; width: 50px; height: 50px; cursor: pointer;
    color: rgba(20, 25, 21, 0.68); background: transparent; flex: none;
  }
  .sabd-save:hover { border-color: #141915; }
  .sabd-save[data-saved] { color: #0A6B4D; background: rgba(47,211,160,0.15); }
  /* :global because the icon arrives through set:html and carries no scope id. */
  .sabd-save :global(svg) { width: 16px; height: 18px; fill: none; }
  .sabd-save[data-saved] :global(svg) { fill: currentColor; }
  /* Official-site link shown when the CTA pill is Closed/Opens-soon, so the
     source page stays reachable for every listing. */
  .sabd-visit {
    display: block; text-align: center; text-decoration: none;
    font-size: 14px; font-weight: 600; width: 100%; margin-top: 12px;
    border: 1.5px solid rgba(20,25,21,0.25); border-radius: 100px;
    padding: 11px 0; color: rgba(20, 25, 21, 0.78);
  }
  .sabd-visit:hover { border-color: #0E8C64; color: #0A6B4D; }
  .sabd-copy {
    font-family: var(--font-body); font-size: 14px; font-weight: 600; width: 100%; margin-top: 12px;
    background: transparent; border: 1.5px solid rgba(20,25,21,0.25); border-radius: 100px;
    padding: 11px 0; cursor: pointer; color: rgba(20, 25, 21, 0.78);
  }
  .sabd-copy:hover { border-color: #141915; color: #141915; }

  /* A light inline form under the card, not a dark newsletter box
     (critique 2026-09-23). */
  .sabd-remind { border-top: 1px solid rgba(20,25,21,0.14); padding: 18px 2px 0; color: var(--text-primary); }
  .sabd-remind-label { font-family: var(--font-body); font-size: 16px; font-weight: 700; margin: 0 0 4px; }
  .sabd-remind-sub { font-size: 14px; line-height: 1.5; color: rgba(20, 25, 21, 0.75); margin-bottom: 12px; }
  .sabd-remind-form { display: flex; gap: 8px; }
  .sabd-remind-input {
    font-family: var(--font-body); font-size: 14px; flex: 1; min-width: 0;
    background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.3);
    border-radius: 100px; padding: 11px 16px; color: var(--text-primary);
  }
  /* Bare `outline: none` here outranked the global :focus-visible rule, so the
     reminder field had no focus indicator on any of the detail pages. Keeping
     the outline off for mouse focus, where the border is enough, and putting
     the ring back for keyboard focus. */
  .sabd-remind-input:focus { outline: none; }
  .sabd-remind-input:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .sabd-remind-input::placeholder { color: rgba(20, 25, 21, 0.55); }
  .sabd-remind-btn {
    font-family: var(--font-body); font-size: 13.5px; font-weight: 700;
    background: #0A6B4D; color: #F5FBF8; border: none; border-radius: 100px;
    padding: 11px 18px; cursor: pointer; flex: none;
  }
  .sabd-remind-btn:hover { background: #08573E; }
  .sabd-remind-btn:disabled { opacity: 0.6; cursor: default; }
  .sabd-remind-msg { font-size: 14.5px; font-weight: 600; color: #0A6B4D; }

  @media (max-width: 900px) {
    .sabd-crumb-row { padding: 28px 20px 0; }
    .sabd-title-block { padding: 28px 20px 0; }
    /* The rail is a sidebar on a desktop, so the amount, the deadline and the
       Apply button are beside the first line of prose. Stacked, it landed at
       967px on an 812px screen: a reader had to scroll past the eligibility
       box, the description and all three how-to-apply steps to find out what
       the award is worth, when it closes, or where to apply.

       The card is first in the source now, so the stack is just source
       order: card, prose, then the guide link and reminder form, which read
       better after the description. display:contents lets the rail's two
       blocks take the column's gap. */
    /* align-items:start is inherited from the desktop grid, where it stops the
       rail stretching to the tallest row. On a flex column that is the cross
       axis, so it sized every block to its own content and left the card at
       257px in a 335px measure. */
    .sabd-grid { display: flex; flex-direction: column; align-items: stretch; gap: 32px; padding: 32px 20px 72px; }
    .sabd-rail { display: contents; }
    .sabd-facts { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { todayDate } from '../../lib/calendar';
  import { sendEvent, sendEventAfterDwell } from '../../lib/events.ts';
  import { getSaved, toggleSaved, getSavedPrograms, toggleSavedProgram } from '../../lib/tracker';
  import { showToast, showConfetti, prefersReducedMotion } from '../../lib/utils';
  import { URGENT_DAYS, SOON_DAYS } from '../../lib/list-core';
  import { STATUS_WORDS } from '../../lib/status';
  import { placeInList, readListContext } from '../../lib/list-context.ts';

  /** Point the ‹ › arrows at the list the reader came from, or leave them off. */
  function restoreSwitcher() {
    const box = document.querySelector<HTMLElement>('[data-sabd-switcher]');
    if (!box) return;
    const place = placeInList(readListContext(), location.pathname);
    if (!place) { box.hidden = true; return; }

    box.querySelector('[data-sabd-position]')!.textContent = place.label;
    const prev = box.querySelector<HTMLAnchorElement>('[data-sabd-prev]')!;
    const next = box.querySelector<HTMLAnchorElement>('[data-sabd-next]')!;
    prev.href = place.prev;
    next.href = place.next;
    prev.setAttribute('aria-label', `Previous listing (${place.index} of ${place.total})`);
    next.setAttribute('aria-label', `Next listing (${((place.index + 1) % place.total) + 1} of ${place.total})`);
    box.hidden = false;
  }

  function itemAttrs(el: Element): ['scholarship' | 'program' | undefined, number | undefined] {
    const type = el.getAttribute('data-item-type');
    const id = Number(el.getAttribute('data-item-id'));
    return [
      type === 'scholarship' || type === 'program' ? type : undefined,
      Number.isInteger(id) ? id : undefined,
    ];
  }

  function applySaveState(btn: HTMLElement, saved: boolean) {
    // The drawn bookmark from the directories; [data-saved] fills it.
    if (saved) btn.setAttribute('data-saved', '');
    else btn.removeAttribute('data-saved');
    btn.setAttribute('aria-label', `${saved ? 'Remove from saved' : 'Save'}: ${btn.dataset.saveName ?? ''}`);
    btn.setAttribute('aria-pressed', String(saved));
  }

  // Delegated so everything survives view-transition swaps between detail pages
  document.addEventListener('click', (e) => {
    const target = e.target as Element;

    // Scoped to this page's CTA card. The directory's cards use the same
    // data-track="apply" hook, and this listener outlives view transitions;
    // unscoped, it fired a second, type-less apply_click on every directory
    // click made after any detail page had been opened in the tab.
    const apply = target.closest?.('[data-track="apply"]');
    if (apply?.closest('.sabd-card')) {
      const [applyType, applyId] = itemAttrs(apply);
      if (applyType && applyId) sendEvent('apply_click', applyType, applyId);
    }

    const save = target.closest?.('[data-sabd-save]') as HTMLElement | null;
    if (save) {
      const id = parseInt(save.dataset.bookmarkId!);
      const type = save.dataset.bookmarkType as 'scholarship' | 'program';
      if (!prefersReducedMotion()) save.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.4)' }, { transform: 'scale(0.9)' }, { transform: 'scale(1.05)' }, { transform: 'scale(1)' }],
        { duration: 380, easing: 'ease-out' }
      );
      const next = type === 'program' ? toggleSavedProgram(id) : toggleSaved(id);
      const nowSaved = next.includes(id);
      applySaveState(save, nowSaved);
      // Saves count, un-saves don't; the metric is "people who shortlisted it"
      if (nowSaved) { showConfetti(save); sendEvent('save', type, id); }
      showToast(nowSaved ? 'Saved ✓' : 'Removed from saved');
    }

    const copy = target.closest?.('[data-sabd-copy]') as HTMLElement | null;
    if (copy) {
      navigator.clipboard.writeText(copy.dataset.copyUrl || window.location.href).then(() => {
        copy.textContent = 'Link copied';
        setTimeout(() => { copy.textContent = 'Copy link'; }, 2000);
      });
    }
  });

  // Capture phase + stopPropagation so Astro's ClientRouter (which also
  // listens for submit and would swap the page) never handles this form.
  document.addEventListener('submit', async (e) => {
    const form = (e.target as Element).closest?.('[data-sabd-alert-form]') as HTMLFormElement | null;
    if (!form) return;
    e.preventDefault();
    e.stopPropagation();
    const [itemType, itemId] = itemAttrs(form);
    const email = (form.querySelector('input[name="email"]') as HTMLInputElement).value.trim();
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = form.parentElement?.querySelector('[data-sabd-alert-msg]') as HTMLElement | null;
    // One voice for every bad address. `novalidate` turns off the browser's
    // bubbles, which used to appear on top of this message for some inputs and
    // instead of it for others. Same test as /api/alert.
    const problem = !email ? 'Type your email address first.'
      : !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? "That address is missing something. It should look like name@gmail.com."
      : null;
    if (problem) {
      if (msg) { msg.textContent = problem; msg.style.color = 'rgba(238, 241, 236,0.65)'; msg.style.display = 'block'; }
      (form.querySelector('input[name="email"]') as HTMLInputElement).focus();
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/alert', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, itemType, itemId }),
      });
      const data = await res.json() as { error?: string; confirmed?: boolean };
      if (res.ok) {
        form.style.display = 'none';
        // Double opt-in: a new sign-up is not on the list until they click the
        // link, so saying "we'll nudge you" here would promise mail that never
        // arrives. `confirmed` is true only when this address was already on
        // file for this listing; a returning student changing their mind.
        if (msg) {
          msg.textContent = 'Request received. If confirmation is needed, check your inbox. Existing reminders stay unchanged.' ;
          msg.style.display = 'block';
        }
      } else {
        btn.disabled = false;
        btn.textContent = 'Remind me';
        if (msg) { msg.textContent = data.error || 'Something went wrong.'; msg.style.color = 'rgba(238, 241, 236,0.65)'; msg.style.display = 'block'; }
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Remind me';
      if (msg) { msg.textContent = 'Something went wrong. Try again.'; msg.style.color = 'rgba(238, 241, 236,0.65)'; msg.style.display = 'block'; }
    }
  }, true);

  // The page is prerendered, so the SSR status chip is only as fresh as the
  // last build. Re-derive it from the ISO dates in the visitor's timezone
  // (mirrors getScholarshipStatus / scholarshipDayChip in list-core).
  function refreshStatusChip() {
    const el = document.querySelector<HTMLElement>('[data-status-chip]');
    if (!el) return;
    const { deadline, openDate } = el.dataset;
    const inactive = el.dataset.inactive !== undefined;
    if (!deadline && !openDate && !inactive) return; // tba/ongoing: not clock-driven

    const today = todayDate();
    const todayMs = today.getTime();
    const paint = (text: string, bg: string, fg: string) => {
      el.textContent = text;
      el.style.background = bg;
      el.style.color = fg;
    };
    const fmtLong = (iso: string) =>
      new Date(iso + 'T00:00:00')
        .toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });

    const pastDeadline = !!deadline && todayMs > new Date(deadline + 'T00:00:00').getTime();
    // Same ladder as status.ts: an estimate outranks a (rolled-forward) open date.
    if (el.dataset.estimated !== undefined && !pastDeadline) {
      paint(STATUS_WORDS.unconfirmed, 'rgba(20,25,21,0.08)', 'rgba(20,25,21,0.68)');
    } else if (openDate && todayMs < new Date(openDate + 'T00:00:00').getTime()) {
      paint(`Opens ${fmtLong(openDate)}`, 'rgba(14,140,100,0.12)', '#0A6B4D');
    } else if (deadline && todayMs > new Date(deadline + 'T00:00:00').getTime()) {
      paint(STATUS_WORDS.closed, 'rgba(20,25,21,0.08)', 'rgba(20,25,21,0.68)');
    } else if (inactive) {
      paint(STATUS_WORDS.future, 'rgba(14,140,100,0.12)', '#0A6B4D');
    } else if (deadline) {
      // round, not ceil: midnight-to-midnight is whole days except across a
      // DST change, where ceil overcounts by one (and disagrees with the list chips)
      const days = Math.max(0, Math.round((new Date(deadline + 'T00:00:00').getTime() - todayMs) / 86400000));
      if (days === 0) paint('Due today', '#A0491A', '#FFFFFF');
      else if (days <= URGENT_DAYS) paint(`${days} ${days === 1 ? 'day' : 'days'} left`, '#A0491A', '#FFFFFF');
      else if (days <= SOON_DAYS) paint(`${days} days left`, 'rgba(160,73,26,0.12)', '#A0491A');
      else paint(`${days} days left`, 'rgba(20,25,21,0.05)', 'rgba(20,25,21,0.65)');
    }
  }

  // Per-item views + initial save-state paint.
  // astro:page-load fires on first load and after every view-transition swap.
  document.addEventListener('astro:page-load', () => {
    refreshStatusChip();
    restoreSwitcher();
    const view = document.querySelector('[data-detail-view]');
    // Dwell-gated: an instant back/misclick shouldn't count as a view
    if (view) sendEventAfterDwell('detail_view', ...itemAttrs(view));

    document.querySelectorAll<HTMLElement>('[data-sabd-save]').forEach(btn => {
      const id = parseInt(btn.dataset.bookmarkId!);
      const type = btn.dataset.bookmarkType as 'scholarship' | 'program';
      const list = type === 'program' ? getSavedPrograms() : getSaved();
      applySaveState(btn, list.includes(id));
    });
  });
</script>
