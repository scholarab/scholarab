---
// Editorial detail page from the claude.ai/design "ScholarAB Detail" page,
// shared by scholarship and program slug pages.
// Deviations from the design (established site conventions):
// - SabHeader replaces the design's plain header; the mono
//   annotation bar stays removed per Ilia (2026-07-11).
// - The canvas "PREVIEWING X OF N" switcher is implemented as real prev/next
//   links between listings ("LISTING X OF N").
// - A "Checked against the provider's page in <month>" line under the CTA
//   (removed site-wide 2026-07-12, back 2026-09-22 after the design critique:
//   trust is the product, and the month is per listing, not a promised cycle).
// - Reminder copy names only the reminders still ahead (of 30/14/3 days out),
//   and gives way to a plain closing line once none can arrive.
// - Closed and opening-soon states added (the design only shows open listings).

import { emailOff } from '../../lib/email-off';
import { BOOKMARK } from '../../lib/icons';
import { URGENT_DAYS, SOON_DAYS } from '../../lib/list-core';
import { LIKELY_DATE, STATUS_WORDS } from '../../lib/status';
import { milestonesAhead, milestonePhrase, closesPhrase } from '../../lib/alerts';
import type { ToApply } from '../../lib/to-apply';
import { formatVerifiedMonth } from '../../lib/utils';

interface Fact {
  label: string;
  value: string;
}

interface Props {
  itemType: 'scholarship' | 'program';
  itemId: number;
  typeLabel: string; // 'SCHOLARSHIP' | 'PROGRAM'
  name: string;
  subline: string;
  status: 'active' | 'closed' | 'future' | 'unconfirmed' | 'ongoing' | 'tba';
  /** Curated availability cannot change when the browser clock advances. */
  availability?: 'ended' | 'unlisted' | null;
  daysLeft: number | null;
  // ISO dates for the client-side chip recompute: the page is prerendered, so
  // the SSR chip is only as fresh as the last build. null = not clock-driven.
  deadlineIso?: string | null;
  openDateIso?: string | null;
  inactive?: boolean; // curator-closed next-cycle listing (open date unknown)
  estimated?: boolean; // the deadline is last cycle's, rolled forward
  dueLong: string; // 'July 15, 2026' / 'No fixed deadline, join any time' / 'Not posted yet'
  opensLabel?: string | null; // formatted open date, for status 'future'
  backHref: string;
  backLabel: string;
  /** The facet hub this listing sits under, when it has one. */
  facetHref?: string | null;
  facetLabel?: string | null;
  facts: Fact[];
  /** Hard requirements ("88% average"), beside the deadline and above Apply. */
  needs?: string[];
  eligibility: string | null;
  about: string | null;
  notes?: string | null;
  /** Who takes the application, from lib/apply-method.ts; null when the listing doesn't say. */
  howApply?: string | null;
  steps: string[];
  /** What applying takes, from the provider's page. See lib/to-apply.ts. */
  toApply?: ToApply | null;
  valueLabel: string;
  valueBig: string;
  valueNote?: string | null;
  /** The value is a word, not a figure: set small rather than in money type. */
  valueQuiet?: boolean;
  /** 'Sep 2026' from lastVerified; null hides the line. */
  checkedLabel?: string | null;
  ctaLabel: string;
  url: string;
  canRemind: boolean;
  /** Link to the guide that explains this listing, when one covers it. */
  guideHref?: string;
  guideTitle?: string;
  /** Open listings to offer instead; set only on a closed page. */
  alternatives?: Array<{ href: string; title: string; value: string; when: string }>;
  alternativesHref?: string;
  /** Where to go after this one, with why; set only on a page that isn't closed. See lib/whats-next.ts. */
  next?: Array<{ href: string; title: string; value: string; when: string; why?: string }>;
}

const {
  itemType, itemId, typeLabel, name, subline,
  status: datedStatus, availability = null, daysLeft, deadlineIso, openDateIso, inactive, estimated = false, dueLong, opensLabel,
  backHref, backLabel, facetHref = null, facetLabel = null,
  facts, needs = [], eligibility, howApply = null, about, notes, steps, toApply = null,
  valueLabel, valueBig, valueNote, checkedLabel = null, valueQuiet = false,
  ctaLabel, url, canRemind, guideHref, guideTitle,
  alternatives = [], alternativesHref = backHref, next = [],
} = Astro.props;
const status = availability ?? datedStatus;
const toApplyMonth = toApply ? formatVerifiedMonth(toApply.checked) : null;

// The directory's three tiers (list-core), so a listing is the same colour on
// its own page as in the row that linked to it. This page used to go solid at 7.
const urgent = status === 'active' && typeof daysLeft === 'number' && daysLeft <= URGENT_DAYS;
const far = status === 'active' && typeof daysLeft === 'number' && daysLeft > SOON_DAYS;

// The reminder block's first paint; refreshRemind redoes it in the visitor's
// browser on load, because the page is prerendered.
const remindAhead = typeof daysLeft === 'number' ? milestonesAhead(daysLeft) : [];
const remindLate = canRemind && remindAhead.length === 0;
const lateWhen = remindLate && deadlineIso ? closesPhrase(daysLeft ?? 0, deadlineIso) : '';
const lateApply = ctaLabel === 'Apply';
// A posted deadline for a listing still to come: what "confirmed" means in
// status.ts. Closed, estimated and undated listings keep the plain check.
const dateConfirmed = !availability && !!deadlineIso && !estimated && (status === 'active' || status === 'future');

// The pinned Apply bar on a phone (critique 2026-10-02): the card's Apply sat
// at 688 to 743px, under the fold of a 667px screen, below the title, the
// provider, Who can apply and the amount. Only when the card's button is a
// link; a Closed or Opens-later label has nothing to pin.
const barCta = status !== 'closed' && status !== 'ended' && status !== 'future' && !!url;
const barLabel = status === 'unconfirmed' ? 'Check the provider' : ctaLabel;
const barDue = !availability && deadlineIso
  ? `${estimated ? 'Around ' : 'Due '}${new Date(deadlineIso + 'T00:00:00').toLocaleDateString('en-CA', { month: 'short', day: 'numeric' })}`
  : '';

// Listing prose can carry a provider's own address ("apply to x@y.ca"), so it
// is bracketed for Cloudflare's obfuscator. See src/lib/email-off.ts.
const aboutHtml = about ? emailOff(about) : '';
const notesHtml = notes ? emailOff(notes) : '';

// Coloured words, not a filled pill (flow plan, 2026-10-02): the tone says
// how close it is, and the client repaints it from the same ladder.
type Tone = 'quiet' | 'go' | 'soon' | 'urgent';
const chip: { text: string; tone: Tone } =
  status === 'ended' || status === 'unlisted' ? { text: status === 'ended' ? 'Ended' : 'Not currently listed', tone: 'quiet' }
  : status === 'closed' ? { text: STATUS_WORDS.closed, tone: 'quiet' }
  : status === 'future' ? { text: opensLabel ? `Opens ${opensLabel}` : STATUS_WORDS.future, tone: 'go' }
  : status === 'unconfirmed' && estimated && deadlineIso ? { text: LIKELY_DATE, tone: 'quiet' }
  : status === 'unconfirmed' || status === 'tba' ? { text: STATUS_WORDS.unconfirmed, tone: 'quiet' }
  : status === 'ongoing' ? { text: STATUS_WORDS.open, tone: 'go' }
  : daysLeft === 0 ? { text: 'Due today', tone: 'urgent' }
  : typeof daysLeft === 'number'
    ? { text: `${daysLeft} ${daysLeft === 1 ? 'day' : 'days'} left`, tone: urgent ? 'urgent' : far ? 'quiet' : 'soon' }
    : { text: 'Open', tone: 'go' };
---

<div class="sabd-crumb-row" data-listing-page>
  <a href={backHref} class="sabd-mono sabd-back">← {backLabel}</a>
  {facetHref && facetLabel && (
    <a href={facetHref} class="sabd-mono sabd-back sabd-facet">{facetLabel}</a>
  )}
  {/*
    Empty until the client can say which list these arrows walk. There is no
    server-side answer: the build order of the JSON is not a list any reader
    has seen, and a position in it is a claim about nothing. See
    lib/list-context.ts.
  */}
  <div class="sabd-mono sabd-switcher" data-sabd-switcher hidden>
    <span class="sabd-position" data-sabd-position></span>
    <a href="" class="sabd-arrow" data-sabd-prev aria-label="Previous listing">‹</a>
    <a href="" class="sabd-arrow" data-sabd-next aria-label="Next listing">›</a>
  </div>
</div>

<div class="sabd-title-block" data-detail-view data-item-type={itemType} data-item-id={itemId}>
  <div class="sabd-chips">
    {/* Status only. The type and topic pills restated the breadcrumb and
        read as template tags over the title (critique 2026-09-23). */}
    <span
      class="sabd-mono sabd-chip"
      data-tone={chip.tone}
      data-status-chip
      data-availability={availability ?? undefined}
      data-deadline={!availability ? deadlineIso ?? undefined : undefined}
      data-open-date={!availability ? openDateIso ?? undefined : undefined}
      data-inactive={!availability && inactive ? '' : undefined}
      data-estimated={!availability && estimated ? '' : undefined}
    >{chip.text}</span>
  </div>
  <h1 class="sabd-h1">
    {name}
  </h1>
  <div class="sabd-subline">{subline}</div>
  {/* Under the title on every screen: eligibility is the first of the three
      things a student decides on, and the box that held it sat 890px down on
      a 375px phone (critique 2026-09-27). Desktop followed on 2026-10-01, when
      What you'll need took the top of the left column. */}
  {eligibility && (
    <p class="sabd-who"><span class="sabd-who-label">Who can apply:</span> <span set:html={emailOff(eligibility)} /></p>
  )}
  {/* The second question, "what does it take?", answered beside the first.
      It used to be one grey sentence under the amount, and it said "through
      your school" for clubs, nominations and campus offices alike. */}
  {howApply && (
    <p class="sabd-who sabd-how"><span class="sabd-who-label">How you apply:</span> {howApply}</p>
  )}
</div>

<div class="sabd-grid">

  {/* First in the source, as it is first on a phone screen: the page used
      CSS order to lift it, so a screen reader and the Tab key reached the
      amount, deadline and Apply after all the prose (critique 2026-09-23). */}
  <section class="sabd-card" aria-labelledby="sabd-card-h">
    <h2 id="sabd-card-h" class="sr-only">{itemType === 'program' ? 'Cost and deadline' : 'Amount and deadline'}</h2>
    <div class="sabd-card-label">{valueLabel}</div>
    {/* Green is money you receive. A cost in the same green read as a prize. */}
    <div class:list={['sabd-value', { 'is-cost': itemType === 'program', 'is-quiet': valueQuiet }]}>{valueBig}</div>
    {valueNote && <div class="sabd-value-note">{valueNote}</div>}
    {!availability && <div class="sabd-deadline-row">
      <span class="sabd-card-label">Deadline</span>
      <span class="sabd-deadline-value">{estimated ? `Around ${dueLong}` : dueLong}</span>
    </div>}
    {/* Under the date it vouches for. The check is what the site is for (the
        moat in PRODUCT.md), and as 14px grey under the requirements it was the
        quietest line on the page (critique 2026-10-02). A posted, dated
        deadline says so; anything else keeps the plain check. */}
    {checkedLabel && (
      <p class:list={['sabd-checked', { 'is-confirmed': dateConfirmed }]}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">{dateConfirmed
          ? <><circle cx="8" cy="8" r="8" fill="currentColor" /><path d="M4.6 8.3 7 10.6l4.4-5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></>
          : <circle cx="8" cy="8" r="6.75" fill="none" stroke="currentColor" stroke-width="1.5" />}</svg>
        <span>{dateConfirmed ? `Date confirmed on the provider's page, ${checkedLabel}.` : `Checked against the provider's page in ${checkedLabel}.`}</span>
      </p>
    )}
    {/* The bar a student has to clear, above the button: on a phone Apply
        came before Who can apply, and Loran's 88% sat in the About prose
        (critique 2026-09-26). */}
    {needs.length > 0 && (
      <div class="sabd-deadline-row sabd-needs-row">
        <span class="sabd-card-label">Needs</span>
        <span class="sabd-needs-value">{needs.join(' · ')}</span>
      </div>
    )}
    {status === 'ended' && <p class="sabd-estimate-note">This scholarship has ended.</p>}
    {status === 'closed' && (
      <p class="sabd-estimate-note">{opensLabel
        ? `This cycle is over. The next one opens ${opensLabel}.`
        : "This cycle is over and the provider hasn't posted the next one. Save it to find it again."}</p>
    )}
    {/* A closed page is never a dead end: three open listings from the same
        hub, inside the card so they are on the first screen. */}
    {(status === 'closed' || status === 'ended') && alternatives.length > 0 && (
      <nav class="sabd-alts" aria-labelledby="sabd-alts-h">
        <h3 id="sabd-alts-h" class="sabd-alts-h">Open now instead</h3>
        <ul>
          {alternatives.map(a => (
            <li><a href={a.href} class="sabd-alt">
              <span class="sabd-alt-name">{a.title}</span>
              <span class="sabd-alt-meta tnum">{a.value} · {a.when}</span>
            </a></li>
          ))}
        </ul>
        <a href={`${alternativesHref}?status=active`} class="sabd-alts-all">See all open</a>
      </nav>
    )}
    {!availability && estimated && (
      <p class="sabd-estimate-note">Last year's date. The provider hasn't posted this year's yet, so check their page before you plan around it.</p>
    )}
    <div class:list={['sabd-cta-row', status === 'future' && 'sabd-cta-row-later']}>
      {status === 'closed' || status === 'ended' ? (
        <span class="sab-btn sabd-cta sabd-cta-disabled">{status === 'ended' ? 'Ended' : 'Closed'}</span>
      ) : status === 'future' ? (
        <span class="sab-btn sabd-cta sabd-cta-disabled">{opensLabel ? `Opens ${opensLabel}` : STATUS_WORDS.future}</span>
      ) : (
        <a href={url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
          data-track="apply" data-item-type={itemType} data-item-id={itemId}
          class="sab-btn sabd-cta">{status === 'unconfirmed' ? 'Check the provider' : ctaLabel}<span class="sabl-ext" aria-hidden="true">↗</span></a>
      )}
      {/* Worded, not a bare icon: at 4.7 saves per 100 views (Sep 2026) the
          icon beside Apply was being read as decoration. When the listing
          has not opened yet, saving is the one thing a student can do, so
          it takes the green fill. */}
      <button data-sabd-save data-bookmark-type={itemType} data-bookmark-id={itemId}
        class:list={['sabd-save', status === 'future' && 'sabd-save-primary']}
        aria-label={`Save: ${name}`} data-save-name={name} aria-pressed="false"
        data-save-idle={status === 'future' ? 'Save for later' : 'Save'}><Fragment set:html={BOOKMARK} /><span data-save-label>{status === 'future' ? 'Save for later' : 'Save'}</span></button>
    </div>
    {/* Only when the button above is a dead label. For TBA and ongoing
        listings the button already goes to this same URL, and a second
        link to it under a different name read as a second destination. */}
    {(status === 'closed' || status === 'ended' || status === 'future') && url && (
      <a href={url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
        data-track="apply" data-item-type={itemType} data-item-id={itemId}
        class="sabd-visit">Visit the official site<span class="sabl-ext" aria-hidden="true">↗</span></a>
    )}
  </section>

  {/* Phones only, and only while the card's own button is off screen
      (setupBar below). The same link and the same Save, so a tap here is a
      tap on the card. */}
  {barCta && (
    <div class:list={['sabd-bar', { 'is-long': barLabel.length > 12 }]} data-sabd-bar hidden>
      <p class="sabd-bar-facts">
        <span class="sabd-bar-value">{valueBig}</span>
        {barDue && <span class="sabd-bar-due">{barDue}</span>}
      </p>
      <a href={url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
        data-track="apply" data-item-type={itemType} data-item-id={itemId}
        class="sab-btn sabd-cta sabd-bar-cta">{barLabel}<span class="sabl-ext" aria-hidden="true">↗</span></a>
      <button data-sabd-save data-bookmark-type={itemType} data-bookmark-id={itemId}
        class="sabd-save sabd-bar-save" aria-label={`Save: ${name}`} data-save-name={name} aria-pressed="false"
        data-save-idle="Save"><Fragment set:html={BOOKMARK} /><span data-save-label>Save</span></button>
    </div>
  )}

  <!-- left column -->
  <div class="sabd-left">

    {/* The notes are the part no other list has: the catch, the trick, the
        thing the sponsor's page buries (Loran closes at noon ET, not
        midnight). First in the column, so on a phone they sit right under
        Apply, and in the ink and mustard of the list boards: the site's own
        voice, where the ruled notebook paper read as a craft-kit prop and sat
        under three other sections (flow plan, 2026-10-02). No signature: a
        note is the site's, not a personal promise from one person. */}
    {notes && (
      <section class="sabd-note" aria-labelledby="sabd-note-h">
        <h2 id="sabd-note-h" class="sabd-note-h">Worth knowing</h2>
        <p class="sabd-note-text" set:html={notesHtml} />
      </section>
    )}

    {/* First in the column, so on a phone it sits right under Apply: the
        work an award asks for decided whether students finished it, and they
        found out only on the provider's site (private/flow-plan, 2026-10-01). */}
    {toApply && toApply.items.length > 0 && (
      <section class="sabd-kit" aria-labelledby="sabd-kit-h">
        <h2 id="sabd-kit-h" class="sabd-h2">What you'll need</h2>
        <ul class="sabd-kit-list">
          {toApply.items.map(item => (
            <li class:list={['sabd-kit-item', item.kind === 'none' && 'is-nothing']} set:html={emailOff(item.text)} />
          ))}
        </ul>
        <p class="sabd-kit-note">
          From the provider's page{toApplyMonth && `, ${toApplyMonth}`}.{!toApply.complete && " It doesn't list everything, so the form may ask for more."}
        </p>
      </section>
    )}

    {/* Right after the work this one takes, so on a phone the next step is
        on the screen under Apply; "More like this" at the foot of the page
        was reached by 1-9% of readers (private/flow-plan, 2026-10-01). */}
    {next.length > 0 && (
      <nav class="sabd-next" aria-labelledby="sabd-next-h">
        <h2 id="sabd-next-h" class="sabd-h2">What's next</h2>
        <ul class="sabd-next-list">
          {next.map(n => (
            <li><a href={n.href} class="sabd-next-row">
              {n.why && <span class="sabd-next-why">{n.why}</span>}
              <span class="sabd-next-name">{n.title}</span>
              <span class="sabd-next-meta tnum">{n.value} · {n.when}</span>
            </a></li>
          ))}
        </ul>
      </nav>
    )}

    {facts.length > 0 && (
      <div class="sabd-facts">
        {facts.map(f => (
          <div class="sabd-fact">
            <div class="sabd-card-label">{f.label}</div>
            <div class="sabd-fact-value">{f.value}</div>
          </div>
        ))}
      </div>
    )}

    {about && (
      <div>
        <h2 class="sabd-h2">About this {typeLabel.toLowerCase()}</h2>
        <div class="sabd-about">
          <p set:html={aboutHtml} />
        </div>
      </div>
    )}

    {steps.length > 0 && (
      <div>
        <h2 class="sabd-h2">How to apply</h2>
        <div class="sabd-steps">
          {steps.map((text, i) => (
            <div class="sabd-step">
              <span class="sabd-step-n">{i + 1}</span>
              <span class="sabd-step-text">{text}</span>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- right rail -->
  <div class="sabd-rail">
    {guideHref && guideTitle && (
      <a href={guideHref} class="sabd-guide">
        <span class="sabd-guide-label">Read the guide</span>
        <span class="sabd-guide-title">{guideTitle}{'\u00A0'}→</span>
      </a>
    )}

    {!availability && canRemind && (
      <div class="sabd-remind" data-remind data-deadline={deadlineIso ?? undefined}>
      {/* Once no milestone is ahead, the form promised mail the mailer never
          sends (critique 2026-09-29). The late line replaces it instead. */}
      <div data-remind-late hidden={!remindLate}>
        <h2 class="sabd-remind-label">Closes <span data-remind-late-when>{lateWhen}</span></h2>
        <p class="sabd-remind-sub sabd-remind-late">Too soon for an email reminder.{lateApply && ' Apply today.'}</p>
      </div>
      <div data-remind-open hidden={remindLate}>
        <h2 class="sabd-remind-label">Email me before it closes</h2>
        <div class="sabd-remind-sub">We send one link to confirm, then a reminder <span data-remind-when>{milestonePhrase(remindAhead.length ? remindAhead : [30, 14, 3])}</span> before the deadline.</div>
        <form data-sabd-alert-form data-item-type={itemType} data-item-id={itemId} class="sabd-remind-form" novalidate>
          <label for={`sabd-remind-${itemType}-${itemId}`} class="sr-only">Your email for a deadline reminder</label>
          <input id={`sabd-remind-${itemType}-${itemId}`} type="email" name="email" required autocomplete="email" placeholder="your@email.com" class="sabd-remind-input" aria-describedby={`sabd-remind-msg-${itemType}-${itemId}`} />
          <button type="submit" class="sab-btn sabd-remind-btn">Remind me</button>
        </form>
        <div id={`sabd-remind-msg-${itemType}-${itemId}`} data-sabd-alert-msg class="sabd-remind-msg" role="status" aria-live="polite" hidden></div>
        <div class="sabd-remind-fine">
          We store your address only to send these reminders, and delete it the
          moment you unsubscribe.
        </div>
        {/* Opens in place. It was a link to /privacy/, which took a reader
            off the listing mid sign-up, onto a long page with no way back to
            the form but the browser's (reader feedback, 2026-09-29). These
            are the privacy page's own facts about reminders; the page is one
            link further for anyone who wants all of it. */}
        <details class="sabd-remind-how">
          <summary>What we keep<svg class="sabd-remind-caret" viewBox="0 0 12 8" width="10" height="7" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <p>
            Nothing else is sent until you press the button in the confirmation
            email. If you never do, the address is deleted within 30 days.
            Otherwise it goes 60 days after the deadline or the moment you
            unsubscribe, whichever comes first. We never sell or trade it.
            <a href="/privacy/">The full privacy policy</a>.
          </p>
        </details>
      </div>
      </div>
    )}
  </div>

</div>

<style>
  .sabd-mono { font-family: var(--font-label); }

  .sabd-guide {
    display: block; margin-top: 16px; padding: 18px 20px;
    border: 1px solid rgba(20,25,21,0.14); border-radius: 4px;
    background: var(--bg-page); text-decoration: none; box-sizing: border-box;
  }
  .sabd-guide:hover { border-color: #0E8C64; }

  /* Collection notice, sits under the sign-up form. Deliberately quiet but
     always present: the address is the only personal data the site takes, and
     the moment to say what happens to it is the moment it is asked for. */
  /* On the #141915 block, #6B716C measured 3.56:1. Paper at 0.55 is 5.48:1
     and still sits below the sub above it, which is paper at 0.65. */
  .sabd-remind-fine { margin-top: 10px; font-size: var(--fs-meta); line-height: 1.55; color: var(--ink-muted); }
  /* The disclosure under it. The summary keeps the colour and underline the
     old "How this works" link had (in the sentence's own colour it was
