---
// Editorial detail page from the claude.ai/design "ScholarAB Detail" page,
// shared by scholarship and program slug pages.
// Deviations from the design (established site conventions):
// - SabHeader (with ticker band) replaces the design's plain header; the mono
//   annotation bar stays removed per Ilia (2026-07-11).
// - The canvas "PREVIEWING X OF N" switcher is implemented as real prev/next
//   links between listings ("LISTING X OF N").
// - No "Hand-checked / Last verified" line (removed site-wide 2026-07-12).
// - Reminder copy reflects the real send schedule (30/14/3 days out).
// - Closed and opening-soon states added (the design only shows open listings).

interface Fact {
  label: string;
  value: string;
}

interface Props {
  itemType: 'scholarship' | 'program';
  itemId: number;
  typeLabel: string; // 'SCHOLARSHIP' | 'PROGRAM'
  tag: string | null; // category, uppercased
  name: string;
  subline: string;
  status: 'active' | 'closed' | 'future' | 'ongoing' | 'tba';
  daysLeft: number | null;
  dueLong: string; // 'July 15, 2026' / 'Ongoing' / 'TBA'
  opensLabel?: string | null; // formatted open date, for status 'future'
  backHref: string;
  backLabel: string;
  position: string; // 'LISTING 4 OF 156'
  prevHref: string;
  nextHref: string;
  facts: Fact[];
  eligibility: string | null;
  about: string | null;
  notes?: string | null;
  steps: string[];
  valueLabel: string;
  valueBig: string;
  valueNote?: string | null;
  ctaLabel: string;
  url: string;
  canRemind: boolean;
  canonical: string;
}

const {
  itemType, itemId, typeLabel, tag, name, subline,
  status, daysLeft, dueLong, opensLabel,
  backHref, backLabel, position, prevHref, nextHref,
  facts, eligibility, about, notes, steps,
  valueLabel, valueBig, valueNote,
  ctaLabel, url, canRemind, canonical,
} = Astro.props;

const urgent = status === 'active' && typeof daysLeft === 'number' && daysLeft <= 7;

const chip =
  status === 'closed' ? { text: 'CLOSED', bg: 'rgba(20,25,21,0.08)', fg: 'rgba(20,25,21,0.55)' }
  : status === 'future' ? { text: opensLabel ? `OPENS ${opensLabel.toUpperCase()}` : 'OPENING SOON', bg: 'rgba(14,140,100,0.12)', fg: '#0E8C64' }
  : status === 'ongoing' ? { text: 'ONGOING — JOIN ANYTIME', bg: 'rgba(14,140,100,0.12)', fg: '#0E8C64' }
  : status === 'tba' ? { text: 'DEADLINE TBA', bg: 'rgba(20,25,21,0.08)', fg: 'rgba(20,25,21,0.55)' }
  : daysLeft === 0 ? { text: 'DUE TODAY', bg: '#B8541F', fg: '#FAF7F0' }
  : typeof daysLeft === 'number'
    ? { text: `${daysLeft} ${daysLeft === 1 ? 'DAY' : 'DAYS'} LEFT`, bg: urgent ? '#B8541F' : 'rgba(184,84,31,0.12)', fg: urgent ? '#FAF7F0' : '#B8541F' }
    : { text: 'OPEN', bg: 'rgba(14,140,100,0.12)', fg: '#0E8C64' };
---

<div class="sabd-crumb-row">
  <a href={backHref} class="sabd-mono sabd-back">← {backLabel}</a>
  <div class="sabd-mono sabd-switcher">
    <span class="sabd-position">{position}</span>
    <a href={prevHref} class="sabd-arrow" aria-label="Previous listing">‹</a>
    <a href={nextHref} class="sabd-arrow" aria-label="Next listing">›</a>
  </div>
</div>

<div class="sabd-title-block" data-detail-view data-item-type={itemType} data-item-id={itemId}>
  <div class="sabd-chips">
    <span class="sabd-mono sabd-chip sabd-chip-type">{typeLabel}</span>
    {tag && <span class="sabd-mono sabd-chip sabd-chip-tag">{tag}</span>}
    <span class="sabd-mono sabd-chip" style={`background:${chip.bg};color:${chip.fg};`}>{chip.text}</span>
  </div>
  <h1 class="sabd-h1">{name}</h1>
  <div class="sabd-mono sabd-subline">{subline}</div>
</div>

<div class="sabd-grid">

  <!-- left column -->
  <div class="sabd-left">

    <div class="sabd-facts">
      {facts.map(f => (
        <div class="sabd-fact">
          <div class="sabd-mono sabd-fact-label">{f.label}</div>
          <div class="sabd-fact-value">{f.value}</div>
        </div>
      ))}
    </div>

    {eligibility && (
      <div class="sabd-elig">
        <div class="sabd-mono sabd-elig-label">WHO CAN APPLY</div>
        <div class="sabd-elig-text">{eligibility}</div>
      </div>
    )}

    {about && (
      <div>
        <div class="sabd-mono sabd-section-label">ABOUT THIS {typeLabel}</div>
        <div class="sabd-about">
          <p>{about}</p>
          {notes && <p><!--email_off-->{notes}<!--/email_off--></p>}
        </div>
      </div>
    )}

    {steps.length > 0 && (
      <div>
        <div class="sabd-mono sabd-section-label">HOW TO APPLY</div>
        <div class="sabd-steps">
          {steps.map((text, i) => (
            <div class="sabd-step">
              <span class="sabd-step-n">{i + 1}</span>
              <span class="sabd-step-text">{text}</span>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- right rail -->
  <div class="sabd-rail">
    <div class="sabd-card">
      <div class="sabd-mono sabd-fact-label">{valueLabel}</div>
      <div class="sabd-value">{valueBig}</div>
      {valueNote && <div class="sabd-value-note">{valueNote}</div>}
      <div class="sabd-deadline-row">
        <span class="sabd-mono sabd-deadline-label">DEADLINE</span>
        <span class="sabd-deadline-value">{dueLong}</span>
      </div>
      <div class="sabd-cta-row">
        {status === 'closed' ? (
          <span class="sabd-cta sabd-cta-disabled">Closed</span>
        ) : status === 'future' ? (
          <span class="sabd-cta sabd-cta-disabled">{opensLabel ? `Opens ${opensLabel}` : 'Opening soon'}</span>
        ) : (
          <a href={url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
            data-track="apply" data-item-type={itemType} data-item-id={itemId}
            class="sabd-cta">{ctaLabel} →</a>
        )}
        <button data-sabd-save data-bookmark-type={itemType} data-bookmark-id={itemId}
          class="sabd-save" title="Save" aria-label="Save">☆</button>
      </div>
      <button data-sabd-copy data-copy-url={canonical} class="sabd-mono sabd-copy">COPY LINK</button>
    </div>

    {canRemind && (
      <div class="sabd-remind">
        <div class="sabd-mono sabd-remind-label">GET A DEADLINE REMINDER</div>
        <div class="sabd-remind-sub">We email you before it closes. Nothing else, ever.</div>
        <form data-sabd-alert-form data-item-type={itemType} data-item-id={itemId} class="sabd-remind-form">
          <input type="email" name="email" required autocomplete="email" placeholder="your@email.com" class="sabd-remind-input" />
          <button type="submit" class="sabd-remind-btn">Remind me</button>
        </form>
        <div data-sabd-alert-msg class="sabd-remind-msg" style="display:none;"></div>
      </div>
    )}
  </div>

</div>

<style>
  .sabd-mono { font-family: 'IBM Plex Mono', monospace; }

  .sabd-crumb-row {
    max-width: 1180px; margin: 0 auto; padding: 40px 48px 0;
    display: flex; justify-content: space-between; align-items: center; box-sizing: border-box;
  }
  .sabd-back { font-size: 13px; letter-spacing: 0.04em; color: rgba(20,25,21,0.6); text-decoration: none; }
  .sabd-back:hover { color: #0E8C64; }
  .sabd-switcher { display: flex; align-items: center; gap: 14px; font-size: 12px; letter-spacing: 0.05em; color: rgba(20,25,21,0.45); }
  .sabd-arrow {
    font-size: 13px; border: 1.5px solid rgba(20,25,21,0.3); color: #141915;
    border-radius: 100px; width: 30px; height: 30px; text-decoration: none;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .sabd-arrow:hover { border-color: #141915; color: #141915; }

  .sabd-title-block { max-width: 1180px; margin: 0 auto; padding: 36px 48px 0; box-sizing: border-box; }
  .sabd-chips { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sabd-chip { font-size: 11.5px; letter-spacing: 0.05em; padding: 6px 12px; border-radius: 100px; }
  .sabd-chip-type { background: #141915; color: #F2F0E9; }
  .sabd-chip-tag { border: 1px solid rgba(20,25,21,0.25); color: rgba(20,25,21,0.6); }
  .sabd-h1 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(38px, 6vw, 64px); line-height: 1.05; letter-spacing: -0.015em;
    margin: 22px 0 0; max-width: 820px;
  }
  .sabd-subline { font-size: 13px; letter-spacing: 0.04em; color: rgba(20,25,21,0.5); margin-top: 14px; }

  .sabd-grid {
    max-width: 1180px; margin: 0 auto; padding: 44px 48px 96px; box-sizing: border-box;
    display: grid; grid-template-columns: 1fr 360px; gap: 40px; align-items: start;
  }
  .sabd-left { display: flex; flex-direction: column; gap: 36px; min-width: 0; }

  .sabd-facts { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 2px solid #141915; }
  .sabd-fact { padding: 20px 24px 20px 0; border-bottom: 1px solid rgba(20,25,21,0.14); }
  .sabd-fact-label { font-size: 11.5px; letter-spacing: 0.06em; color: rgba(20,25,21,0.5); margin-bottom: 8px; }
  .sabd-fact-value { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }

  .sabd-elig { background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 16px; padding: 28px 30px; }
  .sabd-elig-label { font-size: 12px; letter-spacing: 0.06em; color: #0E8C64; margin-bottom: 14px; }
  .sabd-elig-text { font-size: 16.5px; line-height: 1.6; }

  .sabd-section-label { font-size: 12px; letter-spacing: 0.06em; color: rgba(20,25,21,0.5); margin-bottom: 14px; }
  .sabd-about { font-size: 16.5px; line-height: 1.65; color: rgba(20,25,21,0.78); max-width: 640px; }
  .sabd-about p { margin: 0; }
  .sabd-about p + p { margin-top: 12px; }

  .sabd-steps { display: flex; flex-direction: column; border-top: 1px solid rgba(20,25,21,0.14); max-width: 640px; }
  .sabd-step { display: flex; gap: 18px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid rgba(20,25,21,0.14); }
  .sabd-step-n { font-family: 'Instrument Serif', serif; font-size: 24px; color: #0E8C64; flex: none; width: 28px; }
  .sabd-step-text { font-size: 15.5px; line-height: 1.55; color: rgba(20,25,21,0.8); }

  .sabd-rail { position: sticky; top: 24px; display: flex; flex-direction: column; gap: 16px; }
  .sabd-card {
    background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 16px;
    padding: 28px 26px; box-shadow: 6px 6px 0 #2FD3A0;
  }
  .sabd-value { font-family: 'Instrument Serif', serif; font-size: 52px; line-height: 1.05; color: #0E8C64; margin: 8px 0 4px; }
  .sabd-value-note { font-size: 14px; color: rgba(20,25,21,0.6); }
  .sabd-deadline-row {
    display: flex; justify-content: space-between; align-items: center;
    margin: 22px 0 0; padding-top: 18px; border-top: 1px solid rgba(20,25,21,0.12);
  }
  .sabd-deadline-label { font-size: 12px; color: rgba(20,25,21,0.5); }
  .sabd-deadline-value { font-size: 15px; font-weight: 700; }
  .sabd-cta-row { display: flex; gap: 10px; margin-top: 22px; }
  .sabd-cta {
    flex: 1; text-align: center; font-size: 15.5px; font-weight: 700;
    background: #141915; color: #F2F0E9; padding: 15px 0; border-radius: 100px; text-decoration: none;
  }
  .sabd-cta:hover { background: #0E8C64; color: #F2F0E9; }
  .sabd-cta-disabled { background: rgba(20,25,21,0.08); color: rgba(20,25,21,0.45); cursor: not-allowed; }
  .sabd-cta-disabled:hover { background: rgba(20,25,21,0.08); color: rgba(20,25,21,0.45); }
  .sabd-save {
    font-family: 'Archivo', sans-serif; font-size: 17px; border: 1.5px solid rgba(20,25,21,0.3);
    border-radius: 100px; width: 50px; height: 50px; cursor: pointer;
    color: rgba(20,25,21,0.55); background: transparent; flex: none;
  }
  .sabd-save:hover { border-color: #141915; }
  .sabd-save[data-saved] { color: #0E8C64; background: rgba(47,211,160,0.15); }
  .sabd-copy {
    font-size: 12.5px; letter-spacing: 0.03em; width: 100%; margin-top: 12px;
    background: transparent; border: 1.5px solid rgba(20,25,21,0.25); border-radius: 100px;
    padding: 11px 0; cursor: pointer; color: rgba(20,25,21,0.7);
  }
  .sabd-copy:hover { border-color: #141915; color: #141915; }

  .sabd-remind { background: #141915; border-radius: 16px; padding: 24px 26px; color: #F2F0E9; }
  .sabd-remind-label { font-size: 11.5px; letter-spacing: 0.06em; color: #2FD3A0; margin-bottom: 8px; }
  .sabd-remind-sub { font-size: 14px; line-height: 1.5; color: rgba(242,240,233,0.65); margin-bottom: 16px; }
  .sabd-remind-form { display: flex; gap: 8px; }
  .sabd-remind-input {
    font-family: 'Archivo', sans-serif; font-size: 14px; flex: 1; min-width: 0;
    background: rgba(242,240,233,0.08); border: 1px solid rgba(242,240,233,0.2);
    border-radius: 100px; padding: 11px 16px; color: #F2F0E9; outline: none;
  }
  .sabd-remind-input::placeholder { color: rgba(242,240,233,0.4); }
  .sabd-remind-btn {
    font-family: 'Archivo', sans-serif; font-size: 13.5px; font-weight: 700;
    background: #2FD3A0; color: #0B1512; border: none; border-radius: 100px;
    padding: 11px 18px; cursor: pointer; flex: none;
  }
  .sabd-remind-btn:hover { background: #F2F0E9; }
  .sabd-remind-btn:disabled { opacity: 0.6; cursor: default; }
  .sabd-remind-msg { font-size: 14.5px; font-weight: 600; color: #2FD3A0; }

  @media (max-width: 900px) {
    .sabd-crumb-row { padding: 28px 20px 0; }
    .sabd-title-block { padding: 28px 20px 0; }
    .sabd-grid { grid-template-columns: 1fr; gap: 32px; padding: 32px 20px 72px; }
    .sabd-rail { position: static; }
    .sabd-facts { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { sendEvent } from '../../lib/events.ts';
  import { getSaved, toggleSaved, getSavedPrograms, toggleSavedProgram } from '../../lib/tracker';
  import { showToast, showConfetti } from '../../lib/utils';

  function itemAttrs(el: Element): ['scholarship' | 'program' | undefined, number | undefined] {
    const type = el.getAttribute('data-item-type');
    const id = Number(el.getAttribute('data-item-id'));
    return [
      type === 'scholarship' || type === 'program' ? type : undefined,
      Number.isInteger(id) ? id : undefined,
    ];
  }

  function applySaveState(btn: HTMLElement, saved: boolean) {
    btn.textContent = saved ? '★' : '☆';
    if (saved) btn.setAttribute('data-saved', '');
    else btn.removeAttribute('data-saved');
    btn.setAttribute('aria-label', saved ? 'Remove from saved' : 'Save');
  }

  // Delegated so everything survives view-transition swaps between detail pages
  document.addEventListener('click', (e) => {
    const target = e.target as Element;

    const apply = target.closest?.('[data-track="apply"]');
    if (apply) sendEvent('apply_click', ...itemAttrs(apply));

    const save = target.closest?.('[data-sabd-save]') as HTMLElement | null;
    if (save) {
      const id = parseInt(save.dataset.bookmarkId!);
      const type = save.dataset.bookmarkType as 'scholarship' | 'program';
      save.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.4)' }, { transform: 'scale(0.9)' }, { transform: 'scale(1.05)' }, { transform: 'scale(1)' }],
        { duration: 380, easing: 'ease-out' }
      );
      navigator.vibrate?.(12);
      const next = type === 'program' ? toggleSavedProgram(id) : toggleSaved(id);
      const nowSaved = next.includes(id);
      applySaveState(save, nowSaved);
      if (nowSaved) showConfetti(save);
      showToast(nowSaved ? 'Saved ✓' : 'Removed from saved');
    }

    const copy = target.closest?.('[data-sabd-copy]') as HTMLElement | null;
    if (copy) {
      navigator.clipboard.writeText(copy.dataset.copyUrl || window.location.href).then(() => {
        copy.textContent = '✓ LINK COPIED';
        setTimeout(() => { copy.textContent = 'COPY LINK'; }, 2000);
      });
    }
  });

  // Capture phase + stopPropagation so Astro's ClientRouter (which also
  // listens for submit and would swap the page) never handles this form.
  document.addEventListener('submit', async (e) => {
    const form = (e.target as Element).closest?.('[data-sabd-alert-form]') as HTMLFormElement | null;
    if (!form) return;
    e.preventDefault();
    e.stopPropagation();
    const [itemType, itemId] = itemAttrs(form);
    const email = (form.querySelector('input[name="email"]') as HTMLInputElement).value;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const msg = form.parentElement?.querySelector('[data-sabd-alert-msg]') as HTMLElement | null;
    btn.disabled = true;
    btn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/alert', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, itemType, itemId }),
      });
      const data = await res.json() as { error?: string };
      if (res.ok) {
        form.style.display = 'none';
        if (msg) { msg.textContent = "✓ Set — we'll nudge you before the deadline."; msg.style.display = 'block'; }
      } else {
        btn.disabled = false;
        btn.textContent = 'Remind me';
        if (msg) { msg.textContent = data.error || 'Something went wrong.'; msg.style.color = 'rgba(242,240,233,0.65)'; msg.style.display = 'block'; }
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Remind me';
      if (msg) { msg.textContent = 'Something went wrong. Try again.'; msg.style.color = 'rgba(242,240,233,0.65)'; msg.style.display = 'block'; }
    }
  }, true);

  // Per-item views + initial save-state paint.
  // astro:page-load fires on first load and after every view-transition swap.
  document.addEventListener('astro:page-load', () => {
    const view = document.querySelector('[data-detail-view]');
    if (view) sendEvent('detail_view', ...itemAttrs(view));

    document.querySelectorAll<HTMLElement>('[data-sabd-save]').forEach(btn => {
      const id = parseInt(btn.dataset.bookmarkId!);
      const type = btn.dataset.bookmarkType as 'scholarship' | 'program';
      const list = type === 'program' ? getSavedPrograms() : getSaved();
      applySaveState(btn, list.includes(id));
    });
  });
</script>
