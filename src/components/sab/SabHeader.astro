---
// Dark header band from the claude.ai/design "ScholarAB" pages:
// mono annotation bar + nav with accent underline on the active link.
import { loadScholarships, loadPrograms } from '../../lib/data-loader';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const scholarships = await loadScholarships();
const programs = await loadPrograms();
const newestVerified = [...scholarships, ...programs]
  .map(x => x.lastVerified).filter(Boolean).sort().at(-1);
const verifiedLabel = newestVerified
  ? new Date(newestVerified + '-01T00:00:00').toLocaleDateString('en-CA', { month: 'long', year: 'numeric' })
  : null;

// The home design's nav omits the Home item; every other page includes it.
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Scholarships', href: '/scholarships' },
  { label: 'Programs', href: '/programs' },
  { label: 'Match', href: '/match' },
  { label: 'Saved', href: '/saved' },
  { label: 'About', href: '/about' },
].filter(n => !(currentPath === '/' && n.href === '/'));

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<div class="sabh-annotation">
  <span>A student-run project — Medicine Hat, Alberta</span>
  <span class="sabh-annotation-right">{verifiedLabel ? `Last verified ${verifiedLabel} · ` : ''}100% free</span>
</div>
<div class="sabh-nav">
  <a href="/" class="sabh-logo" aria-label="ScholarAB home">
    <svg width="30" height="30" viewBox="0 0 40 40" aria-hidden="true">
      <polygon points="20,4 37,37 3,37" fill="#2FD3A0"></polygon>
      <polygon points="20,4 24.5,13 15.5,13" fill="#F2F0E9"></polygon>
    </svg>
    <span class="sabh-logo-word">Scholar<span style="color:#2FD3A0;">AB</span></span>
  </a>
  <div class="sabh-links">
    {navItems.map(n => (
      <a
        href={n.href}
        class={`sabh-link${isActive(n.href) ? ' sabh-link-active' : ''}`}
        aria-current={isActive(n.href) ? 'page' : undefined}
      >{n.label}</a>
    ))}
    <a href="/match" class="sabh-cta">Find my match</a>
  </div>
</div>

<style>
  .sabh-annotation {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 48px; border-bottom: 1px solid rgba(242,240,233,0.12);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px; letter-spacing: 0.04em; color: rgba(242,240,233,0.55);
  }
  .sabh-nav { display: flex; justify-content: space-between; align-items: center; padding: 24px 48px; }
  .sabh-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .sabh-logo-word { font-family: 'Archivo', sans-serif; font-weight: 800; font-size: 21px; letter-spacing: -0.02em; color: #F2F0E9; }
  .sabh-links { display: flex; align-items: center; gap: 34px; }
  .sabh-link {
    font-size: 14.5px; font-weight: 500; color: rgba(242,240,233,0.75);
    text-decoration: none; border-bottom: 2px solid transparent; padding-bottom: 4px;
  }
  .sabh-link:hover { color: #F2F0E9; }
  .sabh-link-active { color: #F2F0E9; border-bottom-color: #2FD3A0; }
  .sabh-cta {
    font-size: 14px; font-weight: 600; background: #2FD3A0; color: #0B1512;
    padding: 10px 20px; border-radius: 100px; text-decoration: none;
  }
  .sabh-cta:hover { background: #F2F0E9; color: #0B1512; }

  @media (max-width: 900px) {
    .sabh-annotation { padding: 12px 20px; }
    .sabh-annotation-right { display: none; }
    .sabh-nav { padding: 18px 20px; }
    .sabh-link { display: none; } /* bottom tab bar covers navigation on mobile */
  }
  @media (max-width: 480px) {
    .sabh-cta { padding: 8px 16px; font-size: 13px; }
  }
</style>
