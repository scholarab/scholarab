---
import SabLogoMark from './SabLogoMark.astro';
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const navItems = [
  { label: 'Scholarships', href: '/scholarships/' },
  { label: 'Programs', href: '/programs/' },
  { label: 'Match', href: '/match/' },
  { label: 'Saved', href: '/saved/' },
  { label: 'About', href: '/about/' },
];
const scholarshipLinks = [
  { label: 'All scholarships', href: '/scholarships/' },
  { label: 'Deadline calendar', href: '/deadlines/' },
  { label: 'Guides', href: '/guides/' },
];
const isActive = (href: string) => `${currentPath.replace(/\/$/, '')}/`.startsWith(href);
---
<header class="sabh" data-sab-header>
  <div class="sabh-nav">
    <a href="/" class="sabh-logo" aria-label="ScholarAB home">
      <SabLogoMark size={24} id="header" />
      <span class="sabh-logo-word">Scholar<span style="color:#2FD3A0">AB</span></span>
    </a>
    <nav class="sabh-links" id="sabh-links" aria-label="Main">
      {navItems.map(n => (
        <div class:list={['sabh-item', { 'sabh-has-menu': n.href === '/scholarships/' }]}>
          <a href={n.href} class:list={['sabh-link', { 'sabh-link-active': isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>
            <span class="sabh-link-label">{n.label}</span>
          </a>
          {n.href === '/scholarships/' && (
            <div class="sabh-menu" role="group" aria-label="Scholarships">
              <button type="button" class="sabh-sub-back" data-sabh-back>← Back</button>
              <ul>{scholarshipLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </div>
          )}
        </div>
      ))}
    </nav>
    <button type="button" class="sabh-burger" id="sabh-burger" aria-controls="sabh-links" aria-expanded="false" aria-label="Open menu">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>
<style is:global>
  .sabh-nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 clamp(20px, 4vw, 56px); box-sizing: border-box; height: var(--sab-nav-h); position: relative; }
  .sabh-logo { display: flex; align-items: center; gap: 9px; text-decoration: none; justify-self: start; }
  .sabh-logo-word { font-family: 'Archivo', sans-serif; font-weight: 700; font-size: 17px; letter-spacing: -0.015em; color: #F2F0E9; }
  .sabh-links { display: flex; align-items: stretch; gap: 4px; align-self: stretch; }
  .sabh-item { display: flex; align-items: center; position: relative; }
  .sabh-link { font-size: 13.5px; font-weight: 500; letter-spacing: 0.005em; color: #C6CEC9; text-decoration: none; padding: 7px 13px; border-radius: 6px; }
  .sabh-link:hover, .sabh-link-active { color: #F2F0E9; }
  .sabh-link:hover { background: rgba(242,240,233,0.08); }
  .sabh-menu { position: absolute; left: 0; top: 100%; z-index: 5; min-width: 220px; padding: 16px; background: #0A1310; border: 1px solid rgba(242,240,233,0.18); border-radius: 0 0 10px 10px; visibility: hidden; }
  .sabh-menu ul { list-style: none; margin: 0; padding: 0; }
  .sabh-menu a { display: block; padding: 12px 4px; color: #C6CEC9; text-decoration: none; }
  .sabh-menu a:hover { color: #F2F0E9; text-decoration: underline; }
  .sabh-has-menu:focus-within .sabh-menu { visibility: visible; }
  @media (hover: hover) { .sabh-has-menu:hover .sabh-menu { visibility: visible; } }
  .sabh-sub-back { display: none; }
  .sabh-burger { display: none; width: 44px; height: 44px; padding: 0; justify-self: end; border: 0; border-radius: 8px; background: transparent; flex-direction: column; align-items: center; justify-content: center; gap: 4px; cursor: pointer; }
  .sabh-burger span { display: block; width: 16px; height: 1.5px; background: #F2F0E9; }
  .sabh-burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .sabh-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .sabh-burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }
  @media (max-width: 900px) {
    .sabh-nav { grid-template-columns: 1fr auto; padding: 0 8px 0 20px; }
    .sabh-burger { display: flex; }
    .sabh-links { display: none; position: fixed; inset: 0; z-index: 1; background: #0A1310; flex-direction: column; align-items: stretch; gap: 0; padding: calc(var(--sab-nav-h) + 12px) 20px 24px; box-sizing: border-box; overflow-y: auto; overscroll-behavior: contain; }
    .sabh[data-open] .sabh-links { display: flex; }
    .sabh[data-open] .sabh-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 60; background: #0A1310; }
    .sabh[data-open] .sabh-nav::before { content: ''; position: absolute; inset: 0; background: #0A1310; z-index: 2; }
    .sabh[data-open] .sabh-logo, .sabh[data-open] .sabh-burger { position: relative; z-index: 3; }
    .sabh-item { display: block; }
    .sabh-link { display: flex; align-items: center; min-height: 56px; font-size: 22px; font-weight: 600; letter-spacing: -0.01em; padding: 0; border-radius: 0; border-bottom: 1px solid rgba(242,240,233,0.12); }
    .sabh-link-active .sabh-link-label::after { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #2FD3A0; margin-left: 10px; vertical-align: middle; }
    .sabh-menu { display: none; }
    .sabh[data-sub] .sabh-item:not([data-sub-open]), .sabh[data-sub] [data-sub-open] > .sabh-link { display: none; }
    .sabh[data-sub] [data-sub-open] .sabh-menu { display: block; position: static; visibility: visible; border: 0; padding: 0; }
    .sabh-sub-back { display: block; min-height: 44px; border: 0; border-bottom: 1px solid rgba(242,240,233,0.18); background: transparent; color: #C6CEC9; font-size: 16px; cursor: pointer; }
  }
</style>

<script>
  import { onPageLoad } from '../../lib/page-load';
  // Bind each document once; cached Back visits keep their listeners.
  let header: HTMLElement | null = null;
  let burger: HTMLElement | null = null;
  let sheet: HTMLElement | null = null;

  const isOpen = () => !!header?.hasAttribute('data-open');

  function openMenu() {
    if (!header || !burger || !sheet) return;
    header.setAttribute('data-open', '');
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Close menu');
    document.documentElement.style.overflow = 'hidden';
    sheet.querySelector<HTMLElement>('a')?.focus();
  }

  const isSub = () => !!header?.hasAttribute('data-sub');
  const phone = window.matchMedia('(max-width: 900px)');

  // A row's own panel inside the sheet (phones only). The row is marked rather
  // than named, so Scholarships and Programs need no separate handling.
  const openItem = () => sheet?.querySelector<HTMLElement>('[data-sub-open]') ?? null;

  function openSub(item: HTMLElement) {
    if (!header || !sheet) return;
    item.setAttribute('data-sub-open', '');
    header.setAttribute('data-sub', '');
    sheet.scrollTop = 0;
    item.querySelector<HTMLElement>('[data-sabh-back]')?.focus();
  }

  function closeSub() {
    const item = openItem();
    header?.removeAttribute('data-sub');
    item?.removeAttribute('data-sub-open');
    item?.querySelector<HTMLElement>('.sabh-link')?.focus();
  }

  function closeMenu({ restoreFocus = false } = {}) {
    header?.removeAttribute('data-sub');
    openItem()?.removeAttribute('data-sub-open');
    header?.removeAttribute('data-open');
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Open menu');
    document.documentElement.style.overflow = '';
    if (restoreFocus) burger?.focus();
  }

  function initSabHeader() {
    header = document.querySelector<HTMLElement>('[data-sab-header]');
    burger = document.getElementById('sabh-burger');
    sheet = document.getElementById('sabh-links');
    if (!header || !burger || !sheet || header.dataset.init) return;
    header.dataset.init = 'true';

    burger.addEventListener('click', () => (isOpen() ? closeMenu({ restoreFocus: true }) : openMenu()));

    // Close before leaving so a cached Back visit returns to the page.
    sheet.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-sabh-back]')) {
        closeSub();
        return;
      }
      // In the sheet, a row with a panel opens it instead of navigating; the
      // panel's own "All scholarships" or "All programs" link goes to the
      // directory.
      const item = target.closest<HTMLElement>('.sabh-has-menu');
      if (isOpen() && phone.matches && item && target.closest('.sabh-link')) {
        e.preventDefault();
        openSub(item);
        return;
      }
      if (target.closest('a')) closeMenu();
    });
  }

  document.addEventListener('keydown', e => {
    // In the sheet, Escape backs out of the Scholarships panel first.
    if (e.key === 'Escape' && isOpen() && isSub()) {
      closeSub();
      return;
    }
    // Escape inside the Scholarships dropdown closes it: the panel is held
    // open by focus, so dropping focus is what closes it. Focus goes back to
    // the Scholarships link's item, blurred, so the next Tab resumes there.
    if (e.key === 'Escape') {
      const active = document.activeElement as HTMLElement | null;
      if (active?.closest('.sabh-has-menu')) active.blur();
    }
    if (!isOpen() || !sheet || !burger) return;
    if (e.key === 'Escape') {
      closeMenu({ restoreFocus: true });
      return;
    }
    if (e.key !== 'Tab') return;
    // Keep Tab inside the sheet and its button while the sheet covers
    // everything else on screen.
    // .sabh-link only: the dropdown's links live inside the sheet's markup but
    // are display:none on a phone, and focus() on those silently does nothing.
    // In the Scholarships panel the stops are its Back button and links instead.
    const stops = isSub()
      ? [...(openItem()?.querySelectorAll<HTMLElement>('.sabh-menu button, .sabh-menu a[href]') ?? []), burger]
      : [...sheet.querySelectorAll<HTMLElement>('a.sabh-link[href]'), burger];
    const first = stops[0];
    const last = stops[stops.length - 1];
    if (!first || !last) return;
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // A sheet left open across a rotation to landscape would be a fixed panel
  // with no visible way out; the button it belongs to is hidden above 900px.
  phone.addEventListener('change', ev => {
    if (!ev.matches && isOpen()) closeMenu();
  });

  // ── Sticky header collapse ───────────────────────────────────────────────
  // Flips one attribute on <html>; every property that moves is a transition
  // in global.css. Hysteresis, so a scroll that hovers on the line cannot make
  // the header flap: it condenses at 116px down and only opens back up at 36px.
  // Read inside rAF and never written unless the state actually changes, so a
  // fast scroll costs one class write, not one per frame.
  const STICK_DOWN = 116;
  const STICK_UP = 36;
  let stuckTicking = false;
  function readStuck(): void {
    stuckTicking = false;
    const root = document.documentElement;
    const stuck = root.hasAttribute('data-sab-stuck');
    const y = window.scrollY;
    if (!stuck && y > STICK_DOWN) root.setAttribute('data-sab-stuck', '');
    else if (stuck && y < STICK_UP) root.removeAttribute('data-sab-stuck');
  }
  function onStickScroll(): void {
    if (stuckTicking) return;
    stuckTicking = true;
    requestAnimationFrame(readStuck);
  }
  window.addEventListener('scroll', onStickScroll, { passive: true });
  // A client-side navigation can land part-way down a page, and a reload
  // restores the old offset before any scroll event fires.
  onPageLoad(() => { readStuck(); initSabHeader(); });
</script>
