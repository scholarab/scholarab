---
import { todayDate as albertaToday } from '../../lib/calendar';
// Dark header band. Thin, full-width bar in the Apple/Tesla manner (Ilia,
// 2026-09-13): logo at the window's left edge, links centred, no CTA pill.
// The current page is marked by brighter text, not an accent underline.
// (The mono annotation bar was removed at Ilia's request, 2026-07-11.)
//
// There is no Home link: the logo is an anchor to '/' on every page and in
// the open phone sheet, so a Home row was a second control for a destination
// the wordmark already owns (Ilia, 2026-09-15).
//
// Below 900px the same five anchors become a full-screen sheet behind a
// 44×44 button ("ScholarAB Mobile Home.dc.html", state B); one nav, two
// layouts, so there is no second link list to keep in sync.

import SabLogoMark from './SabLogoMark.astro';
import { loadScholarships, loadPrograms } from '../../lib/data-loader';
import { programIsListed } from '../../lib/status';
import { SCHOLARSHIP_FACETS, PROGRAM_FACETS, PROGRAM_FORMATS, MENU_SCOPES, facetItems, MIN_FACET_ITEMS } from '../../lib/facets';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

// Counts shown beside two links in the mobile sheet. Same definitions the
// home hero uses: every scholarship in the directory, and the programs
// /programs actually lists. Both loaders are cached, so this is free after
// the first page of a build, if the data is unreachable the counts simply
// do not render.
let scholarshipCount: number | null = null;
let programCount: number | null = null;

// The Scholarships and Programs dropdowns (Tesla-style, Ilia 2026-09-13,
// Programs added 2026-09-15): tiles for the hubs, a text list beside them.
// The Scholarships tiles are MENU_SCOPES (facets.ts), shared with the home
// carousel. The Programs tiles are the format hubs (what shape the thing is),
// because that is what a reader is choosing between; the subject hubs sit in
// the list beside them.
const MENU_TOPICS = ['stem', 'arts', 'trades', 'community', 'sports', 'indigenous'];
const scholarshipFacetBySlug = new Map(SCHOLARSHIP_FACETS.map(f => [f.slug, f]));

interface Tile { label: string; href: string; count: number | null; backdrop?: string }
const scopeFacets = MENU_SCOPES
  .map(slug => scholarshipFacetBySlug.get(slug))
  .filter(f => f !== undefined);
const tileOf = (f: { slug: string; label: string; backdrop?: string }, base: string, count: number | null): Tile =>
  ({ label: f.label, href: `${base}${f.slug}/`, count, backdrop: f.backdrop });

let scopeTiles: Tile[] = scopeFacets.map(f => tileOf(f, '/scholarships/', null));
// A hub below the floor has no page, so it gets no tile and no link either.
let formatTiles: Tile[] = [];
let fieldLinks: { label: string; href: string }[] = [];

try {
  const [scholarships, programs] = await Promise.all([loadScholarships(), loadPrograms()]);
  const today = albertaToday();
  const listedPrograms = programs.filter(p => programIsListed(p, today));
  scholarshipCount = scholarships.length;
  programCount = listedPrograms.length;
  // Biggest scope first. Array sort is stable, so a tie keeps the source order.
  scopeTiles = scopeFacets
    .map(f => tileOf(f, '/scholarships/', facetItems(f, scholarships).length))
    .sort((a, b) => b.count! - a.count!);
  const liveHub = (f: { slug: string }) =>
    facetItems(f as Parameters<typeof facetItems>[0], listedPrograms).length;
  formatTiles = PROGRAM_FORMATS
    .map(f => ({ facet: f, items: liveHub(f) }))
    .filter(({ items }) => items >= MIN_FACET_ITEMS)
    .map(({ facet, items }) => tileOf(facet, '/programs/', items))
    .sort((a, b) => b.count! - a.count!);
  fieldLinks = PROGRAM_FACETS
    .filter(f => liveHub(f) >= MIN_FACET_ITEMS)
    .map(f => ({ label: f.label, href: `/programs/${f.slug}/` }));
} catch {
  /* counts are decoration; the nav works without them */
}

const topicLinks = [
  { label: 'All scholarships', href: '/scholarships/' },
  { label: 'Closing soon', href: '/#closing' },
  { label: 'Deadline calendar', href: '/deadlines/' },
  ...MENU_TOPICS
    .map(slug => scholarshipFacetBySlug.get(slug))
    .filter(f => f !== undefined)
    .map(f => ({ label: f.label, href: `/scholarships/${f.slug}/` })),
  { label: 'Guides', href: '/guides/' },
];

// Tiles are formats, so the column beside them is the other axis: the subject
// hubs, then the guides. Both are one click from the panel rather than one
// click plus a chip row.
const programLinks = [
  { label: 'All programs', href: '/programs/' },
  ...fieldLinks,
  { label: 'Guides', href: '/guides/' },
];

// Which nav rows carry a panel, and what goes in it.
const MENUS: Record<string, { label: string; tiles: Tile[]; links: { label: string; href: string }[] }> = {
  '/scholarships/': { label: 'Scholarships by location and topic', tiles: scopeTiles, links: topicLinks },
  '/programs/': { label: 'Programs by format and field', tiles: formatTiles, links: programLinks },
};

const navItems = [
  { label: 'Scholarships', href: '/scholarships/', count: scholarshipCount },
  { label: 'Programs', href: '/programs/', count: programCount },
  { label: 'Match', href: '/match/', count: null as number | null },
  { label: 'Saved', href: '/saved/', count: null as number | null },
  { label: 'About', href: '/about/', count: null as number | null },
];

// Compare with a normalized trailing slash on both sides. The nav hrefs carry
// one (bare paths 308-redirect in production, so linking to them split every
// page across two indexed URLs), but callers pass currentPath either way;
// a bare '/scholarships' must still light up the '/scholarships/' tab.
const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : withSlash(currentPath).startsWith(withSlash(href));
---

<header class="sabh" data-sab-header>
  <div class="sabh-nav">
    <a href="/" class="sabh-logo" aria-label="ScholarAB home">
      <SabLogoMark size={24} id="header" />
      <span class="sabh-logo-word">Scholar<span style="color:#2FD3A0;">AB</span></span>
    </a>
    <div class="sabh-actions">
      <!-- The site nav is a real landmark: it is the only way to jump past
           these links, or straight to them, without walking the whole page. -->
      <nav class="sabh-links" id="sabh-links" aria-label="Main">
        <div class="sabh-sheet-label" aria-hidden="true">GO TO</div>
        {/* One highlight that glides between links, as on tesla.com, instead
            of a pill per link that blinks out and back in as the pointer
            crosses from one to the next. The script sizes and moves it. */}
        <span class="sabh-glide" aria-hidden="true"></span>
        {/* The dropdown's background, shared by both panels (desktop). It
            stays open from Scholarships to Programs and only the contents
            crossfade, as on tesla.com, instead of one panel closing and the
            other reopening. The script sets its height. */}
        <span class="sabh-drop" aria-hidden="true"></span>
        {/* Blurs the page under an open dropdown so the eye stays on the
            panel, as on tesla.com. Never takes the pointer: moving onto the
            page must still read as leaving the menu. */}
        <span class="sabh-scrim" aria-hidden="true"></span>
        {navItems.map(n => (
          <div class={`sabh-item${MENUS[n.href] ? ' sabh-has-menu' : ''}`}>
            <a
              href={n.href}
              class={`sabh-link${isActive(n.href) ? ' sabh-link-active' : ''}`}
              aria-current={isActive(n.href) ? 'page' : undefined}
            >
              <span class="sabh-link-label">{n.label}</span>
              {n.count !== null && <span class="sabh-link-count" aria-hidden="true">{n.count.toLocaleString('en-CA')}</span>}
            </a>
            {MENUS[n.href] && (
              /* Desktop keyboard: one stop, not twenty. The panel's links are
                 out of the tab order until this button opens it, so Tab walks
                 Scholarships, this toggle, Programs. Invisible until focused,
                 so the pointer look is unchanged. Hidden in the phone sheet,
                 where tapping the row opens the panel instead. */
              <button type="button" class="sabh-menu-toggle" data-sabh-toggle
                aria-expanded="false" aria-controls={`sabh-menu-${n.label.toLowerCase()}`}
                aria-label={`Show ${n.label} menu`}>
                <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            )}
            {MENUS[n.href] && (
              /* Desktop: opens on hover (pointer devices) or from the toggle
                 above (keyboard). Phones: the sheet swaps the link list for
                 this panel instead of navigating. */
              <div class="sabh-menu" id={`sabh-menu-${n.label.toLowerCase()}`} role="group" aria-label={MENUS[n.href]!.label}>
                <button type="button" class="sabh-sub-back" data-sabh-back>
                  <span aria-hidden="true">←</span> Back
                </button>
                <div class="sabh-menu-inner">
                  <ul class="sabh-menu-tiles">
                    {MENUS[n.href]!.tiles.map(t => (
                      <li>
                        <a
                          href={t.href}
                          class:list={['sabh-tile', { 'sabh-tile-photo': t.backdrop }]}
                          style={t.backdrop ? `--sabh-tile-img: url(/photos/backdrops/${t.backdrop}-tile.webp)` : undefined}
                        >
                          {t.count !== null && (
                            <span class="sabh-tile-num">{t.count}</span>
                          )}
                          <span class="sabh-tile-text">
                            <span class="sabh-tile-name">{t.label}</span>
                            {t.count !== null && (
                              <span class="sabh-tile-count">
                                {n.href === '/programs/'
                                  ? (t.count === 1 ? 'program' : 'programs')
                                  : (t.count === 1 ? 'scholarship' : 'scholarships')}
                              </span>
                            )}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <ul class="sabh-menu-list">
                    {MENUS[n.href]!.links.map(l => (
                      <li><a href={l.href}>{l.label}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </div>
        ))}
        <div class="sabh-sheet-foot" aria-hidden="true">FREE · NO ACCOUNT<br />MADE IN MEDICINE HAT</div>
      </nav>
      {/* Same destinations and link treatment as the footer's CONTACT column:
          outside links open a new tab, and the mailto sits inside email_off so
          Cloudflare's email obfuscation does not rewrite the anchor. */}
      <div class="sabh-social">
        <a href="https://www.instagram.com/scholarab.ca" target="_blank" rel="noopener noreferrer" aria-label="ScholarAB on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none" /></svg>
        </a>
        <a href="https://www.tiktok.com/@scholarab" target="_blank" rel="noopener noreferrer" aria-label="ScholarAB on TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.77.11V9.77a5.7 5.7 0 0 0-.77-.05 5.68 5.68 0 1 0 5.68 5.68V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-3.24-1.48z" /></svg>
        </a>
        <Fragment set:html={`<!--email_off--><a href="mailto:contact.scholarab@gmail.com" aria-label="Email ScholarAB"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg></a><!--/email_off-->`} />
      </div>
      <button
        type="button"
        class="sabh-burger"
        id="sabh-burger"
        aria-controls="sabh-links"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  /* Full window width, not the content measure: the logo sits at the window's
     left edge and the links are centred on the window, the way Apple and
     Tesla lay out their bars. Three columns, the outer two equal, so the
     links stay truly centred whatever the logo's width. */
  .sabh-nav {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 clamp(20px, 4vw, 56px); box-sizing: border-box;
    /* Declared, not content-derived: the home hero subtracts this to fill the
       fold, and a height that moves with a font metric would move the fold. */
    height: var(--sab-nav-h);
  }
  .sabh-logo { display: flex; align-items: center; gap: 9px; text-decoration: none; justify-self: start; }
  .sabh-logo-word { font-family: var(--font-body); font-weight: 700; font-size: 17px; letter-spacing: -0.015em; color: #EEF1EC; }
  /* The wrapper only exists so the burger can sit beside the links in the
     markup; on desktop the links take the middle column and the burger the
     last, as if the wrapper were not there. */
  .sabh-actions { display: contents; }
  /* The nav row is the positioning context for the dropdown, so the panel
     spans the whole window rather than the width of the link it hangs from. */
  .sabh-nav { position: relative; }
  /* Items fill the bar's full height, so the pointer can travel from a link
     down into the panel without crossing a gap that would close it. */
  .sabh-links { display: flex; align-items: stretch; gap: 0; align-self: stretch; }
  .sabh-item { display: flex; align-items: center; }

  /* ── Scholarships dropdown ── */
  .sabh-menu {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 5;
    background: #0A1310; border-top: 1px solid rgba(238, 241, 236,0.08);
    box-shadow: 0 24px 40px -20px rgba(0,0,0,0.6);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
  }
  .sabh-has-menu[data-menu-open] .sabh-menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  /* Hover opens only where hover is real. On a touch screen wider than 900px
     a first tap would otherwise open the panel instead of following the link. */
  @media (hover: hover) {
    .sabh:not([data-drop]) .sabh-has-menu:hover .sabh-menu { opacity: 1; visibility: visible; transform: none; transition: opacity 0.16s ease 0.06s, transform 0.16s ease 0.06s, visibility 0s linear 0.06s; }
    .sabh-has-menu:hover .sabh-link { color: #EEF1EC; background: rgba(238, 241, 236,0.08); }
  }
  /* With the script running (data-drop), the panels lose their own
     background and slide, and sit on one shared .sabh-drop instead, so moving
     between Scholarships and Programs is a crossfade on a panel that never
     closes. The old panel fades out quickly; the new one fades in just behind
     it. Without the script, each panel keeps its own look above. */
  .sabh-drop, .sabh-scrim { display: none; }
  @media (min-width: 901px) {
    .sabh-drop {
      display: block; position: absolute; left: 0; right: 0; top: 100%; z-index: 4;
      height: 0; pointer-events: none;
      background: #0A1310; border-top: 1px solid rgba(238, 241, 236,0.08);
      box-shadow: 0 24px 40px -20px rgba(0,0,0,0.6);
      opacity: 0; visibility: hidden;
      transition: opacity 0.22s ease, height 0.32s cubic-bezier(0.4, 0, 0.2, 1), visibility 0s linear 0.22s;
    }
    .sabh-drop[data-on] { opacity: 1; visibility: visible; transition-delay: 0s; }
    /* Fixed to the viewport, from the bottom of the bar (set by the script)
       down; z-index under the panel and its background. */
    .sabh-scrim {
      display: block; position: fixed; left: 0; right: 0; bottom: 0; top: var(--sab-nav-h);
      z-index: 3; pointer-events: none;
      background: rgba(10, 19, 16, 0.32);
      -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
      opacity: 0; visibility: hidden;
      transition: opacity 0.3s ease, visibility 0s linear 0.3s;
    }
    .sabh-drop[data-on] ~ .sabh-scrim { opacity: 1; visibility: visible; transition-delay: 0s; }
    .sabh-drop[data-snap] { transition: opacity 0.22s ease, visibility 0s; }
    .sabh[data-drop] .sabh-menu {
      background: transparent; border-top-color: transparent; box-shadow: none; transform: none;
      transition: opacity 0.14s ease, visibility 0s linear 0.14s;
    }
    .sabh[data-drop] .sabh-has-menu[data-menu-open] .sabh-menu {
      transition: opacity 0.24s ease 0.06s, visibility 0s linear 0s;
    }
  }
  @media (min-width: 901px) and (prefers-reduced-motion: reduce) {
    .sabh-drop { transition: opacity 0.12s ease, visibility 0s linear 0.12s; }
  }
  .sabh-menu-inner {
    max-width: var(--sab-measure); margin: 0 auto; box-sizing: border-box;
    padding: 32px var(--sab-gutter) 40px;
    display: grid; grid-template-columns: 1fr auto; gap: 48px;
  }
  .sabh-menu ul { list-style: none; margin: 0; padding: 0; }
  /* The tile rows stretch to the full height of the topic list beside them, as
     Tesla's panel does, so nothing sits empty under the grid. The big count up
     top and the name at the bottom give the tall tile something to hold. */
  .sabh-menu-tiles { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 8px; }
  .sabh-tile {
    display: flex; flex-direction: column; justify-content: space-between; gap: 16px; height: 100%; box-sizing: border-box;
    padding: 20px 18px; border-radius: 10px; text-decoration: none;
    border: 1px solid rgba(238, 241, 236,0.1);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .sabh-tile:hover { background: rgba(238, 241, 236,0.06); border-color: rgba(238, 241, 236, 0.22); }
  /* A scope with a hub photo shows it in its tile. The image is only named
     while the menu is open, so the header, which is on every page, costs no
     image bytes until someone actually opens the menu. The gradient keeps the
     number and name readable over a bright sky or a lit skyline. */
  /* The photo lives on ::after, never on the tile itself: .sabh-tile:hover
     sets the `background` shorthand, which would wipe an image on the tile. */
  .sabh-tile-photo {
    position: relative; overflow: hidden; isolation: isolate; background-color: #16211C;
  }
  .sabh-tile-photo::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background-size: cover; background-position: center;
    transition: transform 0.4s ease;
  }
  .sabh-has-menu[data-menu-open] .sabh-tile-photo::after {
    background-image: linear-gradient(rgba(10,19,16,0.5), rgba(10,19,16,0.05) 38%, rgba(10,19,16,0.1) 55%, rgba(10,19,16,0.82)), var(--sabh-tile-img);
  }
  @media (hover: hover) {
    .sabh:not([data-drop]) .sabh-has-menu:hover .sabh-tile-photo::after {
      background-image: linear-gradient(rgba(10,19,16,0.5), rgba(10,19,16,0.05) 38%, rgba(10,19,16,0.1) 55%, rgba(10,19,16,0.82)), var(--sabh-tile-img);
    }
  }
  /* The photo tile's hover is a slow zoom rather than the grey wash, which
     would muddy the image. */
  .sabh-tile-photo:hover { background-color: #16211C; border-color: rgba(238, 241, 236, 0.35); }
  .sabh-tile-photo:hover::after { transform: scale(1.05); }
  .sabh-tile-photo .sabh-tile-num { color: #EEF1EC; text-shadow: 0 1px 12px rgba(0,0,0,0.35); }
  .sabh-tile-photo .sabh-tile-count { color: rgba(238, 241, 236, 0.8); }
  .sabh-tile-num {
    font-family: var(--font-display); font-size: 44px; line-height: 1;
    color: rgba(238, 241, 236, 0.9); letter-spacing: -0.01em; font-variant-numeric: lining-nums;
  }
  .sabh-tile-text { display: flex; flex-direction: column; gap: 2px; margin-top: auto; }
  .sabh-tile-name { font-size: 16px; font-weight: 600; color: #EEF1EC; letter-spacing: -0.005em; }
  .sabh-tile-count { font-size: 13px; color: rgba(238, 241, 236, 0.55); }
  /* Two classes, not one: `.sabh-menu ul` above resets padding and outranks a
     bare `.sabh-menu-list`, which left the divider touching the text. */
  .sabh-menu .sabh-menu-list {
    border-left: 1px solid rgba(238, 241, 236,0.12); padding-left: 40px;
    display: flex; flex-direction: column; gap: 2px; min-width: 190px;
  }
  .sabh-menu-list a {
    display: block; padding: 6px 0; font-size: 14px; font-weight: 500;
    color: rgba(238, 241, 236, 0.78); text-decoration: none;
  }
  .sabh-menu-list a:hover { color: #EEF1EC; }
  @media (max-width: 1100px) {
    .sabh-menu-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sabh-menu { transform: none; transition: none; }
  }
  .sabh-link {
    font-size: 13.5px; font-weight: 500; letter-spacing: 0.005em; color: rgba(238, 241, 236, 0.7);
    text-decoration: none; padding: 8px 15px; border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  /* A soft pill on hover, as on tesla.com: the target is visible before the
     click without an underline or a colour accent. */
  .sabh-link:hover { color: #EEF1EC; background: rgba(238, 241, 236,0.08); }
  .sabh-link-active { color: #EEF1EC; }
  /* Positioned against .sabh-nav like the dropdowns, never against
     .sabh-links: making the link row a containing block shrinks every panel
     to the row's width. The link's own pill is the no-JS fallback; with the glide running, the
     glide is the only highlight. It sits under the links (z-index), fades in
     where the pointer enters, then slides and resizes between links. */
  .sabh-glide {
    position: absolute; top: 0; left: 0; width: 0; height: 0; z-index: 0;
    border-radius: 6px; background: rgba(238, 241, 236, 0.08);
    opacity: 0; pointer-events: none;
    transition: opacity 0.2s ease, transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sabh-glide[data-snap] { transition: opacity 0.2s ease; }
  .sabh-glide[data-on] { opacity: 1; }
  .sabh-link { position: relative; z-index: 1; }
  .sabh-links[data-glide] .sabh-link:hover,
  .sabh-links[data-glide] .sabh-has-menu:hover .sabh-link { background: transparent; }
  @media (prefers-reduced-motion: reduce) {
    .sabh-glide { transition: opacity 0.2s ease; }
  }
  /* Sheet-only furniture: the section label, the per-link counts and the
     footnote are all invisible on desktop. */
  .sabh-sheet-label, .sabh-sheet-foot, .sabh-link-count, .sabh-sub-back { display: none; }
  /* Clipped to nothing until it has keyboard focus, then a small chevron
     beside its link. Never shown to the pointer, which has hover. */
  .sabh-menu-toggle {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%);
    padding: 0; border: 0; background: transparent; color: rgba(238, 241, 236, 0.78); cursor: pointer;
  }
  .sabh-menu-toggle:focus-visible, .sabh-has-menu[data-menu-open] .sabh-menu-toggle:focus {
    position: static; width: 24px; height: 24px; overflow: visible; clip-path: none;
    display: inline-flex; align-items: center; justify-content: center; border-radius: 6px;
  }
  .sabh-has-menu[data-menu-open] .sabh-menu-toggle svg { transform: rotate(180deg); }
  /* The right-hand column, balancing the logo: the same three destinations
     the footer carries, as quiet glyphs in the links' colour. */
  /* :global on the children: the email link is injected with set:html (for
     the email_off comments), so it never receives this component's scope
     attribute and a scoped `a` selector would miss it. */
  .sabh-social { justify-self: end; display: flex; align-items: center; gap: 2px; }
  .sabh-social :global(a) {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 6px; color: rgba(238, 241, 236, 0.7);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .sabh-social :global(a:hover) { color: #EEF1EC; background: rgba(238, 241, 236,0.08); }
  .sabh-social :global(svg) { width: 18px; height: 18px; display: block; }

  /* ── Menu button: three bars that fold into an ✕ while the sheet is open ── */
  .sabh-burger {
    display: none; width: 44px; height: 44px; flex: none; padding: 0; justify-self: end;
    border: 0; border-radius: 8px; background: transparent;
    flex-direction: column; align-items: center; justify-content: center; gap: 4px;
    cursor: pointer; transition: background 0.18s ease;
  }
  .sabh-burger span {
    display: block; width: 16px; height: 1.5px; background: #EEF1EC;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.3, 1), opacity 0.12s linear;
  }
  .sabh-burger[aria-expanded='true'] { background: rgba(238, 241, 236,0.08); }
  .sabh-burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .sabh-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .sabh-burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) {
    .sabh-burger span { transition: none; }
  }

  /* ══ Phone: bar + sheet ══ */
  @media (max-width: 900px) {
    /* Padding-sized again below 900: the hero no longer claims the fold,
       so nothing is subtracting this. */
    .sabh-nav { grid-template-columns: 1fr auto; padding: 0 8px 0 20px; }
    .sabh-burger { display: flex; }
    /* No room beside the logo and the menu button; the footer still carries
       all three on a phone. */
    .sabh-social { display: none; }
    /* Tapping Scholarships in the sheet swaps the link list for the same
       panel the desktop dropdown shows (Ilia, 2026-09-15): photo tiles two
       across, the topic list under them, and a Back button above. */
    .sabh-menu { display: none; }
    .sabh-menu-toggle, .sabh-menu-toggle:focus-visible { display: none; }
    .sabh-item { display: block; }
    .sabh[data-sub] .sabh-item:not([data-sub-open]),
    .sabh[data-sub] [data-sub-open] > .sabh-link,
    .sabh[data-sub] .sabh-sheet-label,
    .sabh[data-sub] .sabh-sheet-foot { display: none; }
    .sabh[data-sub] [data-sub-open] .sabh-menu {
      display: block; position: static; opacity: 1; visibility: visible; transform: none;
      transition: none; background: transparent; border-top: 0; box-shadow: none;
    }
    .sabh-sub-back {
      display: flex; align-items: center; gap: 8px; min-height: 44px; width: 100%;
      padding: 0; margin: 0 0 12px; border: 0; border-bottom: 1px solid rgba(238, 241, 236,0.18);
      background: transparent; color: rgba(238, 241, 236, 0.7); cursor: pointer;
      font-family: var(--font-label); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
    }
    .sabh-menu-inner { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 0 0 24px; }
    .sabh-menu-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
    .sabh-tile { aspect-ratio: 1; padding: 14px 14px 12px; gap: 8px; }
    .sabh-tile-num { font-size: 38px; }
    .sabh-tile-name { font-size: 15px; }
    .sabh[data-sub] [data-sub-open] .sabh-tile-photo::after {
      background-image: linear-gradient(rgba(10,19,16,0.5), rgba(10,19,16,0.05) 38%, rgba(10,19,16,0.1) 55%, rgba(10,19,16,0.82)), var(--sabh-tile-img);
    }
    .sabh-menu .sabh-menu-list {
      border-left: 0; padding-left: 0; min-width: 0;
      border-top: 1px solid rgba(238, 241, 236,0.12); padding-top: 12px;
    }
    .sabh-menu-list a { padding: 12px 0; font-size: 16px; }

    /* Same six anchors, same order, same active class; just a column that
       owns the screen. Nothing to keep in sync with the desktop row. */
    .sabh-links {
      display: none;
      /* The sheet is a descendant of the bar, so the two are ordered inside
         the bar's own stacking context: sheet 1, bar backdrop 2, bar
         contents 3. */
      position: fixed; inset: 0; z-index: 1;
      background: #0A1310;
      flex-direction: column; align-items: stretch; gap: 0;
      padding: calc(var(--sab-nav-h) + 12px) 20px 24px; box-sizing: border-box;
      overflow-y: auto; overscroll-behavior: contain;
    }
    .sabh[data-open] .sabh-links { display: flex; }
    /* The bar rides above the sheet so the logo stays reachable and the
       button that opened the menu is the button that closes it. */
    .sabh[data-open] .sabh-nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 60; background: #0A1310;
    }
    .sabh[data-open] .sabh-nav::before {
      content: ''; position: absolute; inset: 0; background: #0A1310; z-index: 2;
    }
    .sabh[data-open] .sabh-logo,
    .sabh[data-open] .sabh-burger { position: relative; z-index: 3; }

    .sabh-sheet-label {
      display: block; font-family: var(--font-label); font-size: 12px;
      letter-spacing: 0.06em; color: rgba(238, 241, 236, 0.62);
      padding: 14px 0 6px; border-top: 1px solid rgba(238, 241, 236,0.18);
    }
    .sabh-link {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      min-height: 56px; font-size: 22px; font-weight: 600; letter-spacing: -0.01em;
      padding-bottom: 0; border-bottom: 1px solid rgba(238, 241, 236,0.12);
    }
    /* The sheet keeps an accent dot on the current page: at 22px in a list,
       brighter text alone does not tell the rows apart. */
    .sabh-link { padding: 0; border-radius: 0; }
    .sabh-glide { display: none; }
    .sabh-link:hover { background: transparent; }
    .sabh-link-active .sabh-link-label::after {
      content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%;
      background: #2FD3A0; margin-left: 10px; vertical-align: middle;
    }
    .sabh-link-count {
      display: inline-block; font-family: var(--font-label); font-size: 11px;
      color: rgba(238, 241, 236, 0.62);
    }
    .sabh-sheet-foot {
      display: block; margin-top: 26px;
      font-family: var(--font-label); font-size: 12px; letter-spacing: 0.06em;
      color: rgba(238, 241, 236, 0.62); line-height: 1.6;
    }
  }
</style>

<script>
  // The ClientRouter swaps in fresh header markup on every navigation, so the
  // element handles are re-resolved per page while the document-level
  // listeners below are bound exactly once.
  let header: HTMLElement | null = null;
  let burger: HTMLElement | null = null;
  let sheet: HTMLElement | null = null;

  const isOpen = () => !!header?.hasAttribute('data-open');

  function openMenu() {
    if (!header || !burger || !sheet) return;
    header.setAttribute('data-open', '');
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Close menu');
    document.documentElement.style.overflow = 'hidden';
    sheet.querySelector<HTMLElement>('a')?.focus();
  }

  const isSub = () => !!header?.hasAttribute('data-sub');
  const phone = window.matchMedia('(max-width: 900px)');

  // A row's own panel inside the sheet (phones only). The row is marked rather
  // than named, so Scholarships and Programs need no separate handling.
  const openItem = () => sheet?.querySelector<HTMLElement>('[data-sub-open]') ?? null;

  function openSub(item: HTMLElement) {
    if (!header || !sheet) return;
    item.setAttribute('data-sub-open', '');
    header.setAttribute('data-sub', '');
    sheet.scrollTop = 0;
    item.querySelector<HTMLElement>('[data-sabh-back]')?.focus();
  }

  function closeSub() {
    const item = openItem();
    header?.removeAttribute('data-sub');
    item?.removeAttribute('data-sub-open');
    item?.querySelector<HTMLElement>('.sabh-link')?.focus();
  }

  function closeMenu({ restoreFocus = false } = {}) {
    header?.removeAttribute('data-sub');
    openItem()?.removeAttribute('data-sub-open');
    header?.removeAttribute('data-open');
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Open menu');
    document.documentElement.style.overflow = '';
    if (restoreFocus) burger?.focus();
  }

  function setDropdown(item: HTMLElement, open: boolean) {
    // One panel at a time: opening Programs is a switch, not a second panel.
    if (open) header?.querySelectorAll<HTMLElement>('.sabh-has-menu[data-menu-open]').forEach(o => { if (o !== item) setDropdown(o, false); });
    item.toggleAttribute('data-menu-open', open);
    const toggle = item.querySelector<HTMLElement>('[data-sabh-toggle]');
    toggle?.setAttribute('aria-expanded', String(open));
    const label = item.querySelector('.sabh-link-label')?.textContent ?? '';
    toggle?.setAttribute('aria-label', `${open ? 'Hide' : 'Show'} ${label} menu`);
    syncDrop();
  }

  // Tells the page a dropdown opened or closed. The blur under an open panel
  // is recomputed for every frame of whatever moves beneath it, and the home
  // film is 30 frames a second of exactly that: measured in Chrome, 8 to 10
  // times the GPU work of the closed menu, against none at all over a still
  // page. The film listens and holds while a panel covers it.
  function announceMenu(open: boolean) {
    document.dispatchEvent(new CustomEvent('sab:menu', { detail: { open } }));
  }

  // Sizes the shared background to whichever panel is open. Opening from
  // closed takes the height at once and fades in; a switch between panels
  // animates the height, so the background itself never closes.
  function syncDrop() {
    const drop = header?.querySelector<HTMLElement>('.sabh-drop');
    if (!drop) return;
    const panel = header!.querySelector<HTMLElement>('.sabh-has-menu[data-menu-open] .sabh-menu');
    if (!panel) {
      if (drop.hasAttribute('data-on')) announceMenu(false);
      drop.removeAttribute('data-on');
      return;
    }
    const first = !drop.hasAttribute('data-on');
    if (first) announceMenu(true);
    const scrim = header!.querySelector<HTMLElement>('.sabh-scrim');
    if (scrim && first) scrim.style.top = `${header!.querySelector('.sabh-nav')!.getBoundingClientRect().bottom}px`;
    drop.toggleAttribute('data-snap', first);
    drop.style.height = `${panel.offsetHeight}px`;
    if (first) void drop.offsetHeight;
    drop.removeAttribute('data-snap');
    drop.setAttribute('data-on', '');
  }

  // Desktop hover drives the same open state the keyboard toggle does. A
  // short intent delay before the first open, so a pointer crossing the bar
  // does not flash a panel; none on a switch, since the panel is already
  // there; and a short grace on the way out.
  function initHoverMenus(nav: HTMLElement) {
    if (!header || !matchMedia('(hover: hover)').matches) return;
    header.dataset.drop = '';
    let timer = 0;
    const openItemNow = () => header!.querySelector<HTMLElement>('.sabh-has-menu[data-menu-open]');
    const closeAll = () => header!.querySelectorAll<HTMLElement>('.sabh-has-menu[data-menu-open]').forEach(o => setDropdown(o, false));
    nav.addEventListener('pointerover', e => {
      if (phone.matches) return;
      const item = (e.target as HTMLElement).closest<HTMLElement>('.sabh-item');
      if (!item) return;
      clearTimeout(timer);
      const current = openItemNow();
      if (item === current) return;
      if (!item.classList.contains('sabh-has-menu')) {
        if (current) timer = window.setTimeout(closeAll, 90);
        return;
      }
      if (current) setDropdown(item, true);
      else timer = window.setTimeout(() => setDropdown(item, true), 70);
    });
    nav.addEventListener('pointerleave', () => {
      clearTimeout(timer);
      timer = window.setTimeout(closeAll, 140);
    });
  }

  // Moves the one highlight to whichever link the pointer is over. Inside an
  // open Scholarships panel the pointer is still within that item, so the
  // highlight stays on Scholarships, as the per-link pill used to.
  function initGlide(nav: HTMLElement) {
    const glide = nav.querySelector<HTMLElement>('.sabh-glide');
    if (!glide || !matchMedia('(hover: hover)').matches) return;
    nav.dataset.glide = '';
    nav.addEventListener('pointerover', e => {
      if (matchMedia('(max-width: 900px)').matches) return;
      const link = (e.target as HTMLElement).closest('.sabh-item')?.querySelector<HTMLElement>('.sabh-link');
      if (!link) return;
      // Measured from the glide's containing block (.sabh-nav), not the link row.
      const box = (glide.offsetParent ?? nav).getBoundingClientRect();
      const r = link.getBoundingClientRect();
      const first = !glide.hasAttribute('data-on');
      // Entering from outside: appear in place, then only later moves slide.
      glide.toggleAttribute('data-snap', first);
      glide.style.width = `${r.width}px`;
      glide.style.height = `${r.height}px`;
      glide.style.transform = `translate(${r.left - box.left}px, ${r.top - box.top}px)`;
      if (first) void glide.offsetWidth;
      glide.removeAttribute('data-snap');
      glide.setAttribute('data-on', '');
    });
    nav.addEventListener('pointerleave', () => glide.removeAttribute('data-on'));
  }

  function initSabHeader() {
    header = document.querySelector<HTMLElement>('[data-sab-header]');
    burger = document.getElementById('sabh-burger');
    sheet = document.getElementById('sabh-links');
    if (!header || !burger || !sheet || header.dataset.init) return;
    header.dataset.init = 'true';

    burger.addEventListener('click', () => (isOpen() ? closeMenu({ restoreFocus: true }) : openMenu()));

    initGlide(sheet);
    initHoverMenus(sheet);

    // Desktop dropdown toggles. Focus leaving the item closes its panel, so a
    // Tab past the last link, or a click elsewhere, never leaves it hanging.
    header.querySelectorAll<HTMLElement>('.sabh-has-menu').forEach(item => {
      item.querySelector('[data-sabh-toggle]')?.addEventListener('click', () => {
        setDropdown(item, !item.hasAttribute('data-menu-open'));
      });
      item.addEventListener('focusout', e => {
        if (!item.contains(e.relatedTarget as Node | null)) setDropdown(item, false);
      });
    });

    // Tapping a destination closes the sheet. The ClientRouter swaps the page
    // without a reload, so nothing else would.
    sheet.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-sabh-back]')) {
        closeSub();
        return;
      }
      // In the sheet, a row with a panel opens it instead of navigating; the
      // panel's own "All scholarships" or "All programs" link goes to the
      // directory. The ClientRouter skips clicks already default-prevented.
      const item = target.closest<HTMLElement>('.sabh-has-menu');
      if (isOpen() && phone.matches && item && target.closest('.sabh-link')) {
        e.preventDefault();
        openSub(item);
        return;
      }
      if (target.closest('a')) closeMenu();
    });
  }

  document.addEventListener('keydown', e => {
    // In the sheet, Escape backs out of the Scholarships panel first.
    if (e.key === 'Escape' && isOpen() && isSub()) {
      closeSub();
      return;
    }
    // Escape inside a desktop dropdown closes it and hands focus back to
    // the toggle that opened it, so the next Tab resumes from there.
    if (e.key === 'Escape') {
      const item = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>('.sabh-has-menu[data-menu-open]');
      if (item) {
        setDropdown(item, false);
        item.querySelector<HTMLElement>('[data-sabh-toggle]')?.focus();
      }
    }
    if (!isOpen() || !sheet || !burger) return;
    if (e.key === 'Escape') {
      closeMenu({ restoreFocus: true });
      return;
    }
    if (e.key !== 'Tab') return;
    // Keep Tab inside the sheet and its button while the sheet covers
    // everything else on screen.
    // .sabh-link only: the dropdown's links live inside the sheet's markup but
    // are display:none on a phone, and focus() on those silently does nothing.
    // In the Scholarships panel the stops are its Back button and links instead.
    const stops = isSub()
      ? [...(openItem()?.querySelectorAll<HTMLElement>('.sabh-menu button, .sabh-menu a[href]') ?? []), burger]
      : [...sheet.querySelectorAll<HTMLElement>('a.sabh-link[href]'), burger];
    const first = stops[0];
    const last = stops[stops.length - 1];
    if (!first || !last) return;
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // A sheet left open across a rotation to landscape would be a fixed panel
  // with no visible way out; the button it belongs to is hidden above 900px.
  phone.addEventListener('change', ev => {
    if (!ev.matches && isOpen()) closeMenu();
  });

  // Never leave the scroll lock behind on a client-side navigation.
  document.addEventListener('astro:before-swap', () => {
    document.documentElement.style.overflow = '';
  });

  // ── Sticky header collapse ───────────────────────────────────────────────
  // Flips one attribute on <html>; every property that moves is a transition
  // in global.css. Hysteresis, so a scroll that hovers on the line cannot make
  // the header flap: it condenses at 116px down and only opens back up at 36px.
  // Read inside rAF and never written unless the state actually changes, so a
  // fast scroll costs one class write, not one per frame.
  const STICK_DOWN = 116;
  const STICK_UP = 36;
  let stuckTicking = false;
  function readStuck(): void {
    stuckTicking = false;
    const root = document.documentElement;
    const stuck = root.hasAttribute('data-sab-stuck');
    const y = window.scrollY;
    if (!stuck && y > STICK_DOWN) root.setAttribute('data-sab-stuck', '');
    else if (stuck && y < STICK_UP) root.removeAttribute('data-sab-stuck');
  }
  function onStickScroll(): void {
    if (stuckTicking) return;
    stuckTicking = true;
    requestAnimationFrame(readStuck);
  }
  window.addEventListener('scroll', onStickScroll, { passive: true });
  // A client-side navigation can land part-way down a page, and a reload
  // restores the old offset before any scroll event fires.
  document.addEventListener('astro:page-load', readStuck);
  readStuck();

  initSabHeader();
  document.addEventListener('astro:page-load', initSabHeader);
</script>
