---
// Dark header band from the claude.ai/design "ScholarAB" pages:
// nav with accent underline on the active link.
// (The mono annotation bar and the home-page Home-item omission from the
// design were both removed at Ilia's request, 2026-07-11.)

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Scholarships', href: '/scholarships' },
  { label: 'Programs', href: '/programs' },
  { label: 'Match', href: '/match' },
  { label: 'Saved', href: '/saved' },
  { label: 'About', href: '/about' },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// Scrolling announcement band (fishback2026.com-style): a short pair of
// linked CTAs repeated to fill the loop.
const tickerPair = [
  { label: 'Find your match', rest: 'in 60 seconds', href: '/match' },
  { label: 'Browse scholarships', rest: 'open right now', href: '/scholarships' },
];
const tickerItems = Array.from({ length: 4 }, () => tickerPair).flat();
---

<div class="sabh-nav">
  <a href="/" class="sabh-logo" aria-label="ScholarAB home">
    <svg width="30" height="30" viewBox="0 0 40 40" aria-hidden="true">
      <polygon points="20,4 37,37 3,37" fill="#2FD3A0"></polygon>
      <polygon points="20,4 24.5,13 15.5,13" fill="#F2F0E9"></polygon>
    </svg>
    <span class="sabh-logo-word">Scholar<span style="color:var(--sab-band-accent);">AB</span></span>
  </a>
  <div class="sabh-links">
    {navItems.map(n => (
      <a
        href={n.href}
        class={`sabh-link${isActive(n.href) ? ' sabh-link-active' : ''}`}
        aria-current={isActive(n.href) ? 'page' : undefined}
      >{n.label}</a>
    ))}
    <a href="/match" class="sabh-cta">Find my match</a>
    <button id="sabh-theme" aria-label="Toggle light/dark theme">
      <span class="sabh-theme-moon" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"/>
        </svg>
      </span>
      <span class="sabh-theme-sun" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/>
        </svg>
      </span>
    </button>
  </div>
</div>
<div class="sabh-ticker-band">
  <div class="sabh-ticker">
    {[false, true].map(hidden => (
      <span class="sabh-ticker-half" aria-hidden={hidden || undefined}>
        {tickerItems.map(t => (
          <span class="sabh-ticker-item">
            <a href={t.href}>{t.label}</a>
            <span>{t.rest}</span>
          </span>
        ))}
      </span>
    ))}
  </div>
</div>

<style>
  .sabh-nav { display: flex; justify-content: space-between; align-items: center; padding: 24px 48px; }
  .sabh-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .sabh-logo-word { font-family: 'Archivo', sans-serif; font-weight: 800; font-size: 21px; letter-spacing: -0.02em; color: var(--sab-band-ink); }
  .sabh-links { display: flex; align-items: center; gap: 34px; }
  .sabh-link {
    font-size: 14.5px; font-weight: 500; color: rgba(var(--sab-band-ink-rgb),0.75);
    text-decoration: none; border-bottom: 2px solid transparent; padding-bottom: 4px;
  }
  .sabh-link:hover { color: var(--sab-band-ink); }
  .sabh-link-active { color: var(--sab-band-ink); border-bottom-color: #2FD3A0; }
  .sabh-cta {
    font-size: 14px; font-weight: 600; background: #2FD3A0; color: #0B1512;
    padding: 10px 20px; border-radius: 100px; text-decoration: none;
  }
  .sabh-cta:hover { background: var(--sab-band-ink); color: var(--sab-dark-band); }

  /* fishback2026.com campaign-ticker parity: Manrope 600 14px, solid band,
     45px tall, 60px between items, 30s linear loop, 1px underline offset 3px */
  .sabh-ticker-band {
    background: #0E2A20;
    overflow: hidden;
  }
  .sabh-ticker {
    display: flex; white-space: nowrap; align-items: center; height: 45px;
    font-family: 'Manrope', sans-serif; font-size: 14px; font-weight: 600;
    color: #FFFFFF;
    animation: sabh-tick 30s linear infinite; will-change: transform;
  }
  .sabh-ticker-half { display: inline-flex; }
  .sabh-ticker-item { display: inline-flex; gap: 5px; padding-right: 60px; }
  .sabh-ticker-item a {
    color: #2FD3A0; text-decoration: underline;
    text-decoration-thickness: 1px; text-underline-offset: 3px;
  }
  .sabh-ticker-item a:hover { color: #F2F0E9; }
  @keyframes sabh-tick {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sabh-ticker { animation: none; }
  }

  @media (max-width: 900px) {
    .sabh-nav { padding: 18px 20px; }
    .sabh-link { display: none; } /* bottom tab bar covers navigation on mobile */
  }
  @media (max-width: 480px) {
    .sabh-cta { padding: 8px 16px; font-size: 13px; }
  }

  /* Theme toggle — follows the header band's ink color */
  #sabh-theme {
    position: relative; width: 36px; height: 36px; flex: none;
    border-radius: 100px; border: 1px solid rgba(var(--sab-band-ink-rgb),0.3);
    background: transparent; color: var(--sab-band-ink); cursor: pointer; overflow: hidden;
    margin-left: -12px; /* tuck closer to the CTA than the 34px link gap */
  }
  #sabh-theme:hover { border-color: var(--sab-band-ink); }
  .sabh-theme-moon, .sabh-theme-sun {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    transition: transform 400ms cubic-bezier(0.34,1.56,0.64,1), opacity 400ms cubic-bezier(0.34,1.56,0.64,1);
  }
  @media (prefers-reduced-motion: reduce) {
    .sabh-theme-moon, .sabh-theme-sun { transition: none; }
  }
</style>

<style is:global>
  /* Icon state follows the html.theme-* class (set before CSS loads) */
  .sabh-theme-moon { transform: rotate(0deg) scale(1); opacity: 1; }
  .sabh-theme-sun  { transform: rotate(180deg) scale(0); opacity: 0; }
  html.theme-light .sabh-theme-moon { transform: rotate(-180deg) scale(0); opacity: 0; }
  html.theme-light .sabh-theme-sun  { transform: rotate(0deg) scale(1); opacity: 1; }
</style>

<script>
  function initSabTheme() {
    const btn = document.getElementById('sabh-theme');
    if (!btn || btn.dataset.init) return;
    btn.dataset.init = 'true';
    btn.addEventListener('click', async () => {
      const { applyTheme, getStoredTheme } = await import('../../lib/themeClient.ts');
      applyTheme(getStoredTheme() === 'dark' ? 'light' : 'dark');
    });
  }
  initSabTheme();
  document.addEventListener('astro:page-load', initSabTheme);
</script>
