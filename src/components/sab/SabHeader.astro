---
import { todayDate as albertaToday } from '../../lib/calendar';
// Dark header band. Thin, full-width bar in the Apple/Tesla manner (Ilia,
// 2026-09-13): logo at the window's left edge, links centred, no CTA pill.
// The current page is marked by brighter text, not an accent underline.
// (The mono annotation bar was removed at Ilia's request, 2026-07-11.)
//
// There is no Home link: the logo is an anchor to '/' on every page and in
// the open phone sheet, so a Home row was a second control for a destination
// the wordmark already owns (Ilia, 2026-09-15).
//
// Below 900px the same five anchors become a full-screen sheet behind a
// 44×44 button ("ScholarAB Mobile Home.dc.html", state B); one nav, two
// layouts, so there is no second link list to keep in sync.

import SabTour from './SabTour.astro';
import { loadScholarships, loadPrograms } from '../../lib/data-loader';
import { programIsListed } from '../../lib/status';
import { guides } from '../../lib/guides';
import { SCHOLARSHIP_FACETS, PROGRAM_FACETS, PROGRAM_FORMATS, MENU_SCOPES, facetItems, MIN_FACET_ITEMS } from '../../lib/facets';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
// The bar's tone (global.css, "Header tones"): home owns its own dark film
// look; every other page is white.
const tone = currentPath === '/' ? 'dark' : 'light';

// Counts shown beside two links in the mobile sheet. Same definitions the
// home hero uses: every scholarship in the directory, and the programs
// /programs actually lists. Both loaders are cached, so this is free after
// the first page of a build, if the data is unreachable the counts simply
// do not render.
let scholarshipCount: number | null = null;
let programCount: number | null = null;
// The real listing the How it works walkthrough draws as its example row.
let tourExample: { title: string; amount: string; deadline: string | null } | null = null;

// The Scholarships and Programs dropdowns (Tesla-style, Ilia 2026-09-13,
// Programs added 2026-09-15): tiles for the hubs, a text list beside them.
// The Scholarships tiles are MENU_SCOPES (facets.ts), shared with the home
// carousel. The Programs tiles are the format hubs (what shape the thing is),
// because that is what a reader is choosing between; the subject hubs sit in
// the list beside them.
const MENU_TOPICS = ['stem', 'arts', 'trades', 'community', 'sports', 'indigenous'];
const scholarshipFacetBySlug = new Map(SCHOLARSHIP_FACETS.map(f => [f.slug, f]));

type MenuLink = { label: string; href: string };
interface Tile { label: string; href: string; count: number | null; backdrop?: string }
const scopeFacets = MENU_SCOPES
  .map(slug => scholarshipFacetBySlug.get(slug))
  .filter(f => f !== undefined);
const tileOf = (f: { slug: string; label: string; backdrop?: string }, base: string, count: number | null): Tile =>
  ({ label: f.label, href: `${base}${f.slug}/`, count, backdrop: f.backdrop });

let scopeTiles: Tile[] = scopeFacets.map(f => tileOf(f, '/scholarships/', null));
// A hub below the floor has no page, so it gets no tile and no link either.
let formatTiles: Tile[] = [];
let fieldLinks: { label: string; href: string }[] = [];

try {
  const [scholarships, programs] = await Promise.all([loadScholarships(), loadPrograms()]);
  const today = albertaToday();
  const listedPrograms = programs.filter(p => programIsListed(p, today));
  scholarshipCount = scholarships.length;
  const loran = scholarships.find(s => s.title === 'Loran Scholarship');
  if (loran) tourExample = { title: loran.title, amount: loran.amount ?? '', deadline: loran.deadline ?? null };
  programCount = listedPrograms.length;
  // Biggest scope first. Array sort is stable, so a tie keeps the source order.
  scopeTiles = scopeFacets
    .map(f => tileOf(f, '/scholarships/', facetItems(f, scholarships).length))
    .sort((a, b) => b.count! - a.count!);
  const liveHub = (f: { slug: string }) =>
    facetItems(f as Parameters<typeof facetItems>[0], listedPrograms).length;
  formatTiles = PROGRAM_FORMATS
    .map(f => ({ facet: f, items: liveHub(f) }))
    .filter(({ items }) => items >= MIN_FACET_ITEMS)
    .map(({ facet, items }) => tileOf(facet, '/programs/', items))
    .sort((a, b) => b.count! - a.count!);
  fieldLinks = PROGRAM_FACETS
    .filter(f => liveHub(f) >= MIN_FACET_ITEMS)
    .map(f => ({ label: f.label, href: `/programs/${f.slug}/` }));
} catch {
  /* counts are decoration; the nav works without them */
}

const topicLinks = [
  { label: 'All scholarships', href: '/scholarships/' },
  // Not a place, so not a photo tile: the school's own awards (2026-10-01).
  { label: 'University & college awards', href: '/scholarships/university-college-awards/' },
  { label: 'Closing soon', href: '/#closing' },
  { label: 'Deadline calendar', href: '/deadlines/' },
  ...MENU_TOPICS
    .map(slug => scholarshipFacetBySlug.get(slug))
    .filter(f => f !== undefined)
    .map(f => ({ label: f.label, href: `/scholarships/${f.slug}/` })),
  { label: 'Guides', href: '/guides/' },
];

// Tiles are formats, so the column beside them is the other axis: the subject
// hubs, then the guides. Both are one click from the panel rather than one
// click plus a chip row.
const programLinks = [
  { label: 'All programs', href: '/programs/' },
  ...fieldLinks,
  { label: 'Guides', href: '/guides/' },
];

// Explore presents each tool or guide once, as a direct link.
const EXPLORE_GUIDES: [string, string][] = [
  ['alexander-rutherford-scholarship-guide', 'Rutherford Scholarship guide'],
  ['how-to-write-a-scholarship-essay', 'Writing a scholarship essay'],
  ['grade-11-scholarship-timeline', 'Grade 11 timeline'],
];
const exploreLinks: MenuLink[] = [
  { label: 'Build my combo', href: '/match/' },
  { label: 'Closing soon', href: '/#closing' },
  { label: 'Deadline calendar', href: '/deadlines/' },
  { label: 'All guides', href: '/guides/' },
  ...EXPLORE_GUIDES
    .filter(([slug]) => guides.some(g => g.slug === slug))
    .map(([slug, label]) => ({ label, href: `/guides/${slug}/` })),
  { label: 'Reference letter template', href: '/templates/reference-letter/' },
  { label: 'For educators', href: '/educators/' },
  { label: 'What changed', href: '/updates/' },
];

// The desktop dropdowns are SpaceX's plain lists, five rows at most
// (Ilia, 2026-10-03; six to five 2026-10-05). The phone sheet keeps the full tiles and lists below.
const DESK_MAX = 5;
const scholarshipDesk: MenuLink[] = [
  { label: 'All scholarships', href: '/scholarships/' },
  ...scopeTiles.slice(0, DESK_MAX - 2),
  // Short on the desktop list (Ilia, 2026-10-03); the phone sheet keeps the full name.
  { label: 'Entrance awards', href: '/scholarships/university-college-awards/' },
];
const programDesk: MenuLink[] = [
  { label: 'All programs', href: '/programs/' },
  ...formatTiles.slice(0, DESK_MAX - 1),
];
const exploreDesk: MenuLink[] = [
  { label: 'Build my combo', href: '/match/' },
  { label: 'Deadline calendar', href: '/deadlines/' },
  { label: 'Guides', href: '/guides/' },
  { label: 'For educators', href: '/educators/' },
  { label: 'What changed', href: '/updates/' },
];

// Which nav rows carry a panel, and what goes in it.
const MENUS: Record<string, { label: string; tiles: Tile[]; links: MenuLink[]; desk: MenuLink[] }> = {
  '/scholarships/': { label: 'Scholarships by location and topic', tiles: scopeTiles, links: topicLinks, desk: scholarshipDesk },
  '/programs/': { label: 'Programs by format and field', tiles: formatTiles, links: programLinks, desk: programDesk },
  '/match/': { label: 'Explore the quiz, deadlines, guides and more', tiles: [], links: exploreLinks, desk: exploreDesk },
};
for (const m of Object.values(MENUS)) m.desk = m.desk.slice(0, DESK_MAX);

// Five in the bar. Deadlines, the quiz and the guides live under Explore.
// A row with a menu only opens it, so its href is the key into MENUS and the
// path it lights up on, not a destination. `also` lights Explore on the pages
// it holds.
const navItems: { label: string; href: string; count: number | null; also?: string[]; hint?: string }[] = [
  { label: 'Scholarships', href: '/scholarships/', count: scholarshipCount },
  { label: 'Programs', href: '/programs/', count: programCount },
  // The hint is for the phone sheet, where "Explore" alone did not say the
  // quiz and the deadline calendar were inside (critique 2026-10-01).
  { label: 'Explore', href: '/match/', count: null, also: ['/deadlines/', '/guides/', '/combos/'], hint: 'Build my combo, deadlines, guides' },
  { label: 'My combo', href: '/saved/', count: null },
  { label: 'About', href: '/about/', count: null },
];

// Compare with a normalized trailing slash on both sides. The nav hrefs carry
// one (bare paths 308-redirect in production, so linking to them split every
// page across two indexed URLs), but callers pass currentPath either way;
// a bare '/scholarships' must still light up the '/scholarships/' tab.
const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const isActive = (href: string, also: string[] = []) =>
  href === '/' ? currentPath === '/' : [href, ...also].some(h => withSlash(currentPath).startsWith(withSlash(h)));
---

{/* data-nosnippet: Google quoted this menu ("Scholarships 971 Programs 117
    Match Saved About") as the text of our AI Overview source card for the
    Persons Case Scholarship (2026-09-30). The attribute keeps site chrome out
    of snippets and AI summaries; links are still crawled. Google honours it on
    div, span and section only, hence the display: contents wrapper. */}
<div class="sab-nosnippet" data-nosnippet>
<header class="sabh" data-sab-header data-tone={tone}>
  <div class="sabh-nav">
    <a href="/" class="sabh-logo" aria-label="ScholarAB home">
      <img class="sabh-logo-dark" src="/brand/scholarab-logo-on-dark.svg" alt="" width="124" height="28" />
      {tone !== 'dark' && <img class="sabh-logo-light" src="/brand/scholarab-logo.svg" alt="" width="124" height="28" />}
    </a>
    <div class="sabh-actions">
      <!-- The site nav is a real landmark: it is the only way to jump past
           these links, or straight to them, without walking the whole page. -->
      <nav class="sabh-links" id="sabh-links" aria-label="Main">
        <div class="sabh-sheet-label" aria-hidden="true"></div>
        {navItems.map(n => (
          <div class={`sabh-item${MENUS[n.href] ? ' sabh-has-menu' : ''}`}>
            {/* A row with a menu is a button, not a link (Ilia, 2026-10-12,
                after spacex.com): its first entry already goes where the link
                did, so the label only opens the list. One control for pointer,
                keyboard and the phone sheet. */}
            {MENUS[n.href] ? (
              <button
                type="button"
                class={`sabh-link${isActive(n.href, n.also) ? ' sabh-link-active' : ''}`}
                data-sabh-toggle
                aria-expanded="false"
                aria-controls={`sabh-menu-${n.label.toLowerCase()}`}
              >
                <span class="sabh-link-label">{n.label}</span>
                {n.count !== null && <span class="sabh-link-count" aria-hidden="true">{n.count.toLocaleString('en-CA')}</span>}
                {n.hint && <span class="sabh-link-hint" aria-hidden="true">{n.hint}</span>}
                <svg class="sabh-chev" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            ) : (
              <a
                href={n.href}
                class={`sabh-link${isActive(n.href, n.also) ? ' sabh-link-active' : ''}`}
                aria-current={isActive(n.href) ? 'page' : undefined}
              >
                <span class="sabh-link-label">{n.label}</span>
                {/* How many listings are on the reader's list, filled from the
                    browser by the script below; the tray count on a menu board. */}
                {n.href === '/saved/' && <span class="sabh-saved-n" data-saved-n hidden></span>}
              </a>
            )}
            {MENUS[n.href] && (
              /* Desktop: opens on hover (pointer devices) or from the toggle
                 above (keyboard). Phones: the sheet swaps the link list for
                 this panel instead of navigating. */
              <div class="sabh-menu" id={`sabh-menu-${n.label.toLowerCase()}`} role="group" aria-label={MENUS[n.href]!.label}>
                <button type="button" class="sabh-sub-back" data-sabh-back>
                  <span aria-hidden="true">←</span> Back
                </button>
                <ul class="sabh-menu-desk">
                  {MENUS[n.href]!.desk.map(l => (
                    <li><a href={l.href}>{l.label}</a></li>
                  ))}
                </ul>
                <div class:list={['sabh-menu-inner', { 'sabh-menu-inner-compact': MENUS[n.href]!.tiles.length === 0 }]}>
                  {MENUS[n.href]!.tiles.length > 0 && <ul class="sabh-menu-tiles">
                    {MENUS[n.href]!.tiles.map(t => (
                      <li>
                        <a
                          href={t.href}
                          class:list={['sabh-tile', { 'sabh-tile-photo': t.backdrop }]}
                          style={t.backdrop ? `--sabh-tile-img: url(/photos/backdrops/${t.backdrop}-tile.webp)` : undefined}
                        >
                          {t.count !== null && (
                            <span class="sabh-tile-num">{t.count.toLocaleString('en-CA')}</span>
                          )}
                          <span class="sabh-tile-text">
                            <span class="sabh-tile-name">{t.label}</span>
                            {t.count !== null ? (
                              <span class="sabh-tile-count">
                                {n.href === '/programs/'
                                  ? (t.count === 1 ? 'program' : 'programs')
                                  : (t.count === 1 ? 'scholarship' : 'scholarships')}
                              </span>
                            ) : null}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>}
                  <ul class="sabh-menu-list">
                    {MENUS[n.href]!.links.map(l => (
                      <li><a href={l.href}>{l.label}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </div>
        ))}
        <div class="sabh-item sabh-how-row">
          <button type="button" class="sabh-link" data-tour-open="sheet"><span class="sabh-link-label">How it works</span></button>
        </div>
        <div class="sabh-item sabh-how-row">
          <button type="button" class="sabh-link sabh-theme-row" role="switch" aria-checked="false" data-sabh-theme><span class="sabh-link-label">Dark mode</span><span class="sabh-theme-ind" aria-hidden="true"><span></span></span></button>
        </div>
      </nav>
      {/* The gear holds the footer's CONTACT destinations, social links
          included: outside links open a new tab, and the mailto sits inside
          email_off so Cloudflare's email obfuscation does not rewrite it. */}
      <div class="sabh-right">
      {/* Opt-in: a quiet button, never opened for anyone (SabTour). Text from
          1101px, where the bar has room; the "i" alone from 901 to 1100. */}
      <button type="button" class="sabh-how" data-tour-open="bar" aria-label="How it works">
        <span class="sabh-how-i" aria-hidden="true">i</span><span class="sabh-how-text">How it works</span>
      </button>
      {/* The gear: the site's small print and contact in one place, the way
          polymarket.com folds its links behind one button. */}
      <div class="sabh-gear" data-sabh-gear>
        <button type="button" class="sabh-gear-btn" aria-label="More" aria-expanded="false" aria-controls="sabh-gear-panel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
        <div class="sabh-gear-panel" id="sabh-gear-panel">
          <ul class="sabh-gear-list">
            <li><Fragment set:html={`<!--email_off--><a href="mailto:contact.scholarab@gmail.com">Email us</a><!--/email_off-->`} /></li>
            <li><a href="/guides/">Guides</a></li>
            <li><a href="/about/">Help center</a></li>
            <li><a href="/educators/">For educators</a></li>
            <li><a href="/updates/">What's new</a></li>
          </ul>
          <div class="sabh-gear-dark">
            <span>Dark mode</span>
            <button type="button" class="sabh-gear-switch" role="switch" aria-checked="false" aria-label="Dark mode" data-sabh-theme><span></span></button>
          </div>
          <ul class="sabh-gear-small">
            <li><a href="/terms/">Terms of use</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/credits/">Credits</a></li>
          </ul>
          <div class="sabh-gear-social">
          <a href="https://www.instagram.com/scholarab.ca" target="_blank" rel="noopener noreferrer" aria-label="ScholarAB on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none" /></svg>
          </a>
          <a href="https://www.tiktok.com/@scholarab" target="_blank" rel="noopener noreferrer" aria-label="ScholarAB on TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.77.11V9.77a5.7 5.7 0 0 0-.77-.05 5.68 5.68 0 1 0 5.68 5.68V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-3.24-1.48z" /></svg>
          </a>
          <a href="https://www.youtube.com/@scholaralberta" target="_blank" rel="noopener noreferrer" aria-label="ScholarAB on YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.58 7.19a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.82.42a2.5 2.5 0 0 0-1.76 1.77C2 8.76 2 12 2 12s0 3.24.42 4.81a2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.82-.42a2.5 2.5 0 0 0 1.76-1.77C22 15.24 22 12 22 12s0-3.24-.42-4.81zM10 15V9l5.2 3L10 15z" /></svg>
          </a>
          </div>
        </div>
      </div>
      </div>
      <button
        type="button"
        class="sabh-burger"
        id="sabh-burger"
        aria-controls="sabh-links"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
<SabTour scholarships={scholarshipCount} programs={programCount} example={tourExample} />
</div>

<style>
  /* Full window width, not the content measure: the logo sits at the window's
     left edge and the links are centred on the window, the way Apple and
     Tesla lay out their bars. Three columns, the outer two equal, so the
     links stay truly centred whatever the logo's width. */
  .sabh-nav {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 clamp(20px, 4vw, 56px); box-sizing: border-box;
    /* Declared, not content-derived: the home hero subtracts this to fill the
       fold, and a height that moves with a font metric would move the fold. */
    height: var(--sab-nav-h);
  }
  /* The logo (2026-10-11): Scholar in Big Shoulders, the site's headline face, with AB cut
     out of a green plate, one SVG drawn for dark backgrounds. Its size is fixed in the markup, so it
     never shifts the bar. */
  .sabh-logo { display: flex; align-items: center; text-decoration: none; justify-self: start; }
  /* 28px tall at every width (2026-10-11, measured against 24 to 32): the AB in the plate
     reads, and the 52px bar keeps 12px above and below. Centred on the links' cap height and
     flush with the headline's left edge to within 1.5px. */
  .sabh-logo img { flex: none; }
  /* The wrapper only exists so the burger can sit beside the links in the
     markup; on desktop the links take the middle column and the burger the
     last, as if the wrapper were not there. */
  .sabh-actions { display: contents; }
  /* The nav row is the positioning context for the dropdown, so the panel
     spans the whole window rather than the width of the link it hangs from. */
  .sabh-nav { position: relative; }
  /* Items fill the bar's full height, so the pointer can travel from a link
     down into the panel without crossing a gap that would close it. */
  .sabh-links { display: flex; align-items: stretch; gap: 0; align-self: stretch; }
  .sabh-item { display: flex; align-items: center; }

  /* ── Scholarships dropdown ── */
  .sabh-menu {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 5;
    background: #0A1310; border-top: 1px solid rgba(238, 241, 236,0.08);
    box-shadow: 0 24px 40px -20px rgba(0,0,0,0.6);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
  }
  .sabh-has-menu[data-menu-open] .sabh-menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  /* Hover opens only where hover is real. On a touch screen wider than 900px
     a first tap would otherwise open the panel instead of following the link. */
  @media (hover: hover) {
    .sabh:not([data-drop]) .sabh-has-menu:hover .sabh-menu { opacity: 1; visibility: visible; transform: none; transition: opacity 0.16s ease 0.06s, transform 0.16s ease 0.06s, visibility 0s linear 0.06s; }
    .sabh-has-menu:hover .sabh-link { color: #EEF1EC; background: rgba(238, 241, 236,0.08); }
  }
  /* With the script running (data-drop), the panels lose their own
     background and slide, so moving between Scholarships and Programs is a
     crossfade: the old list fades out quickly, the new one just behind it.
     No panel sits behind them on any page (Ilia, 2026-10-12, as on home).
     Without the script, each panel keeps its own look above. */
  @media (min-width: 901px) {
    .sabh[data-drop] .sabh-menu {
      background: transparent; border-top-color: transparent; box-shadow: none; transform: none;
      transition: opacity 0.14s ease, visibility 0s linear 0.14s;
    }
    .sabh[data-drop] .sabh-has-menu[data-menu-open] .sabh-menu {
      transition: opacity 0.24s ease 0.06s, visibility 0s linear 0s;
    }
  }
  .sabh-menu-inner {
