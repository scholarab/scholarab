  // does not flash a panel; none on a switch, since the panel is already
  // there; and a short grace on the way out.
  function initHoverMenus(nav: HTMLElement) {
    if (!header || !matchMedia('(hover: hover)').matches) return;
    header.dataset.drop = '';
    let timer = 0;
    const openItemNow = () => nav.querySelector<HTMLElement>('.sabh-has-menu[data-menu-open]');
    const closeAll = () => nav.querySelectorAll<HTMLElement>('.sabh-has-menu[data-menu-open]').forEach(o => setDropdown(o, false));
    nav.addEventListener('pointerover', e => {
      if (phone.matches) return;
      const item = (e.target as HTMLElement).closest<HTMLElement>('.sabh-item');
      if (!item) return;
      clearTimeout(timer);
      const current = openItemNow();
      if (item === current) return;
      if (!item.classList.contains('sabh-has-menu')) {
        if (current) timer = window.setTimeout(closeAll, 90);
        return;
      }
      if (current) setDropdown(item, true);
      else timer = window.setTimeout(() => setDropdown(item, true), 70);
    });
    nav.addEventListener('pointerleave', () => {
      clearTimeout(timer);
      timer = window.setTimeout(closeAll, 140);
    });
  }


  function initSabHeader() {
    header = document.querySelector<HTMLElement>('[data-sab-header]');
    burger = document.getElementById('sabh-burger');
    sheet = document.getElementById('sabh-links');
    if (!header || !burger || !sheet || header.dataset.init) return;
    header.dataset.init = 'true';

    burger.addEventListener('click', () => (isOpen() ? closeMenu({ restoreFocus: true }) : openMenu()));

    initHoverMenus(sheet);

    const gear = header.querySelector<HTMLElement>('[data-sabh-gear]');
    if (gear) {
      const btn = gear.querySelector<HTMLElement>('.sabh-gear-btn')!;
      const setGear = (open: boolean) => { gear.toggleAttribute('data-open', open); btn.setAttribute('aria-expanded', String(open)); };
      // A mouse opens it on hover and only leaving closes it, the way
      // polymarket.com does it, so clicking the gear never shuts it. Touch and
      // the keyboard still toggle it with a tap or Enter.
      let gearTimer = 0;
      btn.addEventListener('click', e => {
        setGear((e as PointerEvent).pointerType === 'mouse' || !gear.hasAttribute('data-open'));
      });
      if (matchMedia('(hover: hover)').matches) {
        gear.addEventListener('pointerenter', e => {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(gearTimer);
          setGear(true);
        });
        gear.addEventListener('pointerleave', e => {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(gearTimer);
          gearTimer = window.setTimeout(() => { if (!gear.querySelector(':focus-visible')) setGear(false); }, 100);
        });
      }
      gear.addEventListener('focusout', e => { if (!gear.contains(e.relatedTarget as Node | null)) setGear(false); });
      gear.addEventListener('keydown', e => { if (e.key === 'Escape') { setGear(false); btn.focus(); } });
      document.addEventListener('pointerdown', e => { if (!gear.contains(e.target as Node)) setGear(false); });
    }

    // Dark mode: the gear's switch on desktop, a row in the sheet on phones.
    // Each shows the theme in force, whether chosen here or taken from the
    // device, and a flip stores the choice (Layout's head script).
    const html = document.documentElement;
    const switches = header.querySelectorAll<HTMLElement>('[data-sabh-theme]');
    const syncSwitches = () => switches.forEach(sw => sw.setAttribute('aria-checked', String(html.dataset.theme === 'dark')));
    syncSwitches();
    switches.forEach(sw => sw.addEventListener('click', () => {
      (window as unknown as { __saTheme?: (t: string) => void }).__saTheme?.(html.dataset.theme === 'dark' ? 'light' : 'dark');
      syncSwitches();
    }));

    // Desktop dropdown toggles. A mouse click only opens, since hover has
    // usually opened the list already and a toggle would shut it under the
    // pointer; the keyboard (detail 0) and touch toggle. The phone sheet
    // handles its own rows below. Focus leaving the item closes its panel, so
    // a Tab past the last link, or a click elsewhere, never leaves it hanging.
    header.querySelectorAll<HTMLElement>('.sabh-has-menu').forEach(item => {
      item.querySelector<HTMLElement>('[data-sabh-toggle]')?.addEventListener('click', e => {
        if (phone.matches) return;
        const open = item.hasAttribute('data-menu-open');
        const mouse = (e as PointerEvent).pointerType === 'mouse' && e.detail > 0;
        setDropdown(item, mouse || !open);
      });
      item.addEventListener('focusout', e => {
        if (!item.contains(e.relatedTarget as Node | null)) setDropdown(item, false);
      });
    });

    // Tapping a destination closes the sheet. The ClientRouter swaps the page
    // without a reload, so nothing else would.
    sheet.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-sabh-back]')) {
        closeSub();
        return;
      }
      // In the sheet, a row with a panel opens it; the panel's own "All
      // scholarships" or "All programs" link goes to the directory.
      const item = target.closest<HTMLElement>('.sabh-has-menu');
      if (isOpen() && phone.matches && item && target.closest('.sabh-link')) {
        openSub(item);
        return;
      }
      if (target.closest('a')) closeMenu();
    });
  }

  // A click anywhere else closes an open dropdown. Safari never focuses a
  // clicked button, so the focusout above cannot be relied on for this.
  document.addEventListener('pointerdown', e => {
    header?.querySelectorAll<HTMLElement>('.sabh-has-menu[data-menu-open]').forEach(item => {
      if (!item.contains(e.target as Node)) setDropdown(item, false);
    });
  });

  document.addEventListener('keydown', e => {
    // In the sheet, Escape backs out of the Scholarships panel first.
    if (e.key === 'Escape' && isOpen() && isSub()) {
      closeSub();
      return;
    }
    // Escape inside a desktop dropdown closes it and hands focus back to
    // the toggle that opened it, so the next Tab resumes from there.
    if (e.key === 'Escape') {
      const item = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>('.sabh-has-menu[data-menu-open]');
      if (item) {
        setDropdown(item, false);
        item.querySelector<HTMLElement>('[data-sabh-toggle]')?.focus();
      }
    }
    if (!isOpen() || !sheet || !burger) return;
    if (e.key === 'Escape') {
      closeMenu({ restoreFocus: true });
      return;
    }
    if (e.key !== 'Tab') return;
    // Keep Tab inside the sheet and its button while the sheet covers
    // everything else on screen.
    // .sabh-link only: the dropdown's links live inside the sheet's markup but
    // are display:none on a phone, and focus() on those silently does nothing.
    // In the Scholarships panel the stops are its Back button and links instead.
    const stops = isSub()
      ? [...(openItem()?.querySelectorAll<HTMLElement>('.sabh-menu button, .sabh-menu a[href]') ?? []), burger]
      : [...sheet.querySelectorAll<HTMLElement>('.sabh-link'), burger];
    const first = stops[0];
    const last = stops[stops.length - 1];
    if (!first || !last) return;
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // A sheet left open across a rotation to landscape would be a fixed panel
  // with no visible way out; the button it belongs to is hidden above 900px.
  phone.addEventListener('change', ev => {
    if (!ev.matches && isOpen()) closeMenu();
  });

  // Never leave the scroll lock behind on a client-side navigation.
  document.addEventListener('astro:before-swap', () => {
    document.documentElement.style.overflow = '';
    document.documentElement.removeAttribute('data-sab-menu');
  });

  // ── Sticky header collapse ───────────────────────────────────────────────
  // Flips one attribute on <html>; every property that moves is a transition
  // in global.css. Hysteresis, so a scroll that hovers on the line cannot make
  // the header flap: it condenses at 116px down and only opens back up at 36px.
  // Read inside rAF and never written unless the state actually changes, so a
  // fast scroll costs one class write, not one per frame.
  const STICK_DOWN = 116;
  const STICK_UP = 36;
  // Hide on the way down, show on the way up. A move counts once it passes
  // HIDE_STEP, so the jitter of a resting finger cannot flick the bar, and the
  // bar never hides near the top of the page or while one of its menus is open
  // or holds focus.
  const HIDE_STEP = 8;
  let lastY = window.scrollY;
  const headerBusy = () => {
    const h = document.querySelector('[data-sab-header]');
    return !!h && (h.hasAttribute('data-open') || !!h.querySelector('[data-menu-open]') || !!h.querySelector(':focus-visible'));
  };
  let stuckTicking = false;
  function readStuck(): void {
    stuckTicking = false;
    const root = document.documentElement;
    const stuck = root.hasAttribute('data-sab-stuck');
    const y = window.scrollY;
    if (!stuck && y > STICK_DOWN) root.setAttribute('data-sab-stuck', '');
    else if (stuck && y < STICK_UP) root.removeAttribute('data-sab-stuck');
    const dy = y - lastY;
    if (y <= STICK_UP || headerBusy()) {
      root.removeAttribute('data-sab-hidden');
      lastY = y;
    } else if (Math.abs(dy) >= HIDE_STEP) {
      root.toggleAttribute('data-sab-hidden', dy > 0 && y > STICK_DOWN);
      lastY = y;
    }
  }
  function onStickScroll(): void {
    if (stuckTicking) return;
    stuckTicking = true;
    requestAnimationFrame(readStuck);
  }
  window.addEventListener('scroll', onStickScroll, { passive: true });
  // A client-side navigation can land part-way down a page, and a reload
  // restores the old offset before any scroll event fires.
  document.addEventListener('astro:page-load', () => {
    document.documentElement.removeAttribute('data-sab-hidden');
    lastY = window.scrollY;
    readStuck();
  });
  readStuck();
  // Tabbing back into a hidden bar brings it back.
  document.addEventListener('focusin', e => {
    if ((e.target as Element | null)?.closest?.('[data-sab-header]')) document.documentElement.removeAttribute('data-sab-hidden');
  });

  initSabHeader();
  document.addEventListener('astro:page-load', initSabHeader);

  function paintSavedCount() {
    const n = getSaved().length + getSavedPrograms().length;
    for (const el of document.querySelectorAll<HTMLElement>('[data-saved-n]')) {
      el.textContent = n > 99 ? '99+' : String(n);
      el.hidden = n === 0;
      el.closest('a')?.setAttribute('aria-label', n ? `My combo, ${n} ${n === 1 ? 'listing' : 'listings'}` : 'My combo');
    }
  }
  document.addEventListener('astro:page-load', paintSavedCount);
  window.addEventListener('sab:saved', paintSavedCount);
  window.addEventListener('storage', paintSavedCount);
</script>
