---
// A short rail of guide cards, for the foot of a directory page.
//
// /scholarships/ and /programs/ are the two highest-authority pages on the
// site -- 8,530 of 11,548 impressions in the 2026-08-25 export between them --
// and neither linked to a single guide. The guides section took 2,715
// impressions at 0.59% CTR with 5 of its 11 pages unindexed, on 5 to 13
// inbound internal links each out of 322 pages. This is the missing edge:
// the hub that already ranks pointing at the explainer that does not.
//
// Slugs are passed in rather than derived, because which guides belong under
// which directory is an editorial call, not a category match. getGuide throws
// on an unknown slug, so a renamed guide fails the build here rather than
// shipping a dead internal link.
import { getGuide } from '../../lib/guides';

interface Props {
  /** Guide slugs to show, in the order they should appear. */
  slugs: string[];
  /** The heading itself. */
  heading: string;
}

const { slugs, heading } = Astro.props;
const items = slugs.map(getGuide);
---

<section class="sabgr" aria-labelledby="sabgr-heading">
  <div class="sabgr-inner">
    <div class="sabgr-top">
      <h2 class="sabgr-heading" id="sabgr-heading">{heading}</h2>
      <a class="sabgr-mono sabgr-all" href="/guides/">ALL GUIDES &rarr;</a>
    </div>

    {/* Rows, not cards: every other list on the site is rows since
        2026-09-21, and this was the one bordered-card grid left (critique
        2026-10-01). Same zebra and hover as a directory row. */}
    <ul class="sabgr-list">
      {items.map(g => (
        <li>
          <a class="sabgr-row" href={`/guides/${g.slug}/`}>
            <span class="sabgr-text">
              <span class="sabgr-title">{g.title}</span>
              <span class="sabgr-desc">{g.description}</span>
            </span>
            <span class="sabgr-mono sabgr-meta">{g.minutes} min read</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sabgr-mono { font-family: var(--font-label); }

  .sabgr { border-top: 1px solid rgba(20, 25, 21, 0.12); margin-top: 64px; }
  .sabgr-inner {
    width: 100%; box-sizing: border-box;
    padding: 56px var(--sab-gutter) 88px;
  }

  .sabgr-top {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 24px; margin-bottom: 28px;
  }
  .sabgr-heading {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(26px, 3.4vw, 34px); line-height: 1.15; letter-spacing: -0.01em;
    margin: 10px 0 0; color: #141915;
  }
  .sabgr-all { font-size: 11px; letter-spacing: 0.08em; color: #0A5632; text-decoration: none; white-space: nowrap; display: inline-block; padding: 12px 0; margin: -12px 0; }
  .sabgr-all:hover { text-decoration: underline; }

  .sabgr-list { list-style: none; margin: 0; padding: 0; border-top: 3px solid #141915; }
  .sabgr-list li:nth-child(even) .sabgr-row { background: rgba(20, 25, 21, 0.04); }
  .sabgr-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 24px;
    padding: 18px 20px; text-decoration: none; color: #141915;
    transition: background-color 0.15s ease;
  }
  .sabgr-list li .sabgr-row:hover { background: rgba(74, 168, 115, 0.14); }
  .sabgr-text { display: flex; flex-direction: column; gap: 6px; min-width: 0; max-width: 72ch; }
  .sabgr-title { font-family: var(--font-display); font-weight: 700; font-size: 22px; line-height: 1.2; text-transform: uppercase; }
  .sabgr-desc { font-size: 15px; line-height: 1.5; color: var(--ink-muted); }
  .sabgr-meta { flex: none; font-size: 13px; color: #0A5632; white-space: nowrap; }

  @media (max-width: 720px) {
    .sabgr-inner { padding: 44px 20px 64px; }
    .sabgr-top { flex-direction: column; align-items: flex-start; gap: 12px; }
    .sabgr-row { flex-direction: column; gap: 8px; padding: 16px 14px; }
  }
</style>
