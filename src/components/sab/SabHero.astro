---
// A hub's photo head (Ilia, 2026-10-12, after spacex.com and the home page):
// the hub's photo fills the whole first screen under the see-through header,
// with the heading and standfirst in white at its foot and an arrow down to
// the list. Hubs without a photo keep the plain heading
// on white (.sabl-title-row). Styles in global.css under "Photo head".
import { needsCredit, type PhotoCredit } from '../../lib/photo-credits';

interface Props {
  h1: string;
  intro: string;
  photo: { backdrop: string; credit?: PhotoCredit };
}
const { h1, intro, photo } = Astro.props;
const base = `/photos/backdrops/${photo.backdrop}`;
---

<div class="sabl-hero">
  {/* The wide crop on a desktop, the tall one on a phone, where the band is
      narrow and a slice of the wide one would show mostly sky. It is the
      page's largest paint, so it is fetched first and never lazily. */}
  <picture class="sabl-hero-photo" aria-hidden="true">
    <source media="(min-width: 901px)" srcset={`${base}-wide-1672.webp 1672w, ${base}-wide-3344.webp 3344w`} sizes="100vw" />
    <img src={`${base}-tall-1000.webp`} alt="" fetchpriority="high" decoding="async" />
  </picture>
  <div class="sabl-hero-text">
    <h1 class="sabl-h1">{h1}</h1>
    <p class="sabl-desc">{intro}</p>
  </div>
  <a class="sabl-hero-down" href="#sabl-list">
    See the list
    <svg viewBox="0 0 12 8" width="14" height="10" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
  {photo.credit && needsCredit(photo.credit) && (
    <a class="sabl-hero-credit" href={photo.credit.sourceUrl} target="_blank" rel="noopener noreferrer">Photo: {photo.credit.author}, {photo.credit.license}</a>
  )}
</div>
