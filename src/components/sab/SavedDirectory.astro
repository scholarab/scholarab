---
import type { SavedItem } from '../../lib/saved-client.ts';
import type { Scholarship } from '../../lib/data-loader.ts';
import { savedItems } from '../../lib/saved-items.ts';
import { STARTER_PACK_IDS } from '../../lib/starter-pack.ts';
import { scholarshipStatusOf } from '../../lib/status.ts';
import { isAfterHighSchool } from '../../lib/list-core.ts';
import { todayDate } from '../../lib/calendar';

interface Props {
  initialScholarships: Scholarship[];
}
const { initialScholarships } = Astro.props;
// The page carries only the starter pack, the rows a first visit shows. Any
// other saved row comes from /saved-items.json, fetched when one is needed.
const starter = new Set<number>(STARTER_PACK_IDS);
const items: SavedItem[] = savedItems(initialScholarships.filter(s => starter.has(s.id)), []);

// The empty page leads with a real count rather than a dashed box (flow plan,
// 2026-10-02). Not three picked awards: by date the first three included a
// Photoshop-actions essay contest and Niagara Region Right to Life, and
// filters on the data called a bleeding-disorder award open to anyone.
// The directory's own OPEN NOW run, so the two pages give the same number.
const openNow = initialScholarships.filter(s => {
  const st = scholarshipStatusOf(s, todayDate());
  return (st === 'active' || st === 'ongoing') && !isAfterHighSchool(s);
}).length;
---

<!-- Same skeleton the React island used to show before hydration -->
<div class="sabl-page" data-sv-skeleton>
  <div>
    <div style="height:16px;width:130px;border-radius:var(--radius);background:rgba(20,25,21,0.08);margin-bottom:16px" class="animate-pulse"></div>
    <div style="height:64px;width:220px;border-radius:var(--radius);background:rgba(20,25,21,0.08);margin-bottom:20px" class="animate-pulse"></div>
    <div style="height:16px;width:260px;border-radius:var(--radius);background:rgba(20,25,21,0.08);margin-bottom:40px" class="animate-pulse"></div>
    <div class="sabl-grid">
      {[0, 1, 2].map(() => (
        <div class="animate-pulse" style="height:220px;border-radius:var(--radius);background:rgba(20,25,21,0.06)"></div>
      ))}
    </div>
  </div>
</div>

<div class="sabl-page" data-sv-content hidden>
  <div class="sabl-title-row">
    <div>
      <h1 class="sabl-h1">My combo</h1>
      <p class="sabl-desc tnum" data-sv-count>Your shortlist is saved on this device.</p>
    </div>
    <div class="sabs-toggle" role="group" aria-label="View" data-sv-toggle hidden>
      <button type="button" class="sabs-toggle-btn on" data-sv-view="list" aria-pressed="true">List</button>
      <button type="button" class="sabs-toggle-btn" data-sv-view="calendar" aria-pressed="false">Calendar</button>
    </div>
  </div>

  <div class="sabl-empty sabs-empty" data-sv-empty hidden>
    <h2 class="sabl-empty-title">Nothing saved yet</h2>
    <div class="sabl-empty-sub">
      {openNow.toLocaleString('en-CA')} scholarships are open to apply for right now. Save the ones
      that fit and their deadlines line up here. Not sure which? A few questions build you a shortlist.
    </div>
    <div class="sabs-empty-ctas">
      <a href="/match/" class="sabm-btn-accent">Build my combo</a>
      <a href="/scholarships/" class="sabm-btn-outline">Browse scholarships</a>
    </div>
  </div>

  <div style="margin-top:48px" data-sv-list hidden>
    <section class="sabs-plan" aria-labelledby="sabs-plan-h" data-sv-plan hidden>
      <h2 id="sabs-plan-h" class="sabs-section-head">
        <span class="sabl-group-label">YOUR PLAN</span>
      </h2>
      <p class="sabs-plan-lead" data-sv-plan-lead></p>
      <ul class="sabs-plan-needs" data-sv-plan-needs></ul>
      <p class="sabs-plan-note" data-sv-plan-note></p>
    </section>
    <div data-sv-sh-section hidden>
      <h2 class="sabs-section-head">
        <span class="sabl-group-label">SCHOLARSHIPS</span>
        <span class="sabl-group-count" data-sv-sh-label>0</span>
      </h2>
      <div class="sabl-grid" style="margin-bottom:56px;padding-top:0"></div>
    </div>

    <div data-sv-pr-section hidden>
      <h2 class="sabs-section-head">
        <span class="sabl-group-label">PROGRAMS</span>
        <span class="sabl-group-count" data-sv-pr-label>0</span>
      </h2>
      <div class="sabl-grid" style="padding-top:0"></div>
    </div>
  </div>

  <div data-sv-cal hidden></div>
</div>

<script is:inline type="application/json" data-sv-items data-src="/saved-items.json" set:html={JSON.stringify(items).replace(/</g, '\\u003c')} />

<script>
  import { initSaved } from '../../lib/saved-client.ts';
  initSaved();
</script>

<style is:global>
  /* My combo's section headings take the directory's run heading (label face,
     count sticker) instead of the small mono label with a coloured dot in
     global.css, which read as a template eyebrow (2026-10-05). Kept here, not
     in global.css: editing the shared stylesheet made the home page's
     font-arrival test fail 6 runs in 8 under full-suite load, with no rule of
     it applying there, and it passed every run with global.css unchanged. */
  .sabs-section-head { gap: 14px; font-size: inherit; letter-spacing: normal; color: inherit; }
</style>
