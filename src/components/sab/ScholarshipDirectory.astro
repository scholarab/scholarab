---
// Server-rendered replacement for the old ScholarshipList React island.
// Every card is in the HTML; lib/directory-client.ts shows/hides/reorders
// them and recomputes the clock-dependent bits on load, so no React ships.
import { DEFAULT_SCHOLARSHIP_STATE, DIRECTORY_PAGE_SIZE, SCHOLARSHIP_GROUP_LABELS, directoryCountLine, filterSortScholarships, getScholarshipStatus, groupRuns, scholarshipDayChip, scholarshipGroupKey, shortDate } from '../../lib/list-core.ts';
import type { ScholarshipFilterState, ScholarshipWithMeta } from '../../lib/list-core.ts';
import { generateSlug } from '../../lib/utils.ts';
import { scholarshipSearchBlob } from '../../lib/search-text.ts';
import { SCHOLARSHIP_FACETS, MIN_FACET_ITEMS, facetItems } from '../../lib/facets.ts';
import { surveySpan, surveyReach, daysUntil, surveyMark, surveyPlots } from '../../lib/survey.ts';
import { todayDate as albertaToday } from '../../lib/calendar.ts';

interface Props {
  items: ScholarshipWithMeta[];
  /** Facet hubs supply their own heading and standfirst; /scholarships keeps these defaults. */
  h1?: string;
  intro?: string;
  /**
   * Hubs only (Ilia, 2026-09-15). SCOPE on a hub was eighteen chips of
   * navigation dressed as a filter: the reader had already chosen Calgary in
   * the header menu, and every chip in the row took them off the page they
   * asked for. Two other places carry the same links, both better placed: the
   * header's Scholarships panel above, and the hub footer's sibling list
   * below, which is also what keeps hub-to-hub crawling intact. The row still
   * belongs on /scholarships, where no scope has been chosen yet.
   */
  hideScopes?: boolean;
  /** The whole corpus, for counting the city chips. A region hub is handed only
      its own city in `items`, so it must pass this too. */
  allItems?: ScholarshipWithMeta[];
  /** A category hub has already applied a track, so TRACK would only offer the
      reader ways to empty their own page. */
  hideCategories?: boolean;
  /**
   * Hubs only (Ilia, 2026-09-15). A reader who has already chosen Calgary is
   * past the chips, and on a hub they were four stacked rows of them between
   * the title and the first card: on a laptop the page opened on filters the
   * reader had just used. Railed, the rows move into a sticky left column and
   * the cards start under the toolbar. Below 1180px there is no room for a
   * column, so the rail unwraps back into the rows above the grid.
   */
  railFilters?: boolean;
  /**
   * The Survey Grid world (facet hubs only, seed 75c83193). It changes what is
   * drawn, not what is in the DOM: every data-dir-* hook the directory client
   * reads is identical either way. What it does change is the three things the
   * incumbent markup cannot carry, a category label sitting above the entry's
   * heading, two glyphs standing in for an icon set, and the absence of any
   * shared scale to measure a deadline against.
   */
  survey?: boolean;
}
const {
  items,
  h1 = 'Scholarships',
  intro = "All available scholarships for Alberta high school students. Every listing is written from the provider's own page and links straight back to it.",
  allItems = items,
  hideCategories = false,
  hideScopes = false,
  railFilters = false,
  survey = false,
} = Astro.props;

// SCOPE, not REGION: these are how far an award reaches, not where the student
// lives. Labelled REGION, "Alberta" read as "I live in Alberta", which is true
// of everyone here; instead of "open province-wide". The data key stays
// `region`; only the word the student reads changes.
//
// The city chips are derived from the facet registry rather than listed here,
// because the two were allowed to drift and did: five cities had hub pages and
// guide links pointing at them while the chip row offered Medicine Hat alone,
// leaving forty-one awards with no button that could reach them. The same
// MIN_FACET_ITEMS floor the hubs and the sitemap use applies here too -- a scope too thin to deserve a page is too thin
// to deserve a chip, and a chip is a worse version of the failure either way.
// A region hub is handed only its own city's items, so counting chips against
// `items` there would print "Medicine Hat 20" beside "Calgary 0" and hide every
// other city below the MIN_FACET_ITEMS floor. The chip row is a map of the whole
// directory wherever it appears, so it counts against the whole corpus.
const chipSource = allItems;
// Biggest first, the same order TRACK is in. The row used to run in registry
// order, which is a fact about the file and not about the data: Calgary's 132
// sat fourth behind three scopes a tenth its size. Counted against the whole
// corpus rather than the page, so the order is the same on every hub and a
// reader crossing the row twice finds the chip where they left it.
const regionChips = SCHOLARSHIP_FACETS
  .filter(f => f.kind === 'region' && facetItems(f, chipSource).length >= MIN_FACET_ITEMS)
  .map(f => ({ slug: f.slug, label: f.label, count: facetItems(f, chipSource).length }))
  .sort((a, b) => b.count - a.count);

// The row appears on /scholarships only; see `hideScopes`. There, a scope chip
// navigates to that scope's hub rather than filtering in place. The hub is the
// better page for the same intent: it carries a written intro, a guide link,
// its own TRACK and STATUS rows, and a URL the reader can send to someone. Filtering produced the same list at a URL that forgot it by the next
// visit, and the homepage already sent this click to the hub, so the two rows
// disagreed about what picking a scope means.
//
// The province-wide and National chips used to be the exception, filtering
// because neither had a hub. Both have one now, so the whole row navigates and
// there is no second kind of chip in it.
//
// One thing changed with them: the Alberta chip was the `Alberta-wide` rollup,
// every provincial region including the six cities. As a hub that would have
// been a near-copy of this page at a second URL, so the chip is now the
// province-wide facet -- the awards with no city requirement -- and its count
// drops accordingly. `regionMatches('Alberta-wide')` stays in list-core for the
// match flow, which still wants the rollup.

const SORT_CHIPS = [
  { value: 'closest_due', label: 'Earliest deadline' },
  { value: 'highest_pay', label: 'Highest $' },
  { value: 'lowest_pay',  label: 'Lowest $' },
] as const;

const STATUS_CHIPS = [
  { value: 'all',     label: 'All' },
  { value: 'active',  label: 'Open' },
  { value: 'opening', label: 'Opening soon' },
  { value: 'closed',  label: 'Closed' },
] as const;

const counts = new Map<string, number>();
for (const s of items) if (s.category) counts.set(s.category, (counts.get(s.category) ?? 0) + 1);
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([name]) => name);

// Every filter chip carries the size of the list it would leave behind. The
// row already had counts on the city chips alone, which read as those five
// being the only measured thing on the page rather than as a general habit.
//
// These are the figures for the default state; directory-client recomputes all
// of them against the live state on the first render, so the numbers a reader
// with JS sees are always the ones that match their own filters. The
// server-rendered pass is what a reader without JS gets, and what fills the
// row before hydration so nothing reflows.
const chipCount = (o: Partial<ScholarshipFilterState>) =>
  filterSortScholarships(items, { ...DEFAULT_SCHOLARSHIP_STATE, ...o }).length;

const initial = filterSortScholarships(items, DEFAULT_SCHOLARSHIP_STATE);

// Labelled seams between the open / not-yet-open / closed runs. Emitted
// server-side so the grid reads the same before hydration; the client reuses
// these exact nodes and re-splices them as filters change.
const runs = groupRuns(initial, scholarshipGroupKey, SCHOLARSHIP_GROUP_LABELS);
const showGroups = runs.length > 1;
const headerAt = new Map<number, { label: string; count: number; key: string }>();
if (showGroups) {
  let at = 0;
  for (const r of runs) { headerAt.set(at, r); at += r.count; }
}
const openNow = initial.filter(s => getScholarshipStatus(s) === 'active').length;

// "$X open across these listings"; active money only, follows the filters
const totalOpen = initial.reduce(
  (sum, s) => sum + (getScholarshipStatus(s) === 'active' ? (s._amount ?? 0) : 0), 0,
);

// The money on listings whose cycle has not opened yet. Without this the header
// is flat for months at a time: an award added in August that opens in March
// adds nothing to totalOpen, which is correct and reads as a stalled page.
const totalSoon = initial.reduce(
  (sum, s) => sum + (getScholarshipStatus(s) === 'future' ? (s._amount ?? 0) : 0), 0,
);

// A hub can hold nothing open at all: every Calgary award runs on the one
// EducationMatters cycle, so between June and February the honest open figure
// is $0. A $0 hero reads as breakage, so the upcoming money is promoted into
// the headline and the label says which of the two it is.
const statValue = totalOpen > 0 || totalSoon === 0 ? totalOpen : totalSoon;
const statLabel = totalOpen > 0 || totalSoon === 0
  ? 'OPEN ACROSS THESE LISTINGS'
  : 'OPENING IN A LATER CYCLE';
// One short line under the label, never a stack of them: the stat block shares
// a flex row with the h1 and the standfirst, so a taller stat column pushes the
// toolbar down. e2e/smoke.spec.ts pins every hub's toolbar to the same height
// and catches exactly that.
//
// A count of listings that publish no dollar figure used to sit here too
// ("11 AMOUNTS NOT PUBLISHED"). It was a footnote about our own data in the
// one place on the page that is supposed to answer "how much money is here",
// and it was deleted 2026-09-15 at Ilia's request.
// The graticule's origin. Rendered here so the ticks are in the HTML, then
// recomputed in onCardsParsed on every load, because CDN-cached HTML outlives
// the day it was built. Never serialised as milliseconds; the card carries the
// ISO string and the browser measures from that in the reader's own timezone.
const sgToday = albertaToday();
// The sheet is measured against the ground it covers. Taken from every dated
// entry on this hub, not from the filtered set, so filtering never slides the
// ticks under the reader.
// Only the entries that are actually plotted. A single closed award with a
// deadline in the past pulled the near edge to today and pushed this hub's
// whole open set back to the far end of the rail, which is the cluster the
// span was meant to fix.
const sgSpan = surveySpan(items.map(s => {
  const d = s.deadline;
  return d && surveyPlots(surveyMark(getScholarshipStatus(s), d)) ? daysUntil(d, sgToday) : NaN;
}));

const soonLine = totalOpen > 0 && totalSoon > 0
  ? `+$${totalSoon.toLocaleString('en-CA')} OPENING LATER`
  : '';
---

<div class:list={['sabl-page', { 'sabl-railed': railFilters, 'sg': survey }]}>
  {/* Everything above the cards. Unstyled by default; a hub with a photo
      backdrop turns it into one frosted panel so no text sits on the photo. */}
  <div class="sabl-head">
  <div class="sabl-title-row">
    <div>
      <h1 class="sabl-h1">{h1}</h1>
      <p class="sabl-desc">{intro}</p>
    </div>
    <div class="sabl-stat">
      <div class="sabl-stat-value tnum" data-dir-stat>${statValue.toLocaleString('en-CA')}</div>
      <div class="sabl-mono sabl-stat-label" data-dir-stat-label>{statLabel}</div>
      <div class="sabl-mono sabl-stat-soon" data-dir-stat-soon hidden={!soonLine}>
        {soonLine}
      </div>
    </div>
  </div>

  <div class="sabl-toolbar">
    <div class="sabl-search">
      <span class="sabl-search-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none"><circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.5"/><path d="M10.6 10.6L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
      <input
        type="search"
        data-dir-search
        placeholder="Search by name or keyword…"
        aria-label="Search scholarships by name or keyword"
      />
    </div>
    <div class="sabl-sort" id="dir-sort">
      <span class="sabl-mono sabl-row-label">SORT</span>
      <div class="sabl-sort-chips">
      {SORT_CHIPS.map(s => (
        <button type="button" class={`sabl-chip${s.value === 'closest_due' ? ' on' : ''}`} data-fkey="sort" data-fval={s.value} aria-pressed={s.value === 'closest_due' ? 'true' : 'false'}>{s.label}</button>
      ))}
      </div>
    </div>
    {/* TRACK and STATUS put away from here, and on a hub the cards take the
        rail's column with them (Ilia, 2026-09-15). Only the filters: the
        heading, the standfirst, the money, the search box and these chips all
        stay whichever way it is set. */}
    {/* Phones only: sort and every chip row fold behind this, so the first
        card is on the first screen. Desktop keeps the lean toggle below. */}
    <button type="button" class="sabl-filters-btn" data-dir-filters aria-expanded="false" aria-controls="dir-sort dir-filters">
      Filters<span class="sabl-mono sabl-filters-n" data-dir-filter-n hidden></span>
    </button>
    <button type="button" class="sabl-lean" data-dir-lean aria-pressed="false">
      <span data-dir-lean-word>Hide filters</span>
      <svg class="sabl-lean-caret" viewBox="0 0 12 8" width="12" height="8" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  </div>

  {/* Rail or rows, one DOM: .sabl-split is display:contents unless the page is
      railed and wide, so the filters sit exactly where they always did on
      /scholarships and on any narrow window. */}
  <div class="sabl-split">
  {/* -dense: ten TRACK chips now that each carries a count, which is 90px more
      than the measure holds at the default metrics. The rows scroll rather than
      wrap, so this is not load-bearing; it just buys back enough width that
      nobody has to scroll the row on a desktop. See the modifier in global.css. */}
  <aside class="sabl-rail" id="dir-filters" aria-label="Filters">
  <div class="sabl-filters sabl-filters-dense">
    {!hideCategories && (
      <div class="sabl-filter-row">
        <span class="sabl-mono sabl-row-label">TRACK</span>
        <div class="sabl-chips">
            <button type="button" class="sabl-chip on" data-fkey="category" data-fval="all" aria-pressed="true">All<span class="sabl-mono sabl-chip-count" data-chip-count>{items.length}</span></button>
            {categories.map(c => (
              <button type="button" class="sabl-chip" data-fkey="category" data-fval={c} aria-pressed="false">{c}<span class="sabl-mono sabl-chip-count" data-chip-count>{counts.get(c) ?? 0}</span></button>
            ))}
        </div>
      </div>
    )}
    {!hideScopes && (
      <div class="sabl-filter-row sabl-filter-row-wrap">
        <span class="sabl-mono sabl-row-label">SCOPE</span>
        <div class="sabl-chips sabl-chips-wrap">
          <button type="button" class="sabl-chip on" data-fkey="region" data-fval="" aria-pressed="true">All<span class="sabl-mono sabl-chip-count" data-chip-count>{items.length}</span></button>
          {regionChips.map(c => (
            <a href={`/scholarships/${c.slug}/`} class="sabl-chip sabl-chip-link">
              {c.label}<span class="sabl-mono sabl-chip-count">{c.count}</span>
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="sabl-filter-row">
      <span class="sabl-mono sabl-row-label">STATUS</span>
      <div class="sabl-chips">
        {STATUS_CHIPS.map(s => (
          <button type="button" class={`sabl-chip${s.value === 'all' ? ' on' : ''}`} data-fkey="status" data-fval={s.value} aria-pressed={s.value === 'all' ? 'true' : 'false'}>{s.label}<span class="sabl-mono sabl-chip-count" data-chip-count>{chipCount({ statusFilter: s.value })}</span></button>
        ))}
      </div>
    </div>
  </div>

  {/* Deleted from the page 2026-09-15 (Ilia), kept for screen readers. The
      status headings below now carry the counts a sighted reader needs, and
      each one is about its own run rather than the whole page. But typing in
      the search box changes nothing else a screen reader would announce -- the
      cards simply stop existing -- so the line stays as a polite live region.
      role="status" is implicitly atomic, which is right: it is replaced
      wholesale on every keystroke, not appended to. */}
  </aside>

  <div class="sabl-col">
  <div class="sr-only" data-dir-count role="status">
    {directoryCountLine(initial.length, items.length, 'LISTINGS', openNow)}
  </div>

  <div class="sabl-grid" data-dir-grid hidden={initial.length === 0}>
    {initial.map((s, i) => {
      const status = getScholarshipStatus(s);
      const chip = scholarshipDayChip(s);
      const head = headerAt.get(i);
      return (
        <>
        {head && (
          <button
            type="button"
            class="sabl-group"
            data-dir-group={head.key}
            aria-expanded="true"
            data-dir-later={i >= DIRECTORY_PAGE_SIZE ? '' : undefined}
          >
            {/* The rule belongs to the words, not to the row: it stops
                after the count rather than running on to the toggle (Ilia,
                2026-09-15: "only for text and number of scholarships in that
                filter, stop there"). */}
            <span class="sabl-group-name">
              <span class="sabl-group-label">{head.label}</span>
              <span class="sabl-group-count">{head.count}</span>
            </span>
            {/* aria-hidden so the button's name stays "OPEN NOW 15"; the state
                itself is carried by aria-expanded, which is what a screen
                reader announces and what the word duplicates for everyone
                else. */}
            <span class="sabl-group-toggle" aria-hidden="true">
              <span data-dir-group-word>Hide</span>
              <svg class="sabl-group-caret" viewBox="0 0 12 8" width="12" height="8" fill="none"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </button>
        )}
        <div
          class="sabl-card"
          data-dir-card
          data-dir-later={i >= DIRECTORY_PAGE_SIZE ? '' : undefined}
          data-id={s.id}
          data-name={s.title}
          data-category={s.category ?? undefined}
          data-region={s.region ?? undefined}
          data-amount={String(s._amount ?? 0)}
          data-deadline={s.deadline ?? undefined}
          data-open-date={s.openDate ?? undefined}
          data-inactive={s.active === false ? '' : undefined}
          data-concluded={s.concluded ? '' : undefined}
          data-search={scholarshipSearchBlob(s)}
          data-sg-mark={survey ? surveyMark(status, s.deadline) : undefined}
          style={survey
            ? `--sg-i:${i};--sg-reach:${s.deadline && surveyPlots(surveyMark(status, s.deadline)) ? surveyReach(daysUntil(s.deadline, sgToday), sgSpan) : 0}`
            : undefined}
        >
          <div class="sabl-card-top">
            {/* No category label above the entry's own heading on the survey
                sheet: a word set above a title is a label the title already
                carries, and TRACK in the legend filters by the same field. */}
            {!survey && <span class="sabl-mono sabl-tag">{(s.category ?? 'GENERAL').toUpperCase()}</span>}
            <span class={chip ? chip.cls : 'sabl-days'} data-days-chip hidden={!chip}>{chip?.label}</span>
          </div>
          <h2 class="sabl-name-h"><a href={`/scholarships/${s._slug ?? generateSlug(s.title)}/`} class="sabl-name">{s.title}</a></h2>
          <div class="sabl-amount">{s.amount}</div>
          {s.audience && <div class="sabl-blurb">{s.audience}</div>}
          <div class="sabl-card-foot">
            <span class="sabl-due">
              {s.deadline ? `DUE ${shortDate(s.deadline)}` : 'NO FIXED DEADLINE'}
            </span>
            <div class="sabl-card-actions">
              <button
                type="button"
                class="sabl-save"
                data-dir-save
                data-id={s.id}
                data-name={s.title}
                aria-label={`Save ${s.title}`}
                aria-pressed="false"
              >{survey
                ? <svg class="sg-ico" viewBox="0 0 14 16" width="13" height="15" aria-hidden="true"><path d="M2.5 1.5h9v13l-4.5-3.6-4.5 3.6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                : '☆'}</button>
              {s.url && (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  referrerpolicy="no-referrer"
                  class="sabl-apply"
                  data-track="apply"
                  data-item-id={s.id}
                  aria-label={`${status === 'active' ? 'Apply for' : 'Visit'} ${s.title} on the sponsor's site (opens in a new tab)`}
                ><span data-apply-label>{status === 'active' ? 'Apply' : 'Visit'}</span>{survey
                  ? <svg class="sg-ico" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M4 1.2h6.8V8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M10.4 1.6 1.4 10.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  : <span class="sabl-ext" aria-hidden="true">↗</span>}</a>
              )}
            </div>
          </div>
          {survey && (
            <div class="sg-scale" aria-hidden="true"><span class="sg-tick"></span></div>
          )}
        </div>
        </>
      );
    })}
  </div>

  {/* Every card is in the HTML. Past the first step they carry data-dir-later,
      which global.css hides only under html.js, so a reader or crawler without
      JavaScript still gets the whole list. directory-client drives the rest.
      A list that fits in one step can never need the block (the cards on the
      page are the most any filter can show), so it is left out rather than
      shipped hidden with "Show -3 more" in the markup. */}
  {initial.length > DIRECTORY_PAGE_SIZE && (
    <div class="sabl-more" data-dir-more>
      <p class="sabl-mono sabl-more-line" data-dir-more-line>SHOWING {DIRECTORY_PAGE_SIZE} OF {initial.length}</p>
      <div class="sabl-more-actions">
        <button type="button" class="sabl-more-btn" data-dir-more-btn>Show {Math.min(DIRECTORY_PAGE_SIZE, initial.length - DIRECTORY_PAGE_SIZE)} more</button>
        <button type="button" class="sabl-more-all" data-dir-all hidden={initial.length - DIRECTORY_PAGE_SIZE <= DIRECTORY_PAGE_SIZE}>Show all {initial.length}</button>
      </div>
    </div>
  )}

  <div class="sabl-empty" data-dir-empty hidden={initial.length > 0}>
    <div class="sabl-empty-title">Nothing matches that.</div>
    <div class="sabl-empty-sub" data-dir-empty-sub>Try a shorter word, or clear a filter.</div>
    {/* Filled in by directory-client when the term exists somewhere else on
        the site: a facet page holds a slice, so "clear a filter" is the wrong
        advice for a match sitting on another page. */}
    <div class="sabl-empty-elsewhere" data-dir-elsewhere hidden></div>
    <button type="button" class="sabl-empty-btn" data-dir-clear>Clear search</button>
    <p class="sabl-empty-sub sabl-empty-quiz">Not sure what to search for? <a href="/match/">Answer a few questions</a> and get a shortlist.</p>
  </div>
  </div>
  </div>
</div>

<script>
  import { initDirectory } from '../../lib/directory-client.ts';
  import { SCHOLARSHIP_GROUP_LABELS, buildScholarshipStatusCache, directoryCountLine, filterSortScholarships, getScholarshipStatus, scholarshipDayChip, scholarshipGroupKey, selectScholarships } from '../../lib/list-core.ts';
  import type { ScholarshipWithMeta, ScholarshipSort, ScholarshipStatus, StatusFilter, RegionKey } from '../../lib/list-core.ts';
  import { getSaved, toggleSaved } from '../../lib/tracker.ts';
  import { sendEvent } from '../../lib/events.ts';
  import { surveySpan, surveyReach, daysUntil, surveyMark, surveyPlots } from '../../lib/survey.ts';
  import { getToday } from '../../lib/utils.ts';

  // `name` mirrors the card title for the DirectoryItem contract (save labels)
  type Item = ScholarshipWithMeta & { el: HTMLElement; search: string; name: string };
  type State = { sort: string; category: string; region: string; status: string };

  type Cache = Map<number, ScholarshipStatus>;

  /** The filter state a chip row's key/value pair stands for. */
  const asFilterState = (state: State) => ({
    statusFilter: state.status as StatusFilter,
    selectedCategory: state.category,
    selectedRegion: (state.region || null) as RegionKey | null,
    searchQuery: '',
    sortBy: state.sort as ScholarshipSort,
  });

  initDirectory<Item, State, Cache>('#sab-scholarships', {
    itemType: 'scholarship',
    defaultState: { sort: 'closest_due', category: 'all', region: '', status: 'all' },
    toggleKeys: ['category', 'region'],
    parseCard(el) {
      const d = el.dataset;
      return {
        el,
        search: d.search ?? '',
        id: Number(d.id),
        name: d.name ?? '',
        title: d.name ?? '',
        category: d.category ?? null,
        region: d.region ?? null,
        deadline: d.deadline ?? null,
        openDate: d.openDate ?? null,
        _amount: Number(d.amount ?? 0),
        // Recomputed here, in the visitor's timezone, from the ISO strings.
        // Never serialize these from the server: the build runs in UTC, which
        // shifts every deadline 6-7h early for Alberta visitors.
        _deadline_ms: d.deadline ? new Date(d.deadline + 'T00:00:00').getTime() : 0,
        _open_ms: d.openDate ? new Date(d.openDate + 'T00:00:00').getTime() : 0,
        amount: '', audience: null, url: '', lastVerified: null, notes: null,
        applyViaGuidance: false, active: d.inactive === undefined, eligibility: null,
        // Without this an ended award with no deadline reparses as "between
        // cycles" and the client repaints the server's CLOSED chip as OPENING SOON.
        concluded: d.concluded !== undefined,
      };
    },
    // One pass over the corpus per render, shared by the visible list and all
    // seventeen chip counts.
    renderContext: items => buildScholarshipStatusCache(items),
    select: (items, state, cache) => filterSortScholarships(items, asFilterState(state), cache) as Item[],
    countFor: (items, state, cache) => selectScholarships(items, asFilterState(state), cache).length,
    groups: { key: scholarshipGroupKey, label: key => SCHOLARSHIP_GROUP_LABELS[key] ?? key },
    /**
     * Open money, and the money on listings whose cycle has not opened yet:
     * without the second figure the header is flat for months at a time. Keep
     * this in step with the server pass in the frontmatter above.
     */
    summary(visible, total) {
      let open = 0, soon = 0, openNow = 0;
      for (const s of visible) {
        const status = getScholarshipStatus(s);
        if (status === 'active') { open += s._amount ?? 0; openNow++; }
        else if (status === 'future') soon += s._amount ?? 0;
      }
      const headlineOpen = open > 0 || soon === 0;
      return {
        count: directoryCountLine(visible.length, total, 'LISTINGS', openNow),
        stat: '$' + (headlineOpen ? open : soon).toLocaleString('en-CA'),
        'stat-label': headlineOpen ? 'OPEN ACROSS THESE LISTINGS' : 'OPENING IN A LATER CYCLE',
        'stat-soon': open > 0 && soon > 0 ? `+$${soon.toLocaleString('en-CA')} OPENING LATER` : '',
      };
    },
    getSavedIds: () => [...getSaved()],
    toggleSave: id => [...toggleSaved(id)],
    saveLabel: (name, saved) => (saved ? `Remove ${name} from saved` : `Save ${name}`),
    // Day chips and Apply/Visit labels depend on the clock, not just the data:
    // recompute them on every load so CDN-cached HTML never shows stale text.
    onCardsParsed(items) {
      // Recomputed from the whole hub every load, so a sheet cached overnight
      // is measured against today rather than against its build date.
      const span = surveySpan(items.map(s => {
        const d = s.deadline;
        return d && surveyPlots(surveyMark(getScholarshipStatus(s), d)) ? daysUntil(d, getToday()) : NaN;
      }));
      for (const s of items) {
        const status = getScholarshipStatus(s);
        const chipEl = s.el.querySelector<HTMLElement>('[data-days-chip]');
        if (chipEl) {
          const chip = scholarshipDayChip(s);
          chipEl.hidden = !chip;
          if (chip) { chipEl.className = chip.cls; chipEl.textContent = chip.label; }
        }
        // The graticule is a measurement, so it is recomputed from the ISO
        // string here rather than trusted from the build. Same helper the
        // server used, so the tick and the words beside it cannot disagree.
        if (s.el.classList.contains('sabl-card') && s.el.querySelector('.sg-tick')) {
          const iso = s.el.dataset.deadline;
          const mark = surveyMark(status, iso ?? null);
          s.el.dataset.sgMark = mark;
          s.el.style.setProperty(
            '--sg-reach',
            String(iso && surveyPlots(mark) ? surveyReach(daysUntil(iso, getToday()), span) : 0),
          );
        }
        const apply = s.el.querySelector<HTMLElement>('[data-track="apply"]');
        // Only the word: the ↗ beside it is a sibling span, and overwriting
        // the anchor's textContent would take the arrow with it.
        const applyLabel = apply?.querySelector('[data-apply-label]');
        if (applyLabel) applyLabel.textContent = status === 'active' ? 'Apply' : 'Visit';
      }
    },

  });

  // Outbound apply clicks are an analytics event (same as the old React list)
  document.addEventListener('click', e => {
    const link = (e.target as Element | null)?.closest?.('[data-track="apply"]');
    if (link && link.closest('#sab-scholarships')) {
      sendEvent('apply_click', 'scholarship', Number((link as HTMLElement).dataset.itemId));
    }
  });
</script>
