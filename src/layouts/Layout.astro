---
import Nav from '../components/Nav.astro';
import BottomNav from '../components/BottomNav.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  canonical?: string;
  currentPath: string;
  containerClass?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogUrl,
  canonical,
  currentPath,
  containerClass = 'max-w-6xl',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Flash-prevention: set theme class synchronously before any CSS loads -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme') ||
            (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.add('theme-' + t);
        } catch (e) {
          document.documentElement.classList.add('theme-dark');
        }
      })();
    </script>
    <meta name="color-scheme" content="dark light" />
    <meta name="google-site-verification" content="nhpc-sXNyJgfEMBonhftRYTiJpQMP0NDTVRDsIy2Yk4" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content="https://www.scholarab.ca/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.scholarab.ca/og-image.png" />
    <link rel="canonical" href={canonical ?? ogUrl ?? Astro.url.href} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#22d3a5" />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high" />
    <link rel="preload" href="/fonts/inter-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-screen min-h-[100svh] flex flex-col overflow-x-clip md:overscroll-none">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[9999] focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold" style="background:#22d3a5;color:#0a0a0f;">Skip to content</a>
    <Nav currentPath={currentPath} />
    <main id="main-content" class={`${containerClass} mx-auto w-full flex-1 px-4 pb-24 md:pb-8 md:px-8`}>
      <slot />
    </main>
    <footer class="mt-8 relative" style="z-index:1; border-top: 0.5px solid var(--footer-border);">
      <!-- Desktop footer -->
      <div class="hidden md:flex max-w-6xl mx-auto px-4 py-6 md:px-8 flex-col sm:flex-row sm:justify-between sm:items-center gap-2 text-sm text-center sm:text-left text-faint">
        <span>© 2026 ScholarAB &nbsp;·&nbsp; Created by a <a href="https://mhhs.mhpsd.ca/" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="hover:text-secondary transition-colors">Medicine Hat High School</a> student.</span>
        <div class="flex items-center gap-4">
          <a href="https://www.instagram.com/scholarab" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label="ScholarAB on Instagram" class="hover:text-secondary transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="https://www.tiktok.com/@scholarab" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label="ScholarAB on TikTok" class="hover:text-secondary transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
          </a>
          <a href="mailto:contact.scholarab@gmail.com" class="hover:text-secondary transition-colors">Know a scholarship we're missing?</a>
        </div>
      </div>
      <!-- Mobile social strip (sits above bottom nav) -->
      <div class="md:hidden flex items-center justify-center gap-5 py-3 pb-[calc(64px+12px)]">
        <a href="https://www.instagram.com/scholarab" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label="ScholarAB on Instagram" class="text-faint hover:text-secondary transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.tiktok.com/@scholarab" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label="ScholarAB on TikTok" class="text-faint hover:text-secondary transition-colors">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
        </a>
      </div>
    </footer>
    <BottomNav />
    <SpeedInsights />
    <Analytics />
    <script>
      // Haptic on filter/sort pills and bn-tabs
      document.addEventListener('click', (e) => {
        const pill = (e.target as HTMLElement).closest('.sort-pill, .tab-pill, .bn-tab');
        if (pill) navigator.vibrate?.(6);
      }, { passive: true });

      // Radix/Vaul sets body pointer-events:'none' when a modal/drawer is open.
      // If navigation happens before cleanup, the body stays blocked. Reset it on every swap.
      document.addEventListener('astro:before-swap', () => {
        document.body.style.pointerEvents = '';
      });

      // Re-apply theme class after every Astro page transition (ClientRouter replaces <html>)
      document.addEventListener('astro:after-swap', () => {
        try {
          const t = localStorage.getItem('theme') ||
            (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.remove('theme-dark', 'theme-light');
          document.documentElement.classList.add('theme-' + t);
        } catch (e) {}
      });

      // Keep theme in sync with OS preference changes (only if user hasn't overridden)
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', async (e) => {
        try {
          if (!localStorage.getItem('theme')) {
            const { applyTheme } = await import('../lib/themeClient.ts');
            applyTheme(e.matches ? 'dark' : 'light');
          }
        } catch (e) {}
      });

      // Service worker registration
      document.addEventListener('astro:page-load', () => {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js');
        }
      }, { once: true });
    </script>
  </body>
</html>
