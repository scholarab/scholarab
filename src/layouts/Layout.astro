---
import Nav from '../components/Nav.astro';
import BottomNav from '../components/BottomNav.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  canonical?: string;
  currentPath: string;
  containerClass?: string;
  robots?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogUrl,
  canonical,
  currentPath,
  containerClass = 'max-w-6xl',
  robots,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Flash-prevention: set theme class synchronously before any CSS loads -->
    <script is:inline>
      (function () {
        try {
          const t = localStorage.getItem('theme') ||
            (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.add('theme-' + t);
        } catch {
          document.documentElement.classList.add('theme-dark');
        }
      })();
    </script>
    <meta name="color-scheme" content="dark light" />
    <meta name="google-site-verification" content="nhpc-sXNyJgfEMBonhftRYTiJpQMP0NDTVRDsIy2Yk4" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content="https://www.scholarab.ca/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="ScholarAB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content="https://www.scholarab.ca/og-image.png" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical ?? ogUrl ?? Astro.url.href} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#22d3a5" />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high" />
    <link rel="preload" href="/fonts/inter-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-screen min-h-[100svh] flex flex-col overflow-x-clip md:overscroll-none">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[9999] focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold" style="background:#22d3a5;color:#0a0a0f;">Skip to content</a>
    <Nav currentPath={currentPath} />
    <main id="main-content" class={`${containerClass} mx-auto w-full flex-1 px-4 pb-28 md:pb-8 md:px-8`}>
      <slot />
    </main>
    <footer class="hidden md:block mt-8 relative" style="z-index:1; border-top: 0.5px solid var(--footer-border);">
      <!-- Desktop footer -->
      <div class="flex max-w-6xl mx-auto px-4 py-6 md:px-8 justify-center items-center gap-4 text-sm text-faint">
        <span>© 2026 ScholarAB</span>
        <div class="flex items-center gap-4">
          <a href="https://www.instagram.com/scholar.ab" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label="ScholarAB on Instagram" class="flex items-center hover:text-secondary transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="https://www.tiktok.com/@scholar.ab" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" aria-label="ScholarAB on TikTok" class="flex items-center hover:text-secondary transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
          </a>
        </div>
      </div>
    </footer>
    <BottomNav currentPath={currentPath} />
    <script>
      // Haptic on filter/sort pills and bn-tabs
      document.addEventListener('click', (e) => {
        const pill = (e.target as HTMLElement).closest('.sort-pill, .tab-pill, .bn-tab');
        if (pill) navigator.vibrate?.(6);
      }, { passive: true });

      // Radix/Vaul sets body pointer-events:'none' when a modal/drawer is open.
      // If navigation happens before cleanup, the body stays blocked. Reset it on every swap.
      document.addEventListener('astro:before-swap', () => {
        document.body.style.pointerEvents = '';
      });

      // Re-apply theme class after every Astro page transition (ClientRouter replaces <html>)
      document.addEventListener('astro:after-swap', () => {
        try {
          const t = localStorage.getItem('theme') ||
            (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
          document.documentElement.classList.remove('theme-dark', 'theme-light');
          document.documentElement.classList.add('theme-' + t);
        } catch { /* localStorage unavailable */ }
      });

      // Keep theme in sync with OS preference changes (only if user hasn't overridden)
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', async (e) => {
        try {
          if (!localStorage.getItem('theme')) {
            const { applyTheme } = await import('../lib/themeClient.ts');
            applyTheme(e.matches ? 'dark' : 'light');
          }
        } catch { /* localStorage unavailable */ }
      });

      // Service worker registration
      document.addEventListener('astro:page-load', () => {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js');
        }
      }, { once: true });

      // ── Scroll position restore (listing pages only) ────────
      const SCROLL_PAGES = ['/scholarships', '/programs'];

      let scrollSaveTimer: ReturnType<typeof setTimeout> | null = null;
      window.addEventListener('scroll', () => {
        if (scrollSaveTimer) return;
        scrollSaveTimer = setTimeout(() => {
          scrollSaveTimer = null;
          const path = window.location.pathname;
          if (SCROLL_PAGES.some(p => path === p)) {
            try {
              sessionStorage.setItem('scrollRestore', JSON.stringify({ path, y: window.scrollY }));
            } catch { /* ignore */ }
          }
        }, 100);
      }, { passive: true });

      document.addEventListener('astro:page-load', () => {
        try {
          const raw = sessionStorage.getItem('scrollRestore');
          if (!raw) return;
          const { path, y } = JSON.parse(raw) as { path: string; y: number };
          if (path === window.location.pathname && y > 0) {
            requestAnimationFrame(() => window.scrollTo({ top: y, behavior: 'instant' }));
          }
        } catch { /* ignore */ }
      });

      // ── Swipe navigation (Web K pattern) ────────────────────
      // Clean swipe direction flag after every transition
      document.addEventListener('astro:after-swap', () => {
        delete (document.documentElement.dataset as Record<string, string>).swipeDir;
      });

      (function initSwipeNav() {
        const PAGES = ['/', '/scholarships', '/programs', '/saved', '/about'];
        const THRESHOLD = 50;   // px — commit distance (Web K uses 50px)
        const EDGE_GUARD = 20;  // px — ignore touches near screen edge (iOS back gesture)

        let startX = 0, startY = 0;
        let cancelled = false;
        let locked = false;     // true once horizontal intent is confirmed

        // Don't intercept touches on horizontally scrollable elements (filter chips, etc.)
        function isHorizontalScroller(el: Element | null): boolean {
          while (el && el !== document.body) {
            const ox = getComputedStyle(el).overflowX;
            if (ox === 'auto' || ox === 'scroll') return true;
            el = el.parentElement;
          }
          return false;
        }

        // Don't fire while a Vaul drawer is open
        function isDrawerOpen(): boolean {
          return document.body.style.pointerEvents === 'none' ||
            !!document.querySelector('[vaul-drawer][data-state="open"]');
        }

        document.addEventListener('touchstart', (e) => {
          const t = e.touches[0];
          startX = t.pageX;
          startY = t.pageY;
          cancelled = false;
          locked = false;
          if (startX <= EDGE_GUARD || startX >= window.innerWidth - EDGE_GUARD) { cancelled = true; return; }
          if (isHorizontalScroller(e.target as Element)) { cancelled = true; return; }
          if (isDrawerOpen()) { cancelled = true; }
        }, { passive: true });

        document.addEventListener('touchmove', (e) => {
          if (cancelled) return;
          const dx = e.touches[0].pageX - startX;
          const dy = e.touches[0].pageY - startY;
          if (!locked) {
            // Vertical intent detected — cancel horizontal swipe
            if (Math.abs(dy) > 20 && Math.abs(dy) > Math.abs(dx)) { cancelled = true; return; }
            if (Math.abs(dx) > 10) locked = true;
          }
        }, { passive: true });

        document.addEventListener('touchend', async (e) => {
          if (cancelled || !locked) return;
          const dx = e.changedTouches[0].pageX - startX;
          if (Math.abs(dx) < THRESHOLD) return;

          const path = window.location.pathname;
          const idx = PAGES.findIndex(p => p === '/' ? path === '/' : path.startsWith(p));
          if (idx === -1) return;

          const nextIdx = dx < 0 ? idx + 1 : idx - 1;
          if (nextIdx < 0 || nextIdx >= PAGES.length) return;

          navigator.vibrate?.(6);

          // Tag direction so CSS can flip the transition animation
          document.documentElement.dataset.swipeDir = dx < 0 ? 'left' : 'right';

          const { navigate } = await import('astro:transitions/client');
          navigate(PAGES[nextIdx]);
        }, { passive: true });
      })();
    </script>
  </body>
</html>
