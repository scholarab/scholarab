---
import BottomNav from '../components/BottomNav.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  canonical?: string;
  currentPath: string;
  robots?: string;
  /** Absolute URL of a page-specific OG image; falls back to the site-wide one. */
  ogImage?: string;
  /** og:type — 'article' for the guides, 'website' everywhere else. */
  ogType?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogUrl,
  canonical,
  currentPath,
  robots,
  ogImage = 'https://www.scholarab.ca/og-image.png',
  ogType = 'website',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light" />
    <meta name="google-site-verification" content="nhpc-sXNyJgfEMBonhftRYTiJpQMP0NDTVRDsIy2Yk4" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content={ogType} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="ScholarAB" />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical ?? ogUrl ?? Astro.url.href} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/x-icon" sizes="48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2FD3A0" />
    <!-- No Inter preloads here. Inter is the admin panel's font, and the admin
         pages build their own <head> rather than using this layout, so these
         preloaded four unused weights on every public page (500/600/700/800
         report `unloaded` in document.fonts) and spent a fetchpriority="high"
         slot racing the Instrument Serif and Archivo faces that actually
         render. Public pages preload their real faces via SabFonts. -->
    <ClientRouter />
    <slot name="head" />
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "bda47a2a06b543d7be56420c5efb42ff"}'></script>
  </head>
  <body class="min-h-screen min-h-svh flex flex-col overflow-x-clip md:overscroll-none">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-9999 focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold" style="background:#141915;color:#FAF7F0;">Skip to content</a>
    <main id="main-content" class="w-full flex-1">
      <slot />
    </main>
    <BottomNav currentPath={currentPath} />
    <script>
      // Haptic on filter/sort pills and bn-tabs
      document.addEventListener('click', (e) => {
        const pill = (e.target as HTMLElement).closest('.sort-pill, .tab-pill, .bn-tab');
        if (pill) navigator.vibrate?.(6);
      }, { passive: true });

      // Radix/Vaul sets body pointer-events:'none' when a modal/drawer is open.
      // If navigation happens before cleanup, the body stays blocked. Reset it on every swap.
      document.addEventListener('astro:before-swap', () => {
        document.body.style.pointerEvents = '';
      });

      // Service worker registration
      document.addEventListener('astro:page-load', () => {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js');
        }
      }, { once: true });

      // ── Scroll position restore (listing pages only) ────────
      const SCROLL_PAGES = ['/scholarships', '/programs'];

      let scrollSaveTimer: ReturnType<typeof setTimeout> | null = null;
      window.addEventListener('scroll', () => {
        if (scrollSaveTimer) return;
        scrollSaveTimer = setTimeout(() => {
          scrollSaveTimer = null;
          const path = window.location.pathname;
          if (SCROLL_PAGES.some(p => path === p)) {
            try {
              sessionStorage.setItem('scrollRestore', JSON.stringify({ path, y: window.scrollY }));
            } catch { /* ignore */ }
          }
        }, 100);
      }, { passive: true });

      document.addEventListener('astro:page-load', () => {
        try {
          const raw = sessionStorage.getItem('scrollRestore');
          if (!raw) return;
          const { path, y } = JSON.parse(raw) as { path: string; y: number };
          if (path === window.location.pathname && y > 0) {
            requestAnimationFrame(() => window.scrollTo({ top: y, behavior: 'instant' }));
          }
        } catch { /* ignore */ }
      });

      // ── Swipe navigation (Web K pattern) ────────────────────
      // Clean swipe direction flag after every transition
      document.addEventListener('astro:after-swap', () => {
        delete (document.documentElement.dataset as Record<string, string>).swipeDir;
      });

      (function initSwipeNav() {
        const PAGES = ['/', '/scholarships', '/programs', '/saved', '/about'];
        const THRESHOLD = 50;   // px — commit distance (Web K uses 50px)
        const EDGE_GUARD = 20;  // px — ignore touches near screen edge (iOS back gesture)

        let startX = 0, startY = 0;
        let cancelled = false;
        let locked = false;     // true once horizontal intent is confirmed

        // Don't intercept touches on horizontally scrollable elements (filter chips, etc.)
        function isHorizontalScroller(el: Element | null): boolean {
          while (el && el !== document.body) {
            const ox = getComputedStyle(el).overflowX;
            if (ox === 'auto' || ox === 'scroll') return true;
            el = el.parentElement;
          }
          return false;
        }

        // Don't fire while a modal/drawer has locked the page
        function isDrawerOpen(): boolean {
          return document.body.style.pointerEvents === 'none';
        }

        document.addEventListener('touchstart', (e) => {
          const t = e.touches[0];
          if (!t) { cancelled = true; return; }
          startX = t.pageX;
          startY = t.pageY;
          cancelled = false;
          locked = false;
          if (startX <= EDGE_GUARD || startX >= window.innerWidth - EDGE_GUARD) { cancelled = true; return; }
          if (isHorizontalScroller(e.target as Element)) { cancelled = true; return; }
          if (isDrawerOpen()) { cancelled = true; }
        }, { passive: true });

        document.addEventListener('touchmove', (e) => {
          if (cancelled) return;
          const t = e.touches[0];
          if (!t) return;
          const dx = t.pageX - startX;
          const dy = t.pageY - startY;
          if (!locked) {
            // Vertical intent detected — cancel horizontal swipe
            if (Math.abs(dy) > 20 && Math.abs(dy) > Math.abs(dx)) { cancelled = true; return; }
            if (Math.abs(dx) > 10) locked = true;
          }
        }, { passive: true });

        document.addEventListener('touchend', async (e) => {
          if (cancelled || !locked) return;
          const t = e.changedTouches[0];
          if (!t) return;
          const dx = t.pageX - startX;
          if (Math.abs(dx) < THRESHOLD) return;

          const path = window.location.pathname;
          const idx = PAGES.findIndex(p => p === '/' ? path === '/' : path.startsWith(p));
          if (idx === -1) return;

          const nextPage = PAGES[dx < 0 ? idx + 1 : idx - 1];
          if (!nextPage) return;

          navigator.vibrate?.(6);

          // Tag direction so CSS can flip the transition animation
          document.documentElement.dataset.swipeDir = dx < 0 ? 'left' : 'right';

          const { navigate } = await import('astro:transitions/client');
          navigate(nextPage);
        }, { passive: true });
      })();
    </script>

    <style is:global>
      /* Every page under this layout is the fixed editorial palette, so the
         canvas is pinned here rather than left to global.css's themeable
         `html { background: var(--bg-page) }`. Pages already pin `body` via
         `body:has(#sab-*)`; `html` is what shows through on overscroll.
         global.css keeps its token rule for /admin, which does not use this
         layout. */
      html { background-color: #FAF7F0; }
    </style>
  </body>
</html>
