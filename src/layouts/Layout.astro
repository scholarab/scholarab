---
import Nav from '../components/Nav.astro';
import BottomNav from '../components/BottomNav.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  canonical?: string;
  currentPath: string;
  containerClass?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogUrl,
  canonical,
  currentPath,
  containerClass = 'max-w-6xl',
} = Astro.props;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="nhpc-sXNyJgfEMBonhftRYTiJpQMP0NDTVRDsIy2Yk4" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content="https://www.scholarab.ca/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.scholarab.ca/og-image.png" />
    <link rel="canonical" href={canonical ?? ogUrl ?? Astro.url.href} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#22d3a5" />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high" />
    <link rel="preload" href="/fonts/inter-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="bg-[#0a0a0f] text-white min-h-screen min-h-[100svh] flex flex-col overflow-x-clip md:overscroll-none">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[9999] focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold" style="background:#22d3a5;color:#0a0a0f;">Skip to content</a>
    <Nav currentPath={currentPath} />
    <div id="main-content" class={`${containerClass} mx-auto w-full flex-1 px-4 pb-24 md:pb-8 md:px-8`}>
      <slot />
    </div>
    <footer class="hidden md:block border-t border-white/[0.06] mt-8 relative" style="z-index:1;">
      <div class="max-w-6xl mx-auto px-4 pt-6 pb-24 md:py-6 md:px-8 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 text-sm text-white/25 text-center sm:text-left">
        <span>© 2026 ScholarAB &nbsp;·&nbsp; Created by a <a href="https://mhhs.mhpsd.ca/" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="hover:text-white/50 transition-colors">Medicine Hat High School</a> student.</span>
        <a href="mailto:contact.scholarab@gmail.com" class="hover:text-white/50 transition-colors">Know a scholarship we're missing?</a>
      </div>
    </footer>
    <BottomNav />
    <SpeedInsights />
    <Analytics />
    <script>
      // Haptic on filter/sort pills and bn-tabs
      document.addEventListener('click', (e) => {
        const pill = (e.target as HTMLElement).closest('.sort-pill, .tab-pill, .bn-tab');
        if (pill) navigator.vibrate?.(6);
      }, { passive: true });

      // Service worker registration
      document.addEventListener('astro:page-load', () => {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js');
        }
      }, { once: true });
    </script>
  </body>
</html>
