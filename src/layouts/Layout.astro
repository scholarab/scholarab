---
import Analytics from '../components/sab/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  canonical?: string;
  robots?: string;
  /** Absolute URL of a page-specific OG image; falls back to the site-wide one. */
  ogImage?: string;
  /** og:type; 'article' for the guides, 'website' everywhere else. */
  ogType?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogUrl,
  canonical,
  robots,
  ogImage = 'https://www.scholarab.ca/og-image.png',
  ogType = 'website',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light" />
    <meta name="google-site-verification" content="nhpc-sXNyJgfEMBonhftRYTiJpQMP0NDTVRDsIy2Yk4" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content={ogType} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="ScholarAB" />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical ?? ogUrl ?? Astro.url.href} />
    {/* Listing data is CC BY-SA 4.0; see /DATA-LICENSE.md in the repo. */}
    <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/x-icon" sizes="48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2FD3A0" />
    <!-- No Inter preloads here. Inter is the admin panel's font, and the admin
         pages build their own <head> rather than using this layout, so these
         preloaded four unused weights on every public page (500/600/700/800
         report `unloaded` in document.fonts) and spent a fetchpriority="high"
         slot racing the Instrument Serif and Archivo faces that actually
         render. Public pages preload their real faces via SabFonts. -->
    <slot name="head" />
    <!-- The token is the one in Web Analytics > Manage site > Install JS Snippet.
         bda47a... in the dashboard URL is the site tag, not the token: this beacon
         carried the tag until 2026-09-13 and every report got a 404, so Cloudflare
         recorded zero visits from launch to that date.
         Injected rather than a plain tag so it gets the same guards as GA and the
         events table (analyticsAllowedHere in consent.ts): its first 15 hours of
         data had 46 of 238 visits on localhost, from Playwright runs, plus
         untracked (?nt=1) devices counted as students. -->
    <script is:inline>
      (function () {
        const q = new URLSearchParams(location.search).get('nt');
        let optedOut = q === '1';
        try { optedOut = optedOut || (q !== '0' && !!localStorage.getItem('sa_no_track')); } catch { /* no storage: count it */ }
        if (optedOut || navigator.webdriver) return;
        if (location.hostname !== 'www.scholarab.ca' && location.hostname !== 'scholarab.ca') return;
        // Only a new path is a page view. The beacon counts every same-document
        // navigation, and where the Navigation API exists that includes each
        // history.replaceState, even one that keeps the URL: Astro's router
        // calls it whenever scrolling stops (to remember the position), and the
        // directories call it for ?show and their filters. Measured on the live
        // site 2026-09-14: four scroll stops on /about/ logged four extra page
        // views. Registered before the beacon loads, this listener stops those
        // from reaching it; the navigation itself goes ahead untouched.
        if (window.navigation) {
          window.navigation.addEventListener('navigate', function (e) {
            if (e.destination && e.destination.sameDocument && new URL(e.destination.url).pathname === location.pathname) {
              e.stopImmediatePropagation();
            }
          });
        }
        const s = document.createElement('script');
        s.defer = true;
        s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        s.setAttribute('data-cf-beacon', '{"token": "908fe9e663974dcf903e6a4d862d7bdf"}');
        document.head.appendChild(s);
      })();
    </script>
    <!-- html.js: this page can run scripts. CSS keys things off it that only
         make sense with JavaScript, such as the directories' "Show more" cut
         (global.css), so a reader or crawler without it gets the full list.
         Set before the first paint on each document. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // html[data-pointer]: the last input was a mouse or a touch, so focus
      // rings meant for keyboard users stay hidden. A text input matches
      // :focus-visible however it was focused, which is why CSS alone cannot
      // tell a click into the search box from a Tab into it.
      const root = document.documentElement;
      // html[data-lean]: this reader has put the directories' filter rail away
      // (see .sabl-lean in global.css). Read here, in <head>,
      // rather than by directory-client, so the wide layout is in the first
      // paint instead of arriving a frame later as a jump. Re-applied after
      // every swap for the same reason html.js is.
      function lean() {
        try { if (localStorage.getItem('sa_lean')) root.setAttribute('data-lean', ''); } catch { /* no storage: default layout */ }
      }
      lean();
      document.addEventListener('pointerdown', function () { root.setAttribute('data-pointer', ''); }, true);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Tab' || e.key.slice(0, 5) === 'Arrow') root.removeAttribute('data-pointer');
      }, true);
    </script>
  </head>
  <body class="min-h-screen min-h-svh flex flex-col overflow-x-clip md:overscroll-none">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-9999 focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold" style="background:#141915;color:#FBF8F2;">Skip to content</a>
    {/*
      The site header renders here, OUTSIDE <main>. It used to render inside
      it, which meant the page had no banner landmark to offer; a <header>
      nested in <main> is a plain group, not a banner, and "Skip to content"
      could not point at #main-content, because that landed the reader above
      the nav they were trying to skip. Hence the skip-target span this
      replaces. Named slot rather than a component so each page keeps control
      of its own header band and background.
    */}
    <slot name="header" />
    {/* tabindex so the skip link can actually move focus here, not just scroll. */}
    <main id="main-content" class="w-full flex-1" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    {/* Renders nothing unless PUBLIC_GA_ID is set. Last in the body so the
        consent banner lands at the end of the tab order rather than between
        the page and its footer. */}
    <Analytics />
    <script>
      import { syncTrackingOptOut, recordSourceVisit } from '../lib/events.ts';

      syncTrackingOptOut();
      recordSourceVisit();
      if ('serviceWorker' in navigator) void navigator.serviceWorker.register('/sw.js');

    </script>

    <style is:global>
      /* Every page under this layout is the fixed editorial palette, so the
         canvas is pinned here rather than left to global.css's themeable
         `html { background: var(--bg-page) }`. Pages already pin `body` via
         `body:has(#sab-*)`; `html` is what shows through on overscroll.
         global.css keeps its token rule for /admin, which does not use this
         layout. */
      html { background-color: #FBF8F2; }
    </style>
  </body>
</html>
