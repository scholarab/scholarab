---
import Layout from '../layouts/Layout.astro';
import { loadPrograms } from '../lib/data-loader';
import ProgramList from '../components/ProgramList.tsx';
import { generateSlug } from '../lib/utils';
let raw: Awaited<ReturnType<typeof loadPrograms>> = [];
let loadError = false;
try {
  raw = await loadPrograms();
} catch {
  loadError = true;
}
const mostRecentVerified = raw
  .map(p => p.lastVerified).filter(Boolean).sort().at(-1) ?? null;
const freshnessLabel = mostRecentVerified
  ? new Date(mostRecentVerified + 'T00:00:00').toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
// Enrich at build time — avoids Date parsing on every user's device
const programs = raw.map(p => ({
  ...p,
  _deadline_ms: p.deadline && p.deadline !== 'TBA' && p.deadline !== 'Ongoing'
    ? new Date(p.deadline + 'T00:00:00').getTime()
    : undefined,
  _slug: generateSlug(p.name),
}));
---

<Layout
  title="Alberta Student Research Programs 2026 | ScholarAB"
  description="Discover research programs and summer opportunities for Alberta high school students. Science, health, engineering, arts and more."
  ogTitle="Alberta Student Research Programs 2026 | ScholarAB"
  ogDescription="Discover research programs and summer opportunities for Alberta high school students. Science, health, engineering, arts and more."
  ogUrl="https://www.scholarab.ca/programs"
  currentPath="/programs"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Alberta Student Research Programs 2026",
    "description": "Discover research programs and summer opportunities for Alberta high school students. Science, health, engineering, arts and more.",
    "url": "https://www.scholarab.ca/programs",
    "provider": { "@type": "Organization", "name": "ScholarAB", "url": "https://www.scholarab.ca" },
    "hasPart": raw.slice(0, 10).map(p => ({
      "@type": "EducationalOccupationalProgram",
      "name": p.name,
      "url": `https://www.scholarab.ca/programs/${generateSlug(p.name)}`,
    })),
  })} slot="head" />
  <div>
    <h1 style="font-weight:800;font-size:clamp(26px,3.4vw,40px);margin:0 0 6px;">Research Programs</h1>
    <p style="font-size:14px;color:var(--text-secondary);margin:0 0 4px;line-height:1.65;">University-run summer programs, labs, and competitions open to Alberta high school students.</p>
    {freshnessLabel && <p class="freshness" style="margin-bottom:24px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Last verified: {freshnessLabel}</p>}
    {loadError ? (
      <div class="text-center py-20">
        <p class="text-sm font-semibold text-primary mb-2">Couldn't load programs</p>
        <p class="text-sm text-secondary mb-5">The database may be temporarily unavailable.</p>
        <a href="/programs" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold" style="background:var(--brand);color:var(--text-on-brand);">Try again</a>
      </div>
    ) : (
      <ProgramList items={programs} client:idle />
    )}
  </div>
</Layout>
