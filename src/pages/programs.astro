---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { loadPrograms } from '../lib/data-loader';
import ProgramDirectory from '../components/sab/ProgramDirectory.astro';
import { generateSlug } from '../lib/utils';
let raw: Awaited<ReturnType<typeof loadPrograms>> = [];
let loadError = false;
try {
  // Retired programs (active: false) keep their detail pages for old links
  // but stay out of the directory, matching the sitemap and the quiz.
  raw = (await loadPrograms()).filter(p => p.active !== false);
} catch {
  loadError = true;
}
// Enrich at build time — avoids Date parsing on every user's device
const programs = raw.map(p => ({
  ...p,
  _deadline_ms: p.deadline && p.deadline !== 'TBA' && p.deadline !== 'Ongoing'
    ? new Date(p.deadline + 'T00:00:00').getTime()
    : undefined,
  _slug: generateSlug(p.name),
}));
---

<Layout
  title="Alberta Student Research Programs 2026 | ScholarAB"
  description="Research programs, competitions, and apprenticeships for Alberta high school students. Science, health, engineering, computing, trades and more."
  ogTitle="Alberta Student Research Programs 2026 | ScholarAB"
  ogDescription="Research programs, competitions, and apprenticeships for Alberta high school students. Science, health, engineering, computing, trades and more."
  ogUrl="https://www.scholarab.ca/programs/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Alberta Student Research Programs 2026",
    "description": "Research programs, competitions, and apprenticeships for Alberta high school students. Science, health, engineering, computing, trades and more.",
    "url": "https://www.scholarab.ca/programs/",
    "provider": { "@type": "Organization", "name": "ScholarAB", "url": "https://www.scholarab.ca" },
    "hasPart": raw.slice(0, 10).map(p => ({
      "@type": "EducationalOccupationalProgram",
      "name": p.name,
      "url": `https://www.scholarab.ca/programs/${generateSlug(p.name)}/`,
    })),
  })} slot="head" />
  <SabFonts slot="head" />

  <div id="sab-programs" class="sabp">
    <div class="sabp-header">
      <SabHeader currentPath="/programs" />
    </div>

    <div class="sabp-body">
      {loadError ? (
        <div class="sabl-empty" style="margin-top:64px;">
          <div class="sabl-empty-title">Couldn't load programs.</div>
          <div class="sabl-empty-sub">The database may be temporarily unavailable.</div>
          <a href="/programs/" class="sabl-empty-btn" style="display:inline-block;text-decoration:none;">Try again</a>
        </div>
      ) : (
        <ProgramDirectory items={programs} />
      )}
    </div>

    <SabFooter />
  </div>
</Layout>

<style is:global>
  /* The directory design is fixed light regardless of site theme */
  body:has(#sab-programs) { background: #FAF7F0; }
</style>
