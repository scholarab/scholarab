---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { loadPrograms } from '../lib/data-loader';
import ProgramDirectory from '../components/sab/ProgramDirectory.astro';
import SabGuideRail from '../components/sab/SabGuideRail.astro';
import { enrichPrograms } from '../lib/enrich';
import { DEFAULT_PROGRAM_STATE, filterSortPrograms } from '../lib/list-core';
import { itemListJson } from '../lib/ld';
import { todayDate as albertaToday } from '../lib/calendar';
import { programIsListed } from '../lib/status';
import { ALL_PROGRAM_FACETS, facetItems, MIN_FACET_ITEMS } from '../lib/facets';
let raw: Awaited<ReturnType<typeof loadPrograms>> = [];
let loadError = false;
try {
  // Retired programs (active: false) keep their detail pages for old links
  // but stay out of the directory, matching the sitemap and the quiz.
  raw = (await loadPrograms()).filter(p => p.active !== false);
} catch {
  loadError = true;
}
// Shared with the facet hubs; see lib/enrich.ts.
const programs = enrichPrograms(raw);
const today = albertaToday();
const listed = programs.filter(p => programIsListed(p, today));
const browseFacets = ALL_PROGRAM_FACETS
  .filter(f => facetItems(f, listed).length >= MIN_FACET_ITEMS)
  .map(({ slug, label, kind }) => ({ slug, label, kind }));

// See scholarships.astro: the ItemList has to walk the order the page shows.
const ordered = filterSortPrograms(programs, DEFAULT_PROGRAM_STATE);
const listJson = itemListJson(
  ordered.map(p => ({ name: p.name, url: `https://www.scholarab.ca/programs/${p._slug}/` })),
  'Programs for Alberta High School Students',
  'https://www.scholarab.ca/programs/',
);
---

<Layout
  title="Programs for Alberta High School Students | ScholarAB"
  description="Research programs, competitions, and apprenticeships for Alberta high school students. Science, health, engineering, computing, trades and more."
  ogTitle="Programs for Alberta High School Students | ScholarAB"
  ogDescription="Research programs, competitions, and apprenticeships for Alberta high school students. Science, health, engineering, computing, trades and more."
  ogUrl="https://www.scholarab.ca/programs/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Programs for Alberta High School Students",
    "description": "Research programs, competitions, and apprenticeships for Alberta high school students. Science, health, engineering, computing, trades and more.",
    "url": "https://www.scholarab.ca/programs/",
    "provider": { "@type": "Organization", "name": "ScholarAB", "url": "https://www.scholarab.ca" },
    "hasPart": programs.slice(0, 10).map(p => ({
      "@type": "EducationalOccupationalProgram",
      "name": p.name,
      "url": `https://www.scholarab.ca/programs/${p._slug}/`,
    })),
  })} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listJson)} slot="head" />
  <SabFonts slot="head" chips />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/programs" />
  </div>

  <div id="sab-programs" class="sabp sabp-wide">
    <div class="sabp-body">
      {loadError ? (
        <div class="sabl-empty" style="margin-top:64px;">
          <div class="sabl-empty-title">Couldn't load programs.</div>
          <div class="sabl-empty-sub">The database may be temporarily unavailable.</div>
          <a href="/programs/" class="sabl-empty-btn" style="display:inline-block;text-decoration:none;">Try again</a>
        </div>
      ) : (
        <ProgramDirectory items={programs} browseFacets={browseFacets} railFilters />
      )}
    </div>

    {/* The two directories are the highest-authority pages on the site and
        linked to no guide at all; see SabGuideRail. Outside .sabp-body so the
        rail spans the page rather than sitting inside the directory column. */}
    <SabGuideRail
      slugs={['high-school-research-programs-alberta', 'high-school-computing-programs-alberta', 'medical-experience-high-school-alberta']}
      heading="Which of these is for you"
    />

  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  /* The directory design is fixed light regardless of site theme */
  body:has(#sab-programs) { background: var(--bg-page); }
</style>
