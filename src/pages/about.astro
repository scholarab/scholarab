---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { webPageJson } from '../lib/ld';
interface Principle {
  title: string;
  body: string;
  /** Optional trailing link, rendered after the body. */
  more?: { href: string; label: string };
}
const principles: Principle[] = [
  {
    title: 'No ads',
    body: 'Nothing on the site advertises to you. Listings are sorted by deadline.',
  },
  {
    // "No personal data" flat contradicts /privacy, which discloses an email,
    // a salted IP hash and the text of dead-end searches. "Required" is the
    // word that makes it true: none of it is asked for, the email is offered.
    title: 'No personal data required',
    // Kept deliberately in step with /privacy's table. That page discloses five
    // things: the email, what the reminder is for, a salted hash of the IP for
    // rate limiting, the text of searches that find nothing, and anonymous
    // counts. "The only thing we ever store is an email address" contradicted
    // three of those, so this summary now names them and links to the full list.
    body: 'No name, school, or grades, ever. The only personal information we hold is an email address, and only if you ask for a deadline reminder; delete it any time, in one click. Bookmarks and quiz answers stay on your device and never leave it. Beyond that we keep anonymous counts of what gets used, and the text of searches that find nothing, so we know what to add next. No advertising, no data brokers, and nothing stored that points back to a person. The one thing that would set a cookie is Google Analytics, and it only runs if you press Allow on the banner asking; say no, or ignore it, and it never loads.',
    more: { href: '/privacy/', label: 'The full list is on the privacy page.' },
  },
  {
    title: 'No account required',
    body: 'Everything is public and works on any device, instantly.',
  },
];
const title = 'About ScholarAB | Free Alberta Scholarship Directory';
const description =
  'ScholarAB is a free scholarship directory built by Ilia Ivanov, a Medicine Hat high school student. No ads, no login, no data sold.';
// The founder node reuses the @id declared on the homepage Organization, so
// Google reads one person described in two places rather than two people who
// happen to share a name.
const ldJson = webPageJson({ name: 'About ScholarAB', description, path: '/about/' }, [
  {
    '@type': 'Person',
    '@id': 'https://www.scholarab.ca/#founder',
    name: 'Ilia Ivanov',
    url: 'https://www.scholarab.ca/about/',
    sameAs: 'https://www.linkedin.com/in/iliaivanov/',
  },
]);
---

<Layout
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogUrl="https://www.scholarab.ca/about/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} slot="head" />
  <SabFonts slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/about" />
  </div>

  <div id="sab-about" class="sabp" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="saba-body" style="flex:1;">
      <!-- Title -->
      <h1 class="saba-h1">The story behind ScholarAB</h1>

      <!-- The story, in Ilia's words (2026-09-18) -->
      <div class="saba-paper-wrap">
      <section class="saba-story saba-paper" id="story">
        <p>During my first week of Grade 10, I was signing up for dual credit courses when the coordinator mentioned that they could strengthen my resume and help with scholarship applications. He told me about a friend’s son who had covered his university tuition through scholarships that hardly anyone applied for.</p>
        <p>I remembered that conversation because I wanted to go to university too, and I knew I’d need scholarships myself.</p>
        <p>At the start of Grade 11, I began searching for scholarships myself. The information was scattered across different websites, and a lot of them wanted me to create an account and fill out registration forms. That got tiring. I just wanted to see which scholarships I could apply for without signing up for so many sites.</p>
        <p>In March 2026, I started working on the first version of ScholarAB. I made it free, with no ads and no account required, because those were the things I wanted when I first started searching.</p>
        <p>I’m a high school student from Medicine Hat, and this project grew out of my own experience trying to find scholarships. I figured other students were running into the same problems, and I wanted to make that search easier.</p>
        <p class="saba-paper-right saba-paper-sign">I.I.</p>
      </section>
      </div>

      <!-- How this works -->
      <div class="saba-card">
        <h2 class="saba-card-label">HOW THIS WORKS</h2>
        {principles.map((p, i) => (
          <div class="saba-principle" style={i === 0 ? 'border-top-color:transparent;' : undefined}>
            <div>
              <h3 class="saba-principle-title">{p.title}</h3>
              <div class="saba-principle-body">
                {p.body}
                {p.more && <> <a href={p.more.href}>{p.more.label}</a></>}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Open source + creator -->
      <h2 class="saba-os-label">
        <span class="saba-dot" style="background:#2FD3A0;" aria-hidden="true"></span>
        <span>OPEN SOURCE UNDER AGPL-3.0</span>
      </h2>
      <div class="saba-actions">
        <a
          href="https://github.com/scholarab/scholarab"
          target="_blank" rel="noopener noreferrer"
          class="saba-btn saba-btn-solid"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
          <span>View on GitHub</span>
        </a>
        <!--email_off--><a href="mailto:contact.scholarab@gmail.com" class="saba-btn saba-btn-outline">contact.scholarab@gmail.com</a><!--/email_off-->
      </div>
      <p class="saba-creator">
        Created by <a href="https://www.linkedin.com/in/iliaivanov/" target="_blank" rel="noopener noreferrer" class="saba-creator-name">Ilia Ivanov</a>, a <a href="https://mhhs.mhpsd.ca/" target="_blank" rel="noopener noreferrer" class="saba-creator-link">Medicine Hat High School</a> student.
      </p>
    </div>

  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  /* The about design is fixed light regardless of site theme */
  body:has(#sab-about) { background: var(--bg-page); }
</style>

<style is:global>
  @font-face { font-family: 'Patrick Hand'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/hw-patrick-hand.woff2') format('woff2'); }
</style>

<style>
  .saba-body { padding: 72px var(--sab-gutter) 110px; width: 100%; max-width: var(--sab-measure); margin: 0 auto; box-sizing: border-box; }

  .saba-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(44px, 7vw, 76px); line-height: 1.05; letter-spacing: -0.015em; margin: 0;
  }

  /* The story is written on a sheet of ruled paper (Ilia, 2026-09-18).
     The scan's blue rules are 54.594px apart at its native 1326px width,
     first rule at y=227, red margin at x=46, faint right margin near 1090.
     --u is one scan pixel at the rendered size, so every measurement below is
     in scan pixels and the text lands on the rules at any width. The sheet
     never renders narrower than 700px (a phone shows its left part), because
     narrower rules would force the writing below a readable size.
     The scan is cut in two: the top 1073 rows, then an 11-rule band that
     repeats for as long as the story runs. Line height is one rule;
     paragraphs are one blank rule apart (1lh). The first baseline sits
     0.08 of a rule above rule one: padding = 227 minus the half line box
     minus the face's ascent-over-descent share, all in rule units. */
  .saba-paper-wrap { container-type: inline-size; max-width: 880px; margin-top: 40px; }
  /* Patrick Hand: printed handwriting, chosen over Kalam and Caveat as the
     least template-looking of the three that still reads easily. */
  .saba-paper {
    --pw: max(100cqi, 700px); --u: calc(var(--pw) / 1326); --rule: calc(var(--u) * 54.594);
    --hw-r: 0.707; --hw-ad: 0.730;
    background:
      url('/photos/paper/lined-top.webp') 0 0 / var(--pw) auto no-repeat,
      url('/photos/paper/lined-band.webp') 0 calc(var(--u) * 1073) / var(--pw) auto repeat-y;
    background-color: #F7F9FA;
    box-shadow: 0 1px 2px rgba(20,25,21,0.08), 0 10px 30px rgba(20,25,21,0.10);
    font-family: 'Patrick Hand', 'Comic Sans MS', cursive;
    font-size: calc(var(--rule) * var(--hw-r)); line-height: var(--rule);
    color: #1F2A44;
    padding: calc(var(--u) * (199.703 - 54.594 * (var(--hw-r) * var(--hw-ad) / 2 + 0.08))) calc(var(--u) * 250) calc(var(--rule) * 2) calc(var(--u) * 80);
    box-sizing: border-box;
  }
  .saba-paper p { margin: 0 0 1lh; }
  .saba-paper p:last-child { margin-bottom: 0; }
  /* The initials under the last paragraph, right-aligned like a signed
     letter, one blank rule below it. */
  .saba-paper-right { text-align: right; }
  .saba-paper-sign { font-size: 1.15em; }
  .saba-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }

  .saba-card {
    background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 20px;
    padding: 36px 40px 20px; margin-top: 64px;
  }
  .saba-card-label {
    font-family: var(--font-label); font-weight: 400;
    font-size: 12.5px; letter-spacing: 0.06em; color: rgba(20, 25, 21, 0.65); margin: 0 0 8px;
  }
  /* No 01/02/03 badge: three promises, not three steps. */
  .saba-principle {
    display: grid; grid-template-columns: 1fr; gap: 20px;
    padding: 22px 0; border-top: 1px solid rgba(20,25,21,0.12); align-items: start;
  }
  .saba-principle-title { font-weight: 700; font-size: 18px; letter-spacing: -0.01em; margin: 0 0 6px; }
  .saba-principle-body { font-size: 15px; line-height: 1.6; color: rgba(20, 25, 21, 0.65); max-width: 720px; }
  .saba-principle-body a { color: #0A6B4D; text-decoration: underline; text-underline-offset: 2px; }

  .saba-os-label {
    display: flex; align-items: center; gap: 10px; padding: 14px 0;
    border-top: 2px solid #141915; margin: 64px 0 0;
    font-family: var(--font-label); font-weight: 400;
    font-size: 12.5px; letter-spacing: 0.06em; color: rgba(20, 25, 21, 0.65);
  }
  .saba-actions { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
  .saba-btn {
    display: inline-flex; align-items: center; gap: 10px;
    color: #141915; font-weight: 600; font-size: 15px;
    padding: 13px 24px; border-radius: 100px; text-decoration: none;
    transition: border-color 0.18s ease,
                transform 0.18s cubic-bezier(0.2, 0.8, 0.3, 1), box-shadow 0.18s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .saba-btn:active { transform: translate(1px, 1px); box-shadow: 0 0 0 #0E8C64; transition-duration: 0.07s; }
  .saba-btn-solid { border: 1.5px solid rgba(20,25,21,0.85); background: #FFFFFF; }
  .saba-btn-solid:hover, .saba-btn-solid:focus-visible {
    color: #141915; transform: translate(-2px, -2px); box-shadow: 5px 5px 0 #0E8C64;
  }
  .saba-btn-outline { border: 1.5px solid rgba(20,25,21,0.3); }
  .saba-btn-outline:hover, .saba-btn-outline:focus-visible {
    border-color: #0A6B4D; color: #141915;
    transform: translate(-2px, -2px); box-shadow: 5px 5px 0 #0E8C64;
  }
  @media (prefers-reduced-motion: reduce) {
    .saba-btn, .saba-btn:hover, .saba-btn:focus-visible, .saba-btn:active { transform: none; transition: none; }
  }

  .saba-creator { font-size: 16px; line-height: 1.6; color: rgba(20, 25, 21, 0.65); margin: 40px 0 0; }
  .saba-creator-name { color: #141915; font-weight: 700; }
  .saba-creator-name:hover, .saba-creator-link:hover { color: #0A6B4D; }
  .saba-creator-link { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(20, 25, 21, 0.3); }

  /* The design specifies >=1080px only; below is our adaptation. */
  @media (max-width: 900px) {
    .saba-body { padding: 40px 20px 72px; }
    .saba-paper { padding-right: calc(var(--u) * 60); }
    .saba-card { padding: 24px 20px 12px; margin-top: 48px; }
    /* The 44px column held the 01/02/03 badge; with the badge gone it took the
       card's only child and set every title one word per line. */
    .saba-principle { gap: 14px; }
    .saba-os-label { margin-top: 48px; }
    .saba-actions .saba-btn { font-size: 14px; padding: 12px 20px; }
  }
</style>
