---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { webPageJson } from '../lib/ld';
const title = 'About ScholarAB | Free Alberta Scholarship Directory';
const description =
  'ScholarAB is a free scholarship directory built by Ilia Ivanov, a Medicine Hat high school student. No ads, no login, no data sold.';
// The founder node reuses the @id declared on the homepage Organization, so
// Google reads one person described in two places rather than two people who
// happen to share a name.
const ldJson = webPageJson({ name: 'About ScholarAB', description, path: '/about/' }, [
  {
    '@type': 'Person',
    '@id': 'https://www.scholarab.ca/#founder',
    name: 'Ilia Ivanov',
    url: 'https://www.scholarab.ca/about/',
    sameAs: 'https://www.linkedin.com/in/iliaivanov/',
  },
]);
---

<Layout
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogUrl="https://www.scholarab.ca/about/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} slot="head" />
  <SabFonts slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/about" />
  </div>

  <div id="sab-about" class="sabp" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="saba-body" style="flex:1;">
      <h1 class="saba-h1">The story behind ScholarAB</h1>
      <p class="saba-creator">
        By <a href="https://www.linkedin.com/in/iliaivanov/" target="_blank" rel="noopener noreferrer">Ilia Ivanov</a>, a <a href="https://mhhs.mhpsd.ca/" target="_blank" rel="noopener noreferrer">Medicine Hat High School</a> student.
      </p>

      <!-- The story, in Ilia's words (2026-09-18) -->
      <div class="saba-paper-wrap">
      <section class="saba-story saba-paper" id="story">
        <p>During my first week of Grade 10, I was signing up for dual credit courses when the coordinator mentioned that they could strengthen my resume and help with scholarship applications. He told me about a friend’s son who had covered his university tuition through scholarships that hardly anyone applied for.</p>
        <p>I remembered that conversation because I wanted to go to university too, and I knew I’d need scholarships myself.</p>
        <p>At the start of Grade 11, I began searching for scholarships myself. The information was scattered across different websites, and a lot of them wanted me to create an account and fill out registration forms. That got tiring. I just wanted to see which scholarships I could apply for without signing up for so many sites.</p>
        <p>In March 2026, I started working on the first version of ScholarAB. I made it free, with no ads and no account required, because those were the things I wanted when I first started searching.</p>
        <p>I figured other students were running into the same problems, and I wanted to make that search easier.</p>
      </section>
      </div>

      <section class="saba-details" aria-labelledby="saba-details-heading">
        <h2 id="saba-details-heading">About the site</h2>
        <p>Saved listings and quiz answers stay on your device. Reminder emails require confirmation, and you can unsubscribe at any time. The <a href="/privacy/">privacy page</a> explains what else we collect and how to control it.</p>
        <p>For questions or corrections, email <!--email_off--><a href="mailto:contact.scholarab@gmail.com">contact.scholarab@gmail.com</a><!--/email_off-->.</p>
        <p>The code is <a href="https://github.com/scholarab/scholarab" target="_blank" rel="noopener noreferrer">on GitHub</a> under AGPL-3.0.</p>
      </section>
    </div>

  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  /* The about design is fixed light regardless of site theme */
  body:has(#sab-about) { background: var(--bg-page); }
</style>

<style is:global>
  @font-face { font-family: 'Patrick Hand'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/hw-patrick-hand.woff2') format('woff2'); }
</style>

<style>
  .saba-body { padding: 72px var(--sab-gutter) 110px; width: 100%; max-width: var(--sab-measure); margin: 0 auto; box-sizing: border-box; }

  .saba-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(44px, 7vw, 76px); line-height: 1.05; letter-spacing: -0.015em; margin: 0;
  }

  /* The story is written on a sheet of ruled paper (Ilia, 2026-09-18).
     The scan's blue rules are 54.594px apart at its native 1326px width,
     first rule at y=227, red margin at x=46, faint right margin near 1090.
     --u is one scan pixel at the rendered size, so every measurement below is
     in scan pixels and the text lands on the rules at any width. The sheet
     never renders narrower than 700px (a phone shows its left part), because
     narrower rules would force the writing below a readable size.
     The scan is cut in two: the top 1073 rows, then an 11-rule band that
     repeats for as long as the story runs. Line height is one rule;
     paragraphs are one blank rule apart (1lh). The first baseline sits
     0.08 of a rule above rule one: padding = 227 minus the half line box
     minus the face's ascent-over-descent share, all in rule units. */
  .saba-paper-wrap { container-type: inline-size; max-width: 880px; margin-top: 40px; }
  /* Patrick Hand: printed handwriting, chosen over Kalam and Caveat as the
     least template-looking of the three that still reads easily. */
  .saba-paper {
    --pw: max(100cqi, 700px); --u: calc(var(--pw) / 1326); --rule: calc(var(--u) * 54.594);
    --hw-r: 0.707; --hw-ad: 0.730;
    background:
      url('/photos/paper/lined-top.webp') 0 0 / var(--pw) auto no-repeat,
      url('/photos/paper/lined-band.webp') 0 calc(var(--u) * 1073) / var(--pw) auto repeat-y;
    background-color: #F7F9FA;
    box-shadow: 0 1px 2px rgba(20,25,21,0.08), 0 10px 30px rgba(20,25,21,0.10);
    font-family: 'Patrick Hand', 'Comic Sans MS', cursive;
    font-size: calc(var(--rule) * var(--hw-r)); line-height: var(--rule);
    color: #1F2A44;
    padding: calc(var(--u) * (199.703 - 54.594 * (var(--hw-r) * var(--hw-ad) / 2 + 0.08))) calc(var(--u) * 250) calc(var(--rule) * 2) calc(var(--u) * 80);
    box-sizing: border-box;
  }
  .saba-paper p { margin: 0 0 1lh; }
  .saba-paper p:last-child { margin-bottom: 0; }
  .saba-details { margin-top: 48px; max-width: 720px; font-size: 16px; line-height: 1.6; color: rgba(20,25,21,0.8); }
  .saba-details h2 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(32px, 4vw, 44px); line-height: 1.1; letter-spacing: -0.01em;
    color: var(--text-primary); margin: 0 0 20px;
  }
  .saba-details p { margin: 0 0 16px; }
  .saba-details p:last-child { margin-bottom: 0; }
  .saba-creator { font-size: 16px; line-height: 1.6; color: rgba(20,25,21,0.8); margin: 16px 0 0; }
  .saba-creator a, .saba-details a { color: #0A6B4D; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .saba-creator a:hover, .saba-details a:hover { text-decoration-thickness: 2px; }

  /* The design specifies >=1080px only; below is our adaptation. */
  @media (max-width: 900px) {
    .saba-body { padding: 40px 20px 72px; }
    .saba-paper { padding-right: calc(var(--u) * 60); }
  }
</style>
