---
import SabFooter from '../components/sab/SabFooter.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
---

<Layout
  title="Page Not Found | ScholarAB"
  description="This page does not exist. Browse Alberta scholarships and research programs on ScholarAB."
  ogTitle="Page Not Found | ScholarAB"
  ogDescription="This page does not exist. Browse Alberta scholarships and research programs on ScholarAB."
  ogUrl="https://www.scholarab.ca/404/"
  robots="noindex, follow"
>
  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/404" />
  </div>

  <div id="sab-404" class="sabp" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabp-body" style="flex:1;display:flex;flex-direction:column;justify-content:center;">
      <div class="sab-kicker" style="--kicker:#A0491A;">ERROR 404</div>
      <h1 class="sab404-h1">This page doesn't exist.</h1>
      <p class="sab404-copy">The link may be old, or the address was mistyped. Everything real lives one click away.</p>
      <div class="sab404-actions">
        <a href="/" class="sab-btn sab404-btn-accent">Back home</a>
        <a href="/scholarships/" class="sab-btn sab404-btn-outline">Browse scholarships</a>
      </div>
    </div>

  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  body:has(#sab-404) { background: #FBF8F2; }
</style>

<style>
  .sab404-h1 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(44px, 6vw, 68px); line-height: 1.05; letter-spacing: -0.015em; margin: 0;
  }
  .sab404-copy { font-size: 17px; line-height: 1.6; color: rgba(20,25,21,0.65); margin: 20px 0 0; max-width: 480px; }
  .sab404-actions { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .sab404-btn-accent {
    display: inline-flex; align-items: center; font-weight: 600; font-size: 15px;
    background: #2FD3A0; color: #08120E; padding: 13px 24px; border-radius: 100px; text-decoration: none;
  }
  .sab404-btn-accent:hover { background: #4FE0B4; color: #08120E; }
  .sab404-btn-outline {
    display: inline-flex; align-items: center; font-weight: 600; font-size: 15px;
    color: #141915; padding: 13px 24px; border-radius: 100px;
    border: 1.5px solid rgba(20,25,21,0.3); text-decoration: none;
  }
  .sab404-btn-outline:hover { border-color: #141915; color: #141915; }
</style>
