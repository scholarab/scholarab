---
// The deadline calendar: /deadlines/.
//
// Every other surface on the site is organised by WHAT an award is: its
// region, its category, its provider. This one is organised by WHEN, which is
// the axis a student in the middle of a semester actually plans on, and the
// axis the site had no page for. It is also the axis the two directories
// cannot express: they sort by deadline, but a sorted list has no month
// headings, no anchors, and nothing for "what closes in March" to land on.
//
// Scholarships and programs share the months. A Grade 12 student does not
// think of them as two systems, and a month showing four awards while hiding
// the summer research application that closes the same week is lying by
// omission about that month's workload.
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { loadScholarships, loadPrograms } from '../lib/data-loader';
import { generateSlug, getToday } from '../lib/utils';
import { scholarshipStatusOf, programIsListed } from '../lib/status';
import { formatListingDate } from '../lib/meta';
import { itemListJson } from '../lib/ld';

const today = getToday();
const todayMs = today.getTime();
const dayMs = (d: string) => new Date(d + 'T00:00:00').getTime();

let scholarships: Awaited<ReturnType<typeof loadScholarships>> = [];
let programs: Awaited<ReturnType<typeof loadPrograms>> = [];
let loadError = false;
try {
  [scholarships, programs] = await Promise.all([loadScholarships(), loadPrograms()]);
} catch {
  loadError = true;
}

interface Row {
  kind: 'scholarship' | 'program';
  name: string;
  href: string;
  deadline: string;
  meta: string;
  /** The short status the row prints on the right. */
  state: string;
  /** True for "you can apply to this today", which is the only row a student can act on now. */
  open: boolean;
}

// ── What earns a place on the calendar ──────────────────────────────────────
//
// A dated deadline, still ahead of today. Nothing else: a passed deadline is
// a closed listing (noindexed on its own page, so linking a crawler to it from
// an indexable page is worse than useless), and a listing with no date has
// nothing to file under a month. Both of those get their own section at the
// foot of the page rather than an invented month.
const scholarshipRows: Row[] = scholarships
  .filter(s => s.deadline && dayMs(s.deadline) >= todayMs)
  .map(s => {
    const status = scholarshipStatusOf(s, today);
    return {
      kind: 'scholarship' as const,
      name: s.title,
      href: `/scholarships/${generateSlug(s.title)}/`,
      deadline: s.deadline!,
      meta: s.amount || 'Varies',
      // `active: false` is "next cycle, open date not known yet", not closed;
      // so the row says when it opens if the data knows, and says only that it
      // isn't open yet if it doesn't. Never a guessed month.
      // A rolled-forward date is filed under last cycle's month, so the row
      // says so rather than letting the calendar vouch for it.
      state: status === 'active'
        ? 'Open now'
        : status === 'unconfirmed'
          ? 'Date not confirmed'
          : s.openDate
          ? `Opens ${formatListingDate(s.openDate)}`
          : 'Not open yet',
      open: status === 'active',
    };
  });

const programRows: Row[] = programs
  .filter(p => programIsListed(p, today))
  .filter(p => p.deadline && p.deadline !== 'TBA' && p.deadline !== 'Ongoing' && dayMs(p.deadline) >= todayMs)
  .map(p => ({
    kind: 'program' as const,
    name: p.name,
    href: `/programs/${generateSlug(p.name)}/`,
    deadline: p.deadline!,
    // The column is money. A program's grade text sat under the scholarships'
    // amounts and read as one (critique 2026-09-24); the Program tag already
    // says what the row is.
    meta: p.stipend || (p.paid ? 'Paid' : ''),
    state: 'Open now',
    open: true,
  }));

const rows = [...scholarshipRows, ...programRows].sort(
  (a, b) => dayMs(a.deadline) - dayMs(b.deadline) || a.name.localeCompare(b.name),
);

// ── Months ──────────────────────────────────────────────────────────────────
//
// Derived from the data, not from a fixed twelve-month window: a window would
// print empty months at both ends every time the corpus shifted, and an empty
// month heading in a jump nav is a promise the page then breaks.
const byMonth = new Map<string, Row[]>();
for (const r of rows) {
  const key = r.deadline.slice(0, 7);
  (byMonth.get(key) ?? byMonth.set(key, []).get(key)!).push(r);
}
const monthName = (key: string) =>
  new Date(key + '-01T00:00:00').toLocaleDateString('en-CA', { month: 'long', year: 'numeric' });
const monthShort = (key: string) =>
  new Date(key + '-01T00:00:00').toLocaleDateString('en-CA', { month: 'short' }).toUpperCase();
const dayOf = (d: string) => String(new Date(d + 'T00:00:00').getDate());
// The week list crosses a month boundary and has no month heading above it.
const monthDayOf = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString('en-CA', { month: 'short', day: 'numeric' });

const months = [...byMonth.entries()]
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([key, items]) => ({
    key,
    items,
    name: monthName(key),
    short: monthShort(key),
    openCount: items.filter(r => r.open).length,
  }));

// The two tails. Both are real answers to "why isn't X on this page", so they
// are on the page rather than left to be discovered as an absence.
const undated = scholarships
  .filter(s => !s.deadline)
  .map(s => ({ name: s.title, href: `/scholarships/${generateSlug(s.title)}/`, meta: s.amount || 'Varies' }))
  .sort((a, b) => a.name.localeCompare(b.name));

const rollingPrograms = programs.filter(
  p => programIsListed(p, today) && (!p.deadline || p.deadline === 'TBA' || p.deadline === 'Ongoing'),
).length;

const openNow = rows.filter(r => r.open).length;
// The seven days a student with a deadline close is actually asking about,
// above the months (critique 2026-09-23: the page opened on all of September).
const WEEK_MS = 7 * 86400000;
const thisWeek = rows.filter(r => dayMs(r.deadline) - todayMs <= WEEK_MS);
// Listed once: a row in "Due this week" is left out of its month, which says
// how many went above instead of printing them twice (critique 2026-09-24).
const inWeek = new Set(thisWeek);
const first = months[0];
const last = months.at(-1);
const span = first && last && first.key !== last.key
  ? `${first.name} through ${last.name}`
  : first?.name ?? '';

const canonical = 'https://www.scholarab.ca/deadlines/';
const description =
  'Every Alberta scholarship and research program deadline we track, month by month. '
  + `${rows.length} dated deadlines, ${openNow} open to apply today.`;

const listJson = itemListJson(
  rows.map(r => ({ name: r.name, url: `https://www.scholarab.ca${r.href}` })),
  'Alberta Scholarship Deadlines',
  canonical,
);

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scholarab.ca/' },
    { '@type': 'ListItem', position: 2, name: 'Deadlines', item: canonical },
  ],
};
---

<Layout
  title="Alberta Scholarship Deadlines by Month | ScholarAB"
  description={description}
  ogTitle="Alberta Scholarship Deadlines by Month | ScholarAB"
  ogDescription={description}
  ogUrl={canonical}
  canonical={canonical}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listJson)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <SabFonts slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/deadlines" />
  </div>

  <div id="sab-deadlines" class="sabp">
    <div class="sabp-body sabd-cal">
      {loadError ? (
        <div class="sabcal-empty">
          <h1 class="sabcal-h1">Deadlines</h1>
          <p>Couldn't load the calendar. The database may be temporarily unavailable.</p>
          <p><a href="/scholarships/">Browse all scholarships</a> instead.</p>
        </div>
      ) : (
        <>
          <nav class="sabl-crumbs sabl-mono" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Deadlines</span>
          </nav>

          <header class="sabcal-head">
            <h1 class="sabcal-h1">Alberta scholarship deadlines, month by month</h1>
            <p class="sabcal-intro">
              Every dated scholarship and program deadline, soonest first. {span ? `${span}.` : ''}
              Dates can move, so check the provider's page before you plan around one.
            </p>
            <p class="sabcal-stats">
              {`${rows.length.toLocaleString('en-CA')} dated deadlines (${scholarshipRows.length.toLocaleString('en-CA')} scholarships, ${programRows.length.toLocaleString('en-CA')} programs) across ${months.length} months, ${openNow.toLocaleString('en-CA')} of them open to apply today.`}
            </p>
          </header>

          <nav class="sabcal-jump" aria-label="Jump to a month">
            {thisWeek.length > 0 && (
              <a href="#this-week" class="sabcal-chip sabcal-chip-week">
                <span class="sabcal-chip-m">This week</span>
                <span class="sabcal-chip-n tnum">{thisWeek.length}</span>
              </a>
            )}
            {months.map(m => (
              <a href={`#${m.key}`} class="sabcal-chip">
                <span class="sabcal-chip-m">{m.short}</span>
                <span class="sabcal-chip-n tnum">{m.items.length}</span>
              </a>
            ))}
          </nav>

          {thisWeek.length > 0 && (
            <section class="sabcal-month sabcal-week" id="this-week" aria-labelledby="this-week-h">
              <div class="sabcal-month-head">
                <h2 class="sabcal-h2" id="this-week-h">Due this week</h2>
                <span class="sabcal-month-count">{`${thisWeek.length} ${thisWeek.length === 1 ? 'deadline' : 'deadlines'}`}</span>
              </div>
              <ol class="sabcal-rows">
                {thisWeek.map(r => (
                  <li class="sabcal-row" data-deadline={r.deadline}>
                    <span class="sabl-mono sabcal-day sabcal-day-md tnum">{monthDayOf(r.deadline)}</span>
                    <span class="sabcal-name">
                      <a href={r.href}>{r.name}</a>
                      {r.kind === 'program' && <span class="sabcal-tag">Program</span>}
                    </span>
                    <span class="sabcal-sub">
                      <span class="sabcal-meta">{r.meta}</span>
                      <span class:list={['sabcal-state', r.open && 'is-open']}>{r.state}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {/* This month and next open; the rest fold into their headings, so
              the page is a calendar to scan rather than a 78,000px scroll
              (critique 2026-09-23). The jump links open a folded month. */}
          {months.map((m, i) => (
            <details class="sabcal-month" id={m.key} open={i < 2}>
              <summary class="sabcal-month-head">
                <h2 class="sabcal-h2">{m.name}</h2>
                <span class="sabcal-month-count">
                  {`${m.items.length} ${m.items.length === 1 ? 'deadline' : 'deadlines'}${m.openCount > 0 ? `, ${m.openCount} open now` : ''}`}
                </span>
              </summary>
              {m.items.some(r => inWeek.has(r)) && (
                <p class="sabcal-above">
                  {(n => `${n} due this week ${n === 1 ? 'is' : 'are'} listed above.`)(m.items.filter(r => inWeek.has(r)).length)}
                </p>
              )}
              <ol class="sabcal-rows">
                {m.items.filter(r => !inWeek.has(r)).map(r => (
                  <li class="sabcal-row">
                    <span class="sabl-mono sabcal-day tnum">{dayOf(r.deadline)}</span>
                    <span class="sabcal-name">
                      <a href={r.href}>{r.name}</a>
                      {r.kind === 'program' && <span class="sabcal-tag">Program</span>}
                    </span>
                    <span class="sabcal-sub">
                      <span class="sabcal-meta">{r.meta}</span>
                      <span class:list={['sabcal-state', r.open && 'is-open']}>{r.state}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </details>
          ))}

          <section class="sabcal-tail">
            <h2 class="sabcal-h2">Awards with no fixed deadline</h2>
            <p>
              {undated.length.toLocaleString('en-CA')} listings have no date to file under a month; they run until the money
              is gone, or the provider has never published one. They are worth a look early rather
              than late.
            </p>
            {/* Folded: open, the list was most of a 54,000px phone page
                (critique 2026-09-24). */}
            <details class="sabcal-undated-fold">
              <summary>{`Show all ${undated.length.toLocaleString('en-CA')}`}</summary>
              <ul class="sabcal-undated">
                {undated.map(u => (
                  <li><a href={u.href}>{u.name}</a> <span class="sabcal-meta">{u.meta}</span></li>
                ))}
              </ul>
            </details>
            <p>
              A further {rollingPrograms} research programs are rolling or have not announced next
              year's date yet. Those live on <a href="/programs/">the programs directory</a>, which
              shows each one's status as it changes.
            </p>
          </section>
        </>
      )}
    </div>
  </div>

  <SabFooter slot="footer" />
</Layout>

<script>
  // A jump link to a folded month opens it before the browser scrolls there.
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id ? document.getElementById(id) : null;
    if (el instanceof HTMLDetailsElement && !el.open) { el.open = true; el.scrollIntoView(); }
  }
  document.addEventListener('click', e => {
    const a = (e.target as Element).closest?.('.sabcal-jump a') as HTMLAnchorElement | null;
    const el = a ? document.getElementById(a.hash.slice(1)) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
  });
  window.addEventListener('hashchange', openFromHash);
  // The week list is built daily; a row whose date has passed since then goes.
  function pruneWeek() {
    const t = new Date(); t.setHours(0, 0, 0, 0);
    document.querySelectorAll<HTMLElement>('.sabcal-week [data-deadline]').forEach(li => {
      if (new Date(li.dataset.deadline + 'T00:00:00').getTime() < t.getTime()) li.hidden = true;
    });
  }
  document.addEventListener('astro:page-load', pruneWeek);
  document.addEventListener('astro:page-load', openFromHash);
</script>

<style is:global>
  body:has(#sab-deadlines) { background: var(--bg-page); }

  .sabl-crumbs {
    display: flex; gap: 8px; align-items: center;
    font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
    padding-top: 24px; color: #5C5F5B;
  }
  /* 24px tap target at 12px type; the negative margin keeps the line in place. */
  .sabl-crumbs a { color: #5C5F5B; text-decoration: none; display: inline-flex; align-items: center; min-height: 24px; padding: 0 4px; margin: -6px -4px; }
  .sabl-crumbs a:hover { color: #141915; text-decoration: underline; }

  .sabd-cal { padding-bottom: 72px; }
  .sabcal-head { padding: 28px 0 8px; }
  .sabcal-h1 {
    /* The directories' display face, not the body face at 800: this was the
       one page whose H1 read as a different site. */
    font-family: var(--font-display); font-weight: 400; letter-spacing: -0.015em;
    font-size: clamp(40px, 6vw, 68px); line-height: 1.02; color: #141915;
    margin: 0 0 16px; text-wrap: balance; max-width: 24ch;
  }
  .sabcal-intro { font-size: 17px; line-height: 1.65; color: #454945; max-width: 62ch; margin: 0; }
  .sabcal-stats { font-size: 15px; color: #5C5F5B; margin: 14px 0 0; }

  /* The jump nav is the page's table of contents and its main internal link
     block; it sticks because the months below it are long. */
  .sabcal-jump {
    position: sticky; top: var(--sab-nav-h); z-index: 2;
    display: flex; flex-wrap: wrap; gap: 8px;
    margin: 28px 0 8px; padding: 12px 0;
    background: var(--bg-page); border-bottom: 1px solid rgba(20,25,21,0.12);
  }
  .sabcal-chip {
    display: inline-flex; align-items: baseline; gap: 6px;
    padding: 6px 4px; text-decoration: none; color: #141915;
  }
  .sabcal-chip:hover .sabcal-chip-m { text-decoration: underline; text-underline-offset: 3px; }
  .sabcal-chip-m { font-size: 15px; font-weight: 700; }
  .sabcal-chip-n { font-size: 13.5px; color: #5C5F5B; }

  .sabcal-month { padding-top: 40px; scroll-margin-top: 72px; }
  .sabcal-month-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    flex-wrap: wrap; border-bottom: 2px solid #141915; padding-bottom: 8px;
    cursor: pointer; list-style: none;
  }
  .sabcal-month-head::-webkit-details-marker { display: none; }
  .sabcal-month-head .sabcal-h2::after {
    content: ''; display: inline-block; width: 8px; height: 8px; margin-left: 12px;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: translateY(-4px) rotate(45deg); transition: transform 0.15s ease;
  }
  details.sabcal-month:not([open]) .sabcal-h2::after { transform: translateY(-1px) rotate(-45deg); }
  /* The week list is a plain section that never folds, so no chevron. */
  .sabcal-week .sabcal-h2::after { content: none; }
  .sabcal-h2 {
    font-family: var(--font-body); font-weight: 700; letter-spacing: -0.01em;
    font-size: 24px; color: #141915; margin: 0;
  }
  .sabcal-month-count { font-size: 14px; color: #5C5F5B; }

  .sabcal-rows { list-style: none; margin: 0; padding: 0; }
  .sabcal-row {
    display: grid; grid-template-columns: 40px 1fr auto auto;
    gap: 8px 18px; align-items: baseline;
    padding: 13px 0; border-bottom: 1px solid rgba(20,25,21,0.12);
  }
  /* A layout-free wrapper above 720px (meta and status stay grid columns);
     phones turn it into one wrapping line. */
  .sabcal-sub { display: contents; }
  .sabcal-day { font-size: 15px; color: #5C5F5B; text-align: right; }
  /* Each award name is the row's only action and sits in a list, not a
     sentence, so WCAG 2.2 2.5.8's inline exception does not cover it. The
     inline box measured 17px; the padding takes the tap target past 24px and
     the matching negative margin leaves the row's rhythm where it was. */
  .sabcal-name a {
    color: #141915; text-decoration: none; font-size: 16px; line-height: 1.4;
    display: inline-block; padding-block: 4px; margin-block: -4px;
  }
  .sabcal-name a:hover { text-decoration: underline; }
  .sabcal-tag {
    font-size: 13px; font-weight: 600; color: #5C5F5B; margin-left: 8px;
    white-space: nowrap;
  }
  .sabcal-meta { font-size: 14px; color: #5C5F5B; white-space: nowrap; }
  .sabcal-state { font-size: 13.5px; font-weight: 600; color: #5C5F5B; white-space: nowrap; }
  .sabcal-state.is-open { color: #0B7A5A; }

  .sabcal-tail { padding-top: 56px; font-size: 16px; line-height: 1.65; color: #454945; }
  .sabcal-tail p { max-width: 62ch; }
  .sabcal-tail .sabcal-h2 { border-bottom: 2px solid #141915; padding-bottom: 8px; margin-bottom: 16px; }
  .sabcal-undated { list-style: none; margin: 20px 0; padding: 0; }
  .sabcal-undated li { padding: 9px 0; border-bottom: 1px solid rgba(20,25,21,0.12); display: flex; justify-content: space-between; gap: 18px; }
  .sabcal-undated a {
    color: #141915; display: inline-block; padding-block: 3px; margin-block: -3px;
  }

  .sabcal-above { font-size: 14px; color: #5C5F5B; margin: 12px 0 0; }
  .sabcal-day-md { white-space: nowrap; }
  .sabcal-week .sabcal-row { grid-template-columns: 56px 1fr auto auto; }
  .sabcal-undated-fold summary {
    display: inline-flex; align-items: center; min-height: 44px; cursor: pointer;
    font-weight: 600; color: #141915; text-decoration: underline; text-underline-offset: 3px;
  }

  .sabcal-empty { padding: 64px 0; color: #454945; }

  @media (max-width: 720px) {
    /* Wrapped, the eleven month chips stack three deep and a sticky nav then
       holds 139px of a 812px phone screen permanently. One scrolling row costs
       a swipe and gives the months back the space. */
    .sabcal-jump { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .sabcal-jump::-webkit-scrollbar { display: none; }
    .sabcal-chip { flex: 0 0 auto; min-height: 44px; align-items: center; }

    /* Two columns, and the amount and status share the second row rather than
       taking one line each: four stacked lines per award made a month of
       twenty-two deadlines a very long scroll for very little information. */
    /* Meta and status share one wrapping line: side by side when they fit,
       the status dropping below when they do not. A plain 1fr column never
       shrinks below its content, and a program's unwrapped eligibility line
       ("Grades 9 to 12 (AMC 10 for ...") pushed the whole page 224px past a
       320px screen. */
    .sabcal-row { grid-template-columns: 30px minmax(0, 1fr); gap: 4px 12px; padding: 11px 0; }
    .sabcal-week .sabcal-row { grid-template-columns: 48px minmax(0, 1fr); }
    .sabcal-sub {
      grid-column: 2; display: flex; flex-wrap: wrap;
      justify-content: space-between; align-items: baseline; gap: 2px 12px;
    }
    .sabcal-meta { white-space: normal; min-width: 0; }
    .sabcal-state { margin-left: auto; }
    .sabcal-undated li { flex-direction: column; gap: 4px; }
  }
</style>
