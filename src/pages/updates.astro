---
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import {
  months,
  KIND_LABELS,
  KIND_COLORS,
  PROJECT_START,
} from '../lib/updates';
import { webPageJson } from '../lib/ld';

const pageTitle = 'What changed on ScholarAB | Update log';
const description =
  'Every change made to ScholarAB since it launched in March 2026, grouped by month, written in plain English.';
const canonical = 'https://www.scholarab.ca/updates/';
const ldJson = webPageJson({ name: 'What changed on ScholarAB', description, path: '/updates/' });

// One number, not two. A commit total used to sit beside the entry count, which
// invited the reader to subtract one from the other and conclude that most
// changes went unrecorded. What a reader can actually use is how much is
// written up and how long the site has been running.
const totalEntries = months.reduce((n, m) => n + m.items.length, 0);

const longDate = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-CA', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });

const startLabel = longDate(PROJECT_START);
---

<Layout
  title={pageTitle}
  description={description}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={canonical}
  canonical={canonical}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} slot="head" />
  <SabFonts slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/updates" />
  </div>

  <div class="sabp" id="sab-updates" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabu-body" style="flex:1;">
      <h1 class="sabu-h1">What has changed</h1>
      <p class="sabu-lede">
        ScholarAB is built in the open. These are the {totalEntries} changes written up since
        {startLabel}, month by month, in plain English.
      </p>

      <nav class="sabu-jump" aria-label="Jump to month">
        <span class="sabu-jump-label">Jump to</span>
        {months.map(m => (
          <a href={`#${m.id}`} class="sabu-jump-link">{m.label}</a>
        ))}
      </nav>

      {months.map(month => (
        <section class="sabu-month" id={month.id}>
          <div class="sabu-month-head">
            <div class="sabu-month-row">
              <h2 class="sabu-month-title">{month.label}</h2>
              <span class="sabu-month-count">{month.items.length} {month.items.length === 1 ? 'change' : 'changes'}</span>
            </div>
            <p class="sabu-month-summary">{month.summary}</p>
          </div>

          {month.shots && (
            <div class="sabu-shots">
              {month.shots.map(shot => (
                <figure class={`sabu-shot sabu-shot-${shot.shape}`}>
                  <img
                    src={shot.src}
                    width={shot.width}
                    height={shot.height}
                    alt={shot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{shot.caption}</figcaption>
                </figure>
              ))}
            </div>
          )}

          <div class="sabu-month-card">
            <ul class="sabu-list">
              {month.items.map(item => (
                <li class="sabu-item">
                  <span class="sabu-tag" style={`color:${KIND_COLORS[item.kind]};`}>
                    {KIND_LABELS[item.kind]}
                  </span>
                  <span class="sabu-item-text">{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}

    </div>

  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  body:has(#sab-updates) { background: var(--bg-page); }
</style>

<style>

  /* Body -------------------------------------------------------------- */
  .sabu-body { max-width: var(--sab-measure); margin: 0 auto; padding: 72px var(--sab-gutter) 110px; width: 100%; box-sizing: border-box; }
  .sabu-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(44px, 7vw, 76px); line-height: 1.05; letter-spacing: -0.015em; margin: 0;
  }
  .sabu-lede { font-size: 17px; line-height: 1.6; color: rgba(20, 25, 21, 0.78); margin: 20px 0 0; max-width: 62ch; }

  /* A line of plain month links, not a row of pills. */
  .sabu-jump {
    display: flex; align-items: baseline; gap: 0 18px; flex-wrap: wrap;
    margin-top: 36px; padding-bottom: 28px; border-bottom: 1.5px solid rgba(20,25,21,0.12);
    font-size: 15px;
  }
  .sabu-jump-label { color: rgba(20, 25, 21, 0.72); }
  .sabu-jump-link { color: #0A6B4D; text-decoration: underline; text-decoration-color: rgba(10,107,77,0.35); text-underline-offset: 3px; }
  .sabu-jump-link:hover { text-decoration-color: currentColor; }

  /* Month ------------------------------------------------------------- */
  .sabu-month { padding-top: 56px; scroll-margin-top: 24px; }
  .sabu-month-head { margin-bottom: 30px; }
  .sabu-month-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .sabu-month-count { font-size: 14px; color: rgba(20, 25, 21, 0.72); }
  .sabu-month-title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(34px, 4.4vw, 50px); line-height: 1.05; letter-spacing: -0.015em; margin: 0;
  }
  .sabu-month-summary {
    font-size: 16px; line-height: 1.6; color: rgba(20, 25, 21, 0.65);
    margin: 12px 0 0; max-width: 680px;
  }

  /* Screenshots ------------------------------------------------------- */
  /* Wraps rather than scrolls: two shots per month is the usual case, and a
     row that wraps needs no horizontal scrolling on a phone. */
  .sabu-shots {
    display: flex; flex-wrap: wrap; gap: 22px;
    margin: 0 0 26px;
  }
  /* Sized by flex-basis rather than by the image: the pictures load lazily, and
     an item sized by its content collapses to nothing until they arrive. */
  .sabu-shot { margin: 0; min-width: 0; }
  .sabu-shot img {
    display: block; width: 100%; height: auto;
    border: 1.5px solid rgba(20,25,21,0.85); border-radius: 12px;
    background: #FFFFFF;
  }
  .sabu-shot-wide { flex: 0 1 420px; }
  .sabu-shot-tall { flex: 0 1 190px; }
  .sabu-shot figcaption {
    font-size: 12.5px; line-height: 1.5; color: rgba(20, 25, 21, 0.68);
    margin-top: 9px;
  }

  /* Entries ----------------------------------------------------------- */
  .sabu-month-card {
    background: #FFFFFF; border: 1.5px solid rgba(20,25,21,0.85); border-radius: 16px;
    padding: 30px 32px;
  }

  .sabu-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  /* Fixed-width kind column so every line of text starts on the same edge.
     The kind is a plain word in its colour, not a pill (critique 2026-09-23). */
  .sabu-item { display: grid; grid-template-columns: 118px 1fr; gap: 16px; align-items: baseline; }
  .sabu-tag { font-size: 14px; font-weight: 700; white-space: nowrap; }
  .sabu-item-text { font-size: 15px; line-height: 1.62; color: rgba(20, 25, 21, 0.72); }

  @media (max-width: 900px) {
    /* Touch height without pills. */
    .sabu-jump-link { display: inline-flex; align-items: center; min-height: 44px; }
    .sabu-body { padding: 44px 20px 90px; }
    .sabu-month { padding-top: 44px; }
    .sabu-shots { gap: 16px; }
    /* Two across on a phone, whatever the shape, so the strip stays one row. */
    .sabu-shot-wide, .sabu-shot-tall { flex: 1 1 calc(50% - 8px); max-width: calc(50% - 8px); }
    .sabu-month-card { padding: 24px 22px; }
    .sabu-item { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
