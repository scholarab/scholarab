---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { loadScholarships } from '../lib/data-loader';
import ScholarshipDirectory from '../components/sab/ScholarshipDirectory.astro';
import SabGuideRail from '../components/sab/SabGuideRail.astro';
import { enrichScholarships } from '../lib/enrich';
import { DEFAULT_SCHOLARSHIP_STATE, filterSortScholarships } from '../lib/list-core';
import { itemListJson } from '../lib/ld';
let raw: Awaited<ReturnType<typeof loadScholarships>> = [];
let loadError = false;
try {
  raw = await loadScholarships();
} catch {
  loadError = true;
}
// Shared with the facet hubs so the same listing can't be classified two ways.
const scholarships = enrichScholarships(raw);

// Same call, same state the directory component renders from, so the ItemList
// positions describe the order actually on the page rather than JSON order.
const ordered = filterSortScholarships(scholarships, DEFAULT_SCHOLARSHIP_STATE);
const listJson = itemListJson(
  ordered.map(s => ({ name: s.title, url: `https://www.scholarab.ca/scholarships/${s._slug}/` })),
  'Alberta High School Scholarships',
  'https://www.scholarab.ca/scholarships/',
);
---

<Layout
  title="Alberta High School Scholarships | ScholarAB"
  description="Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed."
  ogTitle="Alberta High School Scholarships | ScholarAB"
  ogDescription="Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed."
  ogUrl="https://www.scholarab.ca/scholarships/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Alberta High School Scholarships",
    "description": "Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed.",
    "url": "https://www.scholarab.ca/scholarships/",
    "provider": { "@type": "Organization", "name": "ScholarAB", "url": "https://www.scholarab.ca" },
    "hasPart": scholarships.slice(0, 10).map(s => ({
      "@type": "EducationalOccupationalProgram",
      "name": s.title,
      "url": `https://www.scholarab.ca/scholarships/${s._slug}/`,
    })),
  })} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listJson)} slot="head" />
  <SabFonts slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/scholarships" />
  </div>

  <div id="sab-scholarships" class="sabp">
    <div class="sabp-body">
      {/* No breadcrumb here, this is the top of the trail, but the hubs below
          have one and the chip rows have to land at the same height on both. */}
      <div class="sabl-crumb-gap" aria-hidden="true"></div>
      {loadError ? (
        <div class="sabl-empty" style="margin-top:64px;">
          <div class="sabl-empty-title">Couldn't load scholarships.</div>
          <div class="sabl-empty-sub">The database may be temporarily unavailable.</div>
          <a href="/scholarships/" class="sabl-empty-btn" style="display:inline-block;text-decoration:none;">Try again</a>
        </div>
      ) : (
        <ScholarshipDirectory items={scholarships} />
      )}
    </div>

    {/* The two directories are the highest-authority pages on the site and
        linked to no guide at all; see SabGuideRail. Outside .sabp-body so the
        rail spans the page rather than sitting inside the directory column. */}
    <SabGuideRail
      slugs={['grade-11-scholarship-timeline', 'reference-letters-for-scholarships', 'scholarships-for-grade-12-students-alberta', 'how-to-write-a-scholarship-essay']}
      kicker="BEFORE YOU APPLY"
      heading="How to actually win one."
    />

  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  /* The directory design is fixed light regardless of site theme */
  body:has(#sab-scholarships) { background: #FBF8F2; }
</style>

