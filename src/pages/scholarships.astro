---
import Layout from '../layouts/Layout.astro';
import { loadScholarships } from '../lib/data-loader';
import ScholarshipList from '../components/ScholarshipList.tsx';
import { generateSlug, formatDeadline } from '../lib/utils';
let raw: Awaited<ReturnType<typeof loadScholarships>> = [];
let loadError = false;
try {
  raw = await loadScholarships();
} catch {
  loadError = true;
}
const mostRecentVerified = raw
  .map(s => s.lastVerified).filter(Boolean).sort().at(-1) ?? null;
const freshnessLabel = mostRecentVerified
  ? new Date(mostRecentVerified + 'T00:00:00').toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
// Enrich at build time — avoids regex/Date parsing on every user's device
const scholarships = raw.map(s => ({
  ...s,
  _amount_cents: (() => { const m = String(s.amount || '').match(/\$[\d,]+/); return m ? parseInt(m[0].replace(/[$,]/g, ''), 10) || 0 : 0 })(),
  _deadline_ms:  s.deadline  ? new Date(s.deadline  + 'T00:00:00').getTime() : 0,
  _open_ms:      s.openDate ? new Date(s.openDate + 'T00:00:00').getTime() : 0,
  _slug:         generateSlug(s.title),
  _deadline_formatted: s.deadline ? formatDeadline(s.deadline) : null,
}));
---

<Layout
  title="Alberta High School Scholarships 2026 | ScholarAB"
  description="Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed."
  ogTitle="Alberta High School Scholarships 2026 | ScholarAB"
  ogDescription="Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed."
  ogUrl="https://www.scholarab.ca/scholarships"
  currentPath="/scholarships"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Alberta High School Scholarships 2026",
    "description": "Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed.",
    "url": "https://www.scholarab.ca/scholarships",
    "provider": { "@type": "Organization", "name": "ScholarAB", "url": "https://www.scholarab.ca" },
    "hasPart": raw.slice(0, 10).map(s => ({
      "@type": "EducationalOccupationalProgram",
      "name": s.title,
      "url": `https://www.scholarab.ca/scholarships/${generateSlug(s.title)}`,
    })),
  })} slot="head" />
  <div>
    <div class="flex items-center justify-between gap-4 mb-1 flex-wrap">
      <h1 class="font-bold text-primary" style="font-size: clamp(22px, 3vw, 32px);">Scholarships</h1>
      <a href="/match" class="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium transition-colors border" style="background: var(--brand-dim); border-color: var(--brand-border); color: var(--brand);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Check Eligibility
      </a>
    </div>
    <p class="text-sm text-secondary mb-1">Open scholarships for Alberta high school students, verified by hand and updated regularly.</p>
    {freshnessLabel && <p class="text-xs text-faint mb-6">Data last reviewed: {freshnessLabel}</p>}
    {loadError ? (
      <div class="text-center py-20">
        <p class="text-sm font-semibold text-primary mb-2">Couldn't load scholarships</p>
        <p class="text-sm text-secondary mb-5">The database may be temporarily unavailable.</p>
        <a href="/scholarships" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold" style="background:var(--brand);color:#0a0a0f;">Try again</a>
      </div>
    ) : (
      <ScholarshipList items={scholarships} client:idle />
    )}
  </div>
</Layout>
