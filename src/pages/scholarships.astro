---
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { loadScholarships } from '../lib/data-loader';
import ScholarshipList from '../components/ScholarshipList.tsx';
import { generateSlug, formatDeadline, parseAmount } from '../lib/utils';
let raw: Awaited<ReturnType<typeof loadScholarships>> = [];
let loadError = false;
try {
  raw = await loadScholarships();
} catch {
  loadError = true;
}
// Enrich at build time — avoids regex/Date parsing on every user's device
const scholarships = raw.map(s => ({
  ...s,
  _amount: parseAmount(s.amount),
  _deadline_ms:  s.deadline  ? new Date(s.deadline  + 'T00:00:00').getTime() : 0,
  _open_ms:      s.openDate ? new Date(s.openDate + 'T00:00:00').getTime() : 0,
  _slug:         generateSlug(s.title),
  _deadline_formatted: s.deadline ? formatDeadline(s.deadline) : null,
}));
---

<Layout
  title="Alberta High School Scholarships 2026 | ScholarAB"
  description="Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed."
  ogTitle="Alberta High School Scholarships 2026 | ScholarAB"
  ogDescription="Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed."
  ogUrl="https://www.scholarab.ca/scholarships"
  currentPath="/scholarships"
  hideChrome
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Alberta High School Scholarships 2026",
    "description": "Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed.",
    "url": "https://www.scholarab.ca/scholarships",
    "provider": { "@type": "Organization", "name": "ScholarAB", "url": "https://www.scholarab.ca" },
    "hasPart": raw.slice(0, 10).map(s => ({
      "@type": "EducationalOccupationalProgram",
      "name": s.title,
      "url": `https://www.scholarab.ca/scholarships/${generateSlug(s.title)}`,
    })),
  })} slot="head" />
  <link rel="preload" href="/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin slot="head" />
  <link rel="preload" href="/fonts/archivo-400.woff2" as="font" type="font/woff2" crossorigin slot="head" />
  <link rel="preload" href="/fonts/archivo-700.woff2" as="font" type="font/woff2" crossorigin slot="head" />
  <link rel="preload" href="/fonts/plex-mono-400.woff2" as="font" type="font/woff2" crossorigin slot="head" />

  <div id="sab-scholarships" class="sabp">
    <div class="sabp-header">
      <SabHeader currentPath="/scholarships" />
    </div>

    <div class="sabp-body">
      {loadError ? (
        <div class="sabl-empty" style="margin-top:64px;">
          <div class="sabl-empty-title">Couldn't load scholarships.</div>
          <div class="sabl-empty-sub">The database may be temporarily unavailable.</div>
          <a href="/scholarships" class="sabl-empty-btn" style="display:inline-block;text-decoration:none;">Try again</a>
        </div>
      ) : (
        <ScholarshipList items={scholarships} client:idle />
      )}
    </div>

    <!-- Slim dark footer -->
    <div class="sabp-footer">
      <div class="sabp-footer-inner">
        <div class="sabp-footer-logo">
          <svg width="22" height="22" viewBox="0 0 40 40" aria-hidden="true">
            <polygon points="20,4 37,37 3,37" fill="#2FD3A0"></polygon>
            <polygon points="20,4 24.5,13 15.5,13" fill="#F2F0E9"></polygon>
          </svg>
          <span>Scholar<span style="color:#2FD3A0;">AB</span></span>
        </div>
        <span class="sabp-footer-note"><a href="/">Back home</a></span>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* The directory design is fixed light regardless of site theme */
  body:has(#sab-scholarships) { background: #FAF7F0; }
</style>

