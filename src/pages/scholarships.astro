---
import Layout from '../layouts/Layout.astro';
import scholarships from '../data/scholarships.json';
import ScholarshipList from '../components/ScholarshipList.jsx';
---

<Layout
  title="Alberta High School Scholarships 2026 | ScholarAB"
  description="Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed."
  ogTitle="Alberta High School Scholarships 2026 | ScholarAB"
  ogDescription="Find and filter Alberta scholarships for high school students. Browse awards by region, amount, and deadline. Free, updated, no account needed."
  ogUrl="https://www.scholarab.ca/scholarships"
  currentPath="/scholarships"
>
  <main>
    <h1 class="font-bold text-gray-900 dark:text-white mb-1" style="font-size: clamp(22px, 3vw, 32px);">Scholarships</h1>
    <p class="text-sm text-gray-500 dark:text-white/45 mb-6">Open scholarships for Alberta high school students, verified by hand and updated regularly.</p>
    <ScholarshipList initialScholarships={scholarships} client:load />
  </main>
</Layout>
