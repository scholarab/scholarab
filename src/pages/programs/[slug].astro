---
import Layout from '../../layouts/Layout.astro';
import SabHeader from '../../components/sab/SabHeader.astro';
import SabDetail from '../../components/sab/SabDetail.astro';
import { loadPrograms } from '../../lib/data-loader';
import { generateSlug } from '../../lib/utils.ts';

export async function getStaticPaths() {
  const programs = await loadPrograms();
  // Neighbor order matches the directory's default sort: earliest deadline
  // first, then TBA / Ongoing at the end
  const ms = (d: string | null) =>
    d && d !== 'TBA' && d !== 'Ongoing' ? new Date(d + 'T00:00:00').getTime() : Infinity;
  const ordered = [...programs].sort((a, b) => ms(a.deadline) - ms(b.deadline) || a.id - b.id);
  return ordered.map((p, i) => ({
    params: { slug: generateSlug(p.name) },
    props: {
      program: p,
      position: `LISTING ${i + 1} OF ${ordered.length}`,
      prevSlug: generateSlug(ordered[(i - 1 + ordered.length) % ordered.length]!.name),
      nextSlug: generateSlug(ordered[(i + 1) % ordered.length]!.name),
    },
  }));
}

const { program, position, prevSlug, nextSlug } = Astro.props;
const slug = generateSlug(program.name);

function formatDate(str: string | null): string {
  if (!str) return 'TBA';
  if (str === 'TBA' || str === 'Ongoing') return str;
  const d = new Date(str + 'T00:00:00');
  return d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}

const todayDate = new Date();
todayDate.setHours(0, 0, 0, 0);
const hasDate = !!program.deadline && program.deadline !== 'TBA' && program.deadline !== 'Ongoing';
const deadlineDate = hasDate ? new Date(program.deadline + 'T00:00:00') : null;
const status = deadlineDate
  ? (todayDate > deadlineDate ? 'closed' : 'active')
  : program.deadline === 'Ongoing' ? 'ongoing' : 'tba';
const daysLeft = status === 'active' && deadlineDate
  ? Math.max(0, Math.ceil((deadlineDate.getTime() - todayDate.getTime()) / 86400000))
  : null;

const desc = program.description ?? '';
const metaDescription = desc.length > 160
  ? desc.slice(0, 157) + '...'
  : desc || `${program.name} is a research program offered by ${program.provider}. Discover and apply through ScholarAB, Alberta's free scholarship and program directory for high school students.`;
const canonical = `https://www.scholarab.ca/programs/${slug}`;
const pageTitle = `${program.name} | ScholarAB | Alberta Research Programs`;

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalProgram',
  'name': program.name,
  'description': metaDescription,
  'url': canonical,
  ...(hasDate ? { 'applicationDeadline': program.deadline } : {}),
  'provider': { '@type': 'Organization', 'name': program.provider },
};

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Research Programs', 'item': 'https://www.scholarab.ca/programs' },
    { '@type': 'ListItem', 'position': 3, 'name': program.name, 'item': canonical },
  ],
};

const dueLong = status === 'ongoing' ? 'Ongoing — join anytime' : formatDate(program.deadline);

const facts = [
  { label: 'DURATION', value: program.duration || 'Varies' },
  { label: 'GRADES', value: program.grades || 'High school' },
  { label: 'LOCATION', value: program.location || 'Alberta' },
  { label: 'DEADLINE', value: dueLong },
];

// The data has no per-listing application steps; these stay generic and true.
const deadlineClause = hasDate ? ` before ${formatDate(program.deadline)}` : '';
const steps = [
  'Review the details and eligibility on the official program site.',
  'Prepare the application materials it asks for.',
  status === 'ongoing'
    ? 'Apply or sign up on the official site. You can join anytime.'
    : `Apply on the official site${deadlineClause}.`,
];

const valueNote = program.paid && program.stipend
  ? program.stipend
  : [program.duration, program.grades].filter(Boolean).join(' · ') || null;
---

<Layout
  title={pageTitle}
  description={metaDescription}
  ogTitle={pageTitle}
  ogDescription={metaDescription}
  ogUrl={canonical}
  canonical={canonical}
  currentPath="/programs"
  hideChrome
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <link rel="preload" href="/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin slot="head" />
  <link rel="preload" href="/fonts/archivo-400.woff2" as="font" type="font/woff2" crossorigin slot="head" />
  <link rel="preload" href="/fonts/archivo-700.woff2" as="font" type="font/woff2" crossorigin slot="head" />
  <link rel="preload" href="/fonts/plex-mono-400.woff2" as="font" type="font/woff2" crossorigin slot="head" />

  <div id="sab-detail" class="sabp">
    <div class="sabp-header">
      <SabHeader currentPath="/programs" />
    </div>

    <SabDetail
      itemType="program"
      itemId={program.id}
      typeLabel="PROGRAM"
      tag={program.category ? program.category.toUpperCase() : null}
      name={program.name}
      subline={program.provider ? `RUN BY ${program.provider.toUpperCase()}` : 'ALBERTA · VERIFIED BY HAND'}
      status={status}
      daysLeft={daysLeft}
      dueLong={dueLong}
      backHref="/programs"
      backLabel="Back to Programs"
      position={position}
      prevHref={`/programs/${prevSlug}`}
      nextHref={`/programs/${nextSlug}`}
      facts={facts}
      eligibility={program.eligibility}
      about={program.description}
      steps={steps}
      valueLabel="THIS PROGRAM IS"
      valueBig={program.paid ? 'Paid' : 'Free'}
      valueNote={valueNote}
      ctaLabel="Learn more"
      url={program.url}
      canRemind={status === 'active' && daysLeft !== null && daysLeft > 0}
      canonical={canonical}
    />

    <!-- Slim dark footer -->
    <div class="sabp-footer">
      <div class="sabp-footer-inner">
        <div class="sabp-footer-logo">
          <svg width="22" height="22" viewBox="0 0 40 40" aria-hidden="true">
            <polygon points="20,4 37,37 3,37" fill="#2FD3A0"></polygon>
            <polygon points="20,4 24.5,13 15.5,13" fill="#F2F0E9"></polygon>
          </svg>
          <span>Scholar<span style="color:#2FD3A0;">AB</span></span>
        </div>
        <span class="sabp-footer-note"><a href="/">Back home</a></span>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* Canvas follows the theme (--sab-* tokens) */
  body:has(#sab-detail) { background: var(--sab-canvas); }
</style>
