---
import Layout from '../../layouts/Layout.astro';
import DetailLayout from '../../components/DetailLayout.astro';
import { loadPrograms } from '../../lib/data-loader';
import { generateSlug } from '../../lib/utils.ts';
import { PROGRAM_BADGES as CATEGORY_BADGE, DEFAULT_BADGE } from '../../lib/badges.ts';

export async function getStaticPaths() {
  const programs = await loadPrograms();
  return programs.map(p => ({
    params: { slug: generateSlug(p.name) },
    props: { program: p },
  }));
}

const { program } = Astro.props;
const slug = generateSlug(program.name);


function formatDate(str: string): string {
  if (!str || str === 'TBA' || str === 'Ongoing') return str;
  const d = new Date(str + 'T00:00:00');
  return d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}

const todayDate = new Date();
todayDate.setHours(0, 0, 0, 0);
const isClosed = program.deadline && program.deadline !== 'TBA' && program.deadline !== 'Ongoing'
  ? todayDate > new Date(program.deadline + 'T00:00:00')
  : false;

const rawBadge = CATEGORY_BADGE[program.category] || DEFAULT_BADGE;
const badge    = { ...rawBadge, emoji: program.emoji || rawBadge.emoji, label: program.category };

const desc = program.description ?? '';
const metaDescription = desc.length > 160 ? desc.slice(0, 157) + '...' : desc;
const canonical = `https://www.scholarab.ca/programs/${slug}`;
const pageTitle = `${program.name} | ScholarAB — Alberta Research Programs`;

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalProgram',
  'name': program.name,
  'description': metaDescription,
  'url': canonical,
  ...(program.deadline && program.deadline !== 'TBA' && program.deadline !== 'Ongoing'
    ? { 'applicationDeadline': program.deadline }
    : {}),
  'provider': { '@type': 'Organization', 'name': program.provider },
};

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Research Programs', 'item': 'https://www.scholarab.ca/programs' },
    { '@type': 'ListItem', 'position': 3, 'name': program.name, 'item': canonical },
  ],
};
---

<Layout
  title={pageTitle}
  description={metaDescription}
  ogTitle={pageTitle}
  ogDescription={metaDescription}
  ogUrl={canonical}
  canonical={canonical}
  currentPath="/programs"
  containerClass="max-w-2xl"
>
  <script type="application/ld+json" set:html={JSON.stringify(ldJson)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />

  <DetailLayout
    badge={badge}
    title={program.name}
    titleMb="mb-1"
    subtitle={program.provider}
    amount={program.paid && program.stipend ? program.stipend : undefined}
    amountStyle="clamp(20px, 3vw, 28px)"
    url={program.url}
    status={isClosed ? 'closed' : 'active'}
    backHref="/programs"
    backLabel="Back to Programs"
    ctaLabel="Learn More →"
    itemId={program.id}
    itemType="program"
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 border-t border-subtle pt-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Duration</p>
        <p class="text-sm font-medium text-primary">{program.duration}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Grades</p>
        <p class="text-sm font-medium text-primary">{program.grades}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Location</p>
        <p class="text-sm font-medium text-primary">{program.location}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Deadline</p>
        <p class="text-sm font-medium text-primary">{formatDate(program.deadline)}</p>
      </div>
    </div>

    <div class="mb-6 p-4 rounded-xl bg-subtle border border-subtle">
      <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Eligibility</p>
      <p class="text-sm text-secondary">{program.eligibility}</p>
    </div>

    <div class="mb-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-2">About</p>
      <p class="text-sm leading-relaxed text-secondary">{program.description}</p>
    </div>
  </DetailLayout>
</Layout>
