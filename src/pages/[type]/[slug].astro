---
import { todayDate as albertaToday } from '../../lib/calendar';
import SabFooter from '../../components/sab/SabFooter.astro';
import SabFonts from '../../components/sab/SabFonts.astro';
// One route for both detail-page types: /scholarships/<slug> and
// /programs/<slug>. The two pages share this template verbatim; only the
// frontmatter prep differs, so it branches on `kind` below. The merge was
// verified byte-identical against the previous per-type pages' built HTML.
import Layout from '../../layouts/Layout.astro';
import { scholarshipMetas, programMeta, brandedTitle, listingTitle, formatListingDate as formatDate } from '../../lib/meta';
import { balancedRelated, balancedCross, openAlternatives } from '../../lib/related';
import { scoreProgramForScholarship, scoreScholarshipForProgram } from '../../lib/cross-links';
import { audienceFields, quizField } from '../../lib/eligibility-matcher';
import SabHeader from '../../components/sab/SabHeader.astro';
import SabDetail from '../../components/sab/SabDetail.astro';
import { loadScholarships, loadPrograms } from '../../lib/data-loader';
import { generateSlug, parseAmount, formatVerifiedMonth, formatDeadline, amountSpan } from '../../lib/utils.ts';
import { STATUS_WORDS, canApplyNow, programIsListed, programUndatedLabel, programStatusOf, scholarshipStatusOf, scholarshipIsIndexable, programIsIndexable } from '../../lib/status.ts';
import { guides } from '../../lib/guides.ts';
import { saysNoApplication } from '../../lib/apply-method.ts';
import { SCHOLARSHIP_FACETS, PROGRAM_FACETS, PROGRAM_FORMATS, facetForListing } from '../../lib/facets.ts';
import type { Scholarship, Program } from '../../lib/data-loader';

// A related listing as a row: name, where/what, amount, deadline. The cards
// these replaced left out the deadline, the one thing a student compares on.
type RelatedItem = { href: string; title: string; value: string; tag: string; when: string; money?: boolean; open?: boolean };

export async function getStaticPaths() {
  // Neighbor order matches each directory's default sort: earliest deadline
  // first (programs put TBA / Ongoing at the end)
  const ms = (d: string | null | undefined) =>
    d && d !== 'TBA' && d !== 'Ongoing' ? new Date(d + 'T00:00:00').getTime() : Infinity;

  const scholarships = [...await loadScholarships()]
    .sort((a, b) => ms(a.deadline) - ms(b.deadline) || a.id - b.id);
  const programs = [...await loadPrograms()]
    .sort((a, b) => ms(a.deadline) - ms(b.deadline) || a.id - b.id);

  // "More like this": up to 4 listings sharing category (or region for
  // scholarships), open ones first, then by soonest deadline. Computed here
  // because only getStaticPaths has the full lists in scope.
  const buildTime = Date.now();
  const isOpen = (deadline: string | null | undefined) =>
    !deadline || deadline === 'TBA' || deadline === 'Ongoing' || ms(deadline) >= buildTime;

  // Meta descriptions need the whole corpus, not one listing: two awards that
  // differ only by name generate the same description, and only a pass over
  // the full list can see that. Same reason "more like this" is computed here.
  const metaToday = albertaToday();
  // The ISO form as well as the Date: scholarshipMetas needs it to decide which
  // open dates are near enough to lead the snippet with. toLocaleDateString
  // en-CA is the calendar date in the pinned TZ, which is the comparison the
  // horizon wants; toISOString would be the UTC one and lands a day out.
  const metaTodayIso = metaToday.toLocaleDateString('en-CA');
  const descriptions = scholarshipMetas(
    scholarships,
    (s) => scholarshipStatusOf(s, metaToday),
    formatDate,
    metaTodayIso,
  );

  // Score gates what gets shown FIRST, not whether anything is shown at all.
  //
  // The gate used to be a filter, and a listing in an unusual category with a
  // passed deadline cleared neither branch of it and rendered zero neighbours.
  // That was the main reason 117 of 287 pages sat on two or fewer inbound
  // internal links: the directory, and sometimes one lucky related slot.
  //
  // Fixing that guaranteed every page four links OUT and still said nothing
  // about links IN, and with a deterministic score over a shared corpus the
  // same listings won the slots everywhere: 68 of 117 program pages ended up
  // with no inbound link from any peer while one collected 27. So the picks are
  // made for the whole corpus at once (see lib/related.ts), which is also why
  // the tie-break is no longer corpus order.
  // A closed listing is noindexed and has nothing to apply to, so a rail
  // recommending one (Youreka's page offered the closed AAAF bursary) is a
  // dead end with a friendly face. Its own page still gets neighbours.
  const notClosed = (s: Scholarship) => scholarshipStatusOf(s, metaToday) !== 'closed';
  // Field of study leads: a Western business award was followed by health-care
  // bursaries that shared only "Academic" and "Alberta" with it (critique
  // 2026-09-24). A known clash of fields counts against a neighbour.
  const fieldsOf = new Map(scholarships.map(s => [s, new Set(
    [...(s.eligibility?.fields ?? []), ...audienceFields(s.audience)].map(quizField).filter(Boolean) as string[])]));
  const fieldFit = (a: Scholarship, b: Scholarship) => {
    const fa = fieldsOf.get(a)!, fb = fieldsOf.get(b)!;
    if (!fa.size || !fb.size) return 0;
    return [...fa].some(f => fb.has(f)) ? 3 : -3;
  };
  // Same season: an award due in six days was followed by May 2027 awards
  // (critique 2026-09-24). Neighbours due within about six weeks of it are
  // the ones a student can work on in the same stretch.
  const SEASON_MS = 45 * 86400000;
  const sameSeason = (a: Scholarship, b: Scholarship) => {
    const da = ms(a.deadline), db = ms(b.deadline);
    return da !== Infinity && db !== Infinity && Math.abs(da - db) <= SEASON_MS ? 2 : 0;
  };
  // Same size of award: a $30,000 university award was followed by $500
  // community bursaries (critique 2026-09-25). Within a factor of four counts.
  const amountOf = new Map(scholarships.map(s => [s, parseAmount(s.amount)]));
  const sameSize = (a: Scholarship, b: Scholarship) => {
    const x = amountOf.get(a)!, y = amountOf.get(b)!;
    return x > 0 && y > 0 && Math.max(x, y) / Math.min(x, y) <= 4 ? 2 : 0;
  };
  const relatedScholarshipsFor = balancedRelated(scholarships, {
    eligible: notClosed,
    score: (self, s) =>
      fieldFit(self, s) + sameSeason(self, s) + sameSize(self, s) +
      (s.category && s.category === self.category ? 2 : 0) +
      (s.region && s.region === self.region ? 1 : 0) +
      (isOpen(s.deadline) ? 2 : 0),
    qualifies: (score, s) => score > 2 || (score > 0 && isOpen(s.deadline)),
    prefer: (a, b) => ms(a.deadline) - ms(b.deadline),
  });

  const relatedProgramsFor = balancedRelated(programs, {
    // Retired programs are hidden from the directory, so nothing should link to
    // one; their own pages still show neighbours.
    eligible: p => p.active !== false,
    score: (self, p) =>
      (p.category && p.category === self.category ? 2 : 0) +
      (p.provider && p.provider === self.provider ? 1 : 0) +
      (isOpen(p.deadline) ? 1 : 0),
    qualifies: score => score > 1,
    prefer: (a, b) => ms(a.deadline) - ms(b.deadline),
  });

  // The other half of the site. Nothing crossed between the two datasets:
  // scholarship pages linked to zero programs and programs to zero
  // scholarships, in both median and max, which left the directory as two
  // disconnected components and buried the one thing no competitor offers.
  const crossProgramsFor = balancedCross(scholarships, programs, {
    eligible: p => p.active !== false,
    score: scoreProgramForScholarship,
    qualifies: score => score > 0,
    prefer: (a, b) => ms(a.deadline) - ms(b.deadline),
  });

  const crossScholarshipsFor = balancedCross(programs, scholarships, {
    eligible: notClosed,
    score: (self, s) => scoreScholarshipForProgram(self, s),
    qualifies: score => score > 0,
    prefer: (a, b) => ms(a.deadline) - ms(b.deadline),
  });

  const asScholarshipCards = (list: Scholarship[]): RelatedItem[] =>
    list.map(s => ({
      href: `/scholarships/${generateSlug(s.title)}/`,
      title: s.title,
      value: s.amount,
      tag: s.region || 'Alberta',
      when: !s.deadline ? STATUS_WORDS.none
        : `${s.deadlineEstimated ? 'Around ' : 'Due '}${formatDeadline(s.deadline)}`,
      money: true,
    }));

  const asProgramCards = (list: Program[]): RelatedItem[] =>
    list.map(p => ({
      href: `/programs/${generateSlug(p.name)}/`,
      title: p.name,
      value: p.duration || 'Varies',
      tag: p.category || 'Program',
      when: !p.deadline || p.deadline === 'TBA' || p.deadline === 'Ongoing' ? programUndatedLabel(p.deadline)
        : `Due ${formatDeadline(p.deadline)}`,
      open: canApplyNow(programStatusOf(p, metaToday)),
    }));

  // A closed page leads with three open listings from its own hub, so a
  // student who lands on last year's award has somewhere to go next
  // (critique 2026-09-23). Only closed pages get them.
  const sameFacet = <T extends Scholarship | Program>(facets: typeof SCHOLARSHIP_FACETS, a: T, b: T) => {
    const f = facetForListing(a, facets);
    return f && f === facetForListing(b, facets) ? 4 : 0;
  };
  const alternativesForScholarship = (s: Scholarship): RelatedItem[] =>
    scholarshipStatusOf(s, metaToday) !== 'closed' ? [] : asScholarshipCards(openAlternatives(s, scholarships, {
      isOpen: o => canApplyNow(scholarshipStatusOf(o, metaToday)),
      score: (self, o) => sameFacet(SCHOLARSHIP_FACETS, self, o)
        + (o.category && o.category === self.category ? 2 : 0)
        + (o.region && o.region === self.region ? 1 : 0),
      prefer: (a, b) => ms(a.deadline) - ms(b.deadline),
    }));
  const alternativesForProgram = (p: Program): RelatedItem[] =>
    programStatusOf(p, metaToday) !== 'closed' ? [] : asProgramCards(openAlternatives(p, programs, {
      isOpen: o => programIsListed(o, metaToday) && canApplyNow(programStatusOf(o, metaToday)),
      score: (self, o) => (o.format && o.format === self.format ? 3 : 0)
        + sameFacet(PROGRAM_FACETS, self, o) / 2,
      prefer: (a, b) => ms(a.deadline) - ms(b.deadline),
    }));

  return [
    ...scholarships.map((s, i) => ({
      params: { type: 'scholarships', slug: generateSlug(s.title) },
      props: {
        kind: 'scholarship' as const,
        scholarship: s,
        program: undefined as Program | undefined,
        related: asScholarshipCards(relatedScholarshipsFor[i]!),
        crossRelated: asProgramCards(crossProgramsFor[i]!),
        alternatives: alternativesForScholarship(s),
        metaDescription: descriptions[i]!,
      },
    })),
    ...programs.map((p, i) => ({
      params: { type: 'programs', slug: generateSlug(p.name) },
      props: {
        kind: 'program' as const,
        scholarship: undefined as Scholarship | undefined,
        program: p,
        related: asProgramCards(relatedProgramsFor[i]!),
        crossRelated: asScholarshipCards(crossScholarshipsFor[i]!),
        alternatives: alternativesForProgram(p),
        metaDescription: undefined as string | undefined,
      },
    })),
  ];
}

const { kind, scholarship, program, related, alternatives, metaDescription } = Astro.props;
// A programs block of nothing but "Date not confirmed" rows offers nothing to
// do (critique 2026-09-24): it shows only when one of them is open, open first.
const crossRelated = Astro.props.crossRelated.some(r => r.open !== false)
  ? [...Astro.props.crossRelated].sort((a, b) => Number(b.open !== false) - Number(a.open !== false))
  : [];

const todayDate = albertaToday();

// round, not ceil: the diff is midnight-to-midnight so it's a whole number of
// days except across a DST change, where ceil would overcount by one.
const daysUntil = (d: Date) => Math.max(0, Math.round((d.getTime() - todayDate.getTime()) / 86400000));

// Everything the template needs, computed per kind.
let d;
if (kind === 'scholarship') {
  const s = scholarship!;
  const slug = generateSlug(s.title);
  const deadlineDate = s.deadline ? new Date(s.deadline + 'T00:00:00') : null;
  // Read the ladder from status.ts rather than restating it here. This page
  // kept its own copy, so a listing could be non-indexable by status.ts and
  // still paint "OPENING SOON"; the ended TD award did exactly that, because
  // only `noindex` below consulted the shared function. The one distinction the
  // shared function used not to draw was open-with-no-deadline, which this
  // page mapped to 'tba' ("Date not confirmed") while the directory row for
  // the same award said "No fixed deadline". status.ts returns 'ongoing' for
  // it since 2026-09-23, so both surfaces now say the same thing.
  const status: 'active' | 'tba' | 'closed' | 'future' | 'unconfirmed' | 'ongoing' = scholarshipStatusOf(s, todayDate);
  const daysLeft = status === 'active' && deadlineDate ? daysUntil(deadlineDate) : null;

  // Status-aware and capped at Google's ~155-character cut. The old template
  // ("The <title> offers <amount> to <audience>. Deadline: <date>. Browse
  // more…") averaged 221 characters, so the deadline; the thing the query was
  // asking about; was always past the truncation point. See src/lib/meta.ts.
  const description  = metaDescription!;
  const canonical    = `https://www.scholarab.ca/scholarships/${slug}/`;
  const parsedAmount = parseAmount(s.amount) || null;
  // Nominated, school-selected, or bundled with another application: the
  // listing's own notes say so, and the page must not answer them with
  // "Apply now" and a generic three-step form-filling guide.
  const noApplication = saysNoApplication(s.notes, s.metaDetail, (s as { description?: string }).description);

  d = {
    currentPath: '/scholarships/',
    crossLabel: 'Research programs to go with it',
    crossPath: '/programs/',
    // Award names run long (the median is 41 characters, the longest 76), and
    // Google truncates titles around 60. A second boilerplate phrase after the
    // brand only ever pushed the award's own name out of the snippet, and past
    // a point the brand itself does the same; brandedTitle drops it rather than
    // spend the award's own name on it. What is left over goes to the award
    // value, which is the fact that tells a student whether to click; see
    // listingTitle for why it is the amount and not the year.
    pageTitle: listingTitle(s.title, s.amount),
    description,
    canonical,
    // Per-listing OG images exist for every indexable scholarship (see
    // scripts/generate-og-images.ts, which mirrors this condition).
    ogImage: status !== 'closed' ? `https://www.scholarab.ca/og/scholarships/${slug}.png` : undefined,
    ldJson: {
      '@context': 'https://schema.org',
      '@type': 'EducationalOccupationalProgram',
      'name': s.title,
      'description': description,
      'url': canonical,
      // The site's highest-volume query shape is "when does X open"; five
      // Rutherford variants alone drew 82 impressions last month, and 59
      // listings carry an openDate the markup never mentioned. It is a
      // property of EducationalOccupationalProgram, same as the deadline.
      // Never a rolled-forward guess: markup is a claim to Google, and the page
      // itself no longer states these dates as fact (deadlineEstimated).
      ...(s.openDate && !s.deadlineEstimated ? { 'applicationStartDate': s.openDate } : {}),
      ...(s.deadline && !s.deadlineEstimated ? { 'applicationDeadline': s.deadline } : {}),
      ...(parsedAmount !== null ? { 'offers': { '@type': 'Offer', 'price': parsedAmount, 'priceCurrency': 'CAD' } } : {}),
      // No `provider`: ScholarAB lists these awards, it does not fund or award
      // them, and the data has no provider field to name the real one. Claiming
      // it here was telling Google we run the Rutherford. Programs, which do
      // carry a real provider, still declare theirs.
    },
    breadcrumbName: 'Scholarships',
    itemName: s.title,
    itemId: s.id,
    itemType: 'scholarship' as const,
    typeLabel: 'SCHOLARSHIP',
    subline: s.region || 'Alberta',
    status,
    // Not `status === 'closed'` spelled out again: the sitemap has to list the
    // exact complement of this, so both sides read it from status.ts.
    noindex: !scholarshipIsIndexable(s, todayDate),
    daysLeft,
    // ISO dates for the client-side chip recompute (SabDetail): the page is
    // prerendered, so days-left/closed state must be re-derived on load.
    // A concluded award is not clock-driven, so it passes none of these on.
    // refreshStatusChip returns early without them, leaving the server's CLOSED
    // chip alone; otherwise its `inactive` branch repaints "OPENING SOON" on
    // every load, and a stale future deadline would paint a days-left count.
    deadlineIso: s.concluded ? null : s.deadline,
    openDateIso: s.concluded || (s.active === false && !s.openDate) ? null : s.openDate,
    inactive: s.active === false && !s.concluded,
    estimated: s.deadlineEstimated === true,
    dueLong: formatDate(s.deadline),
    opensLabel: s.openDate ? formatDate(s.openDate) : null,
    // Empty on purpose. Every one of the five facts this used to list was
    // already on the page within one screen of itself: REGION is the subline,
    // CATEGORY is a chip beside the title, DEADLINE and OPENS are the status
    // chip and the rail, AMOUNT is the 52px number in the rail. A facts table
    // that repeats the page teaches the reader to skip tables.
    facts: [],
    eligibility: s.audience,
    // About text mirrors the data description; scholarship.description exists
    // in the JSON but not in the Scholarship type, so read it defensively.
    about: (s as { description?: string }).description
      ?? `${s.title} is an Alberta award for high school students.`,
    notes: s.notes,
    // The data has no per-listing application steps. The generic three
    // ("read the requirements", "prepare your documents", "submit") said
    // nothing the button did not, and were false for every award with no
    // form. Only the school-run case has advice worth a section: the school's
    // own cut-off, which the listing cannot show.
    steps: s.applyViaGuidance && !noApplication
      ? [
          'Ask your guidance counsellor how your school handles this award.',
          'Ask for the school deadline too. It is often earlier than the one listed here.',
        ]
      : [],
    valueLabel: 'AWARD VALUE',
    valueBig: s.amount,
    // A multi-year total says so beside the figure; Knowlton's "$30,000" is
    // $5,000 a year at first (critique 2026-09-24).
    valueNote: [
      amountSpan(s.amount, [s.metaDetail, (s as { description?: string }).description].filter(Boolean).join(' ')),
      noApplication
        ? "You don't file an application for this one. The notes say how it is awarded."
        : s.applyViaGuidance ? 'Applications go through your school.' : null,
    ].filter(Boolean).join(' ') || null,
    checkedLabel: formatVerifiedMonth(s.lastVerified),
    ctaLabel: noApplication ? 'How it is awarded' : s.applyViaGuidance ? 'How to apply' : 'Apply',
    url: s.url,
    canRemind: status === 'active' && daysLeft !== null && daysLeft > 0,
  };
} else {
  const p = program!;
  const slug = generateSlug(p.name);
  const hasDate = !!p.deadline && p.deadline !== 'TBA' && p.deadline !== 'Ongoing';
  const deadlineDate = hasDate ? new Date(p.deadline + 'T00:00:00') : null;
  const status: 'active' | 'tba' | 'closed' | 'future' | 'unconfirmed' | 'ongoing' = programStatusOf(p, todayDate);
  const daysLeft = status === 'active' && deadlineDate ? daysUntil(deadlineDate) : null;

  // Word-boundary clamp, not `slice(0, 157) + '...'`: that cut 123 of the 125
  // program descriptions mid-word. Dated cycles lead with the closing date.
  const programDescription = programMeta(p, status, formatDate);
  const canonical = `https://www.scholarab.ca/programs/${slug}/`;
  const dueLong = status === 'ongoing' ? `${STATUS_WORDS.none}, join any time` : formatDate(p.deadline);

  d = {
    currentPath: '/programs/',
    crossLabel: 'Scholarships to go with it',
    crossPath: '/scholarships/',
    pageTitle: brandedTitle(p.name),
    description: programDescription,
    canonical,
    ldJson: {
      '@context': 'https://schema.org',
      '@type': 'EducationalOccupationalProgram',
      'name': p.name,
      'description': programDescription,
      'url': canonical,
      ...(hasDate ? { 'applicationDeadline': p.deadline } : {}),
      'provider': { '@type': 'Organization', 'name': p.provider },
    },
    breadcrumbName: 'Research Programs',
    itemName: p.name,
    itemId: p.id,
    itemType: 'program' as const,
    typeLabel: 'PROGRAM',
    subline: p.provider ? `Run by ${p.provider}` : 'Alberta',
    status,
    // Retired programs read as TBA/Ongoing on the page; the copy is honest,
    // the page just isn't a search result: nothing links to it any more.
    noindex: !programIsIndexable(p, todayDate),
    daysLeft,
    deadlineIso: hasDate ? p.deadline : null,
    openDateIso: null,
    inactive: false,
    dueLong,
    opensLabel: undefined,
    // Programs keep the facts that appear nowhere else on the page. DEADLINE
    // left with them; the rail already carries it. FORMAT says what shape the
    // thing is (2026-09-15): the tag above reads HEALTH for both a one-day
    // Brain Bee and a six-week paid placement, and the reader cannot tell them
    // apart until they read the duration and guess.
    facts: [
      ...(PROGRAM_FORMATS.find(f => f.value === p.format)
        ? [{ label: 'FORMAT', value: PROGRAM_FORMATS.find(f => f.value === p.format)!.h1 }]
        : []),
      { label: 'DURATION', value: p.duration || 'Varies' },
      { label: 'GRADES', value: p.grades || 'High school' },
      { label: 'LOCATION', value: p.location || 'Alberta' },
    ],
    eligibility: p.eligibility,
    about: p.description,
    notes: undefined,
    // No generic steps: the data has none per program, and "review the
    // details, prepare materials, apply" restated the button.
    steps: [],
    // Two independent questions, and they used to be one. `paid` is whether
    // the student receives money; `cost` is whether they pay any. Rendering
    // `paid ? 'Paid' : 'Free'` told 115 of 129 programs they were free,
    // including ones charging $1,700. A stipend is the headline when there is
    // one, because it is the rarer fact; otherwise the cost is.
    ...programValue(p),
    ctaLabel: 'Visit the program site',
    url: p.url,
    checkedLabel: formatVerifiedMonth(p.lastVerified),
    canRemind: status === 'active' && daysLeft !== null && daysLeft > 0,
  };
}

/**
 * The value block for a program: what it pays, or what it costs.
 *
 * `unconfirmed` deliberately says so rather than guessing. Silence about a fee
 * is not evidence there isn't one, and the old code's guess was always "Free".
 */
function programValue(p: Program) {
  if (p.paid) {
    return { valueLabel: 'THIS PROGRAM IS', valueBig: 'Paid', valueNote: p.stipend };
  }
  if (p.cost === 'free') {
    return { valueLabel: 'THIS PROGRAM IS', valueBig: 'Free', valueNote: p.costNote };
  }
  if (p.cost === 'fee' || p.cost === 'varies') {
    return {
      valueLabel: 'PROGRAM COST',
      valueBig: p.cost === 'fee' ? 'Has a fee' : 'Varies',
      valueNote: p.costNote,
    };
  }
  // Not a figure, so not set as one: "See provider" in the 52px money type was
  // the largest text on the page and answered nothing.
  return { valueLabel: 'PROGRAM COST', valueBig: 'Not listed', valueNote: "Check the provider's page for any fee.", valueQuiet: true };
}

// The explainer for this listing, when one exists. The link is reciprocal on
// purpose: the guide already linked down to the listing, so Google saw a rich
// page pointing at a thin near-duplicate of itself and picked its own
// canonical for the pair. Linking back marks the listing as the directory
// entry and the guide as its explainer.
//
// Both kinds qualify. This used to resolve only for scholarships, which meant
// a guide about a research program had no way to earn its reciprocal card;
// combined with every guide being scholarship-side, /programs/ received no
// editorial links at all.
const listingSlug = kind === 'scholarship'
  ? generateSlug(scholarship!.title)
  : generateSlug(program!.name);
const guideSlug = guides.find(g => g.relatedListings?.includes(listingSlug));

// The hub this listing sits under, if it has one. Academic awards and
// Alberta-wide regions deliberately have no hub, so null is a normal result and
// the trail simply stays two deep for them.
const facet = kind === 'scholarship'
  ? facetForListing(scholarship!, SCHOLARSHIP_FACETS)
  : facetForListing(program!, PROGRAM_FACETS);
const facetHref = facet ? `${d.currentPath}${facet.slug}/` : null;

// Positions have to be contiguous, so the facet crumb is spliced in rather
// than written as a fixed fourth entry: a breadcrumb that jumps 2 -> 4 is
// invalid markup, and the trail is two, three or four deep depending on the
// listing.
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { name: 'ScholarAB', item: 'https://www.scholarab.ca' },
    { name: d.breadcrumbName, item: `https://www.scholarab.ca${d.currentPath}` },
    ...(facet ? [{ name: facet.label, item: `https://www.scholarab.ca${facetHref}` }] : []),
    { name: d.itemName, item: d.canonical },
  ].map((entry, i) => ({ '@type': 'ListItem', 'position': i + 1, ...entry })),
};
---

<Layout
  title={d.pageTitle}
  description={d.description}
  ogTitle={d.pageTitle}
  ogDescription={d.description}
  ogUrl={d.canonical}
  canonical={d.canonical}
  ogImage={'ogImage' in d ? d.ogImage : undefined}
  robots={d.noindex ? 'noindex' : undefined}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(d.ldJson)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <SabFonts slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath={d.currentPath} />
  </div>

  <div id="sab-detail" class="sabp">

    <SabDetail
      itemType={d.itemType}
      itemId={d.itemId}
      typeLabel={d.typeLabel}
      name={d.itemName}
      subline={d.subline}
      status={d.status}
      daysLeft={d.daysLeft}
      deadlineIso={d.deadlineIso}
      openDateIso={d.openDateIso}
      inactive={d.inactive}
      estimated={"estimated" in d ? d.estimated : false}
      dueLong={d.dueLong}
      opensLabel={d.opensLabel}
      facetHref={facetHref}
      facetLabel={facet?.label ?? null}
      backHref={d.currentPath}
      backLabel={`Back to ${d.breadcrumbName === 'Research Programs' ? 'Programs' : 'Scholarships'}`}
      facts={d.facts}
      eligibility={d.eligibility}
      about={d.about}
      notes={d.notes}
      steps={d.steps}
      valueLabel={d.valueLabel}
      valueBig={d.valueBig}
      valueNote={d.valueNote}
      checkedLabel={"checkedLabel" in d ? d.checkedLabel : null}
      valueQuiet={"valueQuiet" in d ? d.valueQuiet : false}
      ctaLabel={d.ctaLabel}
      url={d.url}
      canRemind={d.canRemind}
      canonical={d.canonical}
      guideHref={guideSlug ? `/guides/${guideSlug.slug}/` : undefined}
      guideTitle={guideSlug?.title}
      alternatives={alternatives}
      alternativesHref={facetHref ?? d.currentPath}
    />

    {related.length > 0 && (
      <div class:list={['sabd-related', crossRelated.length > 0 && 'sabd-related-paired']}>
        <div class="sabd-related-head">
          <h2 class="sabd-related-title">More like this</h2>
          <a href={d.currentPath} class="sabd-related-all">See all →</a>
        </div>
        <div class="sabd-related-grid">
          {related.map(r => (
            <a href={r.href} class="sabd-related-row">
              <span class="sabd-related-main">
                <span class="sabd-related-name">{r.title}</span>
                <span class="sabd-related-tag">{r.tag}</span>
              </span>
              <span class:list={['sabd-related-value tnum', { 'is-plain': !r.money }]}>{r.value}</span>
              <span class="sabd-related-when tnum">{r.when}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* The other dataset. A student reading about a trades bursary has no way
        from here to the trades programs that would strengthen the application,
        which is the site's own differentiator left off its own pages. Three
        cards rather than four, so it reads as a secondary suggestion. */}
    {crossRelated.length > 0 && (
      <div class="sabd-related sabd-cross">
        <div class="sabd-related-head">
          <h2 class="sabd-related-title">{d.crossLabel}</h2>
          <a href={d.crossPath} class="sabd-related-all">See all →</a>
        </div>
        <div class="sabd-related-grid">
          {crossRelated.map(r => (
            <a href={r.href} class="sabd-related-row">
              <span class="sabd-related-main">
                <span class="sabd-related-name">{r.title}</span>
                <span class="sabd-related-tag">{r.tag}</span>
              </span>
              <span class:list={['sabd-related-value tnum', { 'is-plain': !r.money }]}>{r.value}</span>
              <span class="sabd-related-when tnum">{r.when}</span>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  /* The detail design is fixed light regardless of site theme */
  body:has(#sab-detail) { background: var(--bg-page); }
</style>

<style>
  .sabd-related { padding: 0 48px 96px; box-sizing: border-box; }
  .sabd-related-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding-top: 20px; margin-bottom: 10px;
  }
  .sabd-related-title { font-family: var(--font-display); font-weight: 400; font-size: 30px; letter-spacing: -0.01em; line-height: 1.1; margin: 0; }
  .sabd-related-all { font-size: 15px; font-weight: 600; color: #0A6B4D; text-decoration: none; display: inline-block; padding: 12px 0; margin: -12px 0; white-space: nowrap; }
  .sabd-related-all:hover { color: #141915; }
  /* Rows in the directory's own grammar: name and where on the left, then the
     figure and the deadline in fixed columns so both read down the list. */
  .sabd-related-grid { border-top: 2px solid #141915; }
  /* The two related blocks are one pair, so the full 96px section rhythm
     between them would read as two unrelated sections. Applied from the first
     block only when a second actually follows it. */
  .sabd-related-paired { padding-bottom: 40px; }
  .sabd-related-row {
    display: grid; grid-template-columns: 1fr 180px 170px; gap: 24px; align-items: center;
    padding: 16px 8px; border-bottom: 1px solid rgba(20,25,21,0.14);
    text-decoration: none; color: #141915; transition: background 0.15s ease;
  }
  .sabd-related-row:hover { background: rgba(20,25,21,0.04); }
  .sabd-related-row:hover .sabd-related-name { color: var(--green); }
  .sabd-related-main { min-width: 0; }
  .sabd-related-name { display: block; font-weight: 700; font-size: 16px; line-height: 1.35; letter-spacing: -0.01em; }
  .sabd-related-tag { display: block; font-size: 13.5px; color: rgba(20, 25, 21, 0.72); margin-top: 2px; }
  .sabd-related-value { font-family: var(--font-display); font-size: 22px; color: var(--text-primary); text-align: right; }
  /* A duration is not prize money; display type made "1 day" read as one. */
  .sabd-related-value.is-plain { font-family: var(--font-body); font-size: 14px; font-weight: 600; color: rgba(20, 25, 21, 0.75); }
  .sabd-related-when { font-size: 14px; font-weight: 700; text-align: right; }

  @media (max-width: 900px) {
    .sabd-related { padding: 0 20px 72px; }
    .sabd-related-title { font-size: 26px; }
    .sabd-related-row { grid-template-columns: 1fr auto; gap: 4px 14px; padding: 14px 2px; }
    .sabd-related-main { grid-column: 1 / -1; }
    .sabd-related-value { text-align: left; font-size: 20px; }
    .sabd-related-value.is-plain { font-size: 14px; }
  }
</style>
