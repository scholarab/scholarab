---
import Layout from '../layouts/Layout.astro';

const title = 'Privacy Policy | ScholarAB';
const description = 'ScholarAB privacy policy — how we handle your data.';
const canonical = 'https://www.scholarab.ca/privacy';
---

<Layout
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogUrl={canonical}
  canonical={canonical}
  currentPath="/about"
  containerClass="max-w-2xl"
>
  <main class="py-8">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Privacy Policy</h1>
    <p class="text-sm text-gray-400 dark:text-white/30 mb-8">Last updated: April 2026</p>

    <div class="space-y-8 text-sm text-gray-600 dark:text-white/60 leading-relaxed">

      <section>
        <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2">What ScholarAB is</h2>
        <p>ScholarAB is a free, static website that lists scholarships and research programs available to Alberta students. There is no backend server, no database, and no user accounts.</p>
      </section>

      <section>
        <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2">Data we do not collect</h2>
        <ul class="list-disc list-inside space-y-1">
          <li>No account or login information</li>
          <li>No cookies of any kind</li>
          <li>No personally identifiable information from visitors</li>
        </ul>
      </section>

      <section>
        <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2">Saved scholarships</h2>
        <p>The "Save" feature stores your saved scholarship and program IDs in your browser's <code class="font-mono text-xs bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded">localStorage</code>. This data never leaves your device and is not accessible to us.</p>
      </section>

      <section>
        <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2">Analytics</h2>
        <p>We use <a href="https://vercel.com/analytics" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="text-[#22d3a5] hover:opacity-80 transition-opacity">Vercel Analytics</a> and Vercel Speed Insights to understand page traffic and performance. These services collect anonymised data (page views, web vitals) and do not track individuals across sites. No personal data is shared with us. See <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="text-[#22d3a5] hover:opacity-80 transition-opacity">Vercel's privacy policy</a> for details.</p>
      </section>

      <section>
        <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2">Scholarship submissions</h2>
        <p>If you submit a scholarship via our form, the information you provide (scholarship details and optionally your name and email) is processed through a GitHub Actions workflow and added to our public data file. By submitting, you agree that this information may appear publicly on ScholarAB and in our public GitHub repository. We use your email only to follow up on your submission if needed and do not share it for any other purpose.</p>
      </section>

      <section>
        <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2">External links</h2>
        <p>ScholarAB links to third-party scholarship and program websites. We are not responsible for the privacy practices of those sites. All outbound links include <code class="font-mono text-xs bg-gray-100 dark:bg-white/10 px-1 py-0.5 rounded">referrerpolicy="no-referrer"</code> so those sites do not receive your current URL when you click through.</p>
      </section>

      <section>
        <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2">Contact</h2>
        <p>Questions about this policy? Email us at <a href="mailto:contact.scholarab@gmail.com" class="text-[#22d3a5] hover:opacity-80 transition-opacity">contact.scholarab@gmail.com</a>.</p>
      </section>

    </div>
  </main>
</Layout>
