---
export const prerender = false
import LoginForm from '../../components/admin/LoginForm'
import AdminLayout from '../../layouts/AdminLayout.astro'

// Block mobile access; redirect to home
const ua = Astro.request.headers.get('user-agent') ?? '';
const isMobile = /android|iphone|ipad|ipod|mobile/i.test(ua);
if (isMobile) {
  return Astro.redirect('/');
}
---
<AdminLayout title="Sign in">
  <LoginForm client:load next={(() => { const v = Astro.url.searchParams.get('next') ?? ''; return v.startsWith('/admin') && !v.includes('://') ? v : '/admin/analytics'; })()} />
</AdminLayout>
