---
import { todayDate as albertaToday } from '../lib/calendar';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import SabFooter from '../components/sab/SabFooter.astro';
import HomePanelMedia from '../components/sab/HomePanelMedia.astro';
import { loadScholarships, loadPrograms } from '../lib/data-loader';
import { generateSlug, parseAmount, formatDeadline } from '../lib/utils';
import { CLOSING_SOON_MS } from '../lib/constants';
import { STATUS_WORDS, canApplyNow, programIsListed, programStatusOf, scholarshipStatusOf } from '../lib/status';
import { openCounts } from '../lib/counts';
import { isAfterHighSchool } from '../lib/list-core';
import { SCHOLARSHIP_FACETS, PROGRAM_FORMATS, MENU_SCOPES, MIN_FACET_ITEMS, facetForCategory, facetItems } from '../lib/facets';
import { PHOTO_CREDITS, needsCredit } from '../lib/photo-credits';
import { GLOSSARY } from '../lib/glossary';
import { enrichScholarships } from '../lib/enrich';
import { scopeSearchMap } from '../lib/scope-search';

const scholarships = await loadScholarships();
const programs = await loadPrograms();

const today = albertaToday();

// The directory's own definition of open, not a copy of it: this page kept
// its own ladder, so a concluded award or a rolled-forward date could count
// here as "open right now" while the directory said otherwise.
const activeScholarships = scholarships.filter(s => scholarshipStatusOf(s, today) === 'active');
// Open today with or without a deadline: what "can apply for today" means.
const applyableScholarships = scholarships.filter(s => canApplyNow(scholarshipStatusOf(s, today)));

const scholarshipCount = scholarships.length;

// The next five deadlines, NOT the deadlines inside a fixed window. The window
// version (deadline <= today + CLOSING_SOON_MS) rendered nothing at all between
// cycles: on 22 Aug 2026 exactly one of the 39 active awards fell inside seven
// days, and for most of August none did. The section then disappeared, and
// SabFooter links every page on the site at /#closing, so the whole site
// carried a dead anchor for the part of the year counsellors start looking.
//
// CLOSING_SOON_MS still decides the urgency badge on each row, which is where
// "this week" actually belongs; it just no longer decides whether the section
// exists.
const closingSoon = activeScholarships
  .filter(s => s.deadline)
  .sort((a, b) => new Date(a.deadline! + 'T00:00:00').getTime() - new Date(b.deadline! + 'T00:00:00').getTime())
  .slice(0, 5);

// The heading follows the list rather than asserting urgency it may not have:
// "Closing this week" over a row due in November is a claim the page can't keep.
// Every row, not any: one award due today flipped the heading over four due
// in 13 days (critique 2026-10-02).
const allClosingThisWeek = closingSoon.every(
  s => new Date(s.deadline! + 'T00:00:00').getTime() <= today.getTime() + CLOSING_SOON_MS,
);
const closingHeading = allClosingThisWeek ? 'Closing this week' : 'Next deadlines';

// The biggest awards a student can apply for today, in the directory's own
// "Highest $" order (first dollar figure, so "$2,000 to $7,000" ranks at
// $2,000). A Reddit reviewer's note: the top of the catalogue was behind a
// click and a sort, and the homepage led only with whatever closed next.
// "Varies" has no number to rank, so it stays out rather than sorting last.
const biggestOpen = applyableScholarships
  .filter(s => parseAmount(s.amount) > 0)
  .sort((a, b) =>
    parseAmount(b.amount) - parseAmount(a.amount) ||
    (a.deadline ?? '9999').localeCompare(b.deadline ?? '9999'))
  .slice(0, 5);

// Categories: real counts from the data, top 8 types
const categoryCounts = new Map<string, number>();
for (const s of scholarships) {
  if (s.category) categoryCounts.set(s.category, (categoryCounts.get(s.category) ?? 0) + 1);
}
// Each card points at its hub where one exists. Academic (56 listings) and
// General deliberately have none -- a hub that big would compete with
// /scholarships for the same queries -- so those keep the query-string filter,
// which is still a working page, just not a landing one.
const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([name, count]) => {
    const facet = facetForCategory(name, SCHOLARSHIP_FACETS);
    // Data where slogans used to be ("Volunteering hours that actually pay
    // off."): how many are open today and when the next one closes.
    const inCat = activeScholarships.filter(s => s.category === name);
    const next = inCat.filter(s => s.deadline).map(s => s.deadline!).sort()[0] ?? null;
    return {
      name,
      count,
      open: inCat.length,
      next,
      href: facet ? `/scholarships/${facet.slug}/` : `/scholarships/?category=${encodeURIComponent(name)}`,
    };
  });


// The scope carousel under the hero (Ilia, 2026-09-22, after tesla.com's
// model cards): one big photo card per header-menu scope (MENU_SCOPES), biggest
// first. Every scope has a photo since 2026-09-23, so the menu list is what
// keeps this at ten cards rather than twenty-five. Counts are the hub's own
// (facetItems), the same numbers the header tiles show. A CC BY or CC BY-SA
// photo carries its credit on the card (photo-credits.ts).
const SCOPE_KICKERS: Record<string, string> = {
  alberta: 'Anywhere in Alberta',
  national: 'Open across Canada',
};
interface PhotoCard {
  label: string; kicker: string; backdrop: string; href: string; count: number;
  /** The open count (dated, not yet closed), and where it links; null href
   *  when the hub has no open filter. Open includes no-deadline listings. */
  open: number; openHref: string | null;
  credit: (typeof PHOTO_CREDITS)[string] | undefined;
}
const scopeCards: PhotoCard[] = SCHOLARSHIP_FACETS
  .filter(f => MENU_SCOPES.includes(f.slug) && f.backdrop)
  .map(f => {
    const items = facetItems(f, scholarships);
    const href = `/scholarships/${f.slug}/`;
    return {
      label: f.label,
      backdrop: f.backdrop!,
      kicker: SCOPE_KICKERS[f.slug] ?? `${f.label} students`,
      href,
      count: items.length,
      // After-high-school awards sit in their own run on the hub, so its OPEN
      // NOW heading and status chips leave them out; so does this.
      ...openCounts(items.filter(s => !isAfterHighSchool(s)), s => scholarshipStatusOf(s, today)),
      openHref: `${href}?status=active`,
      credit: PHOTO_CREDITS[f.backdrop!],
    };
  })
  .sort((a, b) => b.count - a.count);

// The program twin (Ilia, 2026-09-23): one card per format hub, the same eight
// the header's Programs tiles show, biggest first. The kickers are each hub's
// own intro cut to a line; the two named by a jargon word define it instead
// (lib/glossary.ts). "Open" counts what a student can join today, dated or
// year-round, the same rule as the hub's Open chip (lib/counts.ts).
const FORMAT_KICKERS: Record<string, string> = {
  'summer-programs': 'Camps, institutes and labs',
  competitions: 'Built over a season, entered as a team',
  olympiads: GLOSSARY.olympiad.short,
  'science-fairs': 'The only door to Canada-Wide',
  'research-placements': 'A piece of work with your name on it',
  'dual-credit': GLOSSARY.dualCredit.short,
  clubs: 'Start any week of the year',
  conferences: 'A few days, some funded down to the flight',
};
// Only scopes with a hub page (the floor in scholarships/[facet].astro).
const enrichedScholarships = enrichScholarships(scholarships);
const scopeMap = scopeSearchMap(SCHOLARSHIP_FACETS.filter(f => facetItems(f, enrichedScholarships).length >= MIN_FACET_ITEMS));
const listedPrograms = programs.filter(p => programIsListed(p, today));
const formatCards: PhotoCard[] = PROGRAM_FORMATS
  .filter(f => f.backdrop)
  .map(f => ({ f, items: facetItems(f, listedPrograms) }))
  .filter(({ items }) => items.length >= MIN_FACET_ITEMS)
  .map(({ f, items }) => ({
    label: f.label === 'Summer' ? 'Summer programs' : f.label,
    backdrop: f.backdrop!,
    kicker: FORMAT_KICKERS[f.slug] ?? f.h1,
    href: `/programs/${f.slug}/`,
    count: items.length,
    ...openCounts(items, p => programStatusOf(p, today)),
    openHref: null,
    credit: PHOTO_CREDITS[f.backdrop!],
  }))
  .sort((a, b) => b.count - a.count);

// Only a set's first photo is a real <img>. The rest carry their sources in
// data- attributes until the carousel script asks for them: `loading="lazy"`
// alone let Chrome fetch the four cards beside the visible one in the sideways
// strip, 1,725 KB on a Pixel 7 for one photo on screen (2026-09-30).
// <noscript> keeps every photo for a visitor without JS.
const tallSet = (b: string) => `/photos/backdrops/${b}-tall-1000.webp 1000w, /photos/backdrops/${b}-tall-2000.webp 2000w`;
const wideSrc = (b: string) => `/photos/backdrops/${b}-wide-1672.webp`;
const wideSet = (b: string) => `${wideSrc(b)} 1672w, /photos/backdrops/${b}-wide-3344.webp 3344w`;

// Every city with its own list, for "Back to Calgary" under the hero buttons
// (lib/my-city.ts). Open counts as the carousel counts them, at build time.
const myCityHubs = Object.fromEntries(SCHOLARSHIP_FACETS
  .filter(f => f.kind === 'region' && !f.broad && !f.bySchool)
  .map(f => ({ f, items: facetItems(f, scholarships) }))
  .filter(({ items }) => items.length >= MIN_FACET_ITEMS)
  .map(({ f, items }) => [f.slug, {
    label: f.label,
    open: openCounts(items.filter(s => !isAfterHighSchool(s)), s => scholarshipStatusOf(s, today)).open,
  }]));

const carousels = [
  // `none` is the line under a hub with nothing open, in the directory's own
  // status words (lib/status.ts) so the slide and the hub describe it alike.
  { key: 'scholarships', title: 'Scholarships by where you live', noun: 'scholarships', none: STATUS_WORDS.future, cards: scopeCards },
  // A program with nothing open is waiting on next cycle's dates (summer
  // programs close in February), which "not open yet" would understate.
  { key: 'programs', title: 'Programs by format', noun: 'programs', none: STATUS_WORDS.unconfirmed, cards: formatCards },
].filter(c => c.cards.length > 0);

---

<Layout
  title="Free Alberta High School Scholarships | ScholarAB"
  description={`Browse ${scholarshipCount}+ free scholarships and programs for Alberta high school students. No login, no ads, no data collection. Updated for the 2026-27 cycle.`}
  ogTitle="Free Alberta High School Scholarships | ScholarAB"
  ogDescription={`Browse ${scholarshipCount}+ free scholarships and programs for Alberta high school students. No login, no ads, no data collection. Updated for the 2026-27 cycle.`}
  ogUrl="https://www.scholarab.ca/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.scholarab.ca/#organization",
        "name": "ScholarAB",
        "alternateName": ["ScholarAB.ca", "scholarab"],
        "url": "https://www.scholarab.ca",
        "logo": "https://www.scholarab.ca/icon-512.png",
        "description": "Free Alberta scholarship and program directory for high school students.",
        "areaServed": { "@type": "AdministrativeArea", "name": "Alberta, Canada" },
        "founder": {
          "@type": "Person",
          // Carries an @id so /about/ can describe the same person rather than
          // declaring a second, unrelated Person with the same name.
          "@id": "https://www.scholarab.ca/#founder",
          "name": "Ilia Ivanov",
          "sameAs": "https://www.linkedin.com/in/iliaivanov/",
        },
        "sameAs": [
          "https://www.instagram.com/scholarab.ca",
          "https://www.tiktok.com/@scholarab",
          // The top search result for the brand name, above the site itself.
          "https://github.com/scholarab/scholarab",
        ],
      },
      {
        "@type": "WebSite",
        "@id": "https://www.scholarab.ca/#website",
        "name": "ScholarAB",
        "alternateName": ["scholarab"],
        "url": "https://www.scholarab.ca",
        "description": "Free Alberta scholarship and program directory for high school students.",
        "publisher": { "@id": "https://www.scholarab.ca/#organization" },
        "inLanguage": "en-CA",
      },
    ],
  })} slot="head" />
  <SabFonts chips slot="head" />
  {/* The poster is the phone LCP and a CSS background, so the browser only
      found it after the stylesheet: 2.5 s on a throttled 4G run. Phones get
      the same 720x1080 centre crop as the `.m` clips, at under half the bytes. */}
  <link rel="preload" as="image" href="/video/hero/poster.webp" media="(min-width: 901px)" fetchpriority="high" slot="head" />
  <link rel="preload" as="image" href="/video/hero/poster.m.webp" media="(max-width: 900px)" fetchpriority="high" slot="head" />

  {/* The header is the page's banner and cannot sit inside <main>; it used to
      be the hero's first flex child. The hero now pulls itself up under it so
      the film is the header's background (Ilia, 2026-10-02), and the bar
      stays see-through over every section below it too. */}
  <div class="sab-hero-band" slot="header">
    <SabHeader currentPath="/" />
  </div>

  <div id="sab-home">

    <!-- ============ DARK HERO ============ -->
    <div class="sab-hero">
      {/* Background film: twelve Pexels clips crossfading in a loop, behind
          the see-through header. The still is the first clip's first frame and is
          all that shows on phones, with reduced motion, or with Save-Data on. */}
      <div class="sab-hero-media" aria-hidden="true">
        <video class="sab-hero-vid" muted playsinline preload="none"></video>
        <video class="sab-hero-vid" muted playsinline preload="none"></video>
      </div>
      <!-- hero body -->
      <div class="sab-container sab-hero-body">
        <p class="sab-byline">Built by a high school student from Medicine Hat<span class="sab-kicker-sep" aria-hidden="true">·</span><a href="/about/" class="sab-kicker-link">Read the story</a></p>

        <h1 class="sab-h1"><span class="sab-h1-l sab-h1-l1">Making scholarships and programs</span> <span class="sab-h1-l sab-h1-l2">easier to find for Alberta students</span></h1>

        <div class="sab-hero-bottom">
          <div class="sab-hero-copy">
            <p>
              <span class="sab-hero-p-l1">ScholarAB tracks scholarships and programs for Alberta high school students.</span>
            </p>
            {/* The home page had no search (critique 2026-09-24); the directory
                reads ?q= the same way the 404 page's search uses it. */}
            <form action="/scholarships/" method="get" class="sab-hero-search" role="search" data-scope-search data-scope-hubs={JSON.stringify(scopeMap)}>
              <label for="sab-hero-q" class="sr-only">Search scholarships</label>
              <svg class="sab-hero-search-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.5"/><path d="M10.6 10.6L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              <input id="sab-hero-q" name="q" type="search" enterkeyhint="search" placeholder="Search, e.g. nursing" class="sab-hero-search-input" />
              <button type="submit" class="sab-hero-search-btn">Search</button>
            </form>
            <div class="sab-hero-ctas">
              <a href="/scholarships/" class="sab-btn-accent">
                Browse {scholarshipCount.toLocaleString('en-CA')} scholarships
              </a>
              <a href="/programs/" class="sab-btn-outline">
                Explore programs
              </a>
            </div>
            {/* A returning student's own city, from the last city list they
                opened (lib/my-city.ts). Filled in the browser; hidden until then. */}
            <p class="sab-hero-quiz sab-hero-city" data-my-city={JSON.stringify(myCityHubs)} hidden>
              <a href="/scholarships/" data-my-city-link></a>
            </p>
            {/* Inline, right here, so the line is in place before first paint:
                painted later, it would push the quiz line down under the reader. */}
            <script is:inline>(function () {
              const line = document.querySelector('[data-my-city]');
              const link = line && line.querySelector('[data-my-city-link]');
              if (!link) return;
              try {
                const hubs = JSON.parse(line.getAttribute('data-my-city') || '{}');
                const slug = localStorage.getItem('sa_city'); // lib/my-city.ts
                const hub = slug && Object.prototype.hasOwnProperty.call(hubs, slug) ? hubs[slug] : null;
                if (!hub) return;
                link.href = '/scholarships/' + slug + '/';
                link.textContent = hub.open > 0
                  ? 'Back to ' + hub.label + ': ' + hub.open.toLocaleString('en-CA') + ' open now'
                  : 'Back to ' + hub.label + "'s list";
                line.hidden = false;
              } catch { /* storage blocked: no line */ }
            })();</script>
            {/* The home page's only road to the quiz went with the mini-quiz
                (critique 2026-09-23). One quiet line, not a third button. */}
            <p class="sab-hero-quiz">Not sure where to start? <a href="/match/">Answer a few questions</a><span class="sab-hero-quiz-tail"> and get a shortlist. No email needed.</span></p>
          </div>

        </div>
      </div>

    </div>

    <!-- ============ CLOSING THIS WEEK ============ -->
    {/* Every section below the hero sits on its own film or photo, full
        screen, after spacex.com (Ilia, 2026-10-02). The edges fade to the
        hero's ink, so one section runs into the next with no seam. */}
    {closingSoon.length > 0 && (
      <div class="sab-panel" data-panel data-closing-section>
      <HomePanelMedia clip="07" />
      <div class="sab-container sab-closing" id="closing">
        <div class="sab-section-head">
          <div>
            <h2 class="sab-h2">{closingHeading}</h2>
          </div>
          <a href="/deadlines/" class="sab-view-all">View all deadlines</a>
        </div>

        <div class="sab-closing-table" id="closing-soon-list" data-deadline-list>
          {closingSoon.map(s => (
            <a href={`/scholarships/${generateSlug(s.title)}/`} class="sab-closing-row" data-deadline={s.deadline}>
              <div class="sab-row-main">
                <div class="sab-row-name">{s.title}</div>
                {s.audience && <div class="sab-row-blurb">{s.audience}</div>}
              </div>
              <div class="sab-row-amount tnum">{s.amount}</div>
              <div class="sab-row-when"><span class="sabl-when" data-when><span data-when-main>&hellip;</span><span class="sabl-when-sub" data-when-sub hidden></span></span></div>
            </a>
          ))}
        </div>
      </div>
      </div>
    )}

    <!-- ============ PHOTO CAROUSEL (scholarship scopes or program formats) ============ -->
    {/* One carousel with two sets (Ilia, 2026-09-24): the two stacked ones took
        1.6 phone screens (critique). The tabs sit in the solid ink at the top of
        the slides, where the fade makes them legible over any photo, and name
        what each set sorts by. Without JS both sets show, one above the other. */}
    <section class="sab-scopes-pair" aria-labelledby="sab-scopes-h" data-scopes-pair>
      <h2 id="sab-scopes-h" class="sr-only">Browse by where you live or by program format</h2>
      <div class="sab-scopes-tabs" role="tablist" aria-label="Photo set">
        {carousels.map((k, i) => (
          <button type="button" role="tab" class="sab-scopes-tab" id={`sab-scopes-tab-${k.key}`} aria-controls={`sab-scopes-${k.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-scopes-tab={k.key}>{k.title}</button>
        ))}
      </div>
    {carousels.map((k, i) => (
      <div class="sab-scopes" id={`sab-scopes-${k.key}`} role="tabpanel" aria-labelledby={`sab-scopes-tab-${k.key}`} data-scopes={k.key} data-off={i === 0 ? undefined : ''}>
        <div class="sab-scopes-track" data-scopes-track tabindex="-1">
          {k.cards.map((c, j) => (
            <article class="sab-scope" aria-label={`${c.label}: ${c.count} ${k.noun}`} data-scope-card>
              {j === 0 ? (
                <picture>
                  <source media="(max-width: 700px)" srcset={tallSet(c.backdrop)} sizes="100vw" />
                  <img class="sab-scope-img" src={wideSrc(c.backdrop)} srcset={wideSet(c.backdrop)} sizes="100vw" alt="" loading="lazy" decoding="async" />
                </picture>
              ) : (
                <Fragment>
                  <picture data-defer>
                    <source media="(max-width: 700px)" data-srcset={tallSet(c.backdrop)} sizes="100vw" />
                    <img class="sab-scope-img" data-src={wideSrc(c.backdrop)} data-srcset={wideSet(c.backdrop)} sizes="100vw" alt="" decoding="async" />
                  </picture>
                  <noscript>
                    <picture>
                      <source media="(max-width: 700px)" srcset={tallSet(c.backdrop)} sizes="100vw" />
                      <img class="sab-scope-img" src={wideSrc(c.backdrop)} srcset={wideSet(c.backdrop)} sizes="100vw" alt="" loading="lazy" decoding="async" />
                    </picture>
                  </noscript>
                </Fragment>
              )}
              <div class="sab-scope-body">
                <div class="sab-scope-kicker">{c.kicker}</div>
                <div class="sab-scope-bottom">
                  <h3 class="sab-scope-name">{c.label}</h3>
                  {c.open > 0 && c.openHref
                    ? <a href={c.openHref} class="sab-scope-sub">{c.open.toLocaleString('en-CA')} open right now</a>
                    : <span class="sab-scope-sub sab-scope-sub-plain">{c.open > 0 ? `${c.open.toLocaleString('en-CA')} open right now` : k.none}</span>}
                  <div class="sab-scope-ctas">
                    <a href={c.href} class="sab-scope-btn sab-scope-btn-solid">
                      See all {c.count.toLocaleString('en-CA')}
                    </a>
                  </div>
                </div>
              </div>
              {c.credit && needsCredit(c.credit) && (
                <a class="sab-scope-credit" href={c.credit.sourceUrl} target="_blank" rel="noopener noreferrer">
                  Photo: {c.credit.author}, {c.credit.license}
                </a>
              )}
            </article>
          ))}
        </div>
        <button type="button" class="sab-scopes-arrow sab-scopes-prev" data-scopes-prev aria-label="Previous" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="sab-scopes-arrow sab-scopes-next" data-scopes-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="sab-scopes-dots" data-scopes-dots>
          {k.cards.map((c, i) => (
            <button type="button" class="sab-scopes-dot" aria-label={`Show ${c.label}`} aria-current={i === 0 ? 'true' : undefined}></button>
          ))}
        </div>
      </div>
    ))}
    </section>

    <!-- ============ BIGGEST OPEN AWARDS ============ -->
    {biggestOpen.length > 0 && (
      <div class="sab-panel" data-panel data-closing-section>
      <HomePanelMedia clip="20" />
      <div class="sab-container sab-closing sab-biggest">
        <div class="sab-section-head">
          <div>
            <h2 class="sab-h2">Biggest awards open now</h2>
          </div>
          <a href="/scholarships/?sort=highest_pay" class="sab-view-all">All by amount</a>
        </div>

        <div class="sab-closing-table" data-deadline-list>
          {biggestOpen.map(s => (
            <a href={`/scholarships/${generateSlug(s.title)}/`} class="sab-closing-row" data-deadline={s.deadline}>
              <div class="sab-row-main">
                <div class="sab-row-name">{s.title}</div>
                {s.audience && <div class="sab-row-blurb">{s.audience}</div>}
              </div>
              <div class="sab-row-amount tnum">{s.amount}</div>
              <div class="sab-row-when"><span class="sabl-when" data-when><span data-when-main>&hellip;</span><span class="sabl-when-sub" data-when-sub hidden></span></span></div>
            </a>
          ))}
        </div>
      </div>
      </div>
    )}

    <!-- ============ BY TYPE ============ -->
    {/* Rows in the directory's grammar, not a card grid with slogans; the
        city chip cloud and the home mini-quiz that followed are gone
        (critique 2026-09-23): the header dropdown carries every city, and
        /match is the one quiz. */}
    <div class="sab-panel" data-panel>
    <HomePanelMedia clip="12" />
    <div class="sab-container sab-closing sab-types">
      <div class="sab-section-head">
        <h2 class="sab-h2">By type</h2>
        <a href="/scholarships/" class="sab-view-all">All {scholarshipCount.toLocaleString('en-CA')} scholarships</a>
      </div>
      <div class="sab-closing-table">
        {categories.map(c => (
          <a href={c.href} class="sab-type-row">
            <span class="sab-row-name">{c.name}</span>
            <span class="sab-type-open tnum">{c.open} open now <span class="sab-type-total">of {c.count}</span></span>
            <span class="sab-type-next tnum">{c.next ? `Next due ${formatDeadline(c.next)}` : 'Nothing due soon'}</span>
          </a>
        ))}
      </div>
    </div>

    </div>

  </div>

  <SabFooter slot="footer" />
</Layout>

<script>
  import { wireScopeSearch } from '../lib/scope-search';
  import { scholarshipWhen } from '../lib/list-core';
  import type { ScholarshipWithMeta } from '../lib/list-core';
  import { todayDate as albertaToday } from '../lib/calendar';

  // ── Deadline lines on the homepage rows (client-side so a stale static build never lies) ──
  // Both row lists (closing soon, biggest open) share the chips and the rule
  // that a row whose deadline has passed since the build drops out.
  function updateClosingSoon() {
    document.querySelectorAll<HTMLElement>('[data-deadline-list]').forEach(updateDeadlineList);
  }
  function updateDeadlineList(list: HTMLElement) {
    const today = albertaToday();
    const todayMs = today.getTime();
    const rows = list.querySelectorAll<HTMLElement>('.sab-closing-row');
    let visible = 0;
    rows.forEach(row => {
      const deadline = row.dataset.deadline ?? null;
      if (deadline && new Date(deadline + 'T00:00:00').getTime() < todayMs) {
        row.style.display = 'none';
        return;
      }
      visible++;
      // The directory's own deadline line (list-core), so a row reads the
      // same here as on the listing it links to. Every row here is open.
      const when = scholarshipWhen({ id: 0, deadline, openDate: null, active: true } as unknown as ScholarshipWithMeta);
      const el = row.querySelector<HTMLElement>('[data-when]');
      if (el) {
        el.className = when.cls;
        el.querySelector('[data-when-main]')!.textContent = when.main;
        const sub = el.querySelector<HTMLElement>('[data-when-sub]')!;
        sub.textContent = when.sub;
        sub.hidden = !when.sub;
      }
    });
    if (visible === 0) {
      const section = list.closest('[data-closing-section]') as HTMLElement | null;
      if (section) section.style.display = 'none';
    }
  }

  updateClosingSoon();
  document.querySelectorAll<HTMLFormElement>('form[data-scope-search]').forEach(wireScopeSearch);
  document.addEventListener('astro:page-load', updateClosingSoon);

  // ── Scope carousel ──
  // Native horizontal scroll with snap does the swiping; this only wires the
  // arrows and dots to it and keeps them in step with wherever it rests.
  function initScopes() {
    document.querySelectorAll<HTMLElement>('[data-scopes]').forEach(initCarousel);
  }
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-scopes-track]');
    if (!track || root.dataset.init) return;
    root.dataset.init = '';
    const cards = [...track.querySelectorAll<HTMLElement>('[data-scope-card]')];
    const dots = [...root.querySelectorAll<HTMLElement>('.sab-scopes-dot')];
    const prev = root.querySelector<HTMLButtonElement>('[data-scopes-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-scopes-next]')!;
    const smooth: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const current = () => {
      const left = track.scrollLeft;
      let best = 0;
      cards.forEach((c, i) => { if (Math.abs(c.offsetLeft - track.offsetLeft - left) < Math.abs(cards[best]!.offsetLeft - track.offsetLeft - left)) best = i; });
      return best;
    };
    const go = (i: number) => {
      const c = cards[Math.max(0, Math.min(cards.length - 1, i))];
      if (c) track.scrollTo({ left: c.offsetLeft - track.offsetLeft, behavior: smooth });
    };
    // Photos for the card in view and its neighbours, so a swipe lands on a
    // loaded picture; nothing until the carousel is near the screen. Each one
    // fades in from the slide's ink as it arrives rather than popping in.
    let near = false;
    const fetchPhoto = (c: HTMLElement): HTMLImageElement | null => {
      const pic = c.querySelector<HTMLElement>('picture[data-defer]');
      if (!pic) return null;
      pic.removeAttribute('data-defer');
      const img = pic.querySelector('img')!;
      pic.classList.add('is-loading');
      const shown = () => pic.classList.remove('is-loading');
      img.addEventListener('load', shown, { once: true });
      img.addEventListener('error', shown, { once: true });
      pic.querySelectorAll<HTMLSourceElement | HTMLImageElement>('[data-srcset]').forEach(el => {
        el.srcset = el.dataset.srcset!;
        if (el instanceof HTMLImageElement && el.dataset.src) el.src = el.dataset.src;
      });
      return img;
    };
    const wake = (i: number) => {
      if (!near) return;
      for (const c of cards.slice(Math.max(0, i - 1), i + 2)) fetchPhoto(c);
    };
    // Someone swiping fast outran the neighbours (Ilia, 2026-10-03: "if you go
    // fast they don't download fast enough"). Once they move past the first
    // slide, the rest of the set follows, nearest first and one at a time so
    // the next photo never shares the line with one five slides away. A
    // visitor who never swipes still fetches only the first two.
    let queued = false;
    const fetchRest = () => {
      if (queued) return;
      queued = true;
      const step = () => {
        const i = current();
        const c = [...cards].sort((a, b) => Math.abs(cards.indexOf(a) - i) - Math.abs(cards.indexOf(b) - i))
          .find(x => x.querySelector('picture[data-defer]'));
        const img = c && fetchPhoto(c);
        if (!img) return;
        if (img.complete) setTimeout(step, 0);
        else { img.addEventListener('load', step, { once: true }); img.addEventListener('error', step, { once: true }); }
      };
      step();
    };
    new IntersectionObserver((entries, io) => {
      if (!entries.some(e => e.isIntersecting)) return;
      near = true;
      io.disconnect();
      wake(current());
    }, { rootMargin: '0px 0px 400px 0px' }).observe(root);
    const sync = () => {
      const i = current();
      wake(i);
      if (near && track.scrollLeft > 4) fetchRest();
      dots.forEach((d, j) => (j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      prev.hidden = track.scrollLeft < 4;
      next.hidden = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); }, { passive: true });
    sync();
  }
  document.addEventListener('astro:page-load', initScopes);

  // The two photo sets share one place on the page; a tab shows one. Arrow
  // keys move between the tabs (the WAI tabs pattern), and the shown track
  // re-syncs its arrows, which measured zero width while it was hidden.
  function initScopeTabs() {
    const pair = document.querySelector<HTMLElement>('[data-scopes-pair]');
    if (!pair || pair.dataset.init) return;
    pair.dataset.init = '';
    const tabs = [...pair.querySelectorAll<HTMLButtonElement>('[data-scopes-tab]')];
    const show = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach(t => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        pair.querySelector<HTMLElement>(`[data-scopes="${t.dataset.scopesTab}"]`)?.toggleAttribute('data-off', !on);
      });
      pair.querySelector(`[data-scopes="${tab.dataset.scopesTab}"] [data-scopes-track]`)?.dispatchEvent(new Event('scroll'));
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t));
      t.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); show(tabs[(i + d + tabs.length) % tabs.length]!, true); }
      });
    });
  }
  document.addEventListener('astro:page-load', initScopeTabs);


  // ── Hero film: two <video> elements take turns so the next clip is already
  // buffered when the current one starts fading out. The next clip is fetched
  // PREFETCH_S before the handoff, not at page load: loading both up front
  // pulled 13.2 MB on a desktop first visit (two 6-7 MB takes) for a film most
  // visitors scroll past before the first cut.
  // Twelve 12-second takes, no timelapses (they step, and read as stutter).
  // Each plays at the rate it was shot: 12 and 13 at 60 fps (the only two
  // shot at 60; they were halved to 30 until 2026-10-02), the rest 24 to 30.
  // Nothing is interpolated up to 60.
  // Each clip ships as H.265 (what SpaceX serves: about half the bits of
  // H.264 for the same picture) and as H.264 for browsers without H.265.
  // Phones get a `.m` cut: the hero box is portrait there (375x563 on a 390pt
  // phone), so object-fit already threw away most of a 1920-wide frame's
  // width. The mobile file is that same centre crop encoded at 720x1080,
  // which is about a quarter of the bytes for the picture a phone shows.
  // The film was off on phones entirely until 2026-09-19; it looked stopped.
  const HERO_CLIPS = ['01','18','12','04','17','16','20','08','13','06','10','07'];
  const FADE_S = 1.5;
  const PREFETCH_S = 6;
  function initHeroFilm() {
    const media = document.querySelector<HTMLElement>('.sab-hero-media');
    if (!media || media.dataset.init) return;
    media.dataset.init = '1';
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    // A 2G connection would spend the visit downloading a background.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
    const [a, b] = media.querySelectorAll<HTMLVideoElement>('video');
    if (!a || !b) return;
    const vids = [a, b];
    let i = 0;
    let cur = 0;
    const cut = matchMedia('(max-width: 900px)').matches ? '.m' : '';
    let ext = a.canPlayType('video/mp4; codecs="hvc1.1.6.L120.90"') ? '.hevc.mp4' : '.mp4';
    const src = (n: number) => `/video/hero/${HERO_CLIPS[n % HERO_CLIPS.length]}${cut}${ext}`;
    const load = (v: HTMLVideoElement, n: number) => { v.preload = 'auto'; v.src = src(n); v.load(); };
    // A rejected play() leaves the poster up and the film reads as stopped
    // rather than absent, so a refusal is retried once the clip is decodable
    // and again on the visitor's first touch. iOS refuses the first call while
    // the clip is still arriving, and refuses every call in Low Power Mode,
    // where the poster is the honest end state.
    const start = (v: HTMLVideoElement) => {
      if (v.currentTime) v.currentTime = 0;
      v.play().then(() => v.classList.add('is-on')).catch(() => {
        if (v !== vids[cur]) return;
        const again = () => {
          if (v !== vids[cur] || !v.paused) return;
          v.play().then(() => v.classList.add('is-on')).catch(() => {});
        };
        v.addEventListener('canplay', again, { once: true });
        addEventListener('touchstart', again, { once: true, passive: true });
        addEventListener('pointerdown', again, { once: true });
      });
    };
    // A browser can claim H.265 and still fail to decode it (no hardware
    // decoder). Fall back to H.264 for the rest of the visit.
    vids.forEach(v => v.addEventListener('error', () => {
      if (ext === '.mp4') return;
      ext = '.mp4';
      v.src = v.src.replace('.hevc.mp4', '.mp4');
      v.load();
      if (v === vids[cur]) start(v);
    }));
    let queued = 0; // index of the furthest clip already requested
    vids.forEach(v => v.addEventListener('timeupdate', () => {
      if (v !== vids[cur] || !v.duration || v.dataset.handed) return;
      if (queued === i && v.currentTime >= v.duration - FADE_S - PREFETCH_S) {
        queued = i + 1;
        load(vids[1 - cur]!, i + 1);
      }
      if (v.currentTime < v.duration - FADE_S) return;
      v.dataset.handed = '1';
      const next = vids[1 - cur]!;
      start(next);
      v.classList.remove('is-on');
      cur = 1 - cur;
      i++;
      setTimeout(() => { v.pause(); delete v.dataset.handed; }, FADE_S * 1000);
    }));
    // Backgrounding the tab pauses the clip, and nothing resumes it on the way
    // back: the film sits on a still frame and reads as broken. Phones hit this
    // constantly, since every app switch hides the page.
    // Both listeners live on the document, which outlasts this page under the
    // ClientRouter; once the film is swapped out they must not touch it.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden || !media.isConnected) return;
      const v = vids[cur]!;
      if (v.paused && v.src) v.play().then(() => v.classList.add('is-on')).catch(() => {});
    });
    load(a, 0);
    start(a);
  }
  // After the page has loaded and gone idle, so the first clip (2.7 to 3.2 MB
  // on a desktop) never competes with the poster, fonts or first paint. The
  // poster is the same frame, so the late start is invisible.
  function startHeroFilmLater() {
    const go = () => ('requestIdleCallback' in window
      ? requestIdleCallback(initHeroFilm, { timeout: 2000 })
      : setTimeout(initHeroFilm, 200));
    if (document.readyState === 'complete') go();
    else addEventListener('load', go, { once: true });
  }
  startHeroFilmLater();
  document.addEventListener('astro:page-load', startHeroFilmLater);

  // ── Panels: each row section's clip plays only while its panel is on
  // screen and pauses when it leaves, so at most the one or two panels in
  // view are decoding. Nothing is fetched until a panel comes within a screen
  // of the window. The same gates as the hero film: reduced motion, Save-Data
  // and 2G keep the still. The words rise in as a panel arrives.
  function initPanels() {
    const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')].filter(p => !p.dataset.init);
    if (!panels.length) return;
    panels.forEach(p => { p.dataset.init = '1'; });
    const reveal = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); reveal.unobserve(e.target); }
    }, { rootMargin: '0px 0px -15% 0px' });
    panels.forEach(p => reveal.observe(p));

    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
    const cut = matchMedia('(max-width: 900px)').matches ? '.m' : '';
    const probe = document.createElement('video');
    const ext = probe.canPlayType('video/mp4; codecs="hvc1.1.6.L120.90"') ? '.hevc.mp4' : '.mp4';
    // Either observer can run first in a frame, so both go through this.
    const fetchClip = (v: HTMLVideoElement) => {
      if (v.src) return;
      v.addEventListener('playing', () => v.classList.add('is-on'), { once: true });
      v.preload = 'auto';
      v.src = `/video/hero/${v.dataset.panelClip}${cut}${ext}`;
    };
    const play = (v: HTMLVideoElement) => { fetchClip(v); v.play().catch(() => {}); };
    // Fetched a quarter screen early so the clip is ready, but decoded only
    // while some of the panel is actually in the window.
    const clipOf = (el: Element) => el.querySelector<HTMLVideoElement>('video[data-panel-clip]');
    const fetcher = new IntersectionObserver(entries => {
      for (const e of entries) {
        const v = clipOf(e.target);
        if (!e.isIntersecting || !v) continue;
        fetchClip(v);
        fetcher.unobserve(e.target);
      }
    }, { rootMargin: '25% 0px' });
    const film = new IntersectionObserver(entries => {
      for (const e of entries) {
        const v = clipOf(e.target);
        if (!v) continue;
        // A panel touching the window's edge reports as intersecting with
        // nothing showing; the hero ends exactly where the first one starts.
        if (e.isIntersecting && e.intersectionRect.height > 0) play(v);
        else v.pause();
      }
    }, { threshold: [0, 0.02] });
    panels.forEach(p => { fetcher.observe(p); film.observe(p); });
  }
  initPanels();
  document.addEventListener('astro:page-load', initPanels);
</script>

<style is:global>
  /* The canvas is the same ink as the film sections and the footer. iPhone
     Safari paints the strip behind the status bar from a solid header, or
     else from the page, and the header here is see-through, so a white page
     showed as a white strip above it. */
  html:has(#sab-home), body:has(#sab-home) { background: #0A1310; }
  /* The header is see-through the whole way down the home page, after
     spacex.com (Ilia, 2026-10-02): every section here is dark film, so the
     bar never needs its own ground. Not even under an open dropdown (Ilia,
     2026-10-03: "no background at all, forever"): the menu is words over the
     film, as on spacex.com. Only the phone sheet, which covers the page,
     goes solid. */
  @media (prefers-reduced-motion: no-preference) {
    .sab-hero-band { transition: background-color 0.25s ease, transform 0.3s ease, box-shadow 0.3s ease, border-bottom-color 0.3s ease; }
  }
  .sab-hero-band:not(:has(.sabh[data-open])) {
    background-color: transparent;
    box-shadow: none;
    border-bottom-color: transparent;
  }
  .sab-hero-band .sabh-drop { display: none; }
  .sab-hero-band .sabh-menu-desk a { text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55); }
  /* Desktop: the smoke behind spacex.com's bar (Ilia, 2026-10-03). A soft
     black fall-off under the see-through header, and a deeper, taller one
     while a menu is open so its words read over any frame of the film.
     Behind the bar's contents (z-index -1 inside the sticky band's own
     stacking context) and never in the pointer's way. */
  @media (min-width: 901px) {
    .sab-hero-band::before, .sab-hero-band::after {
      content: ''; position: absolute; left: 0; right: 0; top: 0; z-index: -1;
      pointer-events: none; transition: opacity 0.25s ease;
    }
    .sab-hero-band::before {
      height: 200px;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0, rgba(0, 0, 0, 0.28) 45%, rgba(0, 0, 0, 0) 100%);
    }
    .sab-hero-band::after {
      height: 330px; opacity: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.88) 0, rgba(0, 0, 0, 0.72) 40%, rgba(0, 0, 0, 0) 100%);
    }
    .sab-hero-band:has(.sabh-has-menu[data-menu-open])::after { opacity: 1; }
    /* On a short window the open list lands on the headline, which is
       centred in the fold; it fades back while a menu is open so the list
       reads on its own. */
    /* On the lines, not the h1: its entrance animation holds the h1's own
       opacity at 1. */
    #sab-home .sab-hero .sab-h1-l { transition: opacity 0.25s ease; }
    html:has(.sab-hero-band .sabh-has-menu[data-menu-open]) #sab-home .sab-hero .sab-h1-l { opacity: 0.18; }
    /* The bar slides up out of view on the way down; its smoke goes with it. */
    html[data-sab-hidden] .sab-hero-band::before,
    html[data-sab-hidden] .sab-hero-band::after { opacity: 0; }
  }
</style>

<style>
  /* ════ ScholarAB Home · claude.ai/design "ScholarAB Home.dc.html" ════
     Palette: canvas var(--bg-page) (white since 2026-09-22) · alt band #F2F3F5 · ink #141915 · hero/footer #08120E
     accent #2FD3A0 · accent hover #4FE0B4 · accent-on-dark text #5CE3BB
     green #0A6B4D (pressed #08573E) · hard shadows on cream #0E8C64
     ink-on-accent #08120E · urgency #A0491A
     Tuned 2026-09-02: mint stays the accent, but it no longer doubles as the
     drop shadow on cream, where 1.8:1 against the card made the lift read as
     a smudge. Deep green carries the shadows and the primary action on light
     surfaces; mint keeps the dark ones.
     Type: see --font-display / --font-body / --font-label in global.css */

  #sab-home {
    background: #0A1310;
    color: #141915;
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  #sab-home ::selection { background: #2FD3A0; color: #08120E; }
  .sab-mono { font-family: var(--font-label); }
  /* Full window width with the header's own gutter, so every section lines
     up with the logo and nothing sits in a centred column with bare margins
     either side (Ilia, 2026-09-18). */
  .sab-container { width: 100%; box-sizing: border-box; padding-left: clamp(20px, 4vw, 56px); padding-right: clamp(20px, 4vw, 56px); }

  @keyframes sab-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes sab-pop { 0% { transform: scale(0.94); } 60% { transform: scale(1.05); } 100% { transform: scale(1); } }

  /* ── Dark hero ── */
  /* Fills the first viewport so no canvas sliver peeks below the fold on
     tall/fullscreen windows; on short viewports it grows past 100svh. */
  /* Solid, the same #0A1310 as the Scholarships and Programs dropdowns, so
     an open menu sits on one continuous black panel instead of on the film. */
  /* No position or z-index here: global.css makes this band sticky like every
     other page's header. `position: relative; z-index: 2` (5382481) once
     unstuck it; the hero slides under the sticky bar instead (below).
     The see-through state lives in the is:global block, because it keys off
     the header component's own attributes. */
  .sab-hero-band { background: #0A1310; color: #EEF1EC; }
  .sab-hero {
    background: #0A1310; color: #EEF1EC; position: relative; isolation: isolate;
    overflow: hidden;
    display: flex; flex-direction: column;
    /* Starts behind the header (the bar plus its 1px rule from global.css),
       so the film fills the bar too, and still ends at the fold. */
    margin-top: calc(-1 * var(--sab-nav-h) - 1px);
    min-height: 100vh;
    min-height: 100svh;
  }

  .sab-hero-media {
    position: absolute; z-index: -1; inset: 0;
    background: #0A1310 url('/video/hero/poster.webp') center / cover no-repeat;
  }
  .sab-hero-vid {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity 1.2s ease;
  }
  .sab-hero-vid.is-on { opacity: 1; }
  /* The words sit on the scrim below, not on a glow: the wide soft halos
     that used to carry them read as a template effect (critique 2026-09-23).
     One tight 1px shadow keeps glyph edges clean over bright frames. */
  .sab-hero .sab-h1, .sab-byline, .sab-hero-copy p { text-shadow: 0 1px 2px rgba(5,10,8,0.55); }
  /* The byline measured 3.8:1 median, 2.2 worst, over bright frames of the
     film (critique 2026-09-23); a soft dark shadow under the small type holds
     it above 4.5 without darkening the whole film. */
  .sab-hero .sab-byline { text-shadow: 0 1px 2px rgba(5,10,8,0.7), 0 0 14px rgba(5,10,8,0.6); }
  /* SpaceX-style scrim: the picture stays close to full strength and only
     the places text sits are darkened. A light veil over everything, a band
     under the nav, and a fall-off to near black behind the copy, buttons and
     numbers at the bottom. */
  .sab-hero-media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10,19,16,0.5) 0, rgba(10,19,16,0) calc(160px + var(--sab-nav-h))),
      linear-gradient(180deg, rgba(10,19,16,0) 40%, rgba(10,19,16,0.6) 72%, rgba(10,19,16,0.92) 94%, #0A1310 100%),
      /* The byline and headline sit on the left; on a bright frame the byline
         fell to 3.3:1 (critique 2026-09-23). Darken that side only. */
      linear-gradient(90deg, rgba(10,19,16,0.42) 0, rgba(10,19,16,0.2) 45%, rgba(10,19,16,0) 75%),
      rgba(10,19,16,0.38);
  }

  /* The byline names who built the site and hands off to /about for the rest.
     A sentence in the body face, not a mono eyebrow. */
  .sab-byline {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px;
    font-size: 17px; font-weight: 600; color: #EEF1EC; margin: 0 0 26px;
  }
  .sab-kicker-sep { opacity: 0.45; }
  .sab-kicker-link { color: #EEF1EC; font-weight: 400; text-decoration: none; border-bottom: 1px solid rgba(92,227,187,0.6); padding-top: 12px; margin-top: -12px; display: inline-block; }
  .sab-kicker-link:hover { border-bottom-color: #2FD3A0; color: #2FD3A0; }
  /* The copy is centred in the fold under the bar, with gaps that scale
     with the window's height, so it neither floats under a band of empty
     film nor runs past the fold on a laptop (Ilia, 2026-10-03: "move it up
     and spread things in a natural way"). The 180px clearance for an open
     menu left a hole on a short window; an open menu now sits on the
     header's dark smoke instead, which dims whatever is under it.
     --hero-foot is shared with the byline, which is placed from the foot. */
  .sab-hero-body {
    --hero-foot: clamp(28px, 6vh, 64px);
    padding-top: calc(clamp(32px, 7vh, 88px) + var(--sab-nav-h)); position: relative;
    flex: 1; display: flex; flex-direction: column; justify-content: center;
    width: 100%; box-sizing: border-box;
  }

  /* Two fixed lines on desktop (2026-09-18). With three, the gap at the left
     edge changed from line to line with whichever words opened it: "p" hung
     over "f" while "M" sat well clear of "p", so identical leading read as
     sloppy. Two lines have one gap. Both lines are nearly the same length
     (12.96em and 12.68em of Big Shoulders), so the size is the width of
     the hero divided by the first line: the block fills the row at any
     desktop window instead of wrapping at some widths and not others.
     Line height 1.1 leaves 0.08em between descenders and the ascenders
     below. Tracking 0 is the face's designed spacing, the word space trims
     0.03em because a condensed face's default space reads as a gap, and each
     line is pulled left by its first letter's side-bearing (M 0.043em, e
     0.0355em) so both stems sit exactly on the kicker's and paragraph's
     edge. */
  .sab-hero-body { container-type: inline-size; }
  .sab-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: min(168px, calc(100cqi / 13)); line-height: 1.1; letter-spacing: 0; word-spacing: -0.03em;
    margin: 0;
    animation: sab-rise 0.7s ease both;
  }
  .sab-h1-l { display: block; white-space: nowrap; }
  .sab-h1-l1 { margin-left: -0.043em; }
  .sab-h1-l2 { margin-left: -0.0355em; }

  .sab-hero-bottom {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 40px; margin-top: clamp(24px, 5vh, 48px); padding-bottom: var(--hero-foot);
  }
  /* Two lines, one sentence each (Ilia, 2026-09-23): the first holds its
     line, the second starts under it. The stats wrap under the copy on a
     window too narrow to hold both side by side. */
  .sab-hero-bottom { flex-wrap: wrap; }
  .sab-hero-p-l1 { display: block; }
  .sab-hero-p-l1 { white-space: nowrap; }
  .sab-hero-copy p { font-size: 18px; line-height: 1.55; color: rgba(238, 241, 236, 0.8); margin: 0 0 clamp(16px, 3.4vh, 30px); }
  .sab-hero-search {
    position: relative; display: flex; align-items: center; max-width: 480px; margin: 0 0 16px;
    border: 1px solid rgba(238, 241, 236, 0.32); border-radius: var(--radius);
    background: rgba(10, 19, 16, 0.55); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  }
  .sab-hero-search:focus-within { border-color: #2FD3A0; }
  .sab-hero-search-icon { position: absolute; left: 18px; color: rgba(238, 241, 236, 0.7); pointer-events: none; }
  .sab-hero-search-input {
    flex: 1; min-width: 0; height: 50px; padding: 0 8px 0 44px; border: 0; background: none;
    font: 16px var(--font-body); color: #FFFFFF; outline: none;
  }
  .sab-hero-search-input::placeholder { color: rgba(238, 241, 236, 0.66); }
  .sab-hero-search-btn {
    height: 40px; margin-right: 5px; padding: 0 18px; border: 0; border-radius: var(--radius); cursor: pointer;
    font: 600 15px var(--font-body); color: #EEF1EC; background: rgba(238, 241, 236, 0.12);
  }
  .sab-hero-search-btn:hover { background: rgba(238, 241, 236, 0.22); }
  .sab-hero-ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  /* One sentence, one line: a 62ch cap broke "No email needed." onto its own row. Phones wrap. */
  .sab-hero .sab-hero-quiz { margin: 18px 0 0; font-size: var(--fs-body); line-height: 1.5; color: rgba(238, 241, 236, 0.88); white-space: nowrap; }
  /* Small type at the bottom of the film: median 3.4:1 on bright frames
     (critique 2026-09-27). The byline's heavier shadow and full-strength ink. */
  .sab-hero .sab-hero-quiz { color: #EEF1EC; text-shadow: 0 1px 2px rgba(5,10,8,0.7), 0 0 14px rgba(5,10,8,0.6); }
  .sab-hero-quiz a {
    color: #EEF1EC; font-weight: 600; text-decoration: none; border-bottom: 1px solid rgba(92,227,187,0.6);
    display: inline-block; padding-top: 10px; margin-top: -10px;
  }
  .sab-hero-quiz a:hover { color: #2FD3A0; border-bottom-color: #2FD3A0; }
  /* The remembered city reads as the first thing to press, not a footnote. */
  .sab-hero .sab-hero-city { margin-top: 16px; }
  .sab-hero-city a { font-weight: 700; }
  .sab-hero-city a::after { content: ' →'; }
  .sab-hero-city + .sab-hero-quiz { margin-top: 8px; }
  /* Desktop only (Ilia, 2026-10-03): the headline opens the hero, the
     byline moves to the foot of it as a credit on the right, level with the
     buttons (the quiz line under them is too long to share a row with it at
     960px), and the "Back to <city>" line is gone. Phones keep both.
     A grid, not absolute positioning: the block is centred in the fold, so
     an offset from the hero's bottom left the credit below the buttons on a
     tall window. Here it shares the copy's row and rides with it. */
  @media (min-width: 901px) {
    .sab-hero-body {
      display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: center; column-gap: 40px;
    }
    .sab-hero .sab-h1 { grid-column: 1 / -1; grid-row: 1; }
    .sab-hero-bottom { grid-column: 1; grid-row: 2; }
    .sab-hero .sab-byline {
      grid-column: 2; grid-row: 2; align-self: end;
      /* The hero's foot padding, plus the quiz line (18px gap, 24px line)
         and half the 52px buttons less half this line. */
      margin: 0 0 calc(var(--hero-foot) + 55px); font-size: 16px; justify-content: flex-end;
    }
    .sab-hero .sab-hero-city { display: none; }
  }
  /* Narrow laptops: two right-aligned lines, so the credit clears the
     buttons (one line ran 41px into them at 901px). */
  @media (min-width: 901px) and (max-width: 1100px) {
    .sab-hero .sab-byline {
      font-size: 14px; flex-direction: column; align-items: flex-end; gap: 2px;
      margin-bottom: calc(var(--hero-foot) + 46px);
    }
    .sab-hero .sab-kicker-sep { display: none; }
  }
  /* One pair, one size, one motion: hover only changes colour. The lift onto a
     hard shadow and the press snap were three effects on two buttons, and the
     outline button's thick tinted border made it look like a second, heavier
     pill rather than the quieter choice. */
  .sab-btn-accent, .sab-btn-outline {
    display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box;
    height: 52px; padding: 0 28px; border-radius: var(--radius);
    font-size: 16px; text-decoration: none; white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .sab-btn-accent {
    background: #2FD3A0; color: #08120E; font-weight: 700;
  }
  .sab-btn-accent:hover { background: #5CE3BB; }
  /* spacex.com's secondary button: a half-black fill and a faint 1px line,
     so it holds its shape over any frame of the film. */
  .sab-btn-outline {
    color: #EEF1EC; font-weight: 600;
    border: 1px solid rgba(238, 241, 236, 0.35); background: rgba(10, 19, 16, 0.5);
  }
  .sab-btn-outline:hover { border-color: rgba(238, 241, 236, 0.7); background: rgba(238, 241, 236,0.06); }


  /* ── Closing this week ── */
  /* ── Scope carousel (after tesla.com's model cards) ──
     Full screen since 2026-09-23 (Ilia): each slide is the whole viewport,
     edge to edge with no page showing around it, and swiping sideways brings
     in the next one. The track scrolls natively and snaps a slide at a time. */
  .sab-scopes { position: relative; }
  .sab-scopes-track {
    display: flex; overflow-x: auto; overscroll-behavior-x: contain; background: #0A1310;
    scroll-snap-type: x mandatory; scrollbar-width: none; outline: none;
  }
  .sab-scopes-track::-webkit-scrollbar { display: none; }
  .sab-scope {
    position: relative; flex: 0 0 100%; height: 100svh; min-height: 520px;
    overflow: hidden; scroll-snap-align: start; scroll-snap-stop: always;
    view-timeline: --sab-scope inline;
  }
  .sab-scope picture, .sab-scope-img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sab-scope-img { object-fit: cover; }
  /* A photo that arrives after its slide is on screen fades in from the
     slide's ink instead of popping in (the script sets is-loading). */
  .sab-scope picture.is-loading .sab-scope-img { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .sab-scope-img { transition: opacity 0.45s ease; }
  }
  /* The photos hold still and dissolve into each other while the words and
     buttons slide (Ilia, 2026-10-03: a slow drag showed two photos meeting
     at a sharp edge, and dimming them only softened it). Each photo is
     pinned to the window by moving it against its slide's travel, and the
     arriving one fades in over the one leaving, which sits under it in page
     order. Resting, the slide's own photo is the only one showing, at full
     strength. Photos that do not move are less motion, not more, so this
     holds under reduced motion too. Browsers without scroll-driven
     animations keep the plain slide. */
  @supports (view-timeline: --sab-scope inline) {
    .sab-scope { overflow: visible; }
    .sab-scope picture { animation: sab-scope-hold linear both; animation-timeline: --sab-scope; }
  }
  @keyframes sab-scope-hold {
    0% { transform: translateX(-100%); opacity: 0; }
    50% { transform: none; opacity: 1; }
    100% { transform: translateX(100%); opacity: 1; }
  }
  html:not(.js) .sab-scope picture[data-defer] { display: none; }
  /* Every slide fades to the hero's ink (#0A1310) at its top and bottom
     edges, after spacex.com (Ilia, 2026-09-23): hero to carousel and carousel
     to carousel then meet solid ink against solid ink, so the seam between two
     photos disappears instead of cutting one picture off against the next.
     The same shade carries the kicker at the top and the name and buttons at
     the bottom; the photo stays untouched in the middle. */
  /* On the photo, not the slide: a photo pinned over the next slide carries
     its own shade, so two shades never stack and none goes missing. */
  .sab-scope picture::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(#0A1310, rgba(10,19,16,0.8) 12%, rgba(10,19,16,0) 32%, rgba(10,19,16,0) 48%, rgba(10,19,16,0.7) 80%, #0A1310);
  }
  .sab-scope-body {
    position: relative; z-index: 1; height: 100%; box-sizing: border-box;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: clamp(80px, 9vh, 112px) clamp(24px, 5vw, 80px) clamp(64px, 9vh, 96px);
    color: #FFFFFF;
  }
  /* The kicker measured 3.3 to 4.5 over the brighter skies (critique
     2026-09-23) on a 55% fade; the fade is 80% there now, plus a shadow. */
  .sab-scope-kicker { font-size: 19px; font-weight: 600; letter-spacing: -0.005em; text-shadow: 0 1px 2px rgba(5,10,8,0.6), 0 0 12px rgba(5,10,8,0.5); }
  .sab-scopes-pair { position: relative; }
  html.js .sab-scopes[data-off] { display: none; }
  html:not(.js) .sab-scopes-tabs { display: none; }
  .sab-scopes-tabs {
    position: absolute; z-index: 3; top: clamp(18px, 3.2vh, 32px); left: clamp(24px, 5vw, 80px); right: clamp(24px, 5vw, 80px);
    display: flex; flex-wrap: wrap; gap: 4px 22px;
  }
  .sab-scopes-tab {
    margin: 0; padding: 6px 0; border: 0; background: none; cursor: pointer;
    font-family: var(--font-display); font-weight: 400; font-size: clamp(22px, 2.4vw, 34px); line-height: 1;
    color: rgba(255,255,255,0.62); border-bottom: 2px solid transparent;
    text-shadow: 0 1px 2px rgba(5,10,8,0.6);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .sab-scopes-tab:hover { color: #FFFFFF; }
  .sab-scopes-tab[aria-selected='true'] { color: #FFFFFF; border-bottom-color: #2FD3A0; }
  .sab-scopes-tab:focus-visible { outline: 2px solid #2FD3A0; outline-offset: 4px; border-radius: 2px; }
  .sab-scope-name {
    margin: 0; font-family: var(--font-display); font-weight: 400;
    font-size: clamp(48px, 6vw, 84px); line-height: 0.95; letter-spacing: -0.005em;
  }
  .sab-scope-sub {
    display: inline-block; margin-top: 12px; color: #FFFFFF; font-size: 19px;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px;
  }
  .sab-scope-sub:hover { text-decoration-thickness: 2px; }
  /* A 44px target around a one-line link, without moving the lines. */
  a.sab-scope-sub { position: relative; }
  a.sab-scope-sub::after { content: ''; position: absolute; inset: -10px -4px; }
  .sab-scope-sub-plain, .sab-scope-sub-plain:hover { text-decoration: none; }
  /* The no-deadline count, on its own line under the open one: counted apart
     so "open" here matches the hub's Open chip (lib/counts.ts). */
  .sab-scope-ctas { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .sab-scope-btn {
    display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box;
    min-width: 200px; height: 48px; padding: 0 24px; border-radius: var(--radius);
    font-size: 15px; font-weight: 600; text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .sab-scope-btn-solid { background: #2FD3A0; color: #08120E; }
  .sab-scope-btn-solid:hover { background: #5CE3BB; }
  /* The license credit a CC BY or CC BY-SA photo requires, kept small in the
     card's bottom-right corner, over the photo's own bottom shade. */
  .sab-scope-credit {
    position: absolute; right: 14px; bottom: 5px; z-index: 1; padding-block: 5px;
    font-size: 11px; line-height: 1.3; color: rgba(255,255,255,0.72); text-decoration: none;
    max-width: 60%; text-align: right; text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }
  .sab-scope-credit:hover { color: #FFFFFF; text-decoration: underline; }
  .sab-scopes-arrow {
    /* Above the cards: each card's text layer is z-index 1, and without this
       the arrow is drawn but every click on it lands on the card. */
    position: absolute; z-index: 2; top: 50%; transform: translateY(-50%);
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 56px; border: 0; border-radius: var(--radius); cursor: pointer;
    background: rgba(255,255,255,0.85); color: #141915;
    transition: background-color 0.2s ease;
  }
  .sab-scopes-arrow:hover { background: #FFFFFF; }
  .sab-scopes-arrow[hidden] { display: none; }
  .sab-scopes-prev { left: 16px; }
  .sab-scopes-next { right: 16px; }
  /* Each dot is drawn 8px but taps as 24px: the bare 8px buttons 10px apart
     missed the 24px target floor (critique 2026-09-23). Same 18px pitch.
     They sit on the photo now, over its bottom shade, so they are white. */
  .sab-scopes-dots {
    position: absolute; z-index: 2; left: 50%; bottom: 10px; transform: translateX(-50%);
    display: flex; justify-content: center; gap: 0;
  }
  .sab-scopes-dot {
    /* 44px tall, the 24px pitch kept: ten 44px-wide dots would not fit a
       phone. The dot itself sits where it did (bottom moved 20px to 10px). */
    display: grid; place-items: center; width: 24px; height: 44px; margin: 0 -3px;
    padding: 0; border: 0; background: none; cursor: pointer;
  }
  .sab-scopes-dot::before {
    content: ''; width: 8px; height: 8px; border-radius: 0;
    background: rgba(255, 255, 255, 0.4); transition: background-color 0.2s ease;
  }
  .sab-scopes-dot[aria-current]::before { background: #FFFFFF; }
  @media (max-width: 700px) {
    /* Room under the stacked buttons for the dots and the photo credit line. */
    /* Top room for the two tabs, which wrap to two lines at this width. */
    .sab-scope-body { padding: 104px 20px 76px; }
    .sab-scopes-tabs { left: 20px; right: 20px; top: 16px; gap: 2px 18px; }
    .sab-scopes-tab { font-size: 22px; padding: 7px 0; }
    .sab-scopes-dots { bottom: 20px; }
    .sab-scope-kicker, .sab-scope-sub { font-size: 16px; }
    .sab-scope-ctas { flex-direction: column; gap: 10px; }
    .sab-scope-btn { width: 100%; min-width: 0; }
    .sab-scopes-arrow { display: none; }
  }

  .sab-closing { padding-top: 96px; padding-bottom: 40px; }
  .sab-section-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 14px; gap: 20px; }
  /* Biggest open awards: the same table, and a shorter gap since it follows
     another table rather than the hero. No eyebrows over either heading, no
     01/02 row numbers (critique 2026-09-23): the headings say it. */
  .sab-biggest { padding-top: 56px; }
  .sab-h2 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(36px, 5vw, 58px); letter-spacing: -0.01em; margin: 0;
  }
  .sab-view-all {
    font-weight: 600; font-size: 15px; color: #141915; text-decoration: none;
    border-bottom: 2px solid #2FD3A0; padding-bottom: 3px; white-space: nowrap;
  }
  .sab-view-all:hover { color: #0A6B4D; }

  .sab-closing-table { border-top: 2px solid #141915; }
  /* The directory row's order (global.css, critique 2026-09-29): the date
     down the left edge as a figure, the money on the title's line. The date
     was a 15px line at the far right, the smallest bold thing on a list
     called "Closing this week". */
  .sab-closing-row {
    display: grid; grid-template-columns: 104px minmax(0, 1fr) auto; grid-template-areas: "when main amount";
    gap: 28px; align-items: baseline;
    padding: 26px 8px;
    cursor: pointer; color: inherit; text-decoration: none;
  }
  /* Stripes, not hairlines, and the directory's hover: the same row should
     not change its separators between the home page and the list it links
     to (critique 2026-10-02). */
  .sab-closing-row:nth-child(even) { background: rgba(20,25,21,0.04); }
  .sab-closing-row:last-child { border-bottom: 1px solid rgba(20,25,21,0.14); }
  /* Pointers only: on a phone the tint lit whichever row the finger landed
     on to scroll, and jumped from row to row (Ilia, 2026-10-03). */
  @media (hover: hover) {
    .sab-closing-row:hover { background: rgba(47,211,160,0.14); color: inherit; }
    .sab-closing-row:hover .sab-row-name { color: var(--green); }
    .sab-type-row:hover { background: rgba(47,211,160,0.07); }
    .sab-type-row:hover .sab-row-name { color: var(--green); }
  }
  .sab-row-name { font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
  .sab-row-blurb {
    font-size: var(--fs-small); color: var(--ink-muted); margin-top: 5px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    /* Two lines: who can apply decides whether a student opens the row, and
       one line cut "Indigenous students starting a STEM progra..." on a phone. */
  }
  .sab-row-amount { font-family: var(--font-display); font-size: 28px; text-align: right; }
  .sab-closing-row > .sab-row-main { grid-area: main; min-width: 0; }
  .sab-closing-row > .sab-row-amount { grid-area: amount; }
  .sab-closing-row > .sab-row-when { grid-area: when; justify-self: start; }
  .sab-row-when .sabl-when { flex-direction: column; align-items: flex-start; gap: 3px; white-space: normal; }
  .sab-row-when .sabl-when::before, .sab-row-when .sabl-when-sub::before { content: none; }
  .sab-row-when [data-when-main] { font: 400 28px/1 var(--font-display); color: var(--text-primary); white-space: nowrap; }
  .sab-row-when .sabl-when-sub { font-size: var(--fs-ui); line-height: 1.3; }
  .sab-row-when .sabl-when.is-urgent .sabl-when-sub::before {
    content: ''; display: inline-block; width: 7px; height: 7px; margin: 0 5px 1px 0;
    border-radius: 0; background: var(--rust);
  }

  /* ── Categories ── */
  .sab-types { padding-top: 56px; padding-bottom: 96px; }
  .sab-type-row {
    display: grid; grid-template-columns: 1fr 200px 200px; gap: 28px; align-items: baseline;
