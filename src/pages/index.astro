---
import Layout from '../layouts/Layout.astro';
import { loadScholarships, loadPrograms } from '../lib/data-loader';
import { generateSlug } from '../lib/utils';
import { CLOSING_SOON_MS } from '../lib/constants';

const scholarships = await loadScholarships();
const programs = await loadPrograms();

const today = new Date();
today.setHours(0, 0, 0, 0);

const activeScholarships = scholarships.filter(s => s.active === true);
const activeTotal = activeScholarships.reduce((sum, s) => { const m = s.amount.match(/\$?([\d,]+)/); const n = m ? parseInt(m[1].replace(/,/g, ''), 10) : NaN; return sum + (isNaN(n) ? 0 : n); }, 0);
const researchCount = programs.filter(p => {
  if (!p.deadline || p.deadline === 'TBA' || p.deadline === 'Ongoing') return true;
  return new Date(p.deadline + 'T00:00:00') >= today;
}).length;

const scholarshipCount = scholarships.filter(s => {
  const openMs = s.openDate ? new Date(s.openDate + 'T00:00:00').getTime() : 0;
  if (today.getTime() < openMs) return true;
  const deadMs = s.deadline ? new Date(s.deadline + 'T00:00:00').getTime() : 0;
  return today.getTime() <= deadMs;
}).length;

const ONE_WEEK_MS = CLOSING_SOON_MS;
const closingSoon = scholarships
  .filter(s => {
    if (!s.deadline || !s.active) return false;
    const deadlineMs = new Date(s.deadline + 'T00:00:00').getTime();
    return deadlineMs >= today.getTime() && deadlineMs <= today.getTime() + ONE_WEEK_MS;
  })
  .sort((a, b) => new Date(a.deadline! + 'T00:00:00').getTime() - new Date(b.deadline! + 'T00:00:00').getTime())
  .slice(0, 5);

---

<Layout
  title="ScholarAB | Free Alberta High School Scholarships & Research Programs 2026"
  description={`Browse ${scholarshipCount}+ free scholarships and research programs for Alberta high school students. No login, no ads, no data collection. Updated for 2026.`}
  ogTitle="ScholarAB | Free Alberta High School Scholarships & Research Programs 2026"
  ogDescription={`Browse ${scholarshipCount}+ free scholarships and research programs for Alberta high school students. No login, no ads, no data collection. Updated for 2026.`}
  ogUrl="https://www.scholarab.ca"
  currentPath="/"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ScholarAB",
    "url": "https://www.scholarab.ca",
    "description": "Free Alberta scholarship and research program directory for high school students.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://www.scholarab.ca/scholarships" },
      "query-input": "required name=search_term_string",
    },
  })} slot="head" />

  <div class="pb-8">

    <!-- Hero -->
    <div class="max-w-2xl mx-auto pt-8 md:pt-14 pb-4">

      <!-- Live status pill -->
      <div class="flex justify-center md:justify-start mb-6">
        <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:999px;border:1px solid var(--border-card);background:var(--bg-card);backdrop-filter:blur(12px);font-size:12px;font-weight:500;color:var(--text-secondary);">
          <span style="width:7px;height:7px;border-radius:50%;background:var(--brand);box-shadow:0 0 8px var(--brand);display:inline-block;animation:statusPulse 2s ease-in-out infinite;" aria-hidden="true"></span>
          Alberta's student opportunity directory
        </div>
      </div>

      <!-- H1 — large, bold, gradient on key phrase -->
      <h1 class="text-center md:text-left" style="margin:0 0 20px;font-size:clamp(40px,7vw,72px);font-weight:800;letter-spacing:-0.045em;line-height:0.98;color:var(--text-primary);">
        Every Alberta<br/>scholarship, <span style="background:linear-gradient(120deg,var(--brand) 0%,#3b82f6 50%,#a78bfa 100%);-webkit-background-clip:text;background-clip:text;color:transparent;">in one place.</span>
      </h1>

      <p class="text-center md:text-left text-secondary mb-8" style="font-size:clamp(15px,2vw,18px);line-height:1.55;max-width:480px;letter-spacing:-0.01em;">
        A free directory built by a high school student, for high school students. No ads, no logins — just scholarships.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col items-center md:items-start gap-3">
        <div class="flex flex-row gap-3">
          <a href="/scholarships" class="btn-teal inline-flex items-center justify-center gap-2 whitespace-nowrap px-6 py-3.5 rounded-full text-sm font-semibold" style="background:var(--brand);color:#0a0a0f;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            Browse scholarships
          </a>
          <a href="/programs" class="inline-flex items-center justify-center whitespace-nowrap px-6 py-3.5 rounded-full text-sm font-semibold transition-colors border" style="background:var(--brand-dim);border-color:var(--brand-border);color:var(--brand);">
            Research Programs
          </a>
        </div>
        <a href="/match" class="inline-flex items-center gap-2 text-sm font-medium text-secondary hover:text-primary transition-colors">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"/></svg>
          Find scholarships for me →
        </a>
      </div>

      <!-- Ticker counter panel -->
      <div class="mt-10 md:mt-14" style="padding:20px 24px;border-radius:20px;background:linear-gradient(135deg,rgba(34,211,165,0.08) 0%,rgba(59,130,246,0.04) 50%,rgba(167,139,250,0.06) 100%);border:1px solid var(--border-card);backdrop-filter:blur(24px);box-shadow:0 1px 0 rgba(255,255,255,0.05) inset;">
        <p style="font-size:10px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-secondary);margin-bottom:6px;">Total awards available</p>
        <div class="flex items-baseline gap-2">
          <span style="font-size:clamp(28px,5vw,40px);font-weight:800;letter-spacing:-0.03em;color:var(--text-primary);">$</span>
          <span id="hero-amount" data-target={activeTotal} style="font-size:clamp(40px,7vw,64px);font-weight:800;letter-spacing:-0.045em;color:var(--text-primary);font-variant-numeric:tabular-nums;line-height:1;">0</span>
        </div>
        <p style="margin-top:6px;font-size:13px;color:var(--text-secondary);">across <strong style="color:var(--text-primary);font-variant-numeric:tabular-nums;">{scholarshipCount}</strong> open opportunities · <strong style="color:var(--text-primary);">{researchCount}</strong> research programs</p>
      </div>
    </div>

    <!-- Closing this week — horizontal scroll carousel -->
    {closingSoon.length > 0 && (
      <div class="mt-14 md:mt-20">
        <div class="max-w-2xl mx-auto flex items-baseline justify-between mb-5 px-0">
          <div>
            <p style="font-size:10px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#f5b14a;margin-bottom:6px;">⚡ Time sensitive</p>
            <h2 style="margin:0;font-size:clamp(22px,4vw,32px);font-weight:800;letter-spacing:-0.03em;color:var(--text-primary);">Closing this week</h2>
          </div>
          <a href="/scholarships" class="text-sm text-secondary hover:text-primary transition-colors flex items-center gap-1">View all →</a>
        </div>

        <!-- Horizontal scroll on mobile, stacked on desktop -->
        <div id="closing-soon-list" class="flex md:flex-col gap-3 overflow-x-auto md:overflow-x-visible pb-3 md:pb-0 max-w-2xl mx-auto" style="scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none;">
          {closingSoon.map(s => {
            return (
              <a
                href={`/scholarships/${generateSlug(s.title)}`}
                class="card card-interactive flex items-center justify-between gap-4 px-4 py-3.5 flex-shrink-0 md:flex-shrink"
                style="min-width:280px;scroll-snap-align:start;padding-left:18px;position:relative;"
                data-deadline={s.deadline}
              >
                <div style="position:absolute;left:0;top:12px;bottom:12px;width:3px;border-radius:0 2px 2px 0;background:#f5b14a;box-shadow:0 0 8px rgba(245,177,74,0.4);" aria-hidden="true"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-primary truncate">{s.title}</p>
                  {s.audience && <p class="text-xs text-tertiary mt-0.5 truncate">{s.audience}</p>}
                </div>
                <div class="flex items-center gap-3 flex-shrink-0">
                  <p class="text-sm font-bold text-brand" style="font-variant-numeric:tabular-nums;">{s.amount}</p>
                  <span class="closing-soon-badge text-xs font-semibold px-2.5 py-1 rounded-full border bg-amber-400/10 text-amber-400 border-amber-400/25">
                    &hellip;
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <!-- Stats — large tabular numbers with teal line dividers -->
    <div class="max-w-2xl mx-auto mt-16 md:mt-20 pt-10" style="border-top:1px solid var(--border-subtle);">
      <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-8 text-center md:text-left">By the numbers</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {[
          { v: `${scholarshipCount}+`, l: 'Scholarships tracked' },
          { v: researchCount.toString(), l: 'Research programs' },
          { v: 'Free', l: 'Always — no ads, no fees' },
          { v: '0', l: 'Data collected' },
        ].map(stat => (
          <div style="position:relative;padding-top:16px;">
            <div style="position:absolute;top:0;left:0;right:20%;height:2px;background:linear-gradient(90deg,var(--brand),transparent);border-radius:2px;" aria-hidden="true"></div>
            <span style="display:block;font-size:clamp(32px,5vw,52px);font-weight:800;letter-spacing:-0.04em;color:var(--text-primary);line-height:1;font-variant-numeric:tabular-nums;">{stat.v}</span>
            <span style="display:block;margin-top:6px;font-size:13px;color:var(--text-secondary);letter-spacing:-0.01em;">{stat.l}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Browse by field -->
    <div class="max-w-2xl mx-auto mt-16 md:mt-20">
      <h2 style="margin:0 0 16px;font-size:clamp(22px,4vw,32px);font-weight:800;letter-spacing:-0.03em;color:var(--text-primary);">Browse by field</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {[
          { name: 'STEM & Engineering', count: 'Science, tech, math, engineering', color: 'var(--brand)', href: '/scholarships' },
          { name: 'Humanities & Arts', count: 'English, history, music, fine arts', color: '#a78bfa', href: '/scholarships' },
          { name: 'Business & Econ', count: 'Commerce, accounting, finance', color: '#3b82f6', href: '/scholarships' },
          { name: 'Indigenous & Equity', count: 'Identity-based scholarships', color: '#f5b14a', href: '/scholarships' },
          { name: 'Need-based', count: 'Financial assistance awards', color: 'var(--brand)', href: '/scholarships' },
          { name: 'Research programs', count: `${researchCount} programs open`, color: '#a78bfa', href: '/programs' },
        ].map(f => (
          <a href={f.href} class="card card-interactive" style="padding:18px;text-decoration:none;display:block;">
            <div style={`width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,${f.color}26,${f.color}0d);border:1px solid ${f.color}33;display:flex;align-items:center;justify-content:center;margin-bottom:12px;color:${f.color};`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-4 9 4-9 4-9-4z"/><path d="M6 11v5c2 2 4 3 6 3s4-1 6-3v-5"/></svg>
            </div>
            <p style="font-size:14px;font-weight:600;letter-spacing:-0.015em;color:var(--text-primary);margin-bottom:3px;">{f.name}</p>
            <p style="font-size:11px;color:var(--text-secondary);">{f.count}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- How it works -->
    <div class="max-w-2xl mx-auto mt-16 md:mt-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-6 text-center md:text-left">How it works</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="flex flex-col gap-2">
          <span class="font-bold text-2xl text-brand" style="font-variant-numeric:tabular-nums;">01</span>
          <p class="font-semibold text-sm text-primary">Browse</p>
          <p class="text-sm text-secondary">Browse scholarships and research programs across Alberta</p>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-bold text-2xl text-brand" style="font-variant-numeric:tabular-nums;">02</span>
          <p class="font-semibold text-sm text-primary">Filter</p>
          <p class="text-sm text-secondary">Filter by region, category, or deadline to find what fits you</p>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-bold text-2xl text-brand" style="font-variant-numeric:tabular-nums;">03</span>
          <p class="font-semibold text-sm text-primary">Apply</p>
          <p class="text-sm text-secondary">Click Apply Now and go straight to the official application</p>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
  function startCounter() {
    const el = document.getElementById('hero-amount');
    if (!el) return;
    const target = parseInt((el as HTMLElement).dataset.target ?? '0', 10);
    if (!target) return;

    const final = target.toLocaleString('en-CA');

    if (sessionStorage.getItem('hero-animated')) {
      el.textContent = final;
      return;
    }

    sessionStorage.setItem('hero-animated', '1');
    const duration = 2200;
    const startTime = performance.now();

    function step(now: number) {
      const t = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 4);
      const value = Math.round(eased * target);
      el!.textContent = value.toLocaleString('en-CA');
      if (t < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }

  startCounter();
  document.addEventListener('astro:page-load', startCounter);

  function updateClosingSoon() {
    const list = document.getElementById('closing-soon-list');
    if (!list) return;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const todayMs = today.getTime();
    const cards = list.querySelectorAll<HTMLElement>('a[data-deadline]');
    let visible = 0;
    cards.forEach(card => {
      const deadline = card.dataset.deadline;
      if (!deadline) return;
      const deadlineMs = new Date(deadline + 'T00:00:00').getTime();
      if (deadlineMs < todayMs) {
        card.style.display = 'none';
        return;
      }
      visible++;
      const daysLeft = Math.round((deadlineMs - todayMs) / (1000 * 60 * 60 * 24));
      const urgency = daysLeft === 0 ? 'Today' : daysLeft === 1 ? '1 day left' : `${daysLeft} days left`;
      const badge = card.querySelector('.closing-soon-badge');
      if (badge) {
        badge.textContent = urgency;
        if (daysLeft <= 2) {
          badge.className = 'closing-soon-badge text-xs font-semibold px-2.5 py-1 rounded-full border bg-red-500/10 text-red-400 border-red-500/25';
        } else {
          badge.className = 'closing-soon-badge text-xs font-semibold px-2.5 py-1 rounded-full border bg-amber-400/10 text-amber-400 border-amber-400/25';
        }
      }
    });
    if (visible === 0) {
      const section = list.closest('.mt-14') as HTMLElement | null;
      if (section) section.style.display = 'none';
    }
  }

  updateClosingSoon();
  document.addEventListener('astro:page-load', updateClosingSoon);
</script>

<style>
  #closing-soon-list::-webkit-scrollbar { display: none; }
</style>
