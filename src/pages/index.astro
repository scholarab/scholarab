---
import { todayDate as albertaToday } from '../lib/calendar';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import SabFooter from '../components/sab/SabFooter.astro';
import { loadScholarships, loadPrograms } from '../lib/data-loader';
import { generateSlug, parseAmount } from '../lib/utils';
import { CLOSING_SOON_MS } from '../lib/constants';
import { programIsListed, programStatusOf, scholarshipStatusOf } from '../lib/status';
import { SCHOLARSHIP_FACETS, PROGRAM_FORMATS, MENU_SCOPES, MIN_FACET_ITEMS, facetForCategory, facetItems } from '../lib/facets';
import { PHOTO_CREDITS, needsCredit } from '../lib/photo-credits';
import { TEASER_KEYS, teaserOptions } from '../lib/quiz';

const scholarships = await loadScholarships();
const programs = await loadPrograms();

const today = albertaToday();

// The directory's own definition of open, not a copy of it: this page kept
// its own ladder, so a concluded award or a rolled-forward date could count
// here as "open right now" while the directory said otherwise.
const activeScholarships = scholarships.filter(s => scholarshipStatusOf(s, today) === 'active');
const activeTotal = activeScholarships.reduce((sum, s) => sum + parseAmount(s.amount), 0);
// Retired programs (active: false) are out of the directory, so they must be
// out of this total too; otherwise the hero promises more than /programs shows.
const researchCount = programs.filter(p => programIsListed(p, today)).length;

const scholarshipCount = scholarships.length;

// The next five deadlines, NOT the deadlines inside a fixed window. The window
// version (deadline <= today + CLOSING_SOON_MS) rendered nothing at all between
// cycles: on 22 Aug 2026 exactly one of the 39 active awards fell inside seven
// days, and for most of August none did. The section then disappeared, and
// SabFooter links every page on the site at /#closing, so the whole site
// carried a dead anchor for the part of the year counsellors start looking.
//
// CLOSING_SOON_MS still decides the urgency badge on each row, which is where
// "this week" actually belongs; it just no longer decides whether the section
// exists.
const closingSoon = activeScholarships
  .filter(s => s.deadline)
  .sort((a, b) => new Date(a.deadline! + 'T00:00:00').getTime() - new Date(b.deadline! + 'T00:00:00').getTime())
  .slice(0, 5);

// The heading follows the list rather than asserting urgency it may not have:
// "Closing this week" over a row due in November is a claim the page can't keep.
const anyClosingThisWeek = closingSoon.some(
  s => new Date(s.deadline! + 'T00:00:00').getTime() <= today.getTime() + CLOSING_SOON_MS,
);
const closingHeading = anyClosingThisWeek ? 'Closing this week' : 'Next deadlines';

// The biggest awards a student can apply for today, in the directory's own
// "Highest $" order (first dollar figure, so "$2,000 to $7,000" ranks at
// $2,000). A Reddit reviewer's note: the top of the catalogue was behind a
// click and a sort, and the homepage led only with whatever closed next.
// "Varies" has no number to rank, so it stays out rather than sorting last.
const biggestOpen = activeScholarships
  .filter(s => parseAmount(s.amount) > 0)
  .sort((a, b) =>
    parseAmount(b.amount) - parseAmount(a.amount) ||
    (a.deadline ?? '9999').localeCompare(b.deadline ?? '9999'))
  .slice(0, 5);
const closingEyebrow = anyClosingThisWeek ? 'TIME-SENSITIVE' : 'UPCOMING';

// Categories: real counts from the data, top 8 types
const categoryCounts = new Map<string, number>();
for (const s of scholarships) {
  if (s.category) categoryCounts.set(s.category, (categoryCounts.get(s.category) ?? 0) + 1);
}
const CATEGORY_DESCS: Record<string, string> = {
  'Academic':   'Merit, entrance, and general academic awards.',
  'Community':  'Volunteering hours that actually pay off.',
  'Arts':       'Portfolios, performances, film, and writing.',
  'STEM':       'Science fairs, labs, and research awards.',
  'Trades':     'Apprenticeships, RAP, and skilled-trade awards.',
  'Indigenous': 'Awards for First Nations, Métis, and Inuit students.',
  'Sports':     'For athletes at every level, not just varsity.',
  'General':    'Open eligibility, no niche required.',
};
// Each card points at its hub where one exists. Academic (56 listings) and
// General deliberately have none -- a hub that big would compete with
// /scholarships for the same queries -- so those keep the query-string filter,
// which is still a working page, just not a landing one.
const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([name, count]) => {
    const facet = facetForCategory(name, SCHOLARSHIP_FACETS);
    return {
      name,
      count,
      desc: CATEGORY_DESCS[name] ?? 'Awards for Alberta high school students.',
      href: facet ? `/scholarships/${facet.slug}/` : `/scholarships/?category=${encodeURIComponent(name)}`,
    };
  });

// The homepage has never linked into geo content, which is the half of the
// directory the city queries are looking for. Counts come from the data so a
// card can't advertise a number the hub doesn't show.
const cityFacets = SCHOLARSHIP_FACETS.filter(f => f.kind === 'region').map(f => ({
  slug: f.slug,
  label: f.label,
  // facetItems, not `region ===`: the hub, the header tile and the directory
  // chip all count awards open to several towns (alsoOpenTo), so this row said
  // Medicine Hat 20 beside a header tile saying 22 on the same page.
  count: facetItems(f, scholarships).length,
}));

// The scope carousel under the hero (Ilia, 2026-09-22, after tesla.com's
// model cards): one big photo card per header-menu scope (MENU_SCOPES), biggest
// first. Every scope has a photo since 2026-09-23, so the menu list is what
// keeps this at ten cards rather than twenty-five. Counts are the hub's own
// (facetItems), the same numbers the header tiles show. A CC BY or CC BY-SA
// photo carries its credit on the card (photo-credits.ts).
const SCOPE_KICKERS: Record<string, string> = {
  alberta: 'Anywhere in Alberta',
  national: 'Open across Canada',
};
interface PhotoCard {
  label: string; kicker: string; backdrop: string; href: string; count: number;
  /** The open count, and where it links; null href when the hub has no open filter. */
  open: number; openHref: string | null;
  credit: (typeof PHOTO_CREDITS)[string] | undefined;
}
const scopeCards: PhotoCard[] = SCHOLARSHIP_FACETS
  .filter(f => MENU_SCOPES.includes(f.slug) && f.backdrop)
  .map(f => {
    const items = facetItems(f, scholarships);
    const href = `/scholarships/${f.slug}/`;
    return {
      label: f.label,
      backdrop: f.backdrop!,
      kicker: SCOPE_KICKERS[f.slug] ?? `${f.label} students`,
      href,
      count: items.length,
      open: items.filter(s => scholarshipStatusOf(s, today) === 'active').length,
      openHref: `${href}?status=active`,
      credit: PHOTO_CREDITS[f.backdrop!],
    };
  })
  .sort((a, b) => b.count - a.count);

// The program twin (Ilia, 2026-09-23): one card per format hub, the same eight
// the header's Programs tiles show, biggest first. The kickers are each hub's
// own intro cut to a line. "Open" counts dated deadlines still ahead plus
// rolling ones; the program directory has no status filter, so it is not a link.
const FORMAT_KICKERS: Record<string, string> = {
  'summer-programs': 'Camps, institutes and labs',
  competitions: 'Built over a season, entered as a team',
  olympiads: 'Written at your own school',
  'science-fairs': 'The only door to Canada-Wide',
  'research-placements': 'A piece of work with your name on it',
  'dual-credit': 'Paid, credited, or both',
  clubs: 'Start any week of the year',
  conferences: 'A few days, some funded down to the flight',
};
const listedPrograms = programs.filter(p => programIsListed(p, today));
const formatCards: PhotoCard[] = PROGRAM_FORMATS
  .filter(f => f.backdrop)
  .map(f => ({ f, items: facetItems(f, listedPrograms) }))
  .filter(({ items }) => items.length >= MIN_FACET_ITEMS)
  .map(({ f, items }) => ({
    label: f.label === 'Summer' ? 'Summer programs' : f.label,
    backdrop: f.backdrop!,
    kicker: FORMAT_KICKERS[f.slug] ?? f.h1,
    href: `/programs/${f.slug}/`,
    count: items.length,
    open: items.filter(p => ['active', 'ongoing'].includes(programStatusOf(p, today))).length,
    openHref: null,
    credit: PHOTO_CREDITS[f.backdrop!],
  }))
  .sort((a, b) => b.count - a.count);

const carousels = [
  { key: 'scholarships', title: 'Scholarships by where you live', noun: 'scholarships', none: 'Opening later this year', cards: scopeCards },
  // A program with nothing open is waiting on next cycle's dates (summer
  // programs close in February), which "later this year" would misstate.
  { key: 'programs', title: 'Programs by format', noun: 'programs', none: 'Next dates not posted yet', cards: formatCards },
].filter(c => c.cards.length > 0);

// Seed the same grade/city/field answers consumed by the legacy quiz.
const legacyLabels: Record<string, string> = {
  grade: 'YOUR GRADE', city: 'YOUR REGION', field: "YOU'RE INTO",
};
const matchGroups = TEASER_KEYS.map(key => ({ key, label: legacyLabels[key]!, opts: teaserOptions(key) }));
---

<Layout
  title="Free Alberta High School Scholarships | ScholarAB"
  description={`Browse ${scholarshipCount}+ free scholarships and research programs for Alberta high school students. No login, no ads, no data collection. Updated for the 2026-27 cycle.`}
  ogTitle="Free Alberta High School Scholarships | ScholarAB"
  ogDescription={`Browse ${scholarshipCount}+ free scholarships and research programs for Alberta high school students. No login, no ads, no data collection. Updated for the 2026-27 cycle.`}
  ogUrl="https://www.scholarab.ca/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.scholarab.ca/#organization",
        "name": "ScholarAB",
        "alternateName": ["ScholarAB.ca", "scholarab"],
        "url": "https://www.scholarab.ca",
        "logo": "https://www.scholarab.ca/icon-512.png",
        "description": "Free Alberta scholarship and research program directory for high school students.",
        "areaServed": { "@type": "AdministrativeArea", "name": "Alberta, Canada" },
        "founder": {
          "@type": "Person",
          // Carries an @id so /about/ can describe the same person rather than
          // declaring a second, unrelated Person with the same name.
          "@id": "https://www.scholarab.ca/#founder",
          "name": "Ilia Ivanov",
          "sameAs": "https://www.linkedin.com/in/iliaivanov/",
        },
        "sameAs": [
          "https://www.instagram.com/scholarab.ca",
          "https://www.tiktok.com/@scholarab",
        ],
      },
      {
        "@type": "WebSite",
        "@id": "https://www.scholarab.ca/#website",
        "name": "ScholarAB",
        "alternateName": ["scholarab"],
        "url": "https://www.scholarab.ca",
        "description": "Free Alberta scholarship and research program directory for high school students.",
        "publisher": { "@id": "https://www.scholarab.ca/#organization" },
        "inLanguage": "en-CA",
      },
    ],
  })} slot="head" />
  <SabFonts slot="head" />
  {/* The poster is the phone LCP and a CSS background, so the browser only
      found it after the stylesheet: 2.5 s on a throttled 4G run. Phones get
      the same 720x1080 centre crop as the `.m` clips, at under half the bytes. */}
  <link rel="preload" as="image" href="/video/hero/poster.webp" media="(min-width: 901px)" fetchpriority="high" slot="head" />
  <link rel="preload" as="image" href="/video/hero/poster.m.webp" media="(max-width: 900px)" fetchpriority="high" slot="head" />

  {/* The header is the page's banner and cannot sit inside <main>; it used to
      be the hero's first flex child. Same dark background either side, so the
      band still reads as one, but the hero no longer contains the height it
      has to subtract, hence the calc below. */}
  <div class="sab-hero-band" slot="header">
    <SabHeader currentPath="/" />
  </div>

  <div id="sab-home">

    <!-- ============ DARK HERO ============ -->
    <div class="sab-hero">
      {/* Background film: twelve Pexels clips crossfading in a loop, under
          the solid header. The still is the first clip's first frame and is
          all that shows on phones, with reduced motion, or with Save-Data on. */}
      <div class="sab-hero-media" aria-hidden="true">
        <video class="sab-hero-vid" muted playsinline preload="none"></video>
        <video class="sab-hero-vid" muted playsinline preload="none"></video>
      </div>
      <!-- hero body -->
      <div class="sab-container sab-hero-body">
        <div class="sab-kicker">BUILT BY A HIGH SCHOOL STUDENT FROM MEDICINE HAT<span class="sab-kicker-sep" aria-hidden="true">·</span><a href="/about/" class="sab-kicker-link">READ THE STORY</a></div>

        <h1 class="sab-h1"><span class="sab-h1-l sab-h1-l1">Making scholarships and programs</span> <span class="sab-h1-l sab-h1-l2">easier to find for Alberta students</span></h1>

        <div class="sab-hero-bottom">
          <div class="sab-hero-copy">
            <p>
              ScholarAB tracks scholarships and research programs for Alberta high school students.<span class="sab-hero-p-tail"> Finally one place with all the information.</span>
            </p>
            <div class="sab-hero-ctas">
              <a href="/scholarships/" class="sab-btn-accent">
                Browse {scholarshipCount.toLocaleString('en-CA')} scholarships
              </a>
              <a href="/programs/" class="sab-btn-outline">
                Explore programs
              </a>
            </div>
          </div>

          <!-- stat block, ledger style -->
          <div class="sab-stats">
            <div class="sab-stat">
              <div class="sab-stat-value tnum"><span id="hero-amount-count" data-total={activeTotal}>${activeTotal.toLocaleString('en-CA')}</span></div>
              <div class="sab-stat-label sab-mono">OPEN RIGHT NOW</div>
            </div>
            <div class="sab-stat">
              <div class="sab-stat-value tnum">{scholarshipCount.toLocaleString('en-CA')}</div>
              <div class="sab-stat-label sab-mono">SCHOLARSHIPS</div>
            </div>
            <div class="sab-stat">
              <div class="sab-stat-value tnum">{researchCount}</div>
              <div class="sab-stat-label sab-mono">RESEARCH PROGRAMS</div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- ============ PHOTO CAROUSELS (scholarship scopes, then program formats) ============ -->
    {carousels.map(k => (
      <section class="sab-scopes" aria-labelledby={`sab-scopes-h-${k.key}`} data-scopes={k.key}>
        <h2 id={`sab-scopes-h-${k.key}`} class="sr-only">{k.title}</h2>
        <div class="sab-scopes-track" data-scopes-track tabindex="-1">
          {k.cards.map(c => (
            <article class="sab-scope" aria-label={`${c.label}: ${c.count} ${k.noun}`} data-scope-card>
              <picture>
                <source media="(max-width: 700px)" srcset={`/photos/backdrops/${c.backdrop}-tall-1000.webp 1000w, /photos/backdrops/${c.backdrop}-tall-2000.webp 2000w`} sizes="88vw" />
                <img
                  class="sab-scope-img"
                  src={`/photos/backdrops/${c.backdrop}-wide-1672.webp`}
                  srcset={`/photos/backdrops/${c.backdrop}-wide-1672.webp 1672w, /photos/backdrops/${c.backdrop}-wide-3344.webp 3344w`}
                  sizes="74vw" alt="" loading="lazy" decoding="async"
                />
              </picture>
              <div class="sab-scope-body">
                <div class="sab-scope-kicker">{c.kicker}</div>
                <div class="sab-scope-bottom">
                  <h3 class="sab-scope-name">{c.label}</h3>
                  {c.open > 0 && c.openHref
                    ? <a href={c.openHref} class="sab-scope-sub">{c.open.toLocaleString('en-CA')} open right now</a>
                    : <span class="sab-scope-sub sab-scope-sub-plain">{c.open > 0 ? `${c.open.toLocaleString('en-CA')} open right now` : k.none}</span>}
                  <div class="sab-scope-ctas">
                    <a href={c.href} class="sab-scope-btn sab-scope-btn-solid">
                      See all {c.count.toLocaleString('en-CA')}
                    </a>
                    <a href="/match/" class="sab-scope-btn sab-scope-btn-light">Find my match</a>
                  </div>
                </div>
              </div>
              {c.credit && needsCredit(c.credit) && (
                <a class="sab-scope-credit" href={c.credit.sourceUrl} target="_blank" rel="noopener noreferrer">
                  Photo: {c.credit.author}, {c.credit.license}
                </a>
              )}
            </article>
          ))}
        </div>
        <button type="button" class="sab-scopes-arrow sab-scopes-prev" data-scopes-prev aria-label="Previous" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="sab-scopes-arrow sab-scopes-next" data-scopes-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="sab-scopes-dots" data-scopes-dots>
          {k.cards.map((c, i) => (
            <button type="button" class="sab-scopes-dot" aria-label={`Show ${c.label}`} aria-current={i === 0 ? 'true' : undefined}></button>
          ))}
        </div>
      </section>
    ))}

    <!-- ============ CLOSING THIS WEEK ============ -->
    {closingSoon.length > 0 && (
      <div class="sab-container sab-closing" id="closing" data-closing-section>
        <div class="sab-section-head">
          <div>
            <div class="sab-mono sab-eyebrow-urgent">{closingEyebrow}</div>
            <h2 class="sab-h2">{closingHeading}</h2>
          </div>
          <a href="/deadlines/" class="sab-view-all">View all deadlines</a>
        </div>

        <div class="sab-closing-table" id="closing-soon-list" data-deadline-list>
          {closingSoon.map((s, i) => (
            <a href={`/scholarships/${generateSlug(s.title)}/`} class="sab-closing-row" data-deadline={s.deadline}>
              <div class="sab-row-num sab-mono">{String(i + 1).padStart(2, '0')}</div>
              <div class="sab-row-main">
                <div class="sab-row-name">{s.title}</div>
                {s.audience && <div class="sab-row-blurb">{s.audience}</div>}
              </div>
              <div class="sab-row-amount tnum">{s.amount}</div>
              <div class="sab-row-when"><span class="sabl-when" data-when><span data-when-main>&hellip;</span><span class="sabl-when-sub" data-when-sub hidden></span></span></div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ============ BIGGEST OPEN AWARDS ============ -->
    {biggestOpen.length > 0 && (
      <div class="sab-container sab-closing sab-biggest" data-closing-section>
        <div class="sab-section-head">
          <div>
            <div class="sab-mono sab-eyebrow-money">HIGHEST VALUE</div>
            <h2 class="sab-h2">Biggest awards open now</h2>
          </div>
          <a href="/scholarships/?sort=highest_pay" class="sab-view-all">All by amount</a>
        </div>

        <div class="sab-closing-table" data-deadline-list>
          {biggestOpen.map((s, i) => (
            <a href={`/scholarships/${generateSlug(s.title)}/`} class="sab-closing-row" data-deadline={s.deadline}>
              <div class="sab-row-num sab-mono">{String(i + 1).padStart(2, '0')}</div>
              <div class="sab-row-main">
                <div class="sab-row-name">{s.title}</div>
                {s.audience && <div class="sab-row-blurb">{s.audience}</div>}
              </div>
              <div class="sab-row-amount tnum">{s.amount}</div>
              <div class="sab-row-when"><span class="sabl-when" data-when><span data-when-main>&hellip;</span><span class="sabl-when-sub" data-when-sub hidden></span></span></div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ============ BROWSE BY CATEGORY ============ -->
    <div class="sab-cat-band">
      <div class="sab-container sab-cats">
        <div class="sab-section-head">
          <h2 class="sab-h2">Start where you are</h2>
          <span class="sab-mono sab-cats-meta">{scholarshipCount.toLocaleString('en-CA')} scholarships · {categories.length} types</span>
        </div>
        <div class="sab-cat-grid">
          {categories.map(c => (
            <a href={c.href} class="sab-cat-card">
              <div class="sab-cat-top">
                <span class="sab-cat-name">{c.name}</span>
                <span class="sab-cat-count sab-mono">{c.count}</span>
              </div>
              <div class="sab-cat-desc">{c.desc}</div>
            </a>
          ))}
        </div>

        <div class="sab-city-row">
          <span class="sab-mono sab-city-label">OR BY CITY</span>
          <div class="sab-city-chips">
            {cityFacets.map(c => (
              <a href={`/scholarships/${c.slug}/`} class="sab-city-chip">
                {c.label}<span class="sab-mono sab-city-count">{c.count}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ============ MATCH TEASER ============ -->
    <div class="sab-container sab-match">
      <div class="sab-match-grid">
        <div>
          <h2 class="sab-h2 sab-match-h2">Tell us three things and we'll shortlist for you</h2>
          <p class="sab-match-copy">
            Three picks here, a few more on the next page. No account, no email.
          </p>
        </div>
        <div class="sab-match-card" id="match-teaser" data-quiz-variant="legacy">
          {matchGroups.map(g => (
            <div class="sab-match-group" data-match-group={g.key}>
              <div class="sab-mono sab-match-label">{g.label}</div>
              <div class="sab-match-opts">
                {g.opts.map(o => (
                  <button type="button" class="sab-match-opt" data-value={o.value}>{o.label}</button>
                ))}
              </div>
            </div>
          ))}
          <button type="button" class="sab-match-cta" id="match-teaser-cta" disabled>Pick 3 more to see matches</button>
        </div>
      </div>
    </div>


  </div>

  <SabFooter slot="footer" />
</Layout>

<script>
  import { scholarshipWhen } from '../lib/list-core';
  import type { ScholarshipWithMeta } from '../lib/list-core';
  import { todayDate as albertaToday } from '../lib/calendar';
  import { QUIZ_STORAGE_KEY } from '../lib/quiz';
  import { sendEvent } from '../lib/events';

  // ── Deadline lines on the homepage rows (client-side so a stale static build never lies) ──
  // Both row lists (closing soon, biggest open) share the chips and the rule
  // that a row whose deadline has passed since the build drops out.
  function updateClosingSoon() {
    document.querySelectorAll<HTMLElement>('[data-deadline-list]').forEach(updateDeadlineList);
  }
  function updateDeadlineList(list: HTMLElement) {
    const today = albertaToday();
    const todayMs = today.getTime();
    const rows = list.querySelectorAll<HTMLElement>('.sab-closing-row');
    let visible = 0;
    rows.forEach(row => {
      const deadline = row.dataset.deadline ?? null;
      if (deadline && new Date(deadline + 'T00:00:00').getTime() < todayMs) {
        row.style.display = 'none';
        return;
      }
      visible++;
      // The directory's own deadline line (list-core), so a row reads the
      // same here as on the listing it links to. Every row here is open.
      const when = scholarshipWhen({ id: 0, deadline, openDate: null, active: true } as unknown as ScholarshipWithMeta);
      const el = row.querySelector<HTMLElement>('[data-when]');
      if (el) {
        el.className = when.cls;
        el.querySelector('[data-when-main]')!.textContent = when.main;
        const sub = el.querySelector<HTMLElement>('[data-when-sub]')!;
        sub.textContent = when.sub;
        sub.hidden = !when.sub;
      }
    });
    // Renumber the visible rows so hidden expired entries don't leave gaps
    let n = 0;
    rows.forEach(row => {
      if (row.style.display === 'none') return;
      const num = row.querySelector('.sab-row-num');
      if (num) num.textContent = String(++n).padStart(2, '0');
    });
    if (visible === 0) {
      const section = list.closest('[data-closing-section]') as HTMLElement | null;
      if (section) section.style.display = 'none';
    }
  }

  updateClosingSoon();
  document.addEventListener('astro:page-load', updateClosingSoon);

  // ── Scope carousel ──
  // Native horizontal scroll with snap does the swiping; this only wires the
  // arrows and dots to it and keeps them in step with wherever it rests.
  function initScopes() {
    document.querySelectorAll<HTMLElement>('[data-scopes]').forEach(initCarousel);
  }
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-scopes-track]');
    if (!track || root.dataset.init) return;
    root.dataset.init = '';
    const cards = [...track.querySelectorAll<HTMLElement>('[data-scope-card]')];
    const dots = [...root.querySelectorAll<HTMLElement>('.sab-scopes-dot')];
    const prev = root.querySelector<HTMLButtonElement>('[data-scopes-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-scopes-next]')!;
    const smooth: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const current = () => {
      const left = track.scrollLeft;
      let best = 0;
      cards.forEach((c, i) => { if (Math.abs(c.offsetLeft - track.offsetLeft - left) < Math.abs(cards[best]!.offsetLeft - track.offsetLeft - left)) best = i; });
      return best;
    };
    const go = (i: number) => {
      const c = cards[Math.max(0, Math.min(cards.length - 1, i))];
      if (c) track.scrollTo({ left: c.offsetLeft - track.offsetLeft - parseFloat(getComputedStyle(track).scrollPaddingLeft || '0'), behavior: smooth });
    };
    const sync = () => {
      const i = current();
      dots.forEach((d, j) => (j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      prev.hidden = track.scrollLeft < 4;
      next.hidden = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); }, { passive: true });
    sync();
  }
  document.addEventListener('astro:page-load', initScopes);

  // ── Hero amount count-up (kept from previous hero; final value is server-rendered) ──
  function animateHeroAmount() {
    const el = document.getElementById('hero-amount-count');
    if (!el || el.dataset.counted) return;
    el.dataset.counted = 'true';
    try {
      if (sessionStorage.getItem('sab_hero_counted')) return;
      sessionStorage.setItem('sab_hero_counted', '1');
    } catch { /* storage unavailable; animate anyway */ }
    const total = parseInt(el.dataset.total || '', 10);
    if (!Number.isFinite(total) || total <= 0) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const sameDigitFloor = Math.pow(10, String(total).length - 1);
    const start = Math.max(sameDigitFloor, Math.round(total * 0.35));
    const DURATION = 1100;
    let t0: number | null = null;
    let lastText = '';
    function tick(now: number) {
      if (t0 === null) t0 = now;
      const p = Math.min((now - t0) / DURATION, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      const text = '$' + Math.round(start + (total - start) * eased).toLocaleString('en-CA');
      if (text !== lastText) { el!.textContent = text; lastText = text; }
      if (p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  animateHeroAmount();
  document.addEventListener('astro:page-load', animateHeroAmount);

  // ── Match teaser: local chip picks, CTA goes to the real quiz ──
  function initMatchTeaser() {
    const card = document.getElementById('match-teaser');
    const cta = document.getElementById('match-teaser-cta');
    if (!card || !cta || card.dataset.init) return;
    card.dataset.init = 'true';

    const groups = Array.from(card.querySelectorAll<HTMLElement>('[data-match-group]'));
    const picked = () => {
      const answers: Record<string, string> = {};
      for (const g of groups) {
        const on = g.querySelector<HTMLElement>('.sab-match-opt.on');
        const key = g.dataset.matchGroup;
        if (on && key) answers[key] = on.dataset.value ?? '';
      }
      return answers;
    };
    const update = () => {
      const chosen = Object.keys(picked()).length;
      const ready = chosen === groups.length;
      cta.textContent = ready ? 'Keep going →' : `Pick ${groups.length - chosen} more to see matches`;
      // The button navigates, until all three are picked there is nothing to
      // navigate *with*, so it stays genuinely inert rather than just labelled
      // as if it were.
      (cta as HTMLButtonElement).disabled = !ready;
    };
    groups.forEach(g => {
      g.querySelectorAll<HTMLElement>('.sab-match-opt').forEach(btn => {
        btn.addEventListener('click', () => {
          const wasOn = btn.classList.contains('on');
          g.querySelectorAll('.sab-match-opt').forEach(b => b.classList.remove('on'));
          if (!wasOn) btn.classList.add('on');
          update();
        });
      });
    });
    cta.addEventListener('click', () => {
      if ((cta as HTMLButtonElement).disabled) return;
      // Resume the quiz with the grade/city/field picks and both opportunity types.
      const answers = { searchType: 'both', ...picked() };
      try {
        sessionStorage.removeItem('scholarab_matching_v1'); // Explicit new teaser picks replace a prior quiz session.
        sessionStorage.setItem(QUIZ_STORAGE_KEY, JSON.stringify({ step: 4, answers, savedAt: Date.now() }));
      } catch { /* private mode: the quiz just starts from question 1 */ }
      // The teaser skips question 1, where the quiz normally counts its start.
      sendEvent('quiz_start');
      window.location.assign('/match/');
    });
    update();
  }

  initMatchTeaser();
  document.addEventListener('astro:page-load', initMatchTeaser);

  // ── Hero film: two <video> elements take turns so the next clip is already
  // buffered when the current one starts fading out. The next clip is fetched
  // PREFETCH_S before the handoff, not at page load: loading both up front
  // pulled 13.2 MB on a desktop first visit (two 6-7 MB takes) for a film most
  // visitors scroll past before the first cut.
  // Twelve 12-second takes, no timelapses (they step, and read as stutter).
  // Each clip ships as H.265 (what SpaceX serves: about half the bits of
  // H.264 for the same picture) and as H.264 for browsers without H.265.
  // Phones get a `.m` cut: the hero box is portrait there (375x563 on a 390pt
  // phone), so object-fit already threw away most of a 1920-wide frame's
  // width. The mobile file is that same centre crop encoded at 720x1080,
  // which is about a quarter of the bytes for the picture a phone shows.
  // The film was off on phones entirely until 2026-09-19; it looked stopped.
  const HERO_CLIPS = ['01','18','12','04','17','16','20','08','13','06','10','07'];
  const FADE_S = 1.5;
  const PREFETCH_S = 6;
  function initHeroFilm() {
    const media = document.querySelector<HTMLElement>('.sab-hero-media');
    if (!media || media.dataset.init) return;
    media.dataset.init = '1';
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    // A 2G connection would spend the visit downloading a background.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
    const [a, b] = media.querySelectorAll<HTMLVideoElement>('video');
    if (!a || !b) return;
    const vids = [a, b];
    let i = 0;
    let cur = 0;
    const cut = matchMedia('(max-width: 900px)').matches ? '.m' : '';
    let ext = a.canPlayType('video/mp4; codecs="hvc1.1.6.L120.90"') ? '.hevc.mp4' : '.mp4';
    const src = (n: number) => `/video/hero/${HERO_CLIPS[n % HERO_CLIPS.length]}${cut}${ext}`;
    const load = (v: HTMLVideoElement, n: number) => { v.preload = 'auto'; v.src = src(n); v.load(); };
    // Held while a header dropdown is open: the blur over the page would
    // otherwise be recomputed for every frame of the film (see SabHeader).
    let held = false;
    // A rejected play() leaves the poster up and the film reads as stopped
    // rather than absent, so a refusal is retried once the clip is decodable
    // and again on the visitor's first touch. iOS refuses the first call while
    // the clip is still arriving, and refuses every call in Low Power Mode,
    // where the poster is the honest end state.
    const start = (v: HTMLVideoElement) => {
      if (v.currentTime) v.currentTime = 0;
      if (held) return;
      v.play().then(() => v.classList.add('is-on')).catch(() => {
        if (v !== vids[cur]) return;
        // An open dropdown pausing a play() still in flight rejects it too, so
        // the retry has to respect the hold or it restarts the film under the blur.
        const again = () => {
          if (held || v !== vids[cur] || !v.paused) return;
          v.play().then(() => v.classList.add('is-on')).catch(() => {});
        };
        v.addEventListener('canplay', again, { once: true });
        addEventListener('touchstart', again, { once: true, passive: true });
        addEventListener('pointerdown', again, { once: true });
      });
    };
    // A browser can claim H.265 and still fail to decode it (no hardware
    // decoder). Fall back to H.264 for the rest of the visit.
    vids.forEach(v => v.addEventListener('error', () => {
      if (ext === '.mp4') return;
      ext = '.mp4';
      v.src = v.src.replace('.hevc.mp4', '.mp4');
      v.load();
      if (v === vids[cur]) start(v);
    }));
    let queued = 0; // index of the furthest clip already requested
    vids.forEach(v => v.addEventListener('timeupdate', () => {
      if (v !== vids[cur] || !v.duration || v.dataset.handed) return;
      if (queued === i && v.currentTime >= v.duration - FADE_S - PREFETCH_S) {
        queued = i + 1;
        load(vids[1 - cur]!, i + 1);
      }
      if (v.currentTime < v.duration - FADE_S) return;
      v.dataset.handed = '1';
      const next = vids[1 - cur]!;
      start(next);
      v.classList.remove('is-on');
      cur = 1 - cur;
      i++;
      setTimeout(() => { v.pause(); delete v.dataset.handed; }, FADE_S * 1000);
    }));
    // Backgrounding the tab pauses the clip, and nothing resumes it on the way
    // back: the film sits on a still frame and reads as broken. Phones hit this
    // constantly, since every app switch hides the page.
    // Both listeners live on the document, which outlasts this page under the
    // ClientRouter; once the film is swapped out they must not touch it.
    document.addEventListener('sab:menu', e => {
      if (!media.isConnected) return;
      held = (e as CustomEvent<{ open: boolean }>).detail.open;
      if (held) vids.forEach(v => v.pause());
      else if (vids[cur]!.src) vids[cur]!.play().then(() => vids[cur]!.classList.add('is-on')).catch(() => {});
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden || held || !media.isConnected) return;
      const v = vids[cur]!;
      if (v.paused && v.src) v.play().then(() => v.classList.add('is-on')).catch(() => {});
    });
    load(a, 0);
    start(a);
  }
  // After the page has loaded and gone idle, so the first clip (2.7 to 3.2 MB
  // on a desktop) never competes with the poster, fonts or first paint. The
  // poster is the same frame, so the late start is invisible.
  function startHeroFilmLater() {
    const go = () => ('requestIdleCallback' in window
      ? requestIdleCallback(initHeroFilm, { timeout: 2000 })
      : setTimeout(initHeroFilm, 200));
    if (document.readyState === 'complete') go();
    else addEventListener('load', go, { once: true });
  }
  startHeroFilmLater();
  document.addEventListener('astro:page-load', startHeroFilmLater);
</script>

<style is:global>
  /* The home design is fixed light regardless of site theme */
  body:has(#sab-home) { background: var(--bg-page); }
</style>

<style>
  /* ════ ScholarAB Home · claude.ai/design "ScholarAB Home.dc.html" ════
     Palette: canvas var(--bg-page) (white since 2026-09-22) · alt band #F2F3F5 · ink #141915 · hero/footer #08120E
     accent #2FD3A0 · accent hover #4FE0B4 · accent-on-dark text #5CE3BB
     green #0A6B4D (pressed #08573E) · hard shadows on cream #0E8C64
     ink-on-accent #08120E · urgency #A0491A
     Tuned 2026-09-02: mint stays the accent, but it no longer doubles as the
     drop shadow on cream, where 1.8:1 against the card made the lift read as
     a smudge. Deep green carries the shadows and the primary action on light
     surfaces; mint keeps the dark ones.
     Type: see --font-display / --font-body / --font-label in global.css */

  #sab-home {
    background: var(--bg-page);
    color: #141915;
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  #sab-home ::selection { background: #2FD3A0; color: #08120E; }
  .sab-mono { font-family: var(--font-label); }
  /* Full window width with the header's own gutter, so every section lines
     up with the logo and nothing sits in a centred column with bare margins
     either side (Ilia, 2026-09-18). */
  .sab-container { width: 100%; box-sizing: border-box; padding-left: clamp(20px, 4vw, 56px); padding-right: clamp(20px, 4vw, 56px); }

  @keyframes sab-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes sab-pop { 0% { transform: scale(0.94); } 60% { transform: scale(1.05); } 100% { transform: scale(1); } }

  /* ── Dark hero ── */
  /* Fills the first viewport so no canvas sliver peeks below the fold on
     tall/fullscreen windows; on short viewports it grows past 100svh. */
  /* Solid, the same #0A1310 as the Scholarships and Programs dropdowns, so
     an open menu sits on one continuous black panel instead of on the film. */
  .sab-hero-band { position: relative; z-index: 2; background: #0A1310; color: #EEF1EC; }
  .sab-hero {
    background: #0A1310; color: #EEF1EC; position: relative; isolation: isolate;
    overflow: hidden;
    display: flex; flex-direction: column;
    /* The header used to be inside this box and counted toward the fold. Now
       it sits above, so its height comes off the target instead. */
    min-height: calc(100vh - var(--sab-nav-h));
    min-height: calc(100svh - var(--sab-nav-h));
  }

  .sab-hero-media {
    position: absolute; z-index: -1; inset: 0;
    background: #0A1310 url('/video/hero/poster.webp') center / cover no-repeat;
  }
  .sab-hero-vid {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity 1.2s ease;
  }
  .sab-hero-vid.is-on { opacity: 1; }
  /* The film runs near full strength, so the words carry their own soft
     shadow instead of the whole picture being dimmed: it only matters over
     bright frames (snow, sky) and is invisible over dark ones. */
  .sab-hero .sab-h1 { text-shadow: 0 2px 30px rgba(5,10,8,0.45), 0 1px 3px rgba(5,10,8,0.3); }
  .sab-hero .sab-kicker, .sab-hero-copy p, .sab-stats { text-shadow: 0 1px 14px rgba(5,10,8,0.75), 0 1px 2px rgba(5,10,8,0.6); }
  /* The kicker is mint, nearly as light as the sky it crosses on a phone, so
     it gets a tight halo as well: the wide one alone measured 3.2:1 at its
     worst glyph pixels over the bright poster frame. */
  .sab-hero .sab-kicker { text-shadow: 0 0 6px rgba(5,10,8,0.85), 0 1px 14px rgba(5,10,8,0.75), 0 1px 2px rgba(5,10,8,0.6); }
  /* SpaceX-style scrim: the picture stays close to full strength and only
     the places text sits are darkened. A light veil over everything, a band
     under the nav, and a fall-off to near black behind the copy, buttons and
     numbers at the bottom. */
  .sab-hero-media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10,19,16,0.35) 0, rgba(10,19,16,0) 120px),
      linear-gradient(180deg, rgba(10,19,16,0) 45%, rgba(10,19,16,0.55) 75%, rgba(10,19,16,0.9) 100%),
      rgba(10,19,16,0.28);
  }

  /* The kicker names who built the site and hands off to /about for the rest. */
  .sab-hero .sab-kicker { font-size: 16px; flex-wrap: wrap; row-gap: 4px; }
  .sab-hero .sab-kicker::before { content: none; }
  .sab-kicker-sep { opacity: 0.45; }
  .sab-kicker-link { color: #EEF1EC; text-decoration: none; border-bottom: 1px solid rgba(238, 241, 236, 0.35); padding-top: 12px; margin-top: -12px; display: inline-block; }
  .sab-kicker-link:hover { border-bottom-color: #2FD3A0; color: #2FD3A0; }
  .sab-hero-body {
    padding-top: 76px; position: relative;
    /* Center the copy in the space left under the header */
    flex: 1; display: flex; flex-direction: column; justify-content: center;
    width: 100%; box-sizing: border-box;
  }

  /* Two fixed lines on desktop (2026-09-18). With three, the gap at the left
     edge changed from line to line with whichever words opened it: "p" hung
     over "f" while "M" sat well clear of "p", so identical leading read as
     sloppy. Two lines have one gap. Both lines are nearly the same length
     (12.96em and 12.68em of Big Shoulders), so the size is the width of
     the hero divided by the first line: the block fills the row at any
     desktop window instead of wrapping at some widths and not others.
     Line height 1.1 leaves 0.08em between descenders and the ascenders
     below. Tracking 0 is the face's designed spacing, the word space trims
     0.03em because a condensed face's default space reads as a gap, and each
     line is pulled left by its first letter's side-bearing (M 0.043em, e
     0.0355em) so both stems sit exactly on the kicker's and paragraph's
     edge. */
  .sab-hero-body { container-type: inline-size; }
  .sab-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: min(168px, calc(100cqi / 13)); line-height: 1.1; letter-spacing: 0; word-spacing: -0.03em;
    margin: 0;
    animation: sab-rise 0.7s ease both;
  }
  .sab-h1-l { display: block; white-space: nowrap; }
  .sab-h1-l1 { margin-left: -0.043em; }
  .sab-h1-l2 { margin-left: -0.0355em; }

  .sab-hero-bottom {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 40px; margin-top: 52px; padding-bottom: 64px;
  }
  .sab-hero-copy { max-width: 460px; }
  .sab-hero-copy p { font-size: 18px; line-height: 1.55; color: rgba(238, 241, 236, 0.8); margin: 0 0 30px; }
  .sab-hero-ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  /* One pair, one size, one motion: hover only changes colour. The lift onto a
     hard shadow and the press snap were three effects on two buttons, and the
     outline button's thick tinted border made it look like a second, heavier
     pill rather than the quieter choice. */
  .sab-btn-accent, .sab-btn-outline {
    display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box;
    height: 52px; padding: 0 28px; border-radius: 100px;
    font-size: 16px; text-decoration: none; white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .sab-btn-accent {
    background: #2FD3A0; color: #08120E; font-weight: 700;
  }
  .sab-btn-accent:hover { background: #5CE3BB; }
  .sab-btn-outline {
    color: #EEF1EC; font-weight: 600;
    border: 1px solid rgba(238, 241, 236,0.3); background: transparent;
  }
  .sab-btn-outline:hover { border-color: rgba(238, 241, 236, 0.7); background: rgba(238, 241, 236,0.06); }

  .sab-stats { display: flex; border-left: 1px solid rgba(92,227,187,0.28); }
  .sab-stat { padding: 6px 36px 6px 28px; border-right: 1px solid rgba(92,227,187,0.28); }
  .sab-stat-value { font-family: var(--font-display); font-size: 44px; line-height: 1.05; color: #EEF1EC; font-variant-numeric: tabular-nums; }
  .sab-stat-label { font-size: 12px; letter-spacing: 0.05em; color: rgba(238, 241, 236, 0.62); margin-top: 6px; white-space: nowrap; }

  /* ── Closing this week ── */
  /* ── Scope carousel (after tesla.com's model cards) ──
     Cards take most of the width so the next one peeks in at the right edge;
     the track scrolls natively and snaps each card to the page gutter. */
  .sab-scopes { position: relative; padding-top: 40px; --scope-gutter: clamp(20px, 4vw, 56px); }
  .sab-scopes-track {
    display: flex; gap: 24px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-left: var(--scope-gutter);
    padding: 0 var(--scope-gutter); scrollbar-width: none; outline: none;
  }
  .sab-scopes-track::-webkit-scrollbar { display: none; }
  .sab-scope {
    position: relative; flex: 0 0 min(74vw, 1420px); aspect-ratio: 16 / 9;
    border-radius: 12px; overflow: hidden; scroll-snap-align: start; background: #16211C;
  }
  .sab-scope picture, .sab-scope-img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sab-scope-img { object-fit: cover; }
  /* Shade at the top for the kicker and at the bottom for the name and
     buttons; the photo stays untouched in the middle. */
  .sab-scope::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(rgba(8,18,14,0.45), rgba(8,18,14,0) 26%, rgba(8,18,14,0) 52%, rgba(8,18,14,0.7));
  }
  .sab-scope-body {
    position: relative; z-index: 1; height: 100%; box-sizing: border-box;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: clamp(24px, 3.4vw, 48px) clamp(24px, 3.4vw, 52px);
    color: #FFFFFF;
  }
  .sab-scope-kicker { font-size: 19px; font-weight: 600; letter-spacing: -0.005em; }
  .sab-scope-name {
    margin: 0; font-family: var(--font-display); font-weight: 400;
    font-size: clamp(48px, 6vw, 84px); line-height: 0.95; letter-spacing: -0.005em;
  }
  .sab-scope-sub {
    display: inline-block; margin-top: 12px; color: #FFFFFF; font-size: 19px;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px;
  }
  .sab-scope-sub:hover { text-decoration-thickness: 2px; }
  .sab-scope-sub-plain, .sab-scope-sub-plain:hover { text-decoration: none; }
  .sab-scope-ctas { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .sab-scope-btn {
