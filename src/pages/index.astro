---
import Layout from '../layouts/Layout.astro';
import { loadScholarships, loadPrograms } from '../lib/data-loader';
import { generateSlug } from '../lib/utils';
import { CLOSING_SOON_MS } from '../lib/constants';

const scholarships = await loadScholarships();
const programs = await loadPrograms();

const today = new Date();
today.setHours(0, 0, 0, 0);

const activeScholarships = scholarships.filter(s => {
  if (!s.active) return false;
  if (!s.deadline) return true;
  return new Date(s.deadline + 'T00:00:00').getTime() >= today.getTime();
});
const activeTotal = activeScholarships.reduce((sum, s) => { const m = s.amount.match(/\$?([\d,]+)/); const n = m ? parseInt(m[1].replace(/,/g, ''), 10) : NaN; return sum + (isNaN(n) ? 0 : n); }, 0);
const researchCount = programs.filter(p => {
  if (!p.deadline || p.deadline === 'TBA' || p.deadline === 'Ongoing') return true;
  return new Date(p.deadline + 'T00:00:00') >= today;
}).length;

const scholarshipCount = scholarships.filter(s => {
  const openMs = s.openDate ? new Date(s.openDate + 'T00:00:00').getTime() : 0;
  if (today.getTime() < openMs) return true;
  if (!s.deadline) return true;
  return today.getTime() <= new Date(s.deadline + 'T00:00:00').getTime();
}).length;

const closingSoon = scholarships
  .filter(s => {
    if (!s.deadline || !s.active) return false;
    const deadlineMs = new Date(s.deadline + 'T00:00:00').getTime();
    return deadlineMs >= today.getTime() && deadlineMs <= today.getTime() + CLOSING_SOON_MS;
  })
  .sort((a, b) => new Date(a.deadline! + 'T00:00:00').getTime() - new Date(b.deadline! + 'T00:00:00').getTime())
  .slice(0, 5);

---

<Layout
  title="ScholarAB | Free Alberta High School Scholarships & Research Programs 2026"
  description={`Browse ${scholarshipCount}+ free scholarships and research programs for Alberta high school students. No login, no ads, no data collection. Updated for 2026.`}
  ogTitle="ScholarAB | Free Alberta High School Scholarships & Research Programs 2026"
  ogDescription={`Browse ${scholarshipCount}+ free scholarships and research programs for Alberta high school students. No login, no ads, no data collection. Updated for 2026.`}
  ogUrl="https://www.scholarab.ca"
  currentPath="/"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ScholarAB",
    "url": "https://www.scholarab.ca",
    "description": "Free Alberta scholarship and research program directory for high school students.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://www.scholarab.ca/scholarships" },
      "query-input": "required name=search_term_string",
    },
  })} slot="head" />

  <div class="pb-8">

    <!-- Hero -->
    <div class="hero max-w-2xl mx-auto pt-8 md:pt-14 pb-4 flex flex-col items-center text-center" style="position:relative;">
      <div class="hero-glow" aria-hidden="true"></div>
      <div style="position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;">

        <!-- Tagline -->
        <p class="hero-tagline">Alberta's student opportunity directory.</p>

        <!-- Hero amount -->
        <p class="hero-amount tnum mb-10">
          ${activeTotal.toLocaleString('en-CA')}+ open right now
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-col items-center gap-3">
          <div class="flex flex-row gap-3">
            <a href="/scholarships" class="btn-pill-filled">Find Scholarships</a>
            <a href="/programs" class="btn-pill-outline">Research Programs</a>
          </div>
          <a href="/match" class="find-match">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <span class="label">Find my match</span><span class="arrow">→</span>
          </a>
          <p class="hero-stat" style="font-size:13px;margin-top:4px;">
            <span class="num"><span id="hero-count" data-deadlines={JSON.stringify(scholarships.map(s => ({ d: s.deadline, o: s.openDate })))}>{scholarshipCount}</span></span> scholarships <span class="sep">·</span> <span class="num">{researchCount}</span> research programs
          </p>
        </div>
      </div>
    </div>

    <!-- Closing this week — horizontal scroll carousel -->
    {closingSoon.length > 0 && (
      <div class="mt-14 md:mt-20">
        <div class="max-w-2xl mx-auto flex items-baseline justify-between mb-5 px-0">
          <div>
            <p style="font-size:10px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#f5b14a;margin-bottom:6px;">⚡ Time sensitive</p>
            <h2 style="margin:0;font-size:clamp(22px,4vw,32px);font-weight:800;letter-spacing:-0.03em;color:var(--text-primary);">Closing this week</h2>
          </div>
          <a href="/scholarships" class="find-match"><span class="label">View all</span><span class="arrow">→</span></a>
        </div>

        <!-- Horizontal scroll on mobile, stacked on desktop -->
        <div id="closing-soon-list" class="flex md:flex-col gap-3 overflow-x-auto md:overflow-x-visible pb-3 md:pb-0 max-w-2xl mx-auto" style="scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none;">
          {closingSoon.map(s => {
            return (
              <a
                href={`/scholarships/${generateSlug(s.title)}`}
                class="closing-row shrink-0 md:shrink"
                style="min-width:280px;scroll-snap-align:start;"
                data-deadline={s.deadline}
              >
                <div class="flex-1 min-w-0" style="min-width:0;">
                  <p style="font-size:14px;font-weight:600;margin:0;color:var(--text-primary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{s.title}</p>
                  {s.audience && <p style="font-size:12px;color:var(--text-tertiary);margin:2px 0 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{s.audience}</p>}
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <p class="tnum" style="font-size:14px;font-weight:700;color:var(--brand);margin:0;">{s.amount}</p>
                  <span class="deadline-badge badge-amber closing-soon-badge">&hellip;</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}


    <!-- Browse by field -->
    <div class="max-w-2xl mx-auto mt-16 md:mt-20">
      <h2 style="margin:0 0 16px;font-size:clamp(22px,4vw,32px);font-weight:800;letter-spacing:-0.03em;color:var(--text-primary);">Browse by field</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {[
          { name: 'STEM & Engineering', count: 'Science, tech, math, engineering', color: '#22d3ee', href: '/scholarships?category=STEM',
            icon: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>' },
          { name: 'Humanities & Arts', count: 'English, history, music, fine arts', color: '#a78bfa', href: '/scholarships?category=Arts',
            icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>' },
          { name: 'Business & Econ', count: 'Commerce, accounting, finance', color: '#60a5fa', href: '/scholarships?category=Academic',
            icon: '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>' },
          { name: 'Indigenous & Equity', count: 'Identity-based scholarships', color: '#fb923c', href: '/scholarships?category=Indigenous',
            icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
          { name: 'Need-based', count: 'Financial assistance awards', color: '#34d399', href: '/scholarships?category=Community',
            icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>' },
          { name: 'Research programs', count: `${researchCount} programs open`, color: '#818cf8', href: '/programs',
            icon: '<path d="M10 2v6.5L4.5 19.5A2 2 0 0 0 6.3 22h11.4a2 2 0 0 0 1.8-2.5L14 8.5V2"/><line x1="8.5" y1="2" x2="15.5" y2="2"/>' },
        ].map(f => (
          <a href={f.href} class="card card-interactive" style="padding:18px;text-decoration:none;display:block;">
            <div style={`width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,${f.color}26,${f.color}0d);border:1px solid ${f.color}33;display:flex;align-items:center;justify-content:center;margin-bottom:12px;color:${f.color};`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
            </div>
            <p style="font-size:14px;font-weight:600;letter-spacing:-0.015em;color:var(--text-primary);margin-bottom:3px;">{f.name}</p>
            <p style="font-size:11px;color:var(--text-secondary);">{f.count}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- How it works -->
    <div class="max-w-2xl mx-auto mt-16 md:mt-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-6 text-center md:text-left">How it works</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="flex flex-col gap-2">
          <span class="font-bold text-2xl text-brand" style="font-variant-numeric:tabular-nums;">01</span>
          <p class="font-semibold text-sm text-primary">Browse</p>
          <p class="text-sm text-secondary">Browse scholarships and research programs across Alberta</p>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-bold text-2xl text-brand" style="font-variant-numeric:tabular-nums;">02</span>
          <p class="font-semibold text-sm text-primary">Filter</p>
          <p class="text-sm text-secondary">Filter by region, category, or deadline to find what fits you</p>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-bold text-2xl text-brand" style="font-variant-numeric:tabular-nums;">03</span>
          <p class="font-semibold text-sm text-primary">Apply</p>
          <p class="text-sm text-secondary">Click Apply Now and go straight to the official application</p>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
  function updateScholarshipCount() {
    const el = document.getElementById('hero-count') as HTMLElement | null;
    const raw = el?.dataset.deadlines;
    if (!el || !raw) return;
    const data: { d: string | null; o: string | null }[] = JSON.parse(raw);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const todayMs = today.getTime();
    const count = data.filter(s => {
      const openMs = s.o ? new Date(s.o + 'T00:00:00').getTime() : 0;
      if (todayMs < openMs) return true;
      if (!s.d) return true;
      return todayMs <= new Date(s.d + 'T00:00:00').getTime();
    }).length;
    el.textContent = String(count);
  }

  updateScholarshipCount();
  document.addEventListener('astro:page-load', updateScholarshipCount);

  function updateClosingSoon() {
    const list = document.getElementById('closing-soon-list');
    if (!list) return;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const todayMs = today.getTime();
    const cards = list.querySelectorAll<HTMLElement>('a[data-deadline]');
    let visible = 0;
    cards.forEach(card => {
      const deadline = card.dataset.deadline;
      if (!deadline) return;
      const deadlineMs = new Date(deadline + 'T00:00:00').getTime();
      if (deadlineMs < todayMs) {
        card.style.display = 'none';
        return;
      }
      visible++;
      const daysLeft = Math.round((deadlineMs - todayMs) / (1000 * 60 * 60 * 24));
      const urgency = daysLeft === 0 ? 'Today' : daysLeft === 1 ? '1 day left' : `${daysLeft} days left`;
      const badge = card.querySelector('.closing-soon-badge');
      if (badge) {
        badge.textContent = urgency;
        if (daysLeft <= 2) {
          badge.className = 'deadline-badge badge-red closing-soon-badge' + (daysLeft === 0 ? ' pulse-soft' : '');
        } else {
          badge.className = 'deadline-badge badge-amber closing-soon-badge';
        }
      }
    });
    if (visible === 0) {
      const section = list.closest('.mt-14') as HTMLElement | null;
      if (section) section.style.display = 'none';
    }
  }

  updateClosingSoon();
  document.addEventListener('astro:page-load', updateClosingSoon);
</script>

<style>
  #closing-soon-list::-webkit-scrollbar { display: none; }
</style>
