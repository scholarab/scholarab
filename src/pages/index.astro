---
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import SabFooter from '../components/sab/SabFooter.astro';
import { loadScholarships, loadPrograms } from '../lib/data-loader';
import { generateSlug, parseAmount } from '../lib/utils';
import { CLOSING_SOON_MS } from '../lib/constants';
import { categoryEmoji } from '../lib/category-emoji';

const scholarships = await loadScholarships();
const programs = await loadPrograms();

const today = new Date();
today.setHours(0, 0, 0, 0);

const activeScholarships = scholarships.filter(s => {
  if (!s.active) return false;
  // Not open yet ≠ open right now (Loran/TD/Wolf open in September — the
  // directory shows them as OPENS SEP; the hero total must agree).
  if (s.openDate && new Date(s.openDate + 'T00:00:00').getTime() > today.getTime()) return false;
  if (!s.deadline) return true;
  return new Date(s.deadline + 'T00:00:00').getTime() >= today.getTime();
});
const activeTotal = activeScholarships.reduce((sum, s) => sum + parseAmount(s.amount), 0);
// Retired programs (active: false) are out of the directory, so they must be
// out of this total too — otherwise the hero promises more than /programs shows.
const researchCount = programs.filter(p => {
  if (p.active === false) return false;
  if (!p.deadline || p.deadline === 'TBA' || p.deadline === 'Ongoing') return true;
  return new Date(p.deadline + 'T00:00:00') >= today;
}).length;

const scholarshipCount = scholarships.length;

const closingSoon = scholarships
  .filter(s => {
    if (!s.deadline || !s.active) return false;
    const deadlineMs = new Date(s.deadline + 'T00:00:00').getTime();
    return deadlineMs >= today.getTime() && deadlineMs <= today.getTime() + CLOSING_SOON_MS;
  })
  .sort((a, b) => new Date(a.deadline! + 'T00:00:00').getTime() - new Date(b.deadline! + 'T00:00:00').getTime())
  .slice(0, 5);

// Categories: real counts from the data, top 8 tracks
const categoryCounts = new Map<string, number>();
for (const s of scholarships) {
  if (s.category) categoryCounts.set(s.category, (categoryCounts.get(s.category) ?? 0) + 1);
}
const CATEGORY_DESCS: Record<string, string> = {
  'Academic':   'Merit, entrance, and general academic awards.',
  'Community':  'Volunteering hours that actually pay off.',
  'Arts':       'Portfolios, performances, film, and writing.',
  'STEM':       'Science fairs, labs, and research awards.',
  'Trades':     'Apprenticeships, RAP, and skilled-trade awards.',
  'Indigenous': 'Awards for First Nations, Métis, and Inuit students.',
  'Sports':     'For athletes at every level, not just varsity.',
  'General':    'Open eligibility, no niche required.',
};
const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([name, count]) => ({ name, count, desc: CATEGORY_DESCS[name] ?? 'Awards for Alberta high school students.' }));

const matchGroups = [
  { key: 'grade',    label: 'YOUR GRADE',  opts: ['Grade 10', 'Grade 11', 'Grade 12'] },
  { key: 'region',   label: 'YOUR REGION', opts: ['Calgary', 'Edmonton', 'Rural / small town', 'Anywhere in AB'] },
  { key: 'interest', label: "YOU'RE INTO", opts: ['STEM', 'Trades', 'Arts', 'Sports', 'Volunteering'] },
];
---

<Layout
  title="ScholarAB | Free Alberta High School Scholarships & Research Programs 2026"
  description={`Browse ${scholarshipCount}+ free scholarships and research programs for Alberta high school students. No login, no ads, no data collection. Updated for 2026.`}
  ogTitle="ScholarAB | Free Alberta High School Scholarships & Research Programs 2026"
  ogDescription={`Browse ${scholarshipCount}+ free scholarships and research programs for Alberta high school students. No login, no ads, no data collection. Updated for 2026.`}
  ogUrl="https://www.scholarab.ca/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.scholarab.ca/#organization",
        "name": "ScholarAB",
        "alternateName": ["ScholarAB.ca", "scholarab"],
        "url": "https://www.scholarab.ca",
        "logo": "https://www.scholarab.ca/icon-512.png",
        "description": "Free Alberta scholarship and research program directory for high school students.",
        "areaServed": { "@type": "AdministrativeArea", "name": "Alberta, Canada" },
        "founder": {
          "@type": "Person",
          "name": "Ilia Ivanov",
          "sameAs": "https://www.linkedin.com/in/iliaivanov/",
        },
        "sameAs": [
          "https://www.instagram.com/scholarab.ca",
          "https://www.tiktok.com/@scholarab",
        ],
      },
      {
        "@type": "WebSite",
        "@id": "https://www.scholarab.ca/#website",
        "name": "ScholarAB",
        "alternateName": ["scholarab"],
        "url": "https://www.scholarab.ca",
        "description": "Free Alberta scholarship and research program directory for high school students.",
        "publisher": { "@id": "https://www.scholarab.ca/#organization" },
        "inLanguage": "en-CA",
      },
    ],
  })} slot="head" />
  <SabFonts slot="head" />
  <div id="sab-home">

    <!-- ============ DARK HERO ============ -->
    <div class="sab-hero">

      <SabHeader currentPath="/" />

      <!-- hero body -->
      <div class="sab-container sab-hero-body">
        <div class="sab-kicker sab-mono">
          <span class="sab-kicker-dot" aria-hidden="true"></span>
          <span>BUILT BY A STUDENT, FOR STUDENTS</span>
        </div>

        <h1 class="sab-h1">
          Alberta's student opportunities, in <em>one</em> directory.
        </h1>

        <div class="sab-hero-bottom">
          <div class="sab-hero-copy">
            <span class="sab-sticker sab-mono">🍁 FREE FOREVER · MADE IN MEDICINE HAT</span>
            <p>
              ScholarAB tracks scholarships and research programs for Alberta high school students, with every deadline checked by hand. Free, no account needed.
            </p>
            <div class="sab-hero-ctas">
              <a href="/scholarships/" class="sab-btn-accent">
                Browse {scholarshipCount} scholarships <span style="font-size:18px;">→</span>
              </a>
              <a href="/programs/" class="sab-btn-outline">
                Explore programs
              </a>
            </div>
          </div>

          <!-- stat block, ledger style -->
          <div class="sab-stats">
            <div class="sab-stat">
              <div class="sab-stat-value tnum"><span id="hero-amount-count" data-total={activeTotal}>${activeTotal.toLocaleString('en-CA')}</span></div>
              <div class="sab-stat-label sab-mono">OPEN RIGHT NOW</div>
            </div>
            <div class="sab-stat">
              <div class="sab-stat-value tnum">{scholarshipCount}</div>
              <div class="sab-stat-label sab-mono">SCHOLARSHIPS</div>
            </div>
            <div class="sab-stat">
              <div class="sab-stat-value tnum">{researchCount}</div>
              <div class="sab-stat-label sab-mono">RESEARCH PROGRAMS</div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- ============ CLOSING THIS WEEK ============ -->
    {closingSoon.length > 0 && (
      <div class="sab-container sab-closing" id="closing" data-closing-section>
        <div class="sab-section-head">
          <div>
            <div class="sab-mono sab-eyebrow-urgent">⏳ TIME-SENSITIVE</div>
            <h2 class="sab-h2">Closing this week</h2>
          </div>
          <a href="/scholarships/" class="sab-view-all">View all deadlines →</a>
        </div>

        <div class="sab-closing-table" id="closing-soon-list">
          {closingSoon.map((s, i) => (
            <a href={`/scholarships/${generateSlug(s.title)}/`} class="sab-closing-row" data-deadline={s.deadline}>
              <div class="sab-row-num sab-mono">{String(i + 1).padStart(2, '0')}</div>
              <div class="sab-row-main">
                <div class="sab-row-name">{s.title}</div>
                {s.audience && <div class="sab-row-blurb">{s.audience}</div>}
              </div>
              <div class="sab-row-amount tnum">{s.amount}</div>
              <div class="sab-row-chip sab-mono closing-soon-badge">&hellip;</div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ============ BROWSE BY CATEGORY ============ -->
    <div class="sab-cat-band">
      <div class="sab-container sab-cats">
        <div class="sab-section-head">
          <h2 class="sab-h2">Start where you are</h2>
          <span class="sab-mono sab-cats-meta">{scholarshipCount} scholarships · {categories.length} tracks</span>
        </div>
        <div class="sab-cat-grid">
          {categories.map(c => (
            <a href={`/scholarships/?category=${encodeURIComponent(c.name)}`} class="sab-cat-card">
              <div class="sab-cat-top">
                <span class="sab-cat-name">
                  {categoryEmoji(c.name) && <span class="sab-cat-emoji" aria-hidden="true">{categoryEmoji(c.name)} </span>}{c.name}
                </span>
                <span class="sab-cat-count sab-mono">{c.count}</span>
              </div>
              <div class="sab-cat-desc">{c.desc}</div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- ============ MATCH TEASER ============ -->
    <div class="sab-container sab-match">
      <div class="sab-match-grid">
        <div>
          <div class="sab-mono sab-match-eyebrow">MATCH · 60 SECONDS</div>
          <h2 class="sab-h2 sab-match-h2">Tell us three things. We'll shortlist for you.</h2>
          <p class="sab-match-copy">
            Pick your grade, region, and interests to see which scholarships fit you. Everything stays in your browser — no account or email needed.
          </p>
        </div>
        <div class="sab-match-card" id="match-teaser">
          {matchGroups.map(g => (
            <div class="sab-match-group" data-match-group={g.key}>
              <div class="sab-mono sab-match-label">{g.label}</div>
              <div class="sab-match-opts">
                {g.opts.map(o => (
                  <button type="button" class="sab-match-opt">{o}</button>
                ))}
              </div>
            </div>
          ))}
          <button type="button" class="sab-match-cta" id="match-teaser-cta">Pick 3 more to see matches</button>
        </div>
      </div>
    </div>

    <!-- ============ FOOTER ============ -->
    <SabFooter />

  </div>
</Layout>

<script>
  // ── Closing-this-week day chips (client-side so a stale static build never lies) ──
  function updateClosingSoon() {
    const list = document.getElementById('closing-soon-list');
    if (!list) return;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const todayMs = today.getTime();
    const rows = list.querySelectorAll<HTMLElement>('a[data-deadline]');
    let visible = 0;
    rows.forEach(row => {
      const deadline = row.dataset.deadline;
      if (!deadline) return;
      const deadlineMs = new Date(deadline + 'T00:00:00').getTime();
      if (deadlineMs < todayMs) {
        row.style.display = 'none';
        return;
      }
      visible++;
      const daysLeft = Math.round((deadlineMs - todayMs) / 86400000);
      const chip = row.querySelector('.closing-soon-badge');
      if (chip) {
        chip.textContent = daysLeft === 0 ? 'DUE TODAY' : `${daysLeft} ${daysLeft === 1 ? 'DAY' : 'DAYS'} LEFT`;
        chip.classList.toggle('sab-chip-urgent', daysLeft <= 4);
      }
    });
    // Renumber the visible rows so hidden expired entries don't leave gaps
    let n = 0;
    rows.forEach(row => {
      if (row.style.display === 'none') return;
      const num = row.querySelector('.sab-row-num');
      if (num) num.textContent = String(++n).padStart(2, '0');
    });
    if (visible === 0) {
      const section = list.closest('[data-closing-section]') as HTMLElement | null;
      if (section) section.style.display = 'none';
    }
  }

  updateClosingSoon();
  document.addEventListener('astro:page-load', updateClosingSoon);

  // ── Hero amount count-up (kept from previous hero; final value is server-rendered) ──
  function animateHeroAmount() {
    const el = document.getElementById('hero-amount-count');
    if (!el || el.dataset.counted) return;
    el.dataset.counted = 'true';
    try {
      if (sessionStorage.getItem('sab_hero_counted')) return;
      sessionStorage.setItem('sab_hero_counted', '1');
    } catch { /* storage unavailable — animate anyway */ }
    const total = parseInt(el.dataset.total || '', 10);
    if (!Number.isFinite(total) || total <= 0) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const sameDigitFloor = Math.pow(10, String(total).length - 1);
    const start = Math.max(sameDigitFloor, Math.round(total * 0.35));
    const DURATION = 1100;
    let t0: number | null = null;
    let lastText = '';
    function tick(now: number) {
      if (t0 === null) t0 = now;
      const p = Math.min((now - t0) / DURATION, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      const text = '$' + Math.round(start + (total - start) * eased).toLocaleString('en-CA');
      if (text !== lastText) { el!.textContent = text; lastText = text; }
      if (p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  animateHeroAmount();
  document.addEventListener('astro:page-load', animateHeroAmount);

  // ── Match teaser: local chip picks, CTA goes to the real quiz ──
  function initMatchTeaser() {
    const card = document.getElementById('match-teaser');
    const cta = document.getElementById('match-teaser-cta');
    if (!card || !cta || card.dataset.init) return;
    card.dataset.init = 'true';

    const groups = Array.from(card.querySelectorAll<HTMLElement>('[data-match-group]'));
    const update = () => {
      const chosen = groups.filter(g => g.querySelector('.sab-match-opt.on')).length;
      cta.textContent = chosen === groups.length ? 'Show my matches →' : `Pick ${groups.length - chosen} more to see matches`;
    };
    groups.forEach(g => {
      g.querySelectorAll<HTMLElement>('.sab-match-opt').forEach(btn => {
        btn.addEventListener('click', () => {
          const wasOn = btn.classList.contains('on');
          g.querySelectorAll('.sab-match-opt').forEach(b => b.classList.remove('on'));
          if (!wasOn) btn.classList.add('on');
          update();
        });
      });
    });
    cta.addEventListener('click', async () => {
      const { navigate } = await import('astro:transitions/client');
      navigate('/match');
    });
    update();
  }

  initMatchTeaser();
  document.addEventListener('astro:page-load', initMatchTeaser);
</script>

<style is:global>
  /* The home design is fixed light regardless of site theme */
  body:has(#sab-home) { background: #FAF7F0; }
</style>

<style>
  /* ════ ScholarAB Home — claude.ai/design "ScholarAB Home.dc.html" ════
     Palette: canvas #FAF7F0 · alt band #F2EEE4 · ink #141915 · hero/footer #0B1512
     accent #2FD3A0 (soft: 40% alpha) · link #0E8C64 · urgency #B8541F
     Type: Instrument Serif (display) · Archivo (UI/body) · IBM Plex Mono (labels) */

  #sab-home {
    background: #FAF7F0;
    color: #141915;
    font-family: 'Archivo', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  #sab-home ::selection { background: #2FD3A0; color: #0B1512; }
  .sab-mono { font-family: 'IBM Plex Mono', monospace; }
  .sab-container { padding-left: 48px; padding-right: 48px; }

  @keyframes sab-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes sab-pop { 0% { transform: scale(0.94); } 60% { transform: scale(1.05); } 100% { transform: scale(1); } }

  /* ── Dark hero ── */
  /* Fills the first viewport so no canvas sliver peeks below the fold on
     tall/fullscreen windows; on short viewports it grows past 100svh. */
  .sab-hero {
    background: #0B1512; color: #F2F0E9; position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    min-height: 100vh; min-height: 100svh;
  }

  .sab-hero-body {
    padding-top: 76px; position: relative;
    /* Center the copy in the space left under the header/ticker */
    flex: 1; display: flex; flex-direction: column; justify-content: center;
    width: 100%; box-sizing: border-box;
  }
  .sab-kicker {
    display: flex; align-items: center; gap: 10px; margin-bottom: 30px;
    font-size: 13px; color: #2FD3A0; letter-spacing: 0.06em;
  }
  .sab-kicker-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #2FD3A0; }

  .sab-h1 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(42px, 8.2vw, 96px); line-height: 0.98; letter-spacing: -0.015em;
    margin: 0; max-width: 1050px; text-wrap: balance;
    animation: sab-rise 0.7s ease both;
  }
  .sab-h1 em { font-style: italic; color: #2FD3A0; }

  .sab-hero-bottom {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 40px; margin-top: 52px; padding-bottom: 64px;
  }
  .sab-hero-copy { max-width: 460px; }
  .sab-hero-copy p { font-size: 18px; line-height: 1.55; color: rgba(242,240,233,0.72); margin: 0 0 30px; }
  .sab-hero-ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .sab-sticker {
    display: inline-block; margin-bottom: 22px; padding: 8px 16px;
    background: #2FD3A0; color: #0B1512; font-size: 11.5px; letter-spacing: 0.06em;
    border-radius: 100px; border: 2px solid #0B1512;
    box-shadow: 3px 3px 0 rgba(242,240,233,0.25);
    transform: rotate(-2.5deg);
  }
  /* Buttons lift onto a hard accent shadow on hover/keyboard focus, then snap
     flush into it while held — same press language as the category cards. */
  .sab-btn-accent {
    display: inline-flex; align-items: center; gap: 10px;
    background: #2FD3A0; color: #0B1512; font-weight: 700; font-size: 16px;
    padding: 16px 28px; border-radius: 100px; text-decoration: none; white-space: nowrap;
    transition: background 0.18s ease, color 0.18s ease,
                transform 0.18s cubic-bezier(0.2, 0.8, 0.3, 1), box-shadow 0.18s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .sab-btn-accent:hover, .sab-btn-accent:focus-visible {
    background: #F2F0E9; color: #0B1512;
    transform: translate(-3px, -3px); box-shadow: 5px 5px 0 #2FD3A0;
  }
  .sab-btn-accent:active {
    transform: translate(1px, 1px); box-shadow: 0 0 0 #2FD3A0;
    transition-duration: 0.07s;
  }
  /* the arrow leans toward where it is taking you */
  .sab-btn-accent span { transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.3, 1); }
  .sab-btn-accent:hover span, .sab-btn-accent:focus-visible span { transform: translateX(4px); }
  .sab-btn-accent:active span { transform: translateX(1px); }

  .sab-btn-outline {
    display: inline-flex; align-items: center; gap: 10px;
    color: #F2F0E9; font-weight: 600; font-size: 16px;
    padding: 16px 24px; border-radius: 100px; border: 1px solid rgba(242,240,233,0.3);
    text-decoration: none; white-space: nowrap;
    transition: border-color 0.18s ease, background 0.18s ease,
                transform 0.18s cubic-bezier(0.2, 0.8, 0.3, 1), box-shadow 0.18s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .sab-btn-outline:hover, .sab-btn-outline:focus-visible {
    border-color: #2FD3A0; color: #F2F0E9;
    transform: translate(-3px, -3px); box-shadow: 5px 5px 0 #2FD3A0;
  }
  .sab-btn-outline:active {
    transform: translate(1px, 1px); box-shadow: 0 0 0 #2FD3A0;
    transition-duration: 0.07s;
  }

  .sab-stats { display: flex; border-left: 1px solid rgba(242,240,233,0.18); }
  .sab-stat { padding: 6px 36px 6px 28px; border-right: 1px solid rgba(242,240,233,0.18); }
  .sab-stat-value { font-family: 'Instrument Serif', serif; font-size: 44px; line-height: 1.05; color: #F2F0E9; }
  .sab-stat-label { font-size: 12px; letter-spacing: 0.05em; color: rgba(242,240,233,0.55); margin-top: 6px; white-space: nowrap; }

  /* ── Closing this week ── */
  .sab-closing { padding-top: 96px; padding-bottom: 40px; }
  .sab-section-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 14px; gap: 20px; }
  .sab-eyebrow-urgent { font-size: 13px; letter-spacing: 0.06em; color: #B8541F; margin-bottom: 14px; }
  .sab-h2 {
    font-family: 'Instrument Serif', serif; font-weight: 400;
    font-size: clamp(36px, 5vw, 58px); letter-spacing: -0.01em; margin: 0;
  }
  .sab-view-all {
    font-weight: 600; font-size: 15px; color: #141915; text-decoration: none;
    border-bottom: 2px solid #2FD3A0; padding-bottom: 3px; white-space: nowrap;
  }
  .sab-view-all:hover { color: #0E8C64; }

  .sab-closing-table { border-top: 2px solid #141915; }
  .sab-closing-row {
    display: grid; grid-template-columns: 64px 1fr auto auto; gap: 28px; align-items: center;
    padding: 26px 8px; border-bottom: 1px solid rgba(20,25,21,0.14);
    cursor: pointer; color: inherit; text-decoration: none;
  }
  .sab-closing-row:hover { background: rgba(47,211,160,0.07); color: inherit; }
  .sab-row-num { font-size: 14px; color: rgba(20,25,21,0.4); }
  .sab-row-name { font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
  .sab-row-blurb {
    font-size: 14.5px; color: rgba(20,25,21,0.55); margin-top: 5px;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }
  .sab-row-amount { font-family: 'Instrument Serif', serif; font-size: 28px; text-align: right; }
  .sab-row-chip {
    font-size: 12.5px; font-weight: 500; padding: 7px 14px; border-radius: 100px;
    background: rgba(184,84,31,0.12); color: #B8541F; white-space: nowrap;
  }
  .sab-row-chip.sab-chip-urgent { background: #B8541F; color: #FAF7F0; }

  /* ── Categories ── */
  .sab-cat-band { background: #F2EEE4; border-top: 2px solid #141915; border-bottom: 2px solid #141915; }
  .sab-cats { padding-top: 88px; padding-bottom: 88px; }
  .sab-cats .sab-section-head { margin-bottom: 44px; }
  .sab-cats-meta { font-size: 13px; color: rgba(20,25,21,0.5); white-space: nowrap; }
  .sab-cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .sab-cat-card {
