---
import { todayDate as albertaToday } from '../../lib/calendar';
// The scholarship facet hubs: /scholarships/medicine-hat/, /scholarships/stem/.
//
// IMPORTANT: this route sits at the same URL shape as the detail route in
// src/pages/[type]/[slug].astro and WINS route precedence over it, because it
// has a static `scholarships` segment where the other has `[type]`. That is the
// behaviour we want, and it is also the hazard: a listing that ever slugged to
// one of these facet slugs would have its detail page silently shadowed. That
// is why RESERVED_SCHOLARSHIP_SLUGS exists and why validate-data.ts fails the
// build on a collision instead of trusting this comment.
import SabFooter from '../../components/sab/SabFooter.astro';
import SabFonts from '../../components/sab/SabFonts.astro';
import Layout from '../../layouts/Layout.astro';
import SabHeader from '../../components/sab/SabHeader.astro';
import ScholarshipDirectory from '../../components/sab/ScholarshipDirectory.astro';
import { loadScholarships } from '../../lib/data-loader';
import { enrichScholarships } from '../../lib/enrich';
import { SCHOLARSHIP_FACETS, facetItems, MIN_FACET_ITEMS } from '../../lib/facets';
import { DEFAULT_SCHOLARSHIP_STATE, filterSortScholarships } from '../../lib/list-core';
import { itemListJson } from '../../lib/ld';
import { scholarshipIsIndexable } from '../../lib/status';
import { getGuide } from '../../lib/guides';
import { comboCities } from '../../lib/combos';

export async function getStaticPaths() {
  const all = enrichScholarships(await loadScholarships());
  return SCHOLARSHIP_FACETS
    .map(facet => ({ facet, items: facetItems(facet, all) }))
    // The floor is enforced here, not just documented in facets.ts: a hub
    // listing one award is a doorway page, and a data change should not be able
    // to quietly produce one.
    .filter(({ items }) => items.length >= MIN_FACET_ITEMS)
    .map(({ facet, items }) => ({ params: { facet: facet.slug }, props: { facet, items, allItems: all } }));
}

const { facet, items, allItems } = Astro.props;

const today = albertaToday();

const ordered = filterSortScholarships(items, DEFAULT_SCHOLARSHIP_STATE);
const canonical = `https://www.scholarab.ca/scholarships/${facet.slug}/`;

// ── The off-season problem ──────────────────────────────────────────────────
//
// All 60 city-scoped awards carry `active: false` through late summer: the
// cycle closed and the next open date is not known yet. status.ts already calls
// that 'future' rather than 'closed', and the detail pages already render
// "OPENS <date>", so the counts here have to say the same thing. A hub that
// reported "0 scholarships" in the month counsellors start looking would be
// worse than no hub at all, which is why nothing on this page filters to open.
// The footer's count line ("153 AWARDS · 15 OPEN NOW · 138 NOT OPEN YET, THE
// FIRST ON JANUARY 19, 2027") was deleted 2026-09-15 at Ilia's request. The
// status sections in the list carry all three figures now, each beside the
// listings it describes, and the footer's job is the sibling hubs.

// A hub whose every listing is genuinely closed has nothing to offer and should
// not be in the index. In practice this never fires today, because `active:
// false` is 'future', not 'closed', but it is the same predicate the detail
// pages and the sitemap use, so the three cannot disagree.
const indexable = items.some(s => scholarshipIsIndexable(s, today));

const guide = facet.guide ? getGuide(facet.guide) : null;

// A city's own list, as opposed to a province-wide, national or school one.
const isCity = facet.kind === 'region' && !facet.broad && !facet.bySchool;

const comboPage = comboCities(allItems, today).find(c => c.city === facet.slug);

// The hub footer is now the only cross-hub path on the page (SCOPE left the
// filter rail on 2026-09-15), so it also has to respect the MIN_FACET_ITEMS
// floor that getStaticPaths applies: a facet too thin for a page of its own
// would otherwise be linked here and 404.
const siblings = SCHOLARSHIP_FACETS.filter(
  f => f.slug !== facet.slug && f.kind === facet.kind
    && facetItems(f, allItems).length >= MIN_FACET_ITEMS,
);

const listJson = itemListJson(
  ordered.map(s => ({ name: s.title, url: `https://www.scholarab.ca/scholarships/${s._slug}/` })),
  facet.h1,
  canonical,
);

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scholarab.ca/' },
    { '@type': 'ListItem', position: 2, name: 'Scholarships', item: 'https://www.scholarab.ca/scholarships/' },
    { '@type': 'ListItem', position: 3, name: facet.label, item: canonical },
  ],
};
---

<Layout
  title={`${facet.title} | ScholarAB`}
  description={facet.description}
  ogTitle={`${facet.title} | ScholarAB`}
  ogDescription={facet.description}
  ogUrl={canonical}
  canonical={canonical}
  robots={indexable ? undefined : 'noindex,follow'}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listJson)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <SabFonts slot="head" chips />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/scholarships" />
  </div>

  <div
    id="sab-scholarships"
    data-remember-city={isCity ? facet.slug : undefined}
    class="sabp sabp-wide"
  >
    <div class="sabp-body">
      {/* No visible breadcrumb (Ilia, 2026-09-15). The header names the
          section, the h1 names the facet, and the hub footer links back to the
          directory, so the row was a third copy of the same two facts at the
          top of the reader's screen. The BreadcrumbList JSON-LD stays: the
          trail it describes is still true of the URL. */}
      <ScholarshipDirectory
        items={items}
        h1={facet.h1}
        intro={facet.intro}
        allItems={allItems}
        hideCategories={facet.kind === 'category'}
        hideScopes
        tabs={facet.slug}
        schoolFilter={facet.bySchool}
        towns={facet.members ? [facet.value, ...facet.members] : undefined}
        step={isCity ? 12 : undefined}
      />

      <div class="sabl-hubfoot">
        {guide && (
          <p>
            Reading first? <a href={`/guides/${guide.slug}/`}>{guide.title}</a> walks through how to
            work this list.
          </p>
        )}
        {facet.bySchool && (
          <p>
            Where are these schools, and how far is each from you? See them on
            the <a href="/map/">map of Alberta's universities and colleges</a>.
          </p>
        )}
        {comboPage && (
          <p>
            Know which group you're in? <a href={`/scholarships/${facet.slug}/combos/`}>{comboPage.h1}</a> sort
            these awards into sets you can apply to together.
          </p>
        )}
        <p class="sabl-hublinks">
          {/* The province-wide hub also holds the 184 awards for one town,
              county or school outside the named cities, so a rural reader
              is told where theirs are (critique 2026-09-27). */}
          {siblings.map(f => (
            <a href={`/scholarships/${f.slug}/`}>{f.slug === 'alberta' ? 'Province-wide, other towns and counties' : f.label}</a>
          ))}
          <a href="/scholarships/">All scholarships</a>
        </p>
      </div>
    </div>
  </div>

  <SabFooter slot="footer" />
</Layout>

<script>
  import { rememberCity } from '../../lib/my-city.ts';
  // The city a student last opened, so the home page can offer it back
  // (lib/my-city.ts). On every hub load, view transitions included.
  document.addEventListener('astro:page-load', () => {
    const slug = document.querySelector<HTMLElement>('[data-remember-city]')?.dataset.rememberCity;
    if (slug) rememberCity(slug);
  });
</script>

<style is:global>
  /* The directory design is fixed light regardless of site theme */
  body:has(#sab-scholarships) { background: var(--bg-page); }
</style>
