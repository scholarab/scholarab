---
import { todayDate as albertaToday } from '../../lib/calendar';
// The scholarship facet hubs: /scholarships/medicine-hat/, /scholarships/stem/.
//
// IMPORTANT: this route sits at the same URL shape as the detail route in
// src/pages/[type]/[slug].astro and WINS route precedence over it, because it
// has a static `scholarships` segment where the other has `[type]`. That is the
// behaviour we want, and it is also the hazard: a listing that ever slugged to
// one of these facet slugs would have its detail page silently shadowed. That
// is why RESERVED_SCHOLARSHIP_SLUGS exists and why validate-data.ts fails the
// build on a collision instead of trusting this comment.
import SabFooter from '../../components/sab/SabFooter.astro';
import SabFonts from '../../components/sab/SabFonts.astro';
import Layout from '../../layouts/Layout.astro';
import SabHeader from '../../components/sab/SabHeader.astro';
import ScholarshipDirectory from '../../components/sab/ScholarshipDirectory.astro';
import { loadScholarships } from '../../lib/data-loader';
import { enrichScholarships } from '../../lib/enrich';
import { SCHOLARSHIP_FACETS, facetItems, MIN_FACET_ITEMS } from '../../lib/facets';
import { DEFAULT_SCHOLARSHIP_STATE, filterSortScholarships } from '../../lib/list-core';
import { itemListJson } from '../../lib/ld';
import { scholarshipIsIndexable } from '../../lib/status';
import { getGuide } from '../../lib/guides';

export async function getStaticPaths() {
  const all = enrichScholarships(await loadScholarships());
  return SCHOLARSHIP_FACETS
    .map(facet => ({ facet, items: facetItems(facet, all) }))
    // The floor is enforced here, not just documented in facets.ts: a hub
    // listing one award is a doorway page, and a data change should not be able
    // to quietly produce one.
    .filter(({ items }) => items.length >= MIN_FACET_ITEMS)
    .map(({ facet, items }) => ({ params: { facet: facet.slug }, props: { facet, items, allItems: all } }));
}

const { facet, items, allItems } = Astro.props;

// Full-page photo backdrops are OFF (Ilia, 2026-09-15: "looks broke ... maybe
// we will put them back eventually"). Flip this to false and the hubs render
// their photo again; the images, the facets' `backdrop` values and the
// `.sabl-has-backdrop` CSS below all stay in place for that. The header's
// square photo tiles are a separate surface and are unaffected.
const BACKDROPS_OFF = true;
const backdrop = BACKDROPS_OFF ? null : facet.backdrop;

const today = albertaToday();

const ordered = filterSortScholarships(items, DEFAULT_SCHOLARSHIP_STATE);
const canonical = `https://www.scholarab.ca/scholarships/${facet.slug}/`;

// ── The off-season problem ──────────────────────────────────────────────────
//
// All 60 city-scoped awards carry `active: false` through late summer: the
// cycle closed and the next open date is not known yet. status.ts already calls
// that 'future' rather than 'closed', and the detail pages already render
// "OPENS <date>", so the counts here have to say the same thing. A hub that
// reported "0 scholarships" in the month counsellors start looking would be
// worse than no hub at all, which is why nothing on this page filters to open.
// The footer's count line ("153 AWARDS · 15 OPEN NOW · 138 NOT OPEN YET, THE
// FIRST ON JANUARY 19, 2027") was deleted 2026-09-15 at Ilia's request. The
// status sections in the list carry all three figures now, each beside the
// listings it describes, and the footer's job is the sibling hubs.

// A hub whose every listing is genuinely closed has nothing to offer and should
// not be in the index. In practice this never fires today, because `active:
// false` is 'future', not 'closed', but it is the same predicate the detail
// pages and the sitemap use, so the three cannot disagree.
const indexable = items.some(s => scholarshipIsIndexable(s, today));

const guide = facet.guide ? getGuide(facet.guide) : null;

// The hub footer is now the only cross-hub path on the page (SCOPE left the
// filter rail on 2026-09-15), so it also has to respect the MIN_FACET_ITEMS
// floor that getStaticPaths applies: a facet too thin for a page of its own
// would otherwise be linked here and 404.
const siblings = SCHOLARSHIP_FACETS.filter(
  f => f.slug !== facet.slug && f.kind === facet.kind
    && facetItems(f, allItems).length >= MIN_FACET_ITEMS,
);

const listJson = itemListJson(
  ordered.map(s => ({ name: s.title, url: `https://www.scholarab.ca/scholarships/${s._slug}/` })),
  facet.h1,
  canonical,
);

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.scholarab.ca/' },
    { '@type': 'ListItem', position: 2, name: 'Scholarships', item: 'https://www.scholarab.ca/scholarships/' },
    { '@type': 'ListItem', position: 3, name: facet.label, item: canonical },
  ],
};
---

<Layout
  title={`${facet.title} | ScholarAB`}
  description={facet.description}
  ogTitle={`${facet.title} | ScholarAB`}
  ogDescription={facet.description}
  ogUrl={canonical}
  canonical={canonical}
  robots={indexable ? undefined : 'noindex,follow'}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listJson)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <SabFonts slot="head" chips />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/scholarships" />
  </div>

  <div
    id="sab-scholarships"
    class:list={['sabp', 'sabp-wide', { 'sabl-has-backdrop': backdrop }]}
    style={backdrop
      ? `--sabl-wide: url(/photos/backdrops/${backdrop}-wide-1672.webp); --sabl-wide-2x: url(/photos/backdrops/${backdrop}-wide-3344.webp); --sabl-tall: url(/photos/backdrops/${backdrop}-tall-1000.webp); --sabl-tall-2x: url(/photos/backdrops/${backdrop}-tall-2000.webp)`
      : undefined}
  >
    <div class="sabp-body">
      {/* No visible breadcrumb (Ilia, 2026-09-15). The header names the
          section, the h1 names the facet, and the hub footer links back to the
          directory, so the row was a third copy of the same two facts at the
          top of the reader's screen. The BreadcrumbList JSON-LD stays: the
          trail it describes is still true of the URL. */}
      <ScholarshipDirectory
        items={items}
        h1={facet.h1}
        intro={facet.intro}
        allItems={allItems}
        hideCategories={facet.kind === 'category'}
        hideScopes
        railFilters
      />

      <div class="sabl-hubfoot">
        {guide && (
          <p>
            Reading first? <a href={`/guides/${guide.slug}/`}>{guide.title}</a> walks through how to
            work this list.
          </p>
        )}
        <p class="sabl-hublinks">
          {siblings.map(f => (
            <a href={`/scholarships/${f.slug}/`}>{f.label}</a>
          ))}
          <a href="/scholarships/">All scholarships</a>
        </p>
      </div>
    </div>
  </div>

  <SabFooter slot="footer" />
</Layout>

<script>
  // Drives the backdrop's scroll fade: 0 while the header panel is on screen,
  // 1 once the reader is a screen's height into the listings. A custom property
  // on one element, written at most once a frame, so scrolling stays cheap.
  const page = document.querySelector<HTMLElement>('.sabl-has-backdrop');
  const grid = document.querySelector<HTMLElement>('[data-dir-grid]');
  if (page && grid) {
    let queued = false;
    const update = () => {
      queued = false;
      const start = grid.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.6;
      const t = (window.scrollY - start) / window.innerHeight;
      page.style.setProperty('--sabl-fade', Math.min(1, Math.max(0, t)).toFixed(3));
    };
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style is:global>
  /* The directory design is fixed light regardless of site theme */
  body:has(#sab-scholarships) { background: #F4F5F1; }

  /* A scope's full-page photo backdrop. A fixed pseudo-element rather than
     background-attachment: fixed, which iOS Safari ignores (it scrolls the
     image with the page and blows it up to the page's full 18,000px height).
     The photo stays at full strength; readability comes from the frosted
     panels below, never from fading the photo. Anchored to the bottom, so the
     calm sky sits behind the top of the screen, where the text is, and the
     skyline along the bottom edge. */
  /* .sabp paints solid cream (global.css), which would cover the layer. */
  #sab-scholarships.sabl-has-backdrop { background: transparent; }
  .sabl-has-backdrop::before {
    content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background-color: #D9CFC2;
    background-position: center bottom;
    background-size: cover;
    background-repeat: no-repeat;
  }
  /* Portrait screens (phones, an upright iPad) get a tall crop of the same
     photo instead of a thin slice of the wide one. The towers sit right of
     centre, so the crop leans right to keep them in frame. */
  @media (orientation: portrait) {
    .sabl-has-backdrop::before { background-position: 62% bottom; }
  }
  /* Browsers without image-set get the 1x files. Kept out of the cascade
     everywhere else, or a 2x screen downloads both sizes. */
  @supports not (background-image: image-set(url("a.webp") 1x)) {
    .sabl-has-backdrop::before { background-image: var(--sabl-wide); }
    @media (orientation: portrait) {
      .sabl-has-backdrop::before { background-image: var(--sabl-tall); }
    }
  }
  /* Behind @supports, not as a second declaration: a var() inside an
     image-set the browser cannot parse would not fall back to the url above,
     it would blank the background. Each orientation names only its own pair,
     so a screen fetches one file. */
  @supports (background-image: image-set(url("a.webp") 1x)) {
    .sabl-has-backdrop::before { background-image: image-set(var(--sabl-wide) 1x, var(--sabl-wide-2x) 2x); }
    @media (orientation: portrait) {
      .sabl-has-backdrop::before { background-image: image-set(var(--sabl-tall) 1x, var(--sabl-tall-2x) 2x); }
    }
  }

  /* The scroll fade. A cream layer over the photo, painted after ::before, so
     it sits above the photo and under the page. Clear at the top, where the
     photo is the point; it thickens as the reader scrolls into the listings
     (the script below sets --sabl-fade from 0 to 1). */
  .sabl-has-backdrop::after {
    content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: #F4F5F1; opacity: calc(var(--sabl-fade, 0) * 0.6);
  }

  /* ── Frosted panels ──
     Every piece of text sits on cream glass, and the photo shows in the
     margins and the gaps between cards. The cards are already solid white. */
  .sabl-has-backdrop {
    --sabl-glass: rgba(244, 245, 241,0.84);
    --sabl-glass-edge: rgba(255,255,255,0.55);
  }
  .sabl-has-backdrop .sabl-head,
  .sabl-has-backdrop .sabl-rail,
  .sabl-has-backdrop .sabl-hubfoot,
  .sabl-has-backdrop .sabl-group,
  .sabl-has-backdrop .sabl-more,
  .sabl-has-backdrop .sabl-empty {
    background: var(--sabl-glass);
    border: 1px solid var(--sabl-glass-edge);
    -webkit-backdrop-filter: blur(20px) saturate(1.15);
    backdrop-filter: blur(20px) saturate(1.15);
    box-shadow: 0 10px 30px -18px rgba(20,25,21,0.45);
  }
  /* No blur support: the glass goes nearly opaque instead, so the text over
     it keeps its contrast. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sabl-has-backdrop { --sabl-glass: rgba(244, 245, 241,0.96); }
  }
  /* e2e/smoke.spec.ts checks that every hub puts its toolbar at the same
     height, so hopping from Calgary to Edmonton does not move the chips under
     the cursor. These offsets used to be tuned against a plain hub's 72px body
     padding plus a 42px breadcrumb row; the breadcrumb is gone (2026-09-15) and
     backdrops are off, so nothing exercises this block today. Re-measure the
     sum against the plain hubs before turning BACKDROPS_OFF back to false. */
  .sabl-has-backdrop .sabp-body { padding-top: 32px; }
  .sabl-has-backdrop .sabl-head {
    margin-top: 11px; padding: 36px 40px 6px; border-radius: 22px;
  }
  .sabl-has-backdrop .sabl-group {
    padding: 10px 16px; border-radius: 12px; margin-top: 10px;
  }
  /* The rail left .sabl-head when the filters moved into a column
     (2026-09-15), so it needs its own glass: chips straight on a photographed
     lake are unreadable. The count line that used to sit here with it is gone
     from the page entirely. */
  @media (min-width: 1100px) {
    .sabl-has-backdrop .sabl-railed .sabl-rail {
      padding: 18px 16px; border-radius: 18px;
    }
  }
  .sabl-has-backdrop .sabl-group:first-child { padding-top: 10px; margin-top: 0; }
  .sabl-has-backdrop .sabl-hubfoot {
    padding: 28px 32px; border-radius: 22px; margin-bottom: 8px;
  }
  .sabl-has-backdrop .sabl-empty { border-style: solid; }
  .sabl-has-backdrop .sabl-more { border-radius: 22px; }
  @media (max-width: 900px) {
    .sabl-has-backdrop .sabp-body { padding-top: 20px; }
    /* Nearly edge to edge on a phone: 8px of photo each side is enough to
       read as a panel without costing the chips their width. */
    .sabl-has-backdrop .sabl-head {
      margin-left: -12px; margin-right: -12px; padding: 24px 16px 4px; border-radius: 18px;
      overflow: clip;
    }
    /* Under 1100px the rail is not a column; it is the chip rows again, in
       their own panel under the title one. */
    .sabl-has-backdrop .sabl-rail {
      margin: 10px -12px 0; padding: 4px 16px 16px; border-radius: 18px; overflow: clip;
    }
    /* The chip rows bleed to the edge they scroll under, which is now the
       panel's edge rather than the screen's. */
    .sabl-has-backdrop .sabl-head .sabl-sort-chips,
    .sabl-has-backdrop .sabl-rail .sabl-chips {
      margin-left: -16px; margin-right: -16px; padding-left: 16px; padding-right: 16px;
    }
    .sabl-has-backdrop .sabl-hubfoot { margin-left: -12px; margin-right: -12px; padding: 22px 16px; }
  }


  .sabl-hubfoot {
    border-top: 1px solid #E5E0D5;
    margin-top: 48px; padding: 28px 0 64px;
    display: flex; flex-direction: column; gap: 12px;
    font-size: 15px; color: #4B5563;
  }
  .sabl-hubfoot p { margin: 0; }
  /* Row gap carries most of the vertical rhythm so each link can pad itself
     out to a 24px tap target (WCAG 2.2 2.5.8); these are a nav cluster, not
     links inside a sentence, so the inline exception does not apply. */
  .sabl-hublinks { display: flex; flex-wrap: wrap; gap: 2px 18px; }
  .sabl-hublinks a {
    color: #141915; display: inline-flex; align-items: center; min-height: 24px;
  }
</style>
