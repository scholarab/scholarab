---
import Layout from '../../layouts/Layout.astro';
import DetailLayout from '../../components/DetailLayout.astro';
import { loadScholarships } from '../../lib/data-loader';
import { generateSlug, parseAmount } from '../../lib/utils.ts';
import { SCHOLARSHIP_BADGES as CATEGORY_BADGE, DEFAULT_BADGE } from '../../lib/badges.ts';
import DeadlineAlert from '../../components/DeadlineAlert.astro';

export async function getStaticPaths() {
  const scholarships = await loadScholarships();
  return scholarships.map(s => ({
    params: { slug: generateSlug(s.title) },
    props: { scholarship: s },
  }));
}

const { scholarship } = Astro.props;
const slug = generateSlug(scholarship.title);

function formatDate(str: string | null): string {
  if (!str) return 'N/A';
  const d = new Date(str + 'T00:00:00');
  return d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}

const todayDate = new Date();
todayDate.setHours(0, 0, 0, 0);
const openDate     = new Date((scholarship.openDate || '1970-01-01') + 'T00:00:00');
const deadlineDate = scholarship.deadline ? new Date(scholarship.deadline + 'T00:00:00') : null;
const status = todayDate < openDate ? 'future' : (deadlineDate && todayDate > deadlineDate) ? 'closed' : 'active';

const rawBadge = CATEGORY_BADGE[scholarship.category ?? ''] || DEFAULT_BADGE;
const badge    = { ...rawBadge, label: scholarship.category || '' };

const regionStr    = !scholarship.region || scholarship.region === 'National' ? '' : ` in ${scholarship.region}`;
const description  = `The ${scholarship.title} offers ${scholarship.amount} to ${scholarship.audience}${regionStr}. Deadline: ${formatDate(scholarship.deadline)}. Browse more Alberta scholarships at ScholarAB.`;
const canonical    = `https://www.scholarab.ca/scholarships/${slug}`;
const pageTitle    = `${scholarship.title} | ScholarAB | Alberta Scholarships`;
const parsedAmount = parseAmount(scholarship.amount) || null;

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalProgram',
  'name': scholarship.title,
  'description': description,
  'url': canonical,
  ...(scholarship.deadline ? { 'applicationDeadline': scholarship.deadline } : {}),
  ...(parsedAmount !== null ? { 'offers': { '@type': 'Offer', 'price': parsedAmount, 'priceCurrency': 'CAD' } } : {}),
  'provider': { '@type': 'Organization', 'name': 'ScholarAB', 'url': 'https://www.scholarab.ca' },
};

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Scholarships', 'item': 'https://www.scholarab.ca/scholarships' },
    { '@type': 'ListItem', 'position': 3, 'name': scholarship.title, 'item': canonical },
  ],
};

const ctaLabel = scholarship.applyViaGuidance ? 'Learn More →' : 'Apply Now →';
---

<Layout
  title={pageTitle}
  description={description}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={canonical}
  canonical={canonical}
  currentPath="/scholarships"
  containerClass="max-w-2xl"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />

  <DetailLayout
    badge={badge}
    title={scholarship.title}
    titleMb="mb-1"
    amount={scholarship.amount}
    amountStyle="clamp(20px, 3vw, 28px)"
    url={scholarship.url}
    status={status}
    openDate={scholarship.openDate ? formatDate(scholarship.openDate) : undefined}
    backHref="/scholarships"
    backLabel="Back to Scholarships"
    ctaLabel={ctaLabel}
    itemId={scholarship.id}
    itemType="scholarship"
    lastVerified={scholarship.lastVerified}
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 border-t border-subtle pt-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Region</p>
        <p class="text-sm font-medium text-primary">{scholarship.region || 'Alberta-wide'}</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Deadline</p>
        <p class="text-sm font-medium text-primary">{formatDate(scholarship.deadline)}</p>
      </div>
      {scholarship.openDate && (
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Opens</p>
          <p class="text-sm font-medium text-primary">{formatDate(scholarship.openDate)}</p>
        </div>
      )}
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Category</p>
        <p class="text-sm font-medium text-primary">{scholarship.category || 'General'}</p>
      </div>
    </div>

    {scholarship.audience && (
      <div class="mb-6 p-4 rounded-xl bg-subtle border border-subtle">
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-1">Eligibility</p>
        <p class="text-sm text-secondary">{scholarship.audience}</p>
      </div>
    )}

    {scholarship.notes ? (
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-2">Notes</p>
        <p class="text-sm leading-relaxed text-secondary"><!--email_off-->{scholarship.notes}<!--/email_off--></p>
      </div>
    ) : (
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-2">About</p>
        <p class="text-sm leading-relaxed text-secondary">
          {scholarship.region === 'National'
            ? `${scholarship.title} is a national award open to eligible students across Canada, including Alberta.`
            : scholarship.region === 'Alberta-wide'
              ? `${scholarship.title} is an Alberta-wide award available to eligible high school students across the province.`
              : scholarship.region
                ? `${scholarship.title} is a ${scholarship.region}-based award for local high school students.`
                : `${scholarship.title} is an Alberta award for high school students.`
          }
          {' '}
          {scholarship.applyViaGuidance
            ? 'Applications go through your school guidance counsellor — ask about internal school deadlines.'
            : 'Applications are submitted directly through the official website.'}
        </p>
      </div>
    )}

    {scholarship.applyViaGuidance && (
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-tertiary mb-2">How to Apply</p>
        <p class="text-sm leading-relaxed text-secondary">Via your school guidance counsellor</p>
      </div>
    )}

    <DeadlineAlert itemType="scholarship" itemId={scholarship.id} deadline={scholarship.deadline} />
  </DetailLayout>
</Layout>
