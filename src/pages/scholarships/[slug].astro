---
import Layout from '../../layouts/Layout.astro';
import DetailLayout from '../../components/DetailLayout.astro';
import { loadScholarships } from '../../lib/data-loader';
import { generateSlug } from '../../lib/utils.ts';
import { SCHOLARSHIP_BADGES as CATEGORY_BADGE, DEFAULT_BADGE } from '../../lib/badges.ts';

export async function getStaticPaths() {
  const scholarships = await loadScholarships();
  return scholarships.map(s => ({
    params: { slug: generateSlug(s.title) },
    props: { scholarship: s },
  }));
}

const { scholarship } = Astro.props;
const slug = generateSlug(scholarship.title);


function formatDate(str: string): string {
  if (!str) return 'N/A';
  const d = new Date(str + 'T00:00:00');
  return d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}

const todayDate = new Date();
todayDate.setHours(0, 0, 0, 0);
const openDate     = new Date((scholarship.openDate || '1970-01-01') + 'T00:00:00');
const deadlineDate = scholarship.deadline ? new Date(scholarship.deadline + 'T00:00:00') : null;
const status = todayDate < openDate ? 'future' : (deadlineDate && todayDate > deadlineDate) ? 'closed' : 'active';

const rawBadge = CATEGORY_BADGE[scholarship.category] || DEFAULT_BADGE;
const badge    = { ...rawBadge, label: scholarship.category || '' };

const daysLeft = status === 'active' && deadlineDate
  ? Math.ceil((deadlineDate.getTime() - todayDate.getTime()) / 86400000)
  : null;

const description  = `The ${scholarship.title} offers ${scholarship.amount} to ${scholarship.audience}${scholarship.region ? ` in ${scholarship.region}` : ''}. Deadline: ${formatDate(scholarship.deadline)}. Browse more Alberta scholarships at ScholarAB.`;
const canonical    = `https://www.scholarab.ca/scholarships/${slug}`;
const pageTitle    = `${scholarship.title} | ScholarAB | Alberta Scholarships`;
const parsedAmount = (() => { const n = parseInt(scholarship.amount.replace(/[$,]/g, '')); return isNaN(n) ? null : n; })();

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOccupationalProgram',
  'name': scholarship.title,
  'description': description,
  'url': canonical,
  ...(scholarship.deadline ? { 'applicationDeadline': scholarship.deadline } : {}),
  ...(parsedAmount !== null ? { 'offers': { '@type': 'Offer', 'price': parsedAmount, 'priceCurrency': 'CAD' } } : {}),
  'provider': { '@type': 'Organization', 'name': 'ScholarAB', 'url': 'https://www.scholarab.ca' },
};

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Scholarships', 'item': 'https://www.scholarab.ca/scholarships' },
    { '@type': 'ListItem', 'position': 3, 'name': scholarship.title, 'item': canonical },
  ],
};
---

<Layout
  title={pageTitle}
  description={description}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={canonical}
  canonical={canonical}
  currentPath="/scholarships"
  containerClass="max-w-2xl"
>
  <script type="application/ld+json" set:html={JSON.stringify(ldJson)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />

  <DetailLayout
    badge={badge}
    title={scholarship.title}
    subtitle={scholarship.audience}
    audience={scholarship.audience}
    amount={scholarship.amount}
    url={scholarship.url}
    status={status}
    openDate={scholarship.openDate ? formatDate(scholarship.openDate) : undefined}
    backHref="/scholarships"
    backLabel="Back to Scholarships"
    itemId={scholarship.id}
    itemType="scholarship"
    deadlineFormatted={formatDate(scholarship.deadline)}
    daysLeft={daysLeft}
    region={scholarship.region}
    notes={scholarship.notes}
    applyViaGuidance={scholarship.applyViaGuidance}
  >
    <!-- Detail rows inside glass card -->
    {[
      { icon: 'grad', label: 'Eligibility', value: scholarship.audience },
      { icon: 'location', label: 'Region', value: scholarship.region || 'Alberta-wide' },
      { icon: 'calendar', label: 'Opens', value: formatDate(scholarship.openDate) },
      ...(scholarship.applyViaGuidance ? [{ icon: 'info', label: 'How to apply', value: 'Via your school guidance counsellor' }] : []),
    ].map((row, i, arr) => (
      <div style={`display:grid;grid-template-columns:28px 120px 1fr;align-items:start;gap:12px;padding:14px 20px;${i < arr.length - 1 ? 'border-bottom:1px solid var(--border-subtle);' : ''}`}>
        <div style="color:var(--text-faint);display:flex;margin-top:1px;">
          {row.icon === 'grad' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-4 9 4-9 4-9-4z"/><path d="M6 11v5c2 2 4 3 6 3s4-1 6-3v-5"/></svg>}
          {row.icon === 'location' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-8-7-13a7 7 0 0114 0c0 5-7 13-7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>}
          {row.icon === 'calendar' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>}
          {row.icon === 'info' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>}
        </div>
        <div style="font-size:12px;font-weight:500;color:var(--text-secondary);letter-spacing:-0.01em;">{row.label}</div>
        <div style="font-size:13px;font-weight:500;color:var(--text-primary);letter-spacing:-0.01em;">{row.value}</div>
      </div>
    ))}
  </DetailLayout>
</Layout>
