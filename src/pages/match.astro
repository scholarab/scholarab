---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';

import QuizLoader from '../components/QuizLoader.astro';
import quizDataUrl from '../data/quiz-payload.json?url';
import {
  QUIZ_PROMISE,
  QUIZ_MIN_QUESTION_WORD,
  QUIZ_MIN_QUESTION_COUNT,
  QUIZ_MAX_QUESTION_WORD,
  QUIZ_QUESTION_COUNT,
  QUIZ_STORAGE_KEY,
  QUIZ_TTL_MS,
} from '../lib/quiz';

const description = `${QUIZ_PROMISE} Get a shortlist of Alberta scholarships and programs worth checking.`;
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ScholarAB', item: 'https://www.scholarab.ca' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Find Your Scholarships',
      item: 'https://www.scholarab.ca/match/',
    },
  ],
};
---

<Layout
  title="Find Your Scholarships | ScholarAB"
  description={description}
  ogTitle="Find Your Scholarships | ScholarAB"
  ogDescription={description}
  ogUrl="https://www.scholarab.ca/match/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJson)}
    slot="head"
  />
  <SabFonts slot="head" />
  {/* A returning visitor with a finished run lands on results, which render
      after the catalogue loads. Question one's placeholder and the intro stood
      in until then and were swapped out, a 0.817 layout shift on desktop
      (critique 2026-09-25). Known before first paint, so they never show.
      Program-only runs have three questions. Older stored runs used four
      steps to reach the last program-relevant answer. */}
  <script is:inline slot="head" define:vars={{ key: QUIZ_STORAGE_KEY, ttl: QUIZ_TTL_MS, base: QUIZ_QUESTION_COUNT, programTotal: QUIZ_MIN_QUESTION_COUNT }}>
    try {
      const saved = JSON.parse(sessionStorage.getItem(key) || 'null');
      const a = saved && saved.answers || {};
      const total = a.searchType === 'programs'
        ? (saved.version || 1) >= 2 ? programTotal : 4
        : base + ('board' in a ? 1 : 0) + ('school' in a ? 1 : 0);
      // Version 3 dropped the scholarship path's grade question, one step.
      const step = a.searchType !== 'programs' && (saved.version || 1) < 3 && saved.step >= 2 ? saved.step - 1 : saved.step;
      if (saved && Date.now() - saved.savedAt <= ttl && step >= total) document.documentElement.classList.add('quiz-restore');
    } catch { /* private mode: the normal first paint */ }
  </script>
  {/* The quiz cannot render until the catalogue lands, and the fetch used to
      wait on its own module: on a throttled Slow 4G phone the payload did not
      start until 1,365 ms and question one stayed inert for 2.5 s. Preloading
      it here starts the download with the document instead of after the
      bundle. `crossorigin` matches fetch()'s default CORS mode, so the
      preloaded response is the one the loader reuses rather than a second
      request. */}
  <link rel="preload" as="fetch" href={quizDataUrl} crossorigin slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/match" />
  </div>

  <div id="sab-match" class="sabp" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabm-body" style="flex:1;">
      <div id="match-intro">
        <h1 class="sabm-h1">Find your match</h1>
        <p class="sabm-sub">
          {
            `${QUIZ_MIN_QUESTION_WORD} to ${QUIZ_MAX_QUESTION_WORD} questions to find scholarships and programs for you.`
          }
        </p>
        <p class="sabm-trust">No account needed. Your answers stay in this browser tab.</p>
      </div>

      <QuizLoader url={quizDataUrl} />

      <details class="sabm-about">
        <summary><h2>How the match works</h2></summary>
        <p>
          Programs use your grade and interests. Scholarships also use your location,
          average and study plans, plus your board or school when local awards require them.
          Saved progress stays in this tab and expires after an hour of inactivity. Retake quiz clears it.
        </p>
        <p>
          Scholarship match labels describe fit, not your chances of winning. Criteria
          the quiz hasn’t asked about appear as checks beside each award. Confirm eligibility
          and dates on the provider’s site before applying.
        </p>
        <p>
          You can also browse the full <a href="/scholarships/">scholarship directory</a>
          {' '}or <a href="/programs/">programs list</a>.
        </p>
      </details>
    </div>
  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  /* The match design is fixed light regardless of site theme */
  #sab-match .sabm-trust {
    color: #526252;
  }
  body:has(#sab-match) {
    background: var(--bg-page);
  }
</style>

<style>
  /* Quieter than the quiz above it on purpose: this is the page explaining
     itself, not competing with the thing the reader came to use. */
  .sabm-about {
    max-width: 62ch;
    margin: 48px 0 8px;
    padding-top: 32px;
    border-top: 1px solid rgba(20, 25, 21, 0.12);
    font-family: var(--font-body);
  }
  .sabm-about summary {
    display: flex; align-items: center; gap: 10px;
    list-style: none; cursor: pointer; min-height: 44px;
  }
  .sabm-about summary::-webkit-details-marker { display: none; }
  .sabm-about summary::after {
    content: ''; width: 8px; height: 8px; flex: none; margin-top: -4px;
    border-right: 2px solid #141915; border-bottom: 2px solid #141915;
    transform: rotate(45deg); transition: transform 0.18s ease;
  }
  .sabm-about[open] summary::after { transform: rotate(-135deg); margin-top: 4px; }
  @media (prefers-reduced-motion: reduce) { .sabm-about summary::after { transition: none; } }
  .sabm-about h2 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #141915;
    margin: 0;
  }
  .sabm-about[open] summary { margin-bottom: 14px; }
  .sabm-about p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0 0 16px;
  }
  .sabm-about p:last-child {
    margin-bottom: 0;
  }
  .sabm-about a {
    color: #141915;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sabm-about strong {
    color: #141915;
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .sabm-about {
      margin-top: 48px;
      padding-top: 24px;
    }
  }
</style>
