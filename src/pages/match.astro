---
import Layout from '../layouts/Layout.astro'
import { loadScholarships, loadPrograms } from '../lib/data-loader'
import EligibilityQuiz from '../components/EligibilityQuiz'

const [scholarships, programs] = await Promise.all([loadScholarships(), loadPrograms()])

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Find Your Scholarships', 'item': 'https://www.scholarab.ca/match' },
  ],
};
---

<Layout
  title="Find Your Scholarships | ScholarAB"
  description="Answer a few questions and instantly see every Alberta scholarship you qualify for. Your answers never leave your device."
  ogTitle="Find Your Scholarships | ScholarAB"
  ogDescription="Answer a few questions and instantly see every Alberta scholarship you qualify for. Your answers never leave your device."
  ogUrl="https://www.scholarab.ca/match"
  currentPath="/match"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <div class="pb-16">
    <div class="max-w-2xl mx-auto pt-4 md:pt-6 px-4">
      <div class="mb-4 md:mb-5" id="match-intro">
        <span class="smart-pill" style="margin-bottom:10px;">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Smart matching
        </span>
        <h1 style="font-size:clamp(26px,4vw,40px);font-weight:800;letter-spacing:-0.04em;line-height:1.05;margin-bottom:8px;color:var(--text-primary);">
          Find your <span style="color:var(--brand);">match</span>
        </h1>
        <p style="font-size:14px;color:var(--text-secondary);line-height:1.5;margin-bottom:10px;">
          6 questions. Instant results. Every Alberta opportunity available to you.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--text-tertiary);">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Answers never leave your device
          </span>
          <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--text-tertiary);">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Under 30 seconds
          </span>
        </div>
      </div>
      <hr class="quiz-divider" id="match-divider" style="margin-bottom:20px;" />
      <EligibilityQuiz scholarships={scholarships} programs={programs} client:load />
    </div>
  </div>
</Layout>
