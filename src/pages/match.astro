---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro'
import SabHeader from '../components/sab/SabHeader.astro'
import { loadScholarships, loadPrograms } from '../lib/data-loader'
import EligibilityQuiz from '../components/EligibilityQuiz'

const [scholarships, programs] = await Promise.all([loadScholarships(), loadPrograms()])

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Find Your Scholarships', 'item': 'https://www.scholarab.ca/match/' },
  ],
};
---

<Layout
  title="Find Your Scholarships | ScholarAB"
  description="Answer a few questions and instantly see every Alberta scholarship you qualify for. Your answers never leave your device."
  ogTitle="Find Your Scholarships | ScholarAB"
  ogDescription="Answer a few questions and instantly see every Alberta scholarship you qualify for. Your answers never leave your device."
  ogUrl="https://www.scholarab.ca/match/"
  currentPath="/match"
  hideChrome
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <SabFonts italic slot="head" />

  <div id="sab-match" class="sabp" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabp-header">
      <SabHeader currentPath="/match" />
    </div>

    <div class="sabm-body" style="flex:1;">
      <div id="match-intro">
        <h1 class="sabm-h1">Find your <em>match.</em></h1>
        <p class="sabm-sub">
          Six questions. Instant results. Every Alberta opportunity available to you.
        </p>
        <div class="sabm-trust sabl-mono">
          <span>◦ Answers never leave your device</span>
          <span>◦ Under 30 seconds</span>
        </div>
      </div>

      <EligibilityQuiz scholarships={scholarships} programs={programs} client:load />
    </div>

    <SabFooter />
  </div>
</Layout>

<style is:global>
  /* The match design is fixed light regardless of site theme */
  body:has(#sab-match) { background: #FAF7F0; }
</style>
