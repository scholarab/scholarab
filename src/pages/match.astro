---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';

import QuizLoader from '../components/QuizLoader.astro';
import quizDataUrl from '../data/quiz-payload.json?url';
import {
  QUIZ_DURATION,
  QUIZ_PROMISE,
  QUIZ_QUESTION_WORD,
} from '../lib/quiz';

const description = `${QUIZ_PROMISE} See every Alberta scholarship you qualify for, instantly and anonymously.`;
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ScholarAB', item: 'https://www.scholarab.ca' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Find Your Scholarships',
      item: 'https://www.scholarab.ca/match/',
    },
  ],
};
---

<Layout
  title="Find Your Scholarships | ScholarAB"
  description={description}
  ogTitle="Find Your Scholarships | ScholarAB"
  ogDescription={description}
  ogUrl="https://www.scholarab.ca/match/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJson)}
    slot="head"
  />
  <SabFonts italic slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/match" />
  </div>

  <div id="sab-match" class="sabp" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabm-body" style="flex:1;">
      <div id="match-intro">
        <h1 class="sabm-h1">Find your <em>match.</em></h1>
        <p class="sabm-sub">
          {
            `${QUIZ_QUESTION_WORD} questions to narrow your list.`
          }
        </p>
        <div class="sabm-trust sabl-mono">
          <span>◦ Completely anonymous</span>
          <span>{`◦ Under ${QUIZ_DURATION}`}</span>
        </div>
      </div>

      <QuizLoader url={quizDataUrl} />

      <section class="sabm-about">
        <h2>How matching works</h2>
        <p>Answer six to eight questions about school, interests, grades and study plans.
          Answers stay in this tab, clear after an hour, and reset when you start over.</p>
        <p>Skipped answers stay unknown, so results include awards you may qualify for.
          Strong, good and possible describe fit, not your chance of winning.</p>
        <p>Check the provider's rules before applying. You can also browse
          <a href="/scholarships/">scholarships</a>, <a href="/programs/">programs</a>,
          <a href="/deadlines/">deadlines</a> or <a href="/guides/">guides</a>.</p>
      </section>
    </div>
  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  /* The match design is fixed light regardless of site theme */
  #sab-match .sabm-trust {
    color: #526252;
  }
  body:has(#sab-match) {
    background: #fbf8f2;
  }
</style>

<style>
  /* Quieter than the quiz above it on purpose: this is the page explaining
     itself, not competing with the thing the reader came to use. */
  .sabm-about {
    max-width: 62ch;
    margin: 72px auto 8px;
    padding-top: 32px;
    border-top: 1px solid rgba(20, 25, 21, 0.12);
    font-family: 'Archivo', sans-serif;
  }
  .sabm-about h2 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #141915;
    margin: 0 0 14px;
  }
  .sabm-about p {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(20, 25, 21, 0.74);
    margin: 0 0 16px;
  }
  .sabm-about p:last-child {
    margin-bottom: 0;
  }
  .sabm-about a {
    color: #141915;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sabm-about strong {
    color: #141915;
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .sabm-about {
      margin-top: 48px;
      padding-top: 24px;
    }
  }
</style>
