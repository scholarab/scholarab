---
import Layout from '../layouts/Layout.astro'
import { loadScholarships } from '../lib/data-loader'
import EligibilityQuiz from '../components/EligibilityQuiz'

const scholarships = await loadScholarships()

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'ScholarAB', 'item': 'https://www.scholarab.ca' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Find Your Scholarships', 'item': 'https://www.scholarab.ca/match' },
  ],
};
---

<Layout
  title="Find Your Scholarships | ScholarAB"
  description="Answer a few questions and instantly see every Alberta scholarship you qualify for. Your answers never leave your device."
  ogTitle="Find Your Scholarships | ScholarAB"
  ogDescription="Answer a few questions and instantly see every Alberta scholarship you qualify for. Your answers never leave your device."
  ogUrl="https://www.scholarab.ca/match"
  currentPath="/match"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} slot="head" />
  <div class="pb-16">
    <div class="max-w-xl mx-auto pt-8 md:pt-12">

      <!-- Header -->
      <div class="mb-8">
        <a href="/scholarships" class="text-xs text-tertiary hover:text-secondary transition inline-flex items-center gap-1 mb-4">
          ← All scholarships
        </a>
        <div class="flex items-center gap-2 mb-2">
          <h1 class="font-bold text-primary" style="font-size: clamp(22px, 3vw, 32px);">Find your scholarships</h1>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full" style="background: var(--brand-dim); color: var(--brand);">Beta</span>
        </div>
<p class="text-sm text-secondary mb-3">
          Answer 2 quick questions and we'll show you every scholarship you likely qualify for, with a total award amount.
        </p>
        <div class="flex items-center gap-2 text-xs text-faint">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Your answers are matched locally on this device. Nothing is sent to a server or stored.
        </div>
      </div>

      <!-- Quiz -->
      <div class="card p-6 md:p-8">
        <EligibilityQuiz scholarships={scholarships} client:load />
      </div>

    </div>
  </div>
</Layout>
