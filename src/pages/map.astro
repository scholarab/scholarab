---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { loadScholarships } from '../lib/data-loader';
import { enrichScholarships } from '../lib/enrich';
import { SCHOLARSHIP_FACETS, facetItems } from '../lib/facets';
import { schoolOf } from '../lib/school-awards';
import {
  MAP_W, MAP_H, BORDER_PATH, dotField, edgeTicks, mapPlaces, project,
  SCHOOLS, FROM_TOWNS, KIND_WORDS, type SchoolKind,
} from '../lib/alberta-map';

// Every university, polytechnic and college in Alberta on one map
// (lib/alberta-map.ts has the sources). Built at build time from the
// province's border; the page script only moves state around. Without
// scripts every place and every school is still listed, with its links.
//
// After the map products students already use (Google Maps, Revolut's ATM
// finder, PamPam): a list panel beside the map on a wide screen, a sheet
// over it on a phone, and a place's details replacing the list when it is
// chosen. The town picker answers the question a Grade 12 student actually
// has about a school: how far is it from home.

const all = enrichScholarships(await loadScholarships());
const awardsFacet = SCHOLARSHIP_FACETS.find(f => f.bySchool)!;
const awardCounts = new Map<string, number>();
for (const s of facetItems(awardsFacet, all)) {
  const k = schoolOf(s);
  if (k) awardCounts.set(k, (awardCounts.get(k) ?? 0) + 1);
}
const awardsOf = (name?: string) => (name ? awardCounts.get(name) ?? 0 : 0);
const awardsHref = (name: string) => `/scholarships/${awardsFacet.slug}/?school=${encodeURIComponent(name)}`;

const places = mapPlaces();
const dots = dotField();
const ticks = edgeTicks();
const kinds: SchoolKind[] = ['university', 'polytechnic', 'college'];
const kindCount = (k: SchoolKind) => SCHOOLS.filter(s => s.kind === k).length;
const withAwards = SCHOOLS.filter(s => awardsOf(s.awardsName) > 0).length;
const pct = (v: number, of: number) => `${(v / of * 100).toFixed(3)}%`;
// Dot size by how many schools a place has: one school is a point, eight
// is a city. Square root, so area tracks the count.
const pinSize = (n: number) => Math.round(12 + 6 * Math.sqrt(n - 1));
const schoolsWord = (n: number) => `${n} ${n === 1 ? 'school' : 'schools'}`;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');

const fromTowns = FROM_TOWNS.map(t => {
  const [x, y] = project(t.lat, t.lon);
  return { ...t, x, y };
});
const data = {
  w: MAP_W, h: MAP_H,
  places: places.map(p => ({ id: p.id, name: p.name, lat: p.lat, lon: p.lon, x: p.x, y: p.y })),
  from: fromTowns,
};

const title = "Map of Alberta's Universities and Colleges | ScholarAB";
const description = `All ${SCHOOLS.length} universities, polytechnics and colleges in Alberta on one map, with how far each is from your town and the entrance awards ScholarAB lists for them.`;
const canonical = 'https://www.scholarab.ca/map/';
---

<Layout
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogUrl={canonical}
  canonical={canonical}
>
  <SabFonts slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/map" />
  </div>

  <div id="sab-map" class="am" data-sheet="peek">
    <div class="am-stage" data-stage>
      <div class="am-map" style={`aspect-ratio: ${MAP_W} / ${MAP_H}`} data-map>
        <svg class="am-svg" viewBox={`0 0 ${MAP_W} ${MAP_H}`} aria-hidden="true" focusable="false">
          <path class="am-land" d={BORDER_PATH} />
          <path class="am-dots am-dots-plain" d={dots.plain} />
          <path class="am-dots am-dots-foothills" d={dots.foothills} />
          <path class="am-dots am-dots-peaks" d={dots.peaks} />
          <path class="am-border" d={BORDER_PATH} />
          {ticks.map(t => <text class="am-tick" x={t.x} y={t.y} text-anchor={t.anchor}>{t.text}</text>)}
          <text class="am-range" transform={`translate(${project(51.6, -116.25).join(' ')}) rotate(-58)`}>Rocky Mountains</text>
          <path class="am-arc" d="" data-arc />
        </svg>
        <div class="am-glow" data-glow aria-hidden="true"></div>
        <div class="am-home" data-home hidden aria-hidden="true"><span class="am-home-dot"></span><span class="am-home-label" data-home-label></span></div>
        <div class="am-arc-km" data-arc-km hidden aria-hidden="true"></div>
        <div class="am-legend" aria-hidden="true">
          <span><i class="am-lg-dot"></i>One school</span>
          <span><i class="am-lg-dot am-lg-big">8</i>Several schools</span>
          <span><i class="am-lg-home"></i>Your town</span>
        </div>
        <nav class="am-pins" aria-label="Places on the map">
          {places.map((p, i) => (
            <a
              class:list={['am-pin', { 'am-pin-big': p.schools.length > 1 }, p.label && `am-pin-${p.label}`]}
              href={`#${p.id}`}
              data-pin={p.id}
              style={`left: ${pct(p.x, MAP_W)}; top: ${pct(p.y, MAP_H)}; --s: ${pinSize(p.schools.length)}px; --i: ${i}`}
              aria-label={`${p.name}, ${schoolsWord(p.schools.length)}`}
            >
              <span class="am-pin-dot" data-pin-count>{p.schools.length > 1 ? p.schools.length : ''}</span>
              <span class="am-pin-label">{p.name}</span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <section class="am-panel" aria-labelledby="am-h1" data-panel>
      <button type="button" class="am-grab" data-grab aria-expanded="false" aria-controls="am-scroll">
        <span class="am-grab-bar" aria-hidden="true"></span>
        <span class="sr-only" data-grab-label>Show the list</span>
      </button>
      <div class="am-scroll" id="am-scroll" data-scroll>
        <div class="am-head">
          <h1 id="am-h1" class="am-h1">Alberta's universities and colleges</h1>
          <p class="am-lede">
            {SCHOOLS.length} schools in {places.length} places. Choose a place to see who is there, how far it is
            from you, and the entrance awards we list for {withAwards} of them.
          </p>
          <div class="am-controls">
            <label class="am-from">
              <span class="am-from-label">From</span>
              <select data-from aria-label="Your town, to measure distances from">
                <option value="">Pick your town</option>
                {fromTowns.map(t => <option value={t.slug}>{t.name}</option>)}
              </select>
            </label>
            <div class="am-kinds" role="group" aria-label="Show">
              <button type="button" class="am-kind" data-kind="" aria-pressed="true">All <span class="am-kind-n">{SCHOOLS.length}</span></button>
              {kinds.map(k => (
                <button type="button" class="am-kind" data-kind={k} aria-pressed="false">{KIND_WORDS[k].many} <span class="am-kind-n">{kindCount(k)}</span></button>
              ))}
            </div>
          </div>
        </div>

        <ol class="am-list" data-list aria-label="Places">
          {places.map(p => (
            <li class="am-item" data-item={p.id}>
              <a class="am-row" href={`#${p.id}`} data-row={p.id}>
                <span class="am-row-top">
                  <span class="am-row-name">{p.name}</span>
                  <span class="am-row-km" data-km></span>
                </span>
                <span class="am-row-schools">
                  {p.schools.map((s, i) => <span data-kind={s.kind}>{i > 0 ? ', ' : ''}{s.short ?? s.name}</span>)}
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="am-empty" data-empty hidden>No schools of that kind. <button type="button" class="am-link" data-kind-reset>Show all</button></p>

        <div class="am-details" data-details>
          {places.map(p => (
            <article class="am-place" id={p.id} data-detail={p.id} aria-labelledby={`am-place-${p.id}`}>
              <button type="button" class="am-back" data-back>All places</button>
              <h2 class="am-place-h" id={`am-place-${p.id}`}>{p.name}</h2>
              <p class="am-place-meta"><span data-count>{schoolsWord(p.schools.length)}</span><span class="am-place-km" data-km-line></span></p>
              <ul class="am-schools">
                {p.schools.map(s => {
                  const n = awardsOf(s.awardsName);
                  return (
                    <li class="am-school" data-kind={s.kind}>
                      <h3 class="am-school-name">{s.short ?? s.name}</h3>
                      <p class="am-school-about">{s.short ? `${s.name}. ` : ''}{s.about}{s.note ? `, ${s.note}` : ''}</p>
                      <p class="am-school-links">
                        {n > 0
                          ? <a class="am-awards" href={awardsHref(s.awardsName!)}>{n} entrance {n === 1 ? 'award' : 'awards'}<span aria-hidden="true"> →</span></a>
                          : <span class="am-noawards">No entrance awards listed yet</span>}
                        <a class="am-site" href={s.site} target="_blank" rel="noopener noreferrer">{host(s.site)}<span aria-hidden="true"> ↗</span></a>
                      </p>
                    </li>
                  );
                })}
              </ul>
            </article>
          ))}
        </div>
        <p class="am-source">
          Schools from the Government of Alberta's lists of publicly funded institutions and First Nations
          colleges, plus every school we list entrance awards for. Distances are in a straight line.
        </p>
      </div>
    </section>
  </div>

  <script type="application/json" id="am-data" set:html={JSON.stringify(data)} />
  <SabFooter slot="footer" />
</Layout>

<script>
  import { kmBetween } from '../lib/alberta-map-client';

  interface Data {
    w: number; h: number;
    places: Array<{ id: string; name: string; lat: number; lon: number; x: number; y: number }>;
    from: Array<{ slug: string; name: string; lat: number; lon: number; x: number; y: number }>;
  }
  const FROM_KEY = 'sa_map_from';
  const CITY_KEY = 'sa_city';

  function init() {
    const found = document.getElementById('sab-map');
    const raw = document.getElementById('am-data');
    if (!found || !raw || found.dataset.init) return;
    const root: HTMLElement = found;
    root.dataset.init = '';
    const data = JSON.parse(raw.textContent ?? '{}') as Data;
    const byId = new Map(data.places.map(p => [p.id, p]));
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const $$ = <T extends Element>(sel: string) => [...root.querySelectorAll<T>(sel)];
    const list = $<HTMLElement>('[data-list]');
    const scroll = $<HTMLElement>('[data-scroll]');
    const grab = $<HTMLButtonElement>('[data-grab]');
    const from = $<HTMLSelectElement>('[data-from]');
    const glow = $<HTMLElement>('[data-glow]');
    const home = $<HTMLElement>('[data-home]');
    const arc = $<SVGPathElement>('[data-arc]');
    const arcKm = $<HTMLElement>('[data-arc-km]');
    const pins = new Map($$<HTMLAnchorElement>('[data-pin]').map(a => [a.dataset.pin!, a]));
    const items = new Map($$<HTMLElement>('[data-item]').map(li => [li.dataset.item!, li]));
    const cards = new Map($$<HTMLElement>('[data-detail]').map(a => [a.dataset.detail!, a]));
    const phone = matchMedia('(max-width: 899px)');
    const pct = (v: number, of: number) => `${(v / of) * 100}%`;

    let selected: string | null = null;
    let kind = '';
    let origin: Data['from'][number] | null = null;

    const setSheet = (open: boolean) => {
      root.dataset.sheet = open ? 'open' : 'peek';
      grab.setAttribute('aria-expanded', String(open));
      $('[data-grab-label]').textContent = open ? 'Hide the list' : 'Show the list';
    };

    // ── The kind filter: a place with no school of the kind dims and leaves the list.
    function applyKind() {
      let shown = 0;
      for (const [id, li] of items) {
        const names = [...li.querySelectorAll<HTMLElement>('[data-kind]')];
        let first = true;
        let n = 0;
        for (const s of names) {
          const on = !kind || s.dataset.kind === kind;
          s.hidden = !on;
          if (on) {
            n++;
            // The comma belongs to the second name on, so a hidden first name takes none along.
            const t = s.textContent!.replace(/^, /, '');
            s.textContent = first ? t : `, ${t}`;
            first = false;
          }
        }
        li.hidden = n === 0;
        if (n) shown++;
        const pin = pins.get(id)!;
        pin.classList.toggle('is-off', n === 0);
        pin.tabIndex = n === 0 ? -1 : 0;
        pin.querySelector('[data-pin-count]')!.textContent = n > 1 ? String(n) : '';
        pin.style.setProperty('--s', `${Math.round(12 + 6 * Math.sqrt(Math.max(1, n) - 1))}px`);
        const card = cards.get(id)!;
        for (const s of card.querySelectorAll<HTMLElement>('.am-school')) s.hidden = !!kind && s.dataset.kind !== kind;
        card.querySelector('[data-count]')!.textContent = `${n} ${n === 1 ? 'school' : 'schools'}`;
      }
      $<HTMLElement>('[data-empty]').hidden = shown > 0;
      for (const b of $$<HTMLButtonElement>('[data-kind]')) if (b.classList.contains('am-kind')) b.setAttribute('aria-pressed', String(b.dataset.kind === kind));
      if (selected && pins.get(selected)!.classList.contains('is-off')) select(null);
    }

    // ── Distance from the student's town: each row, each place, and the arc to the chosen one.
    function applyOrigin() {
      home.hidden = !origin;
      if (origin) {
        home.style.left = pct(origin.x, data.w);
        home.style.top = pct(origin.y, data.h);
        // A town with a school already has its name on its pin.
        $('[data-home-label]').textContent = byId.has(origin.slug) ? '' : origin.name;
        // Near the east border the name goes on the left, or it runs off a phone.
        home.classList.toggle('am-home-left', origin.x > data.w * 0.6);
      }
      const km = new Map(data.places.map(p => [p.id, origin ? kmBetween(origin, p) : 0]));
      for (const [id, li] of items) {
        const d = km.get(id)!;
        li.querySelector('[data-km]')!.textContent = origin ? (d < 5 ? 'Here' : `${Math.round(d)} km`) : '';
        const line = cards.get(id)!.querySelector('[data-km-line]')!;
        line.textContent = !origin ? '' : d < 5 ? `In ${origin.name}` : `${Math.round(d).toLocaleString('en-CA')} km from ${origin.name}, in a straight line`;
      }
      // Nearest first once there is a town; biggest first, as built, without one.
      const order = [...items.keys()];
      if (origin) order.sort((a, b) => km.get(a)! - km.get(b)!);
      for (const id of order) list.append(items.get(id)!);
      drawArc();
    }

    function drawArc() {
      const p = selected ? byId.get(selected) : null;
      if (!origin || !p || kmBetween(origin, p) < 5) {
        arc.setAttribute('d', '');
        arcKm.hidden = true;
        return;
      }
      // A gentle bow to one side, so the line reads as a journey, not a ruler.
      const mx = (origin.x + p.x) / 2, my = (origin.y + p.y) / 2;
      const dx = p.x - origin.x, dy = p.y - origin.y;
      const len = Math.hypot(dx, dy);
      const bow = Math.min(60, len * 0.22);
      const cx = mx - (dy / len) * bow, cy = my + (dx / len) * bow;
      arc.setAttribute('d', `M${origin.x} ${origin.y}Q${cx} ${cy} ${p.x} ${p.y}`);
      arc.style.setProperty('--len', String(Math.ceil(arc.getTotalLength())));
      arc.classList.remove('is-drawn');
      void arc.getBoundingClientRect();
      arc.classList.add('is-drawn');
      arcKm.hidden = false;
      arcKm.textContent = `${Math.round(kmBetween(origin, p)).toLocaleString('en-CA')} km`;
      // The curve's own midpoint, half way between the chord and the control point.
      arcKm.style.left = pct((mx + cx) / 2, data.w);
      arcKm.style.top = pct((my + cy) / 2, data.h);
    }

    function select(id: string | null, opts: { focus?: boolean; push?: boolean } = {}) {
      selected = id && byId.has(id) ? id : null;
      root.toggleAttribute('data-picked', !!selected);
      list.hidden = !!selected;
      for (const [pid, card] of cards) card.hidden = pid !== selected;
      for (const [pid, pin] of pins) {
        pin.classList.toggle('is-on', pid === selected);
        if (pid === selected) pin.setAttribute('aria-current', 'true');
        else pin.removeAttribute('aria-current');
      }
      const p = selected ? byId.get(selected)! : null;
      glow.classList.toggle('is-on', !!p);
      if (p) {
        glow.style.left = pct(p.x, data.w);
        glow.style.top = pct(p.y, data.h);
      }
      const hash = selected ? `#${selected}` : location.pathname + location.search;
      if (opts.push !== false) history.replaceState(null, '', hash);
      if (selected) {
        if (phone.matches) setSheet(true);
        scroll.scrollTop = 0;
        if (opts.focus) cards.get(selected)!.querySelector<HTMLElement>('.am-place-h')!.focus({ preventScroll: true });
      }
      drawArc();
    }

    // Pins and rows are links to the place's own article, so they work
    // without scripts; with them, the panel shows that place instead.
    root.addEventListener('click', e => {
      const t = e.target as Element;
      const link = t.closest<HTMLAnchorElement>('[data-pin], [data-row]');
      if (link) {
        e.preventDefault();
        select(link.dataset.pin ?? link.dataset.row!, { focus: e.detail === 0 });
        return;
      }
      if (t.closest('[data-back]')) {
        const was = selected;
        select(null);
        if (was) items.get(was)?.querySelector<HTMLElement>('[data-row]')?.focus({ preventScroll: false });
        return;
      }
      const k = t.closest<HTMLButtonElement>('.am-kind, [data-kind-reset]');
      if (k) { kind = k.dataset.kind ?? ''; applyKind(); return; }
      if (t.closest('[data-grab]')) { setSheet(root.dataset.sheet !== 'open'); return; }
      // A tap on the empty map lowers the sheet, so the whole province shows.
      if (phone.matches && t.closest('[data-stage]') && !t.closest('[data-pin]')) setSheet(false);
    });
    root.addEventListener('keydown', e => {
      if (e.key === 'Escape' && selected) {
        const was = selected;
        select(null);
        pins.get(was)?.focus();
      }
    });
    // A row and its pin light up together.
    const hover = (id: string | undefined, on: boolean) => { if (id) pins.get(id)?.classList.toggle('is-hover', on); };
    list.addEventListener('pointerover', e => hover((e.target as Element).closest<HTMLElement>('[data-row]')?.dataset.row, true));
    list.addEventListener('pointerout', e => hover((e.target as Element).closest<HTMLElement>('[data-row]')?.dataset.row, false));
    list.addEventListener('focusin', e => hover((e.target as HTMLElement).dataset.row, true));
    list.addEventListener('focusout', e => hover((e.target as HTMLElement).dataset.row, false));

    from.addEventListener('change', () => {
      origin = data.from.find(t => t.slug === from.value) ?? null;
      try { if (origin) localStorage.setItem(FROM_KEY, origin.slug); else localStorage.removeItem(FROM_KEY); } catch { /* storage blocked */ }
      applyOrigin();
    });
    // The town picked here before, else the city list the student last opened.
    let saved = '';
    try { saved = localStorage.getItem(FROM_KEY) ?? localStorage.getItem(CITY_KEY) ?? ''; } catch { /* storage blocked */ }
    if (data.from.some(t => t.slug === saved)) { from.value = saved; origin = data.from.find(t => t.slug === saved)!; }

    applyKind();
    applyOrigin();
    select(location.hash.slice(1) || null, { push: false });
    // A shared link (/map/#calgary) opens that place in the panel; the
    // browser's own jump to the anchor would only push the map off the top.
    // It jumps again at load, so the reset waits for that too.
    if (selected) {
      const top = () => scrollTo(0, 0);
      setTimeout(top, 0);
      if (document.readyState !== 'complete') addEventListener('load', () => setTimeout(top, 0), { once: true });
    }
    addEventListener('hashchange', () => select(location.hash.slice(1) || null, { push: false }));
    root.classList.add('is-ready');
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  /* The canvas is the map's ink from the header down, as on the home page. */
  html:has(#sab-map), body:has(#sab-map) { background: #0A1310; }

  #sab-map {
    --am-ink: #0A1310;
    --am-panel: #0E1915;
    --am-line: rgba(238, 241, 236, 0.12);
    --am-text: #EEF1EC;
    --am-soft: rgba(238, 241, 236, 0.78);
    --am-faint: rgba(238, 241, 236, 0.6);
    --am-mint: #2FD3A0;
    --am-mint-hi: #5CE3BB;
    --am-peek: 136px;
    position: relative;
    display: grid; grid-template-columns: minmax(340px, 420px) minmax(0, 1fr);
    height: calc(100vh - var(--sab-nav-h)); height: calc(100svh - var(--sab-nav-h));
    min-height: 560px;
    background: var(--am-ink); color: var(--am-text);
    font-family: var(--font-body);
  }

  /* ── The map ── */
  .am-stage {
    grid-column: 2; grid-row: 1; position: relative; min-height: 0;
    display: grid; place-items: center; padding: 28px 32px;
    background: radial-gradient(60% 55% at 50% 50%, rgba(47, 211, 160, 0.07), transparent 70%);
    overflow: hidden;
  }
  .am-map {
    position: relative;
    height: 100%; max-height: 100%; max-width: 100%;
  }
  .am-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .am-land { fill: rgba(238, 241, 236, 0.025); }
  .am-border { fill: none; stroke: rgba(238, 241, 236, 0.32); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .am-dots { fill: none; stroke-linecap: round; stroke-width: 2.4; }
  .am-dots-plain { stroke: rgba(238, 241, 236, 0.22); }
  .am-dots-foothills { stroke: rgba(238, 241, 236, 0.3); }
  .am-dots-peaks { stroke: rgba(238, 241, 236, 0.5); stroke-width: 2.8; }
  .am-tick, .am-range {
    font-family: var(--font-label); font-size: 13px; letter-spacing: 0.08em; fill: rgba(238, 241, 236, 0.42);
  }
  .am-range { font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase; fill: rgba(238, 241, 236, 0.5); }

  /* The line from the student's town to the chosen place draws itself in. */
  .am-arc { fill: none; stroke: var(--am-mint); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .am-arc-km {
    position: absolute; transform: translate(-50%, -50%); z-index: 3; pointer-events: none;
    padding: 3px 7px; border-radius: var(--radius); background: var(--am-mint); color: #08120E;
    font: 600 12px/1.2 var(--font-body); white-space: nowrap;
  }

  /* A soft light under the chosen place, gliding from place to place. */
  .am-glow {
    position: absolute; width: 180px; height: 180px; margin: -90px 0 0 -90px; border-radius: 50%;
