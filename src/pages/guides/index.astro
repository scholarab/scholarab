---
import Layout from '../../layouts/Layout.astro';
import SabHeader from '../../components/sab/SabHeader.astro';
import SabFooter from '../../components/sab/SabFooter.astro';
import SabFonts from '../../components/sab/SabFonts.astro';
import { guides } from '../../lib/guides';

const pageTitle = 'Scholarship Guides for Alberta Students | ScholarAB';
const description =
  'Practical guides for Alberta high school students: the Rutherford scholarship, essays, reference letters, timelines, research programs and contests.';
const canonical = 'https://www.scholarab.ca/guides/';

const collectionJson = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': 'Scholarship Guides for Alberta Students',
  'description': description,
  'url': canonical,
  'provider': { '@type': 'Organization', 'name': 'ScholarAB', 'url': 'https://www.scholarab.ca' },
  'hasPart': guides.map(g => ({
    '@type': 'Article',
    'headline': g.title,
    'url': `https://www.scholarab.ca/guides/${g.slug}/`,
  })),
};
---

<Layout
  title={pageTitle}
  description={description}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={canonical}
  canonical={canonical}
>
  <SabFonts slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJson)} slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/guides" />
  </div>

  <div class="sabp" id="sab-guides" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabgi-body" style="flex:1;">
      <h1 class="sabgi-h1">How to win a scholarship</h1>
      <p class="sabgi-lede">
        Short, practical guides written for Alberta high school students. No recycled advice from American sites that doesn't apply here.
      </p>

      {/* A list, not a card grid with tags and read times (critique
          2026-09-23). No 01 to 18 numbers either: the list has no order a
          reader needs. */}
      <ul class="sabgi-list">
        {guides.map(g => (
          <li>
            <a href={`/guides/${g.slug}/`} class="sabgi-row">
              <h2 class="sabgi-row-title">{g.title}</h2>
              <p class="sabgi-row-desc">{g.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <SabFooter slot="footer" />
</Layout>

<style is:global>
  body:has(#sab-guides) { background: var(--bg-page); }
</style>

<style>
  .sabgi-body { max-width: var(--sab-measure); margin: 0 auto; padding: 72px var(--sab-gutter) 110px; width: 100%; box-sizing: border-box; }
  .sabgi-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(44px, 7vw, 76px); line-height: 1.05; letter-spacing: -0.015em; margin: 0;
  }
  .sabgi-lede { font-size: 17px; line-height: 1.6; color: rgba(20, 25, 21, 0.78); margin: 20px 0 0; max-width: 62ch; }

  .sabgi-list { list-style: none; margin: 44px 0 0; padding: 0; border-top: 2px solid #141915; max-width: 900px; }
  .sabgi-row {
    display: block; padding: 20px 8px; border-bottom: 1px solid rgba(20,25,21,0.14);
    text-decoration: none; color: #141915; transition: background 0.15s ease;
  }
  .sabgi-row:hover { background: rgba(20,25,21,0.04); }
  .sabgi-row:hover .sabgi-row-title { color: var(--green); }
  .sabgi-row-title { font-weight: 700; font-size: 19px; letter-spacing: -0.01em; line-height: 1.3; margin: 0; }
  .sabgi-row-desc { font-size: 15.5px; line-height: 1.55; color: rgba(20, 25, 21, 0.75); margin: 6px 0 0; max-width: 72ch; }

  @media (max-width: 900px) {
    .sabgi-body { padding: 44px 20px 90px; }
    .sabgi-list { margin-top: 32px; }
    .sabgi-row { padding: 16px 2px; }
    .sabgi-row-title { font-size: 17px; }
  }
</style>
