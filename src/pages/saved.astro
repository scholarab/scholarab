---
import Layout from '../layouts/Layout.astro';
import { loadScholarships, loadPrograms } from '../lib/data-loader';
import SavedList from '../components/SavedList.tsx';
const scholarships = await loadScholarships();
const programs = await loadPrograms();
---

<Layout
  title="Saved Scholarships | ScholarAB"
  description="Your saved Alberta scholarships and research programs. Bookmark opportunities and track deadlines in one place."
  ogTitle="Saved Scholarships | ScholarAB"
  ogDescription="Your saved Alberta scholarships and research programs. Bookmark opportunities and track deadlines in one place."
  ogUrl="https://www.scholarab.ca/saved"
  currentPath="/saved"
  robots="noindex, follow"
>
  <div>
    <SavedList initialScholarships={scholarships} initialPrograms={programs} client:load />
  </div>
</Layout>
