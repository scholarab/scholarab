---
import SabFooter from '../components/sab/SabFooter.astro';
import SabFonts from '../components/sab/SabFonts.astro';
import Layout from '../layouts/Layout.astro';
import SabHeader from '../components/sab/SabHeader.astro';
import { loadScholarships, loadPrograms } from '../lib/data-loader';
import { QUIZ_DURATION, QUIZ_QUESTION_COUNT, QUIZ_MAX_QUESTION_COUNT } from '../lib/quiz';
import { SCHOLARSHIP_FACETS, MIN_FACET_ITEMS, facetItems } from '../lib/facets';
import { programIsListed, scholarshipStatusOf } from '../lib/status';
import { getToday, formatDeadline, generateSlug } from '../lib/utils';
import { webPageJson } from '../lib/ld';

const [scholarships, programs] = await Promise.all([loadScholarships(), loadPrograms()]);

const today = getToday();

// programs.length counts retired programs, which /programs does not list, so
// this page was quoting counsellors a number eight higher than the directory
// they were about to open. Same helper the home hero and the nav count use.
const scholarshipCount = scholarships.length.toLocaleString('en-CA');
const programCount = programs.filter(p => programIsListed(p, today)).length.toLocaleString('en-CA');

// Counted from the hubs that exist, not typed in: this line listed five cities
// long after the site had grown to over twenty.
const cityHubCount = SCHOLARSHIP_FACETS
  .filter(f => f.kind === 'region' && !f.broad && facetItems(f, scholarships).length >= MIN_FACET_ITEMS).length;

// The page is a handout (critique 2026-09-23: the stats row, tag cards,
// 01/02/03 steps and dark CTA block were a landing-page kit, on the page for
// the site's distribution channel). Plain lines a counsellor can print.
const canDo = [
  `Take the ${QUIZ_QUESTION_COUNT} to ${QUIZ_MAX_QUESTION_COUNT} question match quiz (${QUIZ_DURATION}) and get a shortlist worth checking.`,
  `Browse by where they live: ${cityHubCount} city and town pages, plus province-wide and national lists.`,
  'Save scholarships and get email reminders 30, 14 and 3 days before the deadline.',
  'Find paid and unpaid research placements, competitions and trades apprenticeships.',
];

// The directory's own definition of open and the home page's "next five", so
// the printed sheet lists exactly what a student will find on the site.
const nextDeadlines = scholarships
  .filter(s => s.deadline && scholarshipStatusOf(s, today) === 'active')
  .sort((a, b) => a.deadline!.localeCompare(b.deadline!))
  .slice(0, 5);
const asOf = today.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });

const pageTitle = 'For Alberta Educators & Counsellors | ScholarAB';
// Ranked position 1.5 on 24 impressions and took zero clicks, so the ranking
// was never the problem; the snippet was. The old one restated the title and
// then described the site in the abstract ("a free directory... help your
// students find awards"), which is the shape of copy a counsellor has already
// read on five other sites. The counts are the one thing here that no
// competitor snippet can claim, so they lead.
//
// Interpolated rather than typed out: the counts above come
// from the live data, and a hardcoded number in the description would drift
// away from the number rendered on the page the first time a listing lands.
const description = `${scholarshipCount} Alberta scholarships and ${programCount} research programs, sorted by deadline and free for your students. No accounts, no ads, nothing to sign up for.`;
const canonical = 'https://www.scholarab.ca/educators/';
const ldJson = webPageJson({ name: 'For Alberta Educators & Counsellors', description, path: '/educators/' });
---

<Layout
  title={pageTitle}
  description={description}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={canonical}
  canonical={canonical}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} slot="head" />
  <SabFonts slot="head" />

  <div class="sabp-header" slot="header">
    <SabHeader currentPath="/educators" />
  </div>

  <div id="sab-educators" class="sabp" style="display:flex;flex-direction:column;min-height:100%;">
    <div class="sabe-body" style="flex:1;">
      <h1 class="sabe-h1">For counsellors and teachers</h1>
      <p class="sabe-lede">
        ScholarAB is a free list of {scholarshipCount} Alberta scholarships and {programCount} research programs for high school students, each with its deadline and amount. Students don't need an account. Post the link in your guidance office or send it to Grade 11 and 12 students; this page prints as a one-page handout.
      </p>
      <div class="sabe-actions">
        <button type="button" class="sab-btn sabe-btn sabe-btn-solid" data-sabe-print>Print the handout</button>
        <a href="/scholarships/" class="sab-btn sabe-btn sabe-btn-outline">Browse scholarships</a>
      </div>

      <section class="sabe-sheet" aria-labelledby="sabe-sheet-h">
        <h2 id="sabe-sheet-h" class="sabe-domain">scholarab<span class="sabe-tld">.ca</span></h2>
        <p class="sabe-sheet-sub">Scholarships and research programs for Alberta high school students. Free, no account.</p>

        <h3 class="sabe-h3">What you can do there</h3>
        <ul class="sabe-list">
          {canDo.map(line => <li>{line}</li>)}
        </ul>

        {nextDeadlines.length > 0 && (
          <>
            <h3 class="sabe-h3">Next deadlines, as of {asOf}</h3>
            <ul class="sabe-deadlines">
              {nextDeadlines.map(s => (
                <li>
                  <a href={`/scholarships/${generateSlug(s.title)}/`}>{s.title}</a>
                  <span class="sabe-dl-amount tnum">{s.amount}</span>
                  <span class="sabe-dl-date tnum">{formatDeadline(s.deadline)}</span>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>

      <p class="sabe-contact">Built by a high school student in Medicine Hat. Questions, or an award your students should see? <!--email_off--><a href="mailto:contact.scholarab@gmail.com">contact.scholarab@gmail.com</a><!--/email_off--></p>
    </div>
  </div>

  <SabFooter slot="footer" />
</Layout>

<script is:inline>
  document.querySelector('[data-sabe-print]')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  /* The educators design is fixed light regardless of site theme */
  body:has(#sab-educators) { background: var(--bg-page); }

  /* The handout prints alone: no header, footer, consent banner or buttons. */
  @media print {
    body:has(#sab-educators) .sabp-header,
    body:has(#sab-educators) .sabf-footer,
    body:has(#sab-educators) .sabe-actions,
    body:has(#sab-educators) .sabe-lede,
    body:has(#sab-educators) .sabe-h1,
    body:has(#sab-educators) #sab-consent { display: none !important; }
    body:has(#sab-educators) .sabe-body { padding: 0; }
    body:has(#sab-educators) .sabe-sheet { border: 0; padding: 0; margin: 0; }
  }
</style>

<style>
  .sabe-body { padding: 72px var(--sab-gutter) 110px; width: 100%; max-width: var(--sab-measure); margin: 0 auto; box-sizing: border-box; }
  .sabe-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(44px, 7vw, 76px); line-height: 1.05; letter-spacing: -0.015em; margin: 0;
  }
  .sabe-lede { font-size: 17px; line-height: 1.6; color: rgba(20, 25, 21, 0.78); margin: 20px 0 0; max-width: 62ch; }

  .sabe-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .sabe-btn {
    display: inline-flex; align-items: center; font-family: var(--font-body);
    font-size: 15.5px; border-radius: 100px; text-decoration: none; cursor: pointer;
  }
  .sabe-btn-solid { background: var(--green); color: #F5FBF8; font-weight: 700; padding: 13px 24px; border: 0; }
  .sabe-btn-solid:hover { background: #08573E; }
  .sabe-btn-outline { color: var(--text-primary); font-weight: 600; padding: 12px 22px; border: 1.5px solid rgba(20,25,21,0.3); }
  .sabe-btn-outline:hover { border-color: var(--green); color: var(--text-primary); }

  /* The sheet is the handout: one bordered page, read top to bottom. */
  .sabe-sheet {
    margin-top: 56px; max-width: 760px; border: 1.5px solid rgba(20,25,21,0.85);
    border-radius: 14px; padding: 40px 44px 36px; background: #FFFFFF;
  }
  .sabe-domain { font-family: var(--font-display); font-weight: 400; font-size: clamp(48px, 8vw, 84px); line-height: 1; letter-spacing: -0.01em; margin: 0; }
  .sabe-tld { color: #0A6B4D; }
  .sabe-sheet-sub { font-size: 17px; line-height: 1.5; color: rgba(20, 25, 21, 0.78); margin: 12px 0 0; }
  .sabe-h3 { font-size: 17px; font-weight: 700; margin: 34px 0 10px; }
  .sabe-list { margin: 0; padding-left: 1.2em; font-size: 16px; line-height: 1.6; color: rgba(20, 25, 21, 0.85); }
  .sabe-list li + li { margin-top: 6px; }
  .sabe-deadlines { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(20,25,21,0.14); }
  .sabe-deadlines li {
    display: grid; grid-template-columns: 1fr auto 110px; gap: 16px; align-items: baseline;
    padding: 10px 0; border-bottom: 1px solid rgba(20,25,21,0.14); font-size: 15.5px;
  }
  .sabe-deadlines a { color: var(--text-primary); text-decoration: none; font-weight: 600; }
  .sabe-deadlines a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sabe-dl-amount { color: #0A6B4D; font-weight: 700; }
  .sabe-dl-date { color: rgba(20, 25, 21, 0.78); text-align: right; }

  .sabe-contact { font-size: 15px; line-height: 1.6; color: rgba(20, 25, 21, 0.78); margin: 32px 0 0; max-width: 62ch; }
  .sabe-contact a { color: #0A6B4D; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    .sabe-body { padding: 44px 20px 90px; }
    .sabe-sheet { padding: 28px 20px 24px; margin-top: 40px; }
    .sabe-deadlines li { grid-template-columns: 1fr auto; gap: 4px 12px; }
    .sabe-dl-date { grid-column: 1 / -1; text-align: left; font-size: 14px; }
  }
</style>
