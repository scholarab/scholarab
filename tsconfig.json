{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    // Preact is the only JSX runtime. Vite reads these for tests and the build.
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "exclude": [
    "scripts",
    "dist",
    "coverage",
    "test-results",
    // Local, gitignored working folders: a hosted checkout never has them,
    // and their one-off scripts failed `astro check` here.
    "private",
    "outreach",
    "output",
    "social-out"
  ]
}
