{
  // The root tsconfig excludes "scripts" so `astro check` stays focused on the
  // site. That left the five build/automation scripts type-checked by nothing.
  // This config covers them; `npm run type-check:scripts` runs it in CI.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": []
}
