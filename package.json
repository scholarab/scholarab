{
  "name": "scholarab",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "TZ=America/Edmonton tsx scripts/validate-data.ts && TZ=America/Edmonton tsx scripts/generate-sitemap.ts && TZ=America/Edmonton tsx scripts/generate-og-images.ts && tsx scripts/generate-catalogue-payloads.ts && DATABASE_URL= TZ=America/Edmonton astro build && tsx scripts/check-bundle-secrets.ts",
    "preview": "astro preview",
    "auto-expire": "tsx scripts/auto-expire.ts",
    "sitemap": "TZ=America/Edmonton tsx scripts/generate-sitemap.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "check-copies": "tsx scripts/check-copies.ts",
    "sync-db": "tsx scripts/sync-db.ts",
    "check-outreach": "TZ=America/Edmonton tsx scripts/check-outreach.ts",
    "pretest": "tsx scripts/generate-catalogue-payloads.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type-check": "astro check",
    "type-check:scripts": "tsc -p tsconfig.scripts.json",
    "ci": "npm run lint && npm test && npm run build && npm run type-check && npm run type-check:scripts",
    "social": "TZ=America/Edmonton tsx scripts/generate-social.ts",
    "indexnow": "TZ=America/Edmonton tsx scripts/submit-indexnow.ts",
    "index-status": "TZ=America/Edmonton tsx scripts/index-status.ts",
    "gsc-months": "TZ=America/Edmonton tsx scripts/gsc-months.ts",
    "gsc-ctr": "TZ=America/Edmonton tsx scripts/gsc-ctr.ts",
    "predev": "tsx scripts/generate-catalogue-payloads.ts",
    "pretype-check": "tsx scripts/generate-catalogue-payloads.ts",
    "migrate-db": "tsx scripts/migrate-db.ts",
    "publish-drafts": "tsx scripts/publish-drafts.ts",
    "ship-check": "sh .agents/skills/ship-check/scripts/ship-check.sh",
    "measure:match": "MATCH_MEASURE=1 playwright test e2e/match-performance.spec.ts --project chromium --workers 1"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "astro": "^7.3.5",
    "drizzle-orm": "^0.45.2",
    "preact": "^11.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    },
    "miniflare": {
      "undici": "^7.30.0"
    },
    "satori": {
      "fflate": "^0.8.3"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.8.9",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^1.1.0",
    "satori": "^0.33.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "undici": "^8.11.2",
    "vitest": "^5.0.3",
    "wrangler": "4.145.0"
  }
